//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
// V8 FULL · Engine + Context merged in ONE script (token probe build)
// v8.0.5-full · M0-M20 (engine) + C5-C10 (context: MTF ladder, HTF CRT/TBS/TWS, HTF POI #2, trap LT-1..7, panel)
//
// Lineage: 2..txt (ICT-TE v7.10) causal core + 1.txt (LQ-SD-PA v3.1.1) feature set.
// Plan:    V8_MASTER_PLAN_BN.md · Build rules: V8_BUILD_PROCESS_BN.md
// Changelog lives in CHANGELOG.md — this header stays under 30 lines on purpose.
//
// Module order (do not reorder — Pine reads top-down):
//   M0 indicator · M1 inputs · M2 constants+helpers · M3 core series · M4 structure
//   M5 sessions+SB clock · M6 HTF · M7 pool registry · M8 range/OTE · M9 zones
//   M10 triggers · M11 run/cong/regime · M12 setup machine · M13 score · M14 gates
//   M15 risk · M16 trade engine · M17 trade mgmt · M18 draw · M19 dashboard · M20 alerts
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════ M0 · INDICATOR
indicator("V8 Liquidity + PD Array Trade Engine · FULL", "V8-FULL", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════ M1 · INPUTS
// Rule: every input is declared HERE. No input.* anywhere below M1.
// Rule: show* toggles gate DRAWING only. Detection never reads them.

// ── ① Master ──────────────────────────────────────────────────────────────
grpMaster    = "① Master"
entryMode    = input.string("Narrative + confluence", "Entry mode",
     options = ["Narrative only (A+)", "Narrative + confluence", "All engines"], group = grpMaster)
minTier      = input.int(2, "Minimum POI tier (1 = A+ only, 3 = any)", minval = 1, maxval = 3, group = grpMaster)
needHtfAlign = input.bool(true, "Require HTF context alignment", group = grpMaster)
minGrade     = input.string("B", "Minimum grade to trade", options = ["A+", "A", "B"], group = grpMaster)
strictSeq    = input.bool(true, "Strict chronological sequencing", group = grpMaster)
allowRev     = input.bool(true, "Allow counter-HTF REVERSAL setups", group = grpMaster)
maxSetups    = input.int(2, "Concurrent setups per side", minval = 1, maxval = 3, group = grpMaster)
maxPenalty   = input.int(2, "Max grade downgrade steps", minval = 1, maxval = 4, group = grpMaster)

// ── ② General ─────────────────────────────────────────────────────────────
grpG       = "② General"
pivLen     = input.int(5,  "Pivot length (internal / execution)", minval = 2, group = grpG)
extPiv     = input.int(12, "Pivot length (external / context)",   minval = 5, group = grpG)
atrLen     = input.int(14, "ATR length", minval = 1, group = grpG)
biasLen    = input.int(50, "Bias EMA length", minval = 5, group = grpG)
biasFilter = input.string("Off", "Bias filter — block counter-trend signals",
     options = ["Off", "5", "15", "60", "240", "D"], group = grpG)
showLevels = input.bool(true, "Show last swing high / low", group = grpG)
showSweeps = input.bool(true, "Mark liquidity raids", group = grpG)

// ── ③ Structure ───────────────────────────────────────────────────────────
grpM       = "③ Structure"
showStruct = input.bool(true,  "Label BOS / CHoCH", group = grpM)
structFilt = input.bool(false, "Filter signals by structure direction", group = grpM)
structDisp = input.float(0.5, "Structural break body ≥ ATR × (0 = any close)", step = 0.1, minval = 0, group = grpM)
showProt   = input.bool(true,  "Plot protected swing (external)", group = grpM)

// ── ④ Liquidity ───────────────────────────────────────────────────────────
grpLQ        = "④ Liquidity"
showEq       = input.bool(true, "Draw EQH / EQL", group = grpLQ)
eqTol        = input.float(0.15, "Equal level tolerance (ATR ×)", step = 0.05, minval = 0.05, group = grpLQ)
eqMinSep     = input.int(5, "EQH/EQL minimum bar separation", minval = 2, group = grpLQ)
eqNeedReact  = input.bool(true, "EQH/EQL require a reaction at both legs", group = grpLQ)
eqScanN      = input.int(2, "Equal-level pivot memory (pivots compared)", minval = 1, maxval = 6, group = grpLQ)
eqTickMin    = input.int(0, "Equal tolerance floor (ticks)", minval = 0, maxval = 500, group = grpLQ)
sweepLook    = input.int(15, "Raid stays bindable for (bars)", minval = 1, group = grpLQ)
reactWin     = input.int(6, "Bars allowed for a reaction after a raid", minval = 1, group = grpLQ)
poolLife     = input.int(300, "Pool max age (bars, 0 = never)", minval = 0, group = grpLQ)
raidMinAtr   = input.float(0.10, "Minimum raid penetration (ATR ×)", step = 0.05, minval = 0.0, group = grpLQ)
raidDeepAtr  = input.float(0.35, "Grade-A raid penetration (ATR ×)", step = 0.05, minval = 0.05, group = grpLQ)
raidRejFrac  = input.float(0.5, "Raid rejection: close back ≥ this × bar range", step = 0.05, minval = 0.0, maxval = 1.0, group = grpLQ)
raidBackAtr  = input.float(0.0, "Raid rejection also needs close-back (ATR ×, 0 = off)", step = 0.05, minval = 0.0, group = grpLQ)
poolMinTouch = input.int(0, "Prior reactions a pool needs to be a target", minval = 0, maxval = 5, group = grpLQ)
poolMaxN     = input.int(28, "Max pools tracked", minval = 6, maxval = 40, group = grpLQ)
lqPrunePri   = input.bool(true, "Prune the WEAKEST pool at the cap (not the oldest)", group = grpLQ)
tgtDistW     = input.float(1.5, "Target ranking — distance penalty per ATR", step = 0.25, minval = 0.0, group = grpLQ)
tgtMaxAtr    = input.float(25.0, "Target must be within (ATR ×)", step = 5.0, minval = 3.0, group = grpLQ)
tgtMode      = input.string("Any qualifying pool", "Liquidity target mode",
     options = ["Best pool", "Any qualifying pool"], group = grpLQ)
tgtMinPri    = input.int(3, "Any-pool mode: min level priority (1 swing · 3 session · 4 ext/TL · 5 PD/EQ · 6 PW · 7 HTF)", minval = 1, maxval = 7, group = grpLQ)
showPools    = input.bool(true, "Draw the liquidity registry", group = grpLQ)
showSesHL    = input.bool(true, "Session high / low lines", group = grpLQ)
showPD       = input.bool(true, "Previous day high / low", group = grpLQ)
showPW       = input.bool(true, "Previous week high / low", group = grpLQ)
showTL       = input.bool(true, "Trendline liquidity (swept sloped highs / lows)", group = grpLQ)
tlMinTouch   = input.int(2, "Trendline touches before it is liquidity", minval = 1, maxval = 8, group = grpLQ)
lqRaidChar   = input.bool(true, "Mark external-liquidity raids (◇)", group = grpLQ)

// ── ⑤ Supply / Demand / PD arrays ─────────────────────────────────────────
grpZ        = "⑤ Supply / Demand"
showZones   = input.bool(true, "Draw zones", group = grpZ)
dispFactor  = input.float(1.2, "Displacement body ≥ ATR × (chart-wide marker)", step = 0.1, minval = 0.5, group = grpZ)
maxZoneAtr  = input.float(2.0, "Max zone height (ATR ×)", step = 0.5, minval = 0.5, group = grpZ)
maxZones    = input.int(8, "Max zones per side", minval = 1, maxval = 16, group = grpZ)
showOB      = input.bool(true, "Order blocks", group = grpZ)
showBPR     = input.bool(true, "Tag balanced price ranges", group = grpZ)
sdRaidAtr   = input.float(1.0, "S/D provenance: raid wick may sit this far beyond the origin edge (ATR ×)", step = 0.25, minval = 0.0, group = grpZ)
showNext    = input.bool(true, "Highlight NEXT buy / sell zone", group = grpZ)
confirmWin  = input.int(5, "Max bars from 50% tap to confirmation", minval = 1, maxval = 20, group = grpZ)
showFlip    = input.bool(true, "Flip violated zones into breaker / mitigation", group = grpZ)
showRB      = input.bool(true, "Rejection blocks", group = grpZ)
showTier    = input.bool(true, "Show tier tag on zones", group = grpZ)
spreadGuard = input.bool(true, "Refuse an array thinner than 2× estimated spread", group = grpZ)

// ── ⑥ FVG ─────────────────────────────────────────────────────────────────
grpFV        = "⑥ FVG"
showFvgState = input.bool(true, "Annotate FVG lifecycle", group = grpFV)
fvgFillDead  = input.bool(true, "A fully filled FVG stops being a POI", group = grpFV)
fvgMinAtr    = input.float(0.10, "Minimum FVG height (ATR ×)", step = 0.05, minval = 0.0, group = grpFV)
htfOverlapUp = input.bool(true, "LTF array inside a live HTF FVG → tier +1", group = grpFV)

// ── ⑦ HTF ─────────────────────────────────────────────────────────────────
grpH         = "⑦ HTF"
htfSel       = input.string("Auto", "HTF for POI / structure / liquidity", options = ["Auto", "15", "30", "60", "240", "D"], group = grpH)
htfCtxSel    = input.string("Auto", "HTF for CONTEXT (bias / structure / PD)", options = ["Auto", "15", "30", "60", "240", "D"], group = grpH)
htfLiqReg    = input.bool(true, "Register HTF swing highs / lows as pools", group = grpH)
showPoi      = input.bool(true, "Draw live HTF FVG POI boxes", group = grpH)
hPoiMaxAge   = input.int(40, "HTF POI max age (HTF candles)", minval = 5, group = grpH)
hPoiMaxTouch = input.int(3, "HTF POI max mitigations before expiry", minval = 1, group = grpH)
hPoiDisp     = input.float(0.8, "HTF FVG min displacement body (ATR ×)", step = 0.1, minval = 0, group = grpH)
hPoiNeedDir  = input.bool(true, "HTF POI must agree with HTF direction", group = grpH)
htfConfMode  = input.string("A+ only", "HTF CONFLICT (structure ≠ momentum) handling",
     options = ["Off", "Downgrade", "A+ only", "Block"], group = grpH)

// ── ⑧ Entry engine ────────────────────────────────────────────────────────
grpE         = "⑧ Entry engine"
setupLife    = input.int(60, "Setup max life (bars)", minval = 10, group = grpE)
mssWin       = input.int(16, "Max bars: raid→POI, and POI→MSS", minval = 2, group = grpE)
dispWin      = input.int(10, "Max bars from MSS to displacement", minval = 1, group = grpE)
retestWin    = input.int(25, "Max bars from the FVG to its retest", minval = 2, group = grpE)
poiBindAtr   = input.float(0.35, "POI must CONTAIN the raid extreme — slack (ATR ×)", step = 0.05, minval = 0.0, group = grpE)
mssNeedChoch = input.bool(false, "MSS must be a CHoCH (reject CISD-only shifts)", group = grpE)
mssIsDisp    = input.bool(true, "MSS candle may be the displacement candle", group = grpE)
retestDepth  = input.float(0.35, "FVG retest depth required (0.5 = 50%)", step = 0.1, minval = 0.0, maxval = 1.0, group = grpE)
lateBars     = input.int(8, "LATE entry — max bars from first FVG touch", minval = 1, group = grpE)
poiMaxAge    = input.int(80, "Max POI age for binding (bars)", minval = 5, group = grpE)
poiWickFb    = input.bool(true, "POI fallback: the raid candle's own rejection wick (tier 2)", group = grpE)
dispBodyAtr  = input.float(1.0, "Setup displacement body ≥ ATR ×", step = 0.1, minval = 0.5, group = grpE)
useVolConf   = input.bool(true, "Displacement needs relative volume", group = grpE)
volMult      = input.float(1.2, "Relative volume ≥ (× 20-bar mean)", step = 0.1, minval = 0.5, group = grpE)
apMaxTouch   = input.int(2, "A+ only within this many touches of the execution FVG", minval = 1, group = grpE)
minScore     = input.int(0, "Min alignment score (0 = off)", minval = 0, maxval = 100, group = grpE)
masterCd     = input.int(6, "Cooldown after a final signal, per direction (bars)", minval = 0, group = grpE)
dedupePool   = input.bool(true, "One liquidity pool → one execution", group = grpE)
dedupePoi    = input.bool(true, "One POI → one execution", group = grpE)
dedupeMss    = input.bool(true, "One MSS → one execution", group = grpE)
entryModel   = input.string("Rejection close", "Entry price model", options = ["Rejection close", "FVG 50% (CE)"], group = grpE)
machFirst    = input.bool(true, "Machine first: S/D stands down while a same-side setup works the same pool / array", group = grpE)

// ── ⑨ FEM ─────────────────────────────────────────────────────────────────
grpF    = "⑨ Fractal entry model"
useFEM  = input.bool(true, "Enable FEM (HTF POI is the setup's POI)", group = grpF)
femWait = input.int(40, "Max bars from HTF POI tap to execution", minval = 5, group = grpF)

// ── ⑩ Delivery ────────────────────────────────────────────────────────────
grpC        = "⑩ Delivery · CISD / IFC / inducement"
showCisd    = input.bool(true,  "Label CISD", group = grpC)
cisdAsConf  = input.bool(false, "Accept CISD as retest confirmation", group = grpC)
showIFC     = input.bool(true,  "Mark IFC candles", group = grpC)
useInduce   = input.bool(true, "Inducement — minor liquidity taken before the true raid", group = grpC)
induceLook  = input.int(30, "Inducement stays relevant for (bars)", minval = 5, group = grpC)
mssNeedDisp = input.bool(false, "A CISD may only act as MSS with a displacement leg", group = grpC)
minWickAtr  = input.float(0.3, "Min significant wick (ATR ×)", step = 0.1, group = grpC)

// ── ⑪ Trigger candidates (CRT / Turtle soup) ──────────────────────────────
grpT        = "⑪ Trigger candidates"
useCRT      = input.bool(true, "CRT (range → raid → reclaim → delivery) as stage-6 trigger", group = grpT)
crtRangeAtr = input.float(1.2, "CRT min candle-1 range (ATR ×)", step = 0.1, minval = 0.5, group = grpT)
crtDispAtr  = input.float(0.5, "CRT min candle-3 body (ATR ×)", step = 0.1, minval = 0.1, group = grpT)
useTBS      = input.bool(true, "Turtle soup as stage-6 trigger", group = grpT)
tbsLen      = input.int(20, "Turtle soup lookback (bars)", minval = 5, group = grpT)
tbsAgeMin   = input.int(4, "Swept extreme min age (bars)", minval = 1, group = grpT)
tbsAgeMax   = input.int(60, "Swept extreme max age (bars, 0 = off)", minval = 0, group = grpT)

// ── ⑫ Run · congestion · regime ───────────────────────────────────────────
grpW      = "⑫ Liquidity run · congestion · regime"
regPolicy = input.bool(true, "Regime execution policy (TREND / RANGE / EXPANSION / CHOP)", group = grpW)
runGate   = input.string("Downgrade", "Liquidity-run gate — fading an unexhausted run", options = ["Off", "Downgrade", "Block"], group = grpW)
runLife   = input.int(40, "Run stays live for (bars since last leg)", minval = 5, group = grpW)
congLen   = input.int(10, "Congestion window (bars)", minval = 4, group = grpW)
congGate  = input.string("Downgrade", "Congestion filter (= CHOP regime)", options = ["Off", "Downgrade", "A+ only", "Block"], group = grpW)

// ── ⑬ Sessions ────────────────────────────────────────────────────────────
grpK      = "⑬ Sessions / Killzones (New York time)"
useKZ     = input.bool(false, "Only signal inside killzones (intraday)", group = grpK)
paintKZ   = input.bool(false, "Shade killzones", group = grpK)
asiaSes   = input.session("2000-0000", "Asia", group = grpK)
lonSes    = input.session("0200-0500", "London", group = grpK)
nySes     = input.session("0700-1000", "New York AM", group = grpK)

// ── ⑭ Silver Bullet (1.txt arming path + 2..txt filter) ───────────────────
grpSB        = "⑭ Silver Bullet"
sbRole       = input.string("Filter + arming path", "Silver Bullet role",
     options = ["Off", "Filter only", "Filter + arming path"], group = grpSB)
sbOnlyIn     = input.bool(false, "Restrict ALL entries to the SB windows", group = grpSB)
sbUseLO      = input.bool(true, "London SB — 03:00–04:00", group = grpSB)
sbUseAM      = input.bool(true, "NY AM SB — 10:00–11:00 (priority)", group = grpSB)
sbUsePM      = input.bool(true, "NY PM SB — 14:00–15:00", group = grpSB)
sbSesLO      = input.session("0300-0400", "SB London", group = grpSB)
sbSesAM      = input.session("1000-1100", "SB NY AM", group = grpSB)
sbSesPM      = input.session("1400-1500", "SB NY PM", group = grpSB)
sbPreMin     = input.int(15, "Arm from N minutes BEFORE the window", minval = 0, maxval = 60, group = grpSB)
sbQualLO     = input.int(3, "London — min raid grade (1 C · 2 B · 3 A)", minval = 1, maxval = 3, group = grpSB)
sbQualAM     = input.int(2, "NY AM — min raid grade", minval = 1, maxval = 3, group = grpSB)
sbQualPM     = input.int(3, "NY PM — min raid grade", minval = 1, maxval = 3, group = grpSB)
sbPoolPref   = input.bool(true, "Require an engineered pool (session / EQ / PD / PW / HTF)", group = grpSB)
sbChopBypass = input.bool(true, "SB may arm in CHOP regime", group = grpSB)
sbKillAtEnd  = input.bool(true, "Kill an unfilled SB setup at the window close", group = grpSB)
sbLiqWait    = input.int(12, "SB clock: bars raid → POI tap", minval = 2, group = grpSB)
sbPoiWait    = input.int(8,  "SB clock: bars POI tap → shift", minval = 2, group = grpSB)
sbRetWait    = input.int(10, "SB clock: bars shift → entry", minval = 2, group = grpSB)
sbCeTol      = input.float(0.10, "SB CE tolerance (ATR ×)", step = 0.05, minval = 0, group = grpSB)
sbReqPD      = input.bool(true, "SB entry needs the correct premium / discount side (range locked at window open)", group = grpSB)
sbTimeExit   = input.bool(true, "SB trade: exit at window close when TP1 unhit", group = grpSB)
sbTimeMode   = input.string("Full", "Window-close exit", options = ["Full", "Partial (rest to break-even)"], group = grpSB)
sbStructEx   = input.bool(true, "SB trade: exit remainder on opposing MSS / CISD", group = grpSB)
sbPaint      = input.bool(true, "Highlight the active SB window", group = grpSB)

// ── ⑮ Scheduled volatility ────────────────────────────────────────────────
grpN      = "⑮ Scheduled volatility windows (NY) — NOT a live calendar"
useNews   = input.bool(true, "Block signals inside the windows", group = grpN)
paintNews = input.bool(true, "Shade the windows", group = grpN)
news1Ses  = input.session("0825-0845:23456", "Window #1 — 08:30", group = grpN)
news2Ses  = input.session("0955-1010:23456", "Window #2 — 10:00", group = grpN)
news3Ses  = input.session("1355-1435:4",     "Window #3 — 14:00 Wed", group = grpN)

// ── ⑯ Dealing range / OTE ─────────────────────────────────────────────────
grpO       = "⑯ Dealing range / OTE"
rangeSrc   = input.string("External", "Dealing range swings", options = ["External", "Internal"], group = grpO)
oteLegMode = input.bool(true, "OTE from the SETUP'S OWN impulse leg", group = grpO)
oteNeedAp  = input.bool(true, "A+ requires the entry to sit in its own OTE", group = grpO)
showRange  = input.bool(true, "Show range EQ + OTE box", group = grpO)

// ── ⑰ Risk ────────────────────────────────────────────────────────────────
grpR         = "⑰ Risk · SL / TP"
showTrade    = input.bool(true, "Show entry / SL / TP of the last signal", group = grpR)
tpMode       = input.string("Liquidity ladder", "Take-profit mode", options = ["Liquidity ladder", "Next level", "R multiple"], group = grpR)
rrMult       = input.float(2.0, "TP R multiple (fallback + TP2 floor)", step = 0.5, minval = 0.5, group = grpR)
minRiskAtr   = input.float(0.25, "Minimum stop distance (ATR ×)", step = 0.05, minval = 0.05, group = grpR)
maxRiskAtr   = input.float(3.0,  "Maximum stop distance (ATR ×)", step = 0.25, minval = 0.5, group = grpR)
atrStopMult  = input.float(1.0, "ATR fallback stop (ATR ×)", step = 0.25, minval = 0.25, group = grpR)
tpClamp      = input.bool(true, "Clamp TPs behind an un-raided opposing pool / POI", group = grpR)
allowSynthTp = input.bool(true, "Allow synthetic TP2 when no structural target (grade capped at B)", group = grpR)
rrAplus      = input.float(2.0, "Minimum RR — A+", step = 0.1, minval = 0.5, group = grpR)
rrA          = input.float(1.5, "Minimum RR — A",  step = 0.1, minval = 0.5, group = grpR)
rrB          = input.float(1.5, "Minimum RR — B (hard floor)", step = 0.1, minval = 1.5, group = grpR)
useOppLiq    = input.bool(true, "Opposing-liquidity room check", group = grpR)
oppLiqMult   = input.float(1.0, "Opposing liquidity must be ≥ this × risk away", step = 0.25, minval = 0.0, group = grpR)
oppLiqHard   = input.bool(false, "Treat the room check as a HARD block", group = grpR)
trackTrade   = input.bool(true, "Track the emitted trade (TP / SL / BE / trail)", group = grpR)
beAfter      = input.string("TP1", "Move stop to break-even after", options = ["Off", "TP1", "TP2"], group = grpR)
beBuf        = input.float(0.15, "Break-even buffer (ATR ×)", step = 0.05, minval = 0.0, group = grpR)
trailAfterTp2 = input.bool(true, "Trail behind the protected swing after TP2", group = grpR)
adaptGrade   = input.bool(false, "Tighten min grade one step after 3 consecutive stops", group = grpR)

// ── ⑱ Dashboard / UI ──────────────────────────────────────────────────────
grpD        = "⑱ Dashboard / UI"
showDash    = input.bool(true, "Show dashboard", group = grpD)
uiSizeOpt   = input.string("Normal", "Signal label size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = grpD)
uiInfoSize  = input.string("Small", "Info label size", options = ["Tiny", "Small", "Normal", "Large"], group = grpD)
dashSizeOpt = input.string("Normal", "Dashboard text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpD)
