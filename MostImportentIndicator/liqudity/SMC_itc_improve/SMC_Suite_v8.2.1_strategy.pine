var Cfg cfg = Cfg.new(pinWickMult = i_pinMult, pinWickRatioMin = i_pinRatio, dojiBodyMax = i_dojiMax,
     largeRangeMult = i_largeMult, longWickRatio = i_longWick, haramiBodyMax = i_haramiMax, starProxATR = i_starProx,
     ifcWickMult = i_ifcMult, ifcAnyColor = i_ifcAnyCol, manipWickRatio = i_manipWick, swingLen = i_swingLen,
     rangeBarsThresh = i_rangeBars, wyckoffRangeMult = i_wyckMult, fvgMinATR = i_fvgMin,
     fvgMitMode = i_fvgMode, maxFvg = i_maxFvg, fvgMaxAge = i_fvgAge, minFVGForStrong = i_minFvgStr,
     strongBodyEff = i_bodyEff, strongMixMax = i_mixMax, strongSpeedMin = i_speedMin, maxMoveBars = i_maxMove,
     eqTolATR = i_eqTol, touchTolATR = i_touchTol, touchCooldown = i_touchCd, runBodyMin = i_runBody,
     propWindow = i_propWin, propImpATR = i_propImp,
     runCloseMinATR = i_runClose, sweepWickMin = i_sweepWick, failedCloseBars = i_failBars, hiddenN = i_hidN,
     hiddenWickMin = i_hidWick, extLookback = i_extLB, maxLevels = i_maxLevels, klLookLeft = i_klLeft,
     klUseVol = i_klVol, sweepWindow = i_sweepWin, rjbWickMin = i_rjbWick,
     rjbConfirmBars = i_rjbBars, qmMaxBars = i_qmBars, maxZones = i_maxZones, zoneMaxAge = i_zoneAge, zoneMaxATR = i_zoneMaxH,
     gateMode = i_gate, sweepValidHTF = i_sweepVal, candleLookback = i_cLook,
     rejWickRatio = i_rejW, volHighMult = i_volHigh, volLowMult = i_volLow, pinCountMin = i_pinCnt,
     dojiCountMin = i_dojiCnt, retestBodyRatio = i_retestBR, nearZoneATR = i_nearZone,
     rangeLen = i_rangeLen, rangeMaxATR = i_rangeMax, armBars = i_armBars, klMinCrit = i_klMin, rcbFibGate = i_rcbFib, obHpOnly = i_obHpOnly,
     srTradable = i_srTrade,
     maxLabels = i_maxLabels, maxLines = i_maxLines, minGapBars = i_minGap)

var Vis vis = Vis.new(bull = i_cBull, bear = i_cBear, neut = i_cNeut, pool = i_cPool, sr = i_cSR, brk = i_cBrk,
     rcb = i_cRcb, rjb = i_cRjb, qm = i_cQm, htf = i_cHtf, inv = i_cInv, txt = i_cTxt, fillT = i_fillT, boxT = i_boxT,
     lineT = i_lineT, boxMitT = 92, filled = i_filled, sz = i_sz, zsz = i_zsz, offATR = i_off)

var Ctx ctx = Ctx.new(fvgs = array.new<Fvg>(), lv = array.new<Liq>(), zones = array.new<Zone>())
var Sx sx = Sx.new()

// ── L0 CANDLE ANATOMY — once per bar (R1) ────────────────────────────────────
f_candle(cf, aV, rLo, rHi) =>
    k = Cndl.new()
    k.body   := math.abs(close - open)
    k.rng    := high - low
    k.upWick := high - math.max(close, open)
    k.dnWick := math.min(close, open) - low
    if k.rng > 0
        k.bodyRatio   := k.body   / k.rng
        k.upWickRatio := k.upWick / k.rng
        k.dnWickRatio := k.dnWick / k.rng
    k.isBull     := close > open
    k.isBear     := close < open
    k.largeRange := k.rng > aV * cf.largeRangeMult
    if bar_index > 1
        pBody = math.abs(close[1] - open[1])
        k.pinBull := k.dnWick >= cf.pinWickMult * k.body and k.dnWickRatio >= cf.pinWickRatioMin and k.upWick <= k.body
        k.pinBear := k.upWick >= cf.pinWickMult * k.body and k.upWickRatio >= cf.pinWickRatioMin and k.dnWick <= k.body
        k.doji    := k.bodyRatio <= cf.dojiBodyMax
        k.engulfBull := k.isBull and close >= open[1] and open <= close[1] and close[1] < open[1]
        k.engulfBear := k.isBear and close <= open[1] and open >= close[1] and close[1] > open[1]
        k.insideBar  := high <= high[1] and low >= low[1]
        k.harami     := high < high[1] and low > low[1] and k.body < pBody * cf.haramiBodyMax
        k.longWickRej := (k.upWickRatio >= cf.longWickRatio or k.dnWickRatio >= cf.longWickRatio) and k.largeRange
        k.starBear := k.pinBear and math.abs(high - rHi) <= aV * cf.starProxATR
        k.starBull := k.pinBull and math.abs(low - rLo) <= aV * cf.starProxATR
        okBull = cf.ifcAnyColor or close > open
        okBear = cf.ifcAnyColor or close < open
        k.ifcBull := low  < rLo and okBull and k.dnWick >= cf.ifcWickMult * k.body
        k.ifcBear := high > rHi and okBear and k.upWick >= cf.ifcWickMult * k.body
        k.manipBull := low  < low[1]  and close > high[1] and close > open and k.dnWickRatio >= cf.manipWickRatio
        k.manipBear := high > high[1] and close < low[1]  and close < open and k.upWickRatio >= cf.manipWickRatio
    k

// ── L1 STRUCTURE ENGINE — once per bar (R1) ──────────────────────────────────
f_structure(cf, cx, swH, swL, rW, aN) =>
    s = Struct.new()
    pIdx = bar_index - cf.swingLen
    if not na(swH)
        s.swingHigh := true
    if not na(swL)
        s.swingLow := true
    s.bullBOS   := not na(cx.curHigh) and not cx.hiBroken and close > cx.curHigh
    s.bearBOS   := not na(cx.curLow)  and not cx.loBroken and close < cx.curLow
    s.bullSweep := not na(cx.curHigh) and not cx.hiBroken and high > cx.curHigh and close <= cx.curHigh
    s.bearSweep := not na(cx.curLow)  and not cx.loBroken and low  < cx.curLow  and close >= cx.curLow
    // §M1 — a gap or outside bar can close beyond BOTH stored extremes (possible whenever the two
    // pivots sit on the same side of the close). Both flags true made the zone engine pick `isBull =
    // bullBOS` arbitrarily, set the trend from whichever block ran last, and arm M41 in two
    // directions at once. Keep the side price actually displaced further.
    if s.bullBOS and s.bearBOS
        if (close - cx.curHigh) >= (cx.curLow - close)
            s.bearBOS := false
        else
            s.bullBOS := false
    if s.bullBOS
        cx.hiBroken := true
    if s.bearBOS
        cx.loBroken := true
    if s.bearBOS
        // §C5 — the old rule only re-anchored on a lower high, so the FIRST bearish BOS of a chart
        // (which comes off the highest high, not an LH) left majorHigh at `na` and bullCHoCH could
        // never fire; later, a stored major below the live swing high made CHoCH trivially true.
        lhNow = not na(cx.prevHigh) and cx.curHigh < cx.prevHigh
        if lhNow or na(cx.majorHigh) or cx.curHigh >= cx.majorHigh
            cx.majorHigh    := cx.curHigh
            cx.majorHighIdx := cx.curHighIdx
        cx.trend        := "BEARISH"
        cx.barsSinceEvt := 0
    if s.bullBOS
        hlNow = not na(cx.prevLow) and cx.curLow > cx.prevLow
        if hlNow or na(cx.majorLow) or cx.curLow <= cx.majorLow
            cx.majorLow    := cx.curLow
            cx.majorLowIdx := cx.curLowIdx
        cx.trend        := "BULLISH"
        cx.barsSinceEvt := 0
    s.bullCHoCH := cx.trend == "BEARISH" and not na(cx.majorHigh) and close > cx.majorHigh
    s.bearCHoCH := cx.trend == "BULLISH" and not na(cx.majorLow)  and close < cx.majorLow
    if s.bullCHoCH
        cx.trend        := "BULLISH"
        cx.barsSinceEvt := 0
        // §C5 — the new trend needs its own invalidation level, otherwise the next bearCHoCH is
        // measured against a major low from the previous regime. Only anchor below price.
        if not na(cx.curLow) and cx.curLow < close and (na(cx.majorLow) or cx.curLow > cx.majorLow)
            cx.majorLow    := cx.curLow
            cx.majorLowIdx := cx.curLowIdx
        // §M2 — the break flags used to stay latched through a CHoCH: upside is already taken, but
        // a fresh downside break is meaningful again.
        cx.hiBroken := true
        cx.loBroken := false
    if s.bearCHoCH
        cx.trend        := "BEARISH"
        cx.barsSinceEvt := 0
        if not na(cx.curHigh) and cx.curHigh > close and (na(cx.majorHigh) or cx.curHigh < cx.majorHigh)
            cx.majorHigh    := cx.curHigh
            cx.majorHighIdx := cx.curHighIdx
        cx.loBroken := true
        cx.hiBroken := false
    if not (s.bullBOS or s.bearBOS or s.bullCHoCH or s.bearCHoCH)
        cx.barsSinceEvt := cx.barsSinceEvt + 1
        if cx.barsSinceEvt > cf.rangeBarsThresh
            cx.trend := "RANGE"
    if not na(swH)
        cx.prevHigh    := cx.curHigh
        cx.prevHighIdx := cx.curHighIdx
        cx.curHigh     := swH
        cx.curHighIdx  := pIdx
        cx.hiBroken    := false
    if not na(swL)
        cx.prevLow    := cx.curLow
        cx.prevLowIdx := cx.curLowIdx
        cx.curLow     := swL
        cx.curLowIdx  := pIdx
        cx.loBroken   := false
    // §3.5 pullback validity — highest-high / lowest-low candle tracking (tie → latest)
    // the maker must stay the genuine extreme-maker candle: overwriting it with the pullback candle
    // made `low < hiMakerLow` true again on the next bar of the same sequence, so pbValidUp fired on
    // EVERY bar of a move (flooding PB labels and resetting the leg counters every bar). The armed
    // flag makes it one-shot per extreme; a new extreme re-arms it.
    if na(cx.hiMakerHigh) or high >= cx.hiMakerHigh
        cx.hiMakerHigh := high
        cx.hiMakerLow  := low
        cx.pbUpArmed   := true
    else if cx.pbUpArmed and low < cx.hiMakerLow
        s.pbValidUp    := true
        cx.pbUpArmed   := false
        cx.cisdUpSet   := false
    if na(cx.loMakerLow) or low <= cx.loMakerLow
        cx.loMakerLow  := low
        cx.loMakerHigh := high
        cx.pbDnArmed   := true
    else if cx.pbDnArmed and high > cx.loMakerHigh
        s.pbValidDn    := true
        cx.pbDnArmed   := false
        cx.cisdDnSet   := false
    // §C1 — the makers only ever moved outwards, so after a few hundred bars hiMakerHigh WAS the
    // all-time high and loMakerLow the all-time low. movePhase then reduced to "is close at the
    // all-time extreme", i.e. permanently RETRACEMENT, and the pullback tracker was comparing
    // against a candle from a different market regime. A structural event ends the old leg, so
    // re-anchor both makers on it and re-arm the one-shot pullback flags.
    if s.bullBOS or s.bearBOS or s.bullCHoCH or s.bearCHoCH
        cx.hiMakerHigh := high
        cx.hiMakerLow  := low
        cx.pbUpArmed   := true
        cx.loMakerLow  := low
        cx.loMakerHigh := high
        cx.pbDnArmed   := true
    // §3.6 CISD
    if not cx.cisdUpSet and close > open
        // §3.6 mother-candle rule: a green candle that consolidates inside an earlier green
        // candle is not the CISD candidate — take the mother candle's open (up to 2 levels)
        insU1 = high <= high[1] and low >= low[1] and close[1] > open[1]
        insU2 = insU1 and high[1] <= high[2] and low[1] >= low[2] and close[2] > open[2]
        cx.cisdUpOpen := insU2 ? open[2] : insU1 ? open[1] : open
        cx.cisdUpBar  := bar_index - (insU2 ? 2 : insU1 ? 1 : 0)
        cx.cisdUpSet  := true
    if not cx.cisdDnSet and close < open
        insD1 = high <= high[1] and low >= low[1] and close[1] < open[1]
        insD2 = insD1 and high[1] <= high[2] and low[1] >= low[2] and close[2] < open[2]
        cx.cisdDnOpen := insD2 ? open[2] : insD1 ? open[1] : open
        cx.cisdDnBar  := bar_index - (insD2 ? 2 : insD1 ? 1 : 0)
        cx.cisdDnSet  := true
    s.cisdBear := cx.cisdUpSet and close < cx.cisdUpOpen
    s.cisdBull := cx.cisdDnSet and close > cx.cisdDnOpen
    if s.cisdBear
        cx.cisdUpSet := false
    if s.cisdBull
        cx.cisdDnSet := false
    s.trend     := cx.trend
    // §C1 · §3.8 — measured against the CURRENT leg, not the all-time extreme: price pushing
    // past the live swing that defines the leg is impulse, anything inside it is retracement.
    s.movePhase := (not na(cx.curHigh) and close >= cx.curHigh) or (not na(cx.curLow) and close <= cx.curLow) ? "IMPULSIVE" : "RETRACEMENT"
    isRangeNow  = rW < aN * cf.wyckoffRangeMult
    s.wyckoff   := cx.trend == "BULLISH" and not isRangeNow ? "MARKUP" :
                   cx.trend == "BEARISH" and not isRangeNow ? "MARKDOWN" :
                   isRangeNow and cx.trend == "BEARISH" ? "ACCUMULATION" :
                   isRangeNow and cx.trend == "BULLISH" ? "DISTRIBUTION" : "MANIPULATION"
    s

// ── drawing x-coordinate clamp ──────────────────────────────────────
// xloc.bar_index drawings may not reference a bar older than max_bars_back (500),
// otherwise: "The requested historical offset is beyond the historical buffer's limit".
// Stored pivot / zone indices can outlive that window, so pin them to the edge.
f_xb(x) => math.max(math.min(x, bar_index), bar_index - 495)

// ── L2 FVG ENGINE — once per bar (R1); writes into the shared Feat ───────────
f_fvg(cf, cx, v, fv, aV, drawOn, keepMit) =>
    minH = aV * cf.fvgMinATR
    // §C2 — the third candle of the gap is `close`'s own bar. Reading its live low meant the gap's
    // top moved on every tick and could disappear entirely at the close, and since mv.fvgCount,
    // chochReal, atBullFvg/atBearFvg, TP1 and the confluence score all hang off the FVG list, one
    // repainting box repainted the whole signal. Every other zone engine here is already
    // confirmed-gated; this one was the outlier.
    if barstate.isconfirmed and bar_index > 2
        if low > high[2] and (low - high[2]) >= minH
            g = Fvg.new(top = low, bottom = high[2], idx = bar_index - 1, isBull = true)
            if drawOn
                g.bx := box.new(bar_index - 1, low, bar_index, high[2], border_color = color.new(v.bull, 100), bgcolor = color.new(v.bull, v.boxT), extend = extend.right)
            array.push(cx.fvgs, g)
            fv.newBullFvg := true
        if high < low[2] and (low[2] - high) >= minH
            g = Fvg.new(top = low[2], bottom = high, idx = bar_index - 1, isBull = false)
            if drawOn
                g.bx := box.new(bar_index - 1, low[2], bar_index, high, border_color = color.new(v.bear, 100), bgcolor = color.new(v.bear, v.boxT), extend = extend.right)
            array.push(cx.fvgs, g)
            fv.newBearFvg := true
    n = array.size(cx.fvgs)
    if n > 0
        for i = n - 1 to 0
            g = array.get(cx.fvgs, i)
            if not g.mitigated and g.idx < bar_index - 1
                mid = (g.top + g.bottom) * 0.5
                lvl = cf.fvgMitMode == "TOUCH" ? (g.isBull ? g.top : g.bottom) :
                      cf.fvgMitMode == "50%"   ? mid : (g.isBull ? g.bottom : g.top)
                hit = g.isBull ? low <= lvl : high >= lvl
                if hit
                    g.mitigated := true
                    g.mitIdx    := bar_index
                    if not na(g.bx)
                        box.set_extend(g.bx, extend.none)
                        box.set_right(g.bx, bar_index)
                        if keepMit
                            cCol = g.isBull ? v.bull : v.bear
                            box.set_bgcolor(g.bx, color.new(v.inv, v.boxMitT))
                            box.set_border_color(g.bx, color.new(v.inv, 100))
                        else
                            box.delete(g.bx)
            if g.mitigated and bar_index - g.mitIdx > cf.fvgMaxAge
                if not na(g.bx)
                    box.delete(g.bx)
                array.remove(cx.fvgs, i)
    while array.size(cx.fvgs) > cf.maxFvg
        old = array.shift(cx.fvgs)
        if not na(old.bx)
            box.delete(old.bx)

// nearest FVG of a direction whose middle candle sits in [fromIdx, toIdx] → bottom (bull) / top (bear), na if none
f_fvgNear(cx, isBull, fromIdx, toIdx) =>
    res = float(na)
    n = array.size(cx.fvgs)
    if n > 0
        for i = 0 to n - 1
            g = array.get(cx.fvgs, i)
            if g.isBull == isBull and g.idx >= fromIdx and g.idx <= toIdx
                res := isBull ? g.bottom : g.top
                break
    res

// ── L2 MOVE STRENGTH — EVENT-DRIVEN ONLY (§7): BOS, zone tap, CHoCH ──────────
f_moveStrength(cf, cx, fromBar, toBar, aV) =>
    m = Move.new()
    fb = math.max(math.max(fromBar, toBar - cf.maxMoveBars + 1), 0)
    cnt = toBar - fb + 1
    if cnt > 0 and aV > 0
        bodySum = 0.0
        rangeSum = 0.0
        flips = 0
        prevBull = false
        for b = fb to toBar
            off = bar_index - b
            if off >= 0 and off < 500
                bodySum  += math.abs(close[off] - open[off])
                rangeSum += high[off] - low[off]
                isB = close[off] > open[off]
                if b > fb and isB != prevBull
                    flips += 1
                prevBull := isB
        k = array.size(cx.fvgs)
        if k > 0
            for i = 0 to k - 1
                g = array.get(cx.fvgs, i)
                if g.idx >= fb and g.idx <= toBar and not g.mitigated
                    m.fvgCount := m.fvgCount + 1
        m.avgBody := bodySum / cnt
        m.bodyEff := rangeSum > 0 ? bodySum / rangeSum : 0.0
        m.mixed   := cnt > 1 ? flips / (cnt - 1) : 0.0
        offTo   = math.min(math.max(bar_index - toBar, 0), 499)
        offFrom = math.min(math.max(bar_index - fb, 0), 499)
        netMove = math.abs(close[offTo] - open[offFrom])
        m.speed  := netMove / cnt / aV
        m.strong := m.fvgCount >= cf.minFVGForStrong and m.bodyEff >= cf.strongBodyEff and
                     m.mixed <= cf.strongMixMax and m.speed >= cf.strongSpeedMin
    m

// ── L3 LIQUIDITY — helpers ───────────────────────────────────────────────────
f_lvlColor(v, L) =>
    L.touches >= 2 ? v.pool : L.kind == "PDH" or L.kind == "PDL" or L.kind == "PWH" or L.kind == "PWL" ? v.neut : L.isHigh ? v.bear : v.bull

f_lvlText(L) =>
    (L.touches >= 2 ? "POOL·" : "") + L.kind + (L.ext ? "·ext" : "")

f_resolve(v, L, res) =>
    L.done   := true
    L.result := res
    if not na(L.ln)
        line.set_extend(L.ln, extend.none)
        line.set_x2(L.ln, bar_index)
        line.set_style(L.ln, res == "SWEEP" ? line.style_dotted : line.style_solid)
        line.set_color(L.ln, color.new(res == "SWEEP" ? f_lvlColor(v, L) : v.neut, math.min(v.lineT + 30, 100)))

f_addLevel(cf, cx, v, aV, price, idx, isHigh, kind, ext, drawOn) =>
    merged = false
    n = array.size(cx.lv)
    if n > 0 and (kind == "BSL" or kind == "SSL")
        for i = n - 1 to 0
            L = array.get(cx.lv, i)
            // only merge into another swing-derived level: renaming a PDH/PWH to EQH would strand it,
            // because the daily/weekly rollover expires levels by kind and would no longer match it
            famOk = L.kind == "BSL" or L.kind == "SSL" or L.kind == "EQH" or L.kind == "EQL"
            if not L.done and famOk and L.isHigh == isHigh and math.abs(L.price - price) <= aV * cf.eqTolATR
                L.kind      := isHigh ? "EQH" : "EQL"
                L.touches   := L.touches + 1
                L.lastTouch := bar_index
                L.price     := (L.price + price) * 0.5
                L.pooled    := true
                if not na(L.ln)
                    line.set_y1(L.ln, L.price)
                    line.set_y2(L.ln, L.price)
                    line.set_width(L.ln, 2)
                    line.set_style(L.ln, line.style_dashed)
                    line.set_color(L.ln, color.new(f_lvlColor(v, L), v.lineT))
                if not na(L.lb)
                    label.set_text(L.lb, f_lvlText(L))
                    label.set_textcolor(L.lb, f_lvlColor(v, L))
                else if drawOn
                    L.lb := label.new(f_xb(idx), L.price, f_lvlText(L), style = label.style_none, textcolor = f_lvlColor(v, L), size = v.zsz)
                merged := true
                break
    if not merged
        L = Liq.new(price = price, idx = idx, isHigh = isHigh, kind = kind, ext = ext, lastTouch = bar_index)
        if drawOn
            L.ln := line.new(f_xb(idx), price, bar_index, price, color = color.new(f_lvlColor(v, L), v.lineT), width = 1, style = line.style_dotted, extend = extend.right)
        array.push(cx.lv, L)
    merged

// ── L3 LIQUIDITY ENGINE — once per bar (R1); writes into the shared Feat ─────
f_liq(cf, cx, v, fv, aV, swH, swL, eHi, eLo, pdh, pdl, pwh, pwl, nDay, nWeek, drawOn) =>
    pIdx = bar_index - cf.swingLen
    rng  = high - low
    bodyR = rng > 0 ? math.abs(close - open) / rng : 0.0
    if not na(swH)
        f_addLevel(cf, cx, v, aV, swH, pIdx, true,  "BSL", swH >= eHi, drawOn)
    if not na(swL)
        f_addLevel(cf, cx, v, aV, swL, pIdx, false, "SSL", swL <= eLo, drawOn)
    if nDay and not na(pdh)
        if array.size(cx.lv) > 0
            for i = array.size(cx.lv) - 1 to 0
                L = array.get(cx.lv, i)
                if not L.done and (L.kind == "PDH" or L.kind == "PDL")
                    f_resolve(v, L, "EXPIRED")
        f_addLevel(cf, cx, v, aV, pdh, bar_index, true,  "PDH", false, drawOn)
        f_addLevel(cf, cx, v, aV, pdl, bar_index, false, "PDL", false, drawOn)
    if nWeek and not na(pwh)
        if array.size(cx.lv) > 0
            for i = array.size(cx.lv) - 1 to 0
                L = array.get(cx.lv, i)
                if not L.done and (L.kind == "PWH" or L.kind == "PWL")
                    f_resolve(v, L, "EXPIRED")
        f_addLevel(cf, cx, v, aV, pwh, bar_index, true,  "PWH", false, drawOn)
        f_addLevel(cf, cx, v, aV, pwl, bar_index, false, "PWL", false, drawOn)
    n = array.size(cx.lv)
    scanD = aV * cf.nearZoneATR
    if n > 0
        for i = n - 1 to 0
            L = array.get(cx.lv, i)
            if L.done
                if bar_index - L.lastTouch > cf.extLookback * 4
                    if not na(L.ln)
                        line.delete(L.ln)
                    if not na(L.lb)
                        label.delete(L.lb)
                    array.remove(cx.lv, i)
                continue
            if L.idx >= bar_index
                continue
            tol   = aV * cf.touchTolATR
            minGo = aV * cf.runCloseMinATR
            if L.isHigh
                if L.pend > 0
                    if close < L.price
                        f_resolve(v, L, "SWEEP")
                    else
                        L.pend := L.pend - 1
                        if L.pend == 0
                            f_resolve(v, L, "RUN")
                else if high > L.price
                    if close <= L.price
                        f_resolve(v, L, "SWEEP")
                    else if bodyR >= cf.runBodyMin and (close - L.price) >= minGo
                        f_resolve(v, L, "RUN")
                    else
                        L.pend := cf.failedCloseBars
                else if high >= L.price - tol and bar_index - L.lastTouch > cf.touchCooldown
                    L.touches   := L.touches + 1
                    L.lastTouch := bar_index
            else
                if L.pend > 0
                    if close > L.price
                        f_resolve(v, L, "SWEEP")
                    else
                        L.pend := L.pend - 1
                        if L.pend == 0
                            f_resolve(v, L, "RUN")
                else if low < L.price
                    if close >= L.price
                        f_resolve(v, L, "SWEEP")
                    else if bodyR >= cf.runBodyMin and (L.price - close) >= minGo
                        f_resolve(v, L, "RUN")
                    else
                        L.pend := cf.failedCloseBars
                else if low <= L.price + tol and bar_index - L.lastTouch > cf.touchCooldown
                    L.touches   := L.touches + 1
                    L.lastTouch := bar_index
            if L.touches >= 2 and not L.pooled
                L.pooled := true
                if not na(L.ln)
                    line.set_width(L.ln, 2)
                    line.set_style(L.ln, line.style_dashed)
                    line.set_color(L.ln, color.new(v.pool, v.lineT))
                if not na(L.lb)
                    label.set_text(L.lb, f_lvlText(L))
                    label.set_textcolor(L.lb, v.pool)
                else if drawOn
                    L.lb := label.new(f_xb(L.idx), L.price, f_lvlText(L), style = label.style_none, textcolor = v.pool, size = v.zsz)
            if L.done
                if L.result == "SWEEP"
                    if L.isHigh
                        fv.sweptHigh := true
                        cx.sweptHighBar := bar_index
                    else
                        fv.sweptLow := true
                        cx.sweptLowBar := bar_index
                    fv.sweptKind  := f_lvlText(L)
                    if L.isHigh
                        fv.sweptKindHi  := f_lvlText(L)
                        fv.sweptPriceHi := L.price
                    else
                        fv.sweptKindLo  := f_lvlText(L)
                        fv.sweptPriceLo := L.price
                    fv.sweptPrice := L.price
                    fv.sweptPool  := fv.sweptPool or L.touches >= 2
                    // `ext` (at the extLookback extreme) is the common case on a low timeframe, so
                    // counting it here let nearly every sweep through the "major levels only" filter
                    fv.sweptMajor := fv.sweptMajor or L.touches >= 2 or L.kind == "PDH" or L.kind == "PDL" or L.kind == "PWH" or L.kind == "PWL"
                if L.result == "RUN"
                    if L.isHigh
                        fv.runUp := true
                    else
                        fv.runDn := true
                    fv.runPrice := L.price
                    fv.runMajor := fv.runMajor or L.touches >= 2 or L.ext or L.kind == "PDH" or L.kind == "PDL" or L.kind == "PWH" or L.kind == "PWL"
            else
                // liquidity targets near price (M09 / global scoring): unresolved levels within scan distance
                if L.isHigh and L.price > close and L.price - close <= scanD
                    fv.bslAbove := fv.bslAbove + 1
                if not L.isHigh and L.price < close and close - L.price <= scanD
                    fv.sslBelow := fv.sslBelow + 1
    // §M4 — eviction used to be array.shift, i.e. "oldest inserted wins the bin". PDH/PDL enter at
    // the day's first bar, so on a busy session the day's own levels were the first thing thrown
    // away. Score each level instead and drop the cheapest: resolved levels go first, then the ones
    // furthest from price; pooled / daily / weekly / session levels are the last to go.
    while array.size(cx.lv) > cf.maxLevels
        wIdx = 0
        for i = 0 to array.size(cx.lv) - 1
            Le = array.get(cx.lv, i)
            if Le.done or (Le.touches < 2 and (Le.kind == "BSL" or Le.kind == "SSL"))
                wIdx := i
                break
        old = array.get(cx.lv, wIdx)
        if not na(old.ln)
            line.delete(old.ln)
        if not na(old.lb)
            label.delete(old.lb)
        array.remove(cx.lv, wIdx)
    // §5.4 hidden liquidity (edge-triggered)
    // §M5 — hidS/hidB started at `true` and the guards below compare against `low[k+1]`, which is
    // `na` on the first bars; an na comparison is false, so the flags survived and both hidden-
    // liquidity alerts fired at the very start of every chart.
    hidS = bar_index >= cf.hiddenN + 1
    hidB = hidS
    for k = 0 to cf.hiddenN - 1
        r  = high[k] - low[k]
        dw = r > 0 ? (math.min(close[k], open[k]) - low[k]) / r : 0.0
        uw = r > 0 ? (high[k] - math.max(close[k], open[k])) / r : 0.0
        if dw < cf.hiddenWickMin or low[k] < low[k + 1]
            hidS := false
        if uw < cf.hiddenWickMin or high[k] > high[k + 1]
            hidB := false
    fv.hiddenSSL  := hidS and not cx.hidSSLprev
    fv.hiddenBSL  := hidB and not cx.hidBSLprev
    cx.hidSSLprev := hidS
    cx.hidBSLprev := hidB

// ── L4 ZONE — helpers ────────────────────────────────────────────────────────
f_zColor(v, z) =>
    z.kind == "OB"  ? (z.bull ? v.bull : v.bear) :
     z.kind == "BRK" ? v.brk : z.kind == "RCB" ? v.rcb : z.kind == "RJB" ? v.rjb : z.kind == "QM" ? v.qm :
     z.kl >= 4 ? (z.bull ? v.bull : v.bear) : v.sr

f_zText(z) =>
    t = z.kind == "OB" ? (z.bull ? "OB▲" : "OB▼") + (z.hp ? "★" : "") + (z.obType != "" ? " " + z.obType : "") :
         z.kind == "SR" ? (z.kl >= 4 ? "KL★" : z.kl == 3 ? "KL" : (z.bull ? "S" : "R")) :
         z.kind + (z.bull ? "▲" : "▼")
    t += z.flipped ? " FLIP" : ""
    t += z.sweepReq ? " ⚠SWEEP REQ" : ""
    t += z.weak ? " weak" : ""
    t += not z.confirmed ? " ?" : ""
    t += z.idmSwept ? " IDM✓" : ""
    t += z.prop ? " ⇈PROP" : ""
    t += z.nearSwept ? " ★★" : ""
    t

f_zStyle(v, z) =>
    if not na(z.bx)
        weakZ = z.broken or z.weak or not z.confirmed or (z.kind == "OB" and not z.hp and z.obType != "")
        c = weakZ and (z.broken or z.weak) ? v.inv : f_zColor(v, z)
        box.set_bgcolor(z.bx, color.new(c, z.broken or z.weak ? 90 : z.tapped ? math.min(v.boxT + 6, 100) : v.boxT))
        box.set_border_color(z.bx, color.new(z.sweepReq ? v.inv : c, z.broken ? 80 : 40))
        box.set_border_width(z.bx, z.kl >= 4 ? 3 : z.kl == 3 ? 2 : 1)
        box.set_border_style(z.bx, weakZ or z.kind == "BRK" or z.flipped ? line.style_dashed : line.style_solid)
        box.set_text(z.bx, f_zText(z))
        box.set_text_size(z.bx, v.zsz)
        // the box fill IS colour `c` at boxT transparency — painting the text the same colour makes
        // it vanish. chart.fg_color is white on a dark chart, black on a light one.
        box.set_text_color(z.bx, chart.fg_color)

f_zAdd(cf, cx, v, aV, kind, bull, top, bottom, idx, drawOn) =>
    zt = math.max(top, bottom)
    zb = math.min(top, bottom)
    maxH = aV * cf.zoneMaxATR
    if zt - zb > maxH
        // oversized (flash-wick candle): keep the origin edge, clip the rest
        if bull
            zt := zb + maxH
        else
            zb := zt - maxH
    // v8.2.1 · three zones of the same kind within a few ticks was normal on the review charts:
    // clutter on the chart, and f_conf counted one price as "a zone" once per copy. An overlapping
    // live zone of the same kind and side is refreshed instead of duplicated. Two kinds are exempt:
    // SR, because the key-level block finds its origin by `z.idx == oIdx` and merging would break
    // scoring, and RJB, because the caller resets `confirmed` / `pendFvg` on whatever comes back -
    // merging into an already-confirmed rejection block would un-confirm it.
    Zone dup = na
    n0 = kind == "SR" or kind == "RJB" ? 0 : array.size(cx.zones)
    if n0 > 0
        for i = n0 - 1 to 0
            zx = array.get(cx.zones, i)
            if not zx.broken and zx.kind == kind and zx.bull == bull and zx.top >= zb and zx.bottom <= zt
                dup := zx
                break
    z = dup
    if na(dup)
        z := Zone.new(kind = kind, bull = bull, top = zt, bottom = zb, idx = idx, lastTouch = bar_index)
        if drawOn
            z.bx := box.new(f_xb(idx), z.top, bar_index, z.bottom, border_width = 1, extend = extend.right, text_size = v.zsz, text_halign = text.align_left, text_valign = text.align_top)
            f_zStyle(v, z)
        array.push(cx.zones, z)
    z

// §M11 — every directional reading a zone holds was measured for the side it had at the time.
// A flip, a breaker conversion or a propulsion re-arm invalidates all of them at once; leaving the
// inducement level in place is what made M37 (the highest-scored setup here) fire on evidence that
// belonged to the opposite direction.
f_zReset(z) =>
    z.idmLvl    := na
    z.idmSwept  := false
    z.nearMiss  := na
    z.nearSwept := false
    z.fiftyHit  := false

f_hiddenInterest(cf, cx, top, bottom, idx) =>
    clean = true
    n = array.size(cx.zones)
    if n > 0
        for i = 0 to n - 1
            z = array.get(cx.zones, i)
            if z.idx < idx and z.idx >= idx - cf.klLookLeft and z.top >= bottom and z.bottom <= top
                clean := false
                break
    clean

// ── L4 ZONE ENGINE — once per bar (R1); fed by L1 events + L2 strength; writes into Feat ──
f_zones(cf, cx, v, fv, aV, swH, swL, bullBOS, bearBOS, bullCHoCH, bearCHoCH, mvStrong, mvFvg, vOk, onSR, onKL, onOB, onBrk, onRcb, onRjb, onQm) =>
    pIdx = bar_index - cf.swingLen
    // §6.1 S/R wick zones at every confirmed pivot (created always — KL scoring needs them; drawn only if onSR)
    if not na(swH)
        o = cf.swingLen
        f_zAdd(cf, cx, v, aV, "SR", false, high[o], math.max(open[o], close[o]), pIdx, onSR)
    if not na(swL)
        o = cf.swingLen
        f_zAdd(cf, cx, v, aV, "SR", true, math.min(open[o], close[o]), low[o], pIdx, onSR)

    // BOS → Key Level score on origin SR + Order Block / S&D
    if (bullBOS or bearBOS) and barstate.isconfirmed
        isBull = bullBOS
        oIdx   = isBull ? cx.curLowIdx : cx.curHighIdx
        off = bar_index - oIdx
        if off >= 1 and off < 490
            n0 = array.size(cx.zones)
            if n0 > 0
                for i = 0 to n0 - 1
                    z = array.get(cx.zones, i)
                    if z.kind == "SR" and z.idx == oIdx and z.bull == isBull and z.kl == 0
                        // v8.2.1 · base was 2 of 3, so "imbalance in the move" alone made KL and any
                        // second criterion made KL★. In a trend both are almost free (older zones sit
                        // at other prices, so `clean` is nearly always true) and the review charts
                        // carried ~10 KL★ each - which re-opened the "price is at a zone" gate that
                        // §srOk exists to close. Base 1 + the departure's own strength: KL now needs
                        // two earned criteria and KL★ needs three.
                        sc = 1
                        sc += mvFvg >= 1 ? 1 : 0
                        sc += mvStrong ? 1 : 0
                        sc += f_hiddenInterest(cf, cx, z.top, z.bottom, oIdx) ? 1 : 0
                        sc += cf.klUseVol and vOk ? 1 : 0
                        z.kl := sc
                        z.depStrong := mvStrong
                        if sc >= cf.klMinCrit and na(z.bx) and onKL
                            z.bx := box.new(f_xb(z.idx), z.top, bar_index, z.bottom, border_width = 1, extend = extend.right, text_size = v.zsz, text_halign = text.align_left, text_valign = text.align_top)
                        f_zStyle(v, z)
                        break
            // §C3 — this block used to be wrapped in `if onOB`, a "Show" toggle. Turning OB boxes
            // off therefore stopped the zones from existing at all and silently disabled M36, M37,
            // M42, M45, M48 and the whole breaker chain. Detection now always runs; `onOB` is passed
            // to f_zAdd as the draw flag, exactly like the SR zones below already did.
            if not mvStrong
                if isBull
                    fv.evtUp := "T5 no-FVG"
                    fv.tipUp := "Big move but NO imbalance — no OB here (Type 5). Look for reversal the other way."
                else
                    fv.evtDn := "T5 no-FVG"
                    fv.tipDn := "Big move but NO imbalance — no OB here (Type 5). Look for reversal the other way."
            else
                obOff = off
                obT   = "T1"
                if high[obOff] <= high[obOff + 1] and low[obOff] >= low[obOff + 1]
                    obOff := obOff + 1
                    obT   := "T2"
                zTop = high[obOff]
                zBot = low[obOff]
                if obOff >= 1
                    nb = obOff - 1
                    impBull = close[nb] > open[nb]
                    if isBull and impBull and low[nb] < low[obOff]
                        zTop := high[nb]
                        zBot := low[nb]
                        obT  := "G1"
                    if not isBull and not impBull and high[nb] > high[obOff]
                        zTop := high[nb]
                        zBot := low[nb]
                        obT  := "G1"
                    smallBody = math.abs(close[obOff] - open[obOff]) < 0.3 * (high[obOff] - low[obOff])
                    engulfs   = low[nb] <= low[obOff] and high[nb] >= high[obOff]
                    if smallBody and engulfs and obT != "G1"
                        zTop := isBull ? high[obOff] : high[nb]
                        zBot := isBull ? low[nb] : low[obOff]
                        obT  := "G2"
                obIdx  = bar_index - obOff
                fvgLvl = f_fvgNear(cx, isBull, obIdx, obIdx + 3)
                if na(fvgLvl)
                    if isBull
                        fv.evtUp := "T5 no-FVG"
                        fv.tipUp := "STRONG move but no FVG aligned with the OB candle — OB invalid (Type 5)."
                    else
                        fv.evtDn := "T5 no-FVG"
                        fv.tipDn := "STRONG move but no FVG aligned with the OB candle — OB invalid (Type 5)."
                else
                    // the OB CANDLE's own extreme is what may have eaten into the gap — zTop/zBot
                    // have been widened onto the displacement candle for G1, which would always trip
                    selfMit = isBull ? high[obOff] > fvgLvl : low[obOff] < fvgLvl
                    if selfMit
                        if isBull
                            fv.evtUp := "T3 invalid"
                            fv.tipUp := "OB wick mitigated its own FVG (Type 3) — not plotted."
                        else
                            fv.evtDn := "T3 invalid"
                            fv.tipDn := "OB wick mitigated its own FVG (Type 3) — not plotted."
                    else
                        sw = isBull ? cx.sweptLowBar : cx.sweptHighBar
                        hpNow = sw >= obIdx - cf.sweepWindow and sw <= obIdx + 2
                        // §M3 — obHpOnly used to be passed as the DRAW flag, so a non-HP order block
                        // was still created and still gated every OB setup: the input hid the box and
                        // changed nothing about the signals. Now it suppresses the zone itself.
                        if hpNow or not cf.obHpOnly
                            z = f_zAdd(cf, cx, v, aV, "OB", isBull, zTop, zBot, obIdx, onOB)
                            z.obType := obT
                            z.depStrong := mvStrong
                            z.hp := hpNow
                            fv.newObHp := hpNow
                            f_zStyle(v, z)

    // CHoCH → Reclaimed Block + QM pending
    // §C3 — `onRcb` / `onQm` are display toggles and used to gate detection: hiding the boxes
    // deleted M39 and M70 outright. They are now only draw flags.
    if bullCHoCH and barstate.isconfirmed
        llIdx = cx.curLowIdx < cx.majorHighIdx ? cx.curLowIdx : cx.prevLowIdx
        off = bar_index - llIdx
        if off >= 1 and off < 490 and llIdx > 0
            legMid = (low[off] + high) * 0.5
            if high[off] <= legMid or not cf.rcbFibGate
                zr = f_zAdd(cf, cx, v, aV, "RCB", true, high[off], low[off], llIdx, onRcb)
                zr.depStrong := cx.chochReal
        cx.qmBullPend := true
        // §6.10 the QM head is the MOST RECENT low; the prev-low form belongs to RCB (§6.8)
        cx.qmBullLL   := cx.curLow
        cx.qmBullAt   := bar_index
    if bearCHoCH and barstate.isconfirmed
        hhIdx = cx.curHighIdx < cx.majorLowIdx ? cx.curHighIdx : cx.prevHighIdx
        off = bar_index - hhIdx
        if off >= 1 and off < 490 and hhIdx > 0
            legMid = (high[off] + low) * 0.5
            if low[off] >= legMid or not cf.rcbFibGate
                zr = f_zAdd(cf, cx, v, aV, "RCB", false, high[off], low[off], hhIdx, onRcb)
                zr.depStrong := cx.chochReal
        cx.qmBearPend := true
        cx.qmBearHH   := cx.curHigh
        cx.qmBearAt   := bar_index
    if cx.qmBullPend
        if bar_index - cx.qmBullAt > cf.qmMaxBars or bearCHoCH
            cx.qmBullPend := false
        else if not na(cx.qmBullLL) and low < cx.qmBullLL and barstate.isconfirmed
            zq = f_zAdd(cf, cx, v, aV, "QM", true, cx.qmBullLL, low, bar_index, onQm)
            zq.depStrong := cx.chochReal
            cx.qmBullPend := false
    if cx.qmBearPend
        if bar_index - cx.qmBearAt > cf.qmMaxBars or bullCHoCH
            cx.qmBearPend := false
        else if not na(cx.qmBearHH) and high > cx.qmBearHH and barstate.isconfirmed
            zq = f_zAdd(cf, cx, v, aV, "QM", false, high, cx.qmBearHH, bar_index, onQm)
            zq.depStrong := cx.chochReal
            cx.qmBearPend := false

    // §6.9 Rejection Block — §C3: `onRjb` is a draw flag, not a detection gate (it used to kill M40)
    if barstate.isconfirmed and bar_index > 2
        rr1  = high[1] - low[1]
        uw1 = rr1 > 0 ? (high[1] - math.max(open[1], close[1])) / rr1 : 0.0
        dw1 = rr1 > 0 ? (math.min(open[1], close[1]) - low[1]) / rr1 : 0.0
        if uw1 >= cf.rjbWickMin
            zb = math.max(open[1], close[1])
            if high < zb or (close < zb and open < zb)
                z = f_zAdd(cf, cx, v, aV, "RJB", false, high[1], zb, bar_index - 1, onRjb)
                z.confirmed := false
                z.weak      := high >= zb
                z.pendFvg   := 2
                f_zStyle(v, z)
        if dw1 >= cf.rjbWickMin
            zt = math.min(open[1], close[1])
            if low > zt or (close > zt and open > zt)
                z = f_zAdd(cf, cx, v, aV, "RJB", true, zt, low[1], bar_index - 1, onRjb)
                z.confirmed := false
                z.weak      := low <= zt
                z.pendFvg   := 2
                f_zStyle(v, z)

    // per-bar maintenance + "zone at price" feature extraction (nearest active zone touched this bar)
    n = array.size(cx.zones)
    bestPri = -1
    if n > 0
        for i = n - 1 to 0
            z = array.get(cx.zones, i)
            changed = false
            if z.broken
                if bar_index - z.brokenAt > 20
                    if not na(z.bx)
                        box.delete(z.bx)
                    array.remove(cx.zones, i)
                continue
            if z.idx >= bar_index
                continue
            if z.kind == "RJB" and not z.confirmed
                if z.pendFvg > 0
                    z.pendFvg := z.pendFvg - 1
                    if z.pendFvg == 0 and na(f_fvgNear(cx, z.bull, z.idx - 1, z.idx + 1))
                        if not na(z.bx)
                            box.delete(z.bx)
                        array.remove(cx.zones, i)
                        continue
                if (z.bull and bullBOS) or (not z.bull and bearBOS)
                    z.confirmed := true
                    z.depStrong := mvStrong
                    changed := true
                else if bar_index - z.idx > cf.rjbConfirmBars
                    z.broken   := true
                    z.brokenAt := bar_index
                    changed := true
            mid = (z.top + z.bottom) * 0.5
            touchedNow = false
            if z.bull
                if not na(swL) and swL > z.top and (na(z.idmLvl) or swL < z.idmLvl)
                    z.idmLvl := swL
                if not na(z.idmLvl) and not z.idmSwept and low < z.idmLvl and low > z.top
                    z.idmSwept := true
                    changed := true
                if low > z.top and low <= z.top + 0.5 * aV and na(z.nearMiss)
                    z.nearMiss := low
                if not na(z.nearMiss) and not z.nearSwept and low < z.nearMiss and close > z.nearMiss
                    z.nearSwept := true
                    changed := true
                if close < z.bottom
                    if z.kind == "SR" and not z.flipped
                        z.bull := false
                        z.flipped := true
                        z.touches := 0
                        z.sweepReq := false
                        f_zReset(z)
                        changed := true
                        if z.kl >= 4
                            fv.evtDn := "FLIP S→R"
                            fv.tipDn := "Support broken on close — same wick zone now acts as resistance (§6.3)."
                    else if z.kind == "OB"
                        z.kind := "BRK"
                        z.bull := false
                        z.touches := 0
                        z.tapped := false
                        z.sweepReq := false
                        f_zReset(z)
                        changed := true
                        fv.evtDn := "BRK▼"
                        fv.tipDn := "Bullish OB broken on close → bearish Breaker Block (§6.7)."
                        if not onBrk and not na(z.bx)
                            box.delete(z.bx)
                            z.bx := na
                    else
                        z.broken := true
                        z.brokenAt := bar_index
                        changed := true
                else if low <= z.top
                    touchedNow := true
                    if not z.tapped
                        z.tapped := true
                        changed := true
                    if low <= mid and not z.fiftyHit
                        z.fiftyHit := true
                    if bar_index - z.lastTouch > cf.touchCooldown
                        z.touches := z.touches + 1
                        z.lastTouch := bar_index
                        if z.touches >= 2 and not z.sweepReq
                            z.sweepReq := true
                            changed := true
                            if z.kind == "OB" or z.kind == "BRK"
                                fv.evtUp := "⚠SWEEP REQ"
                                fv.tipUp := "Zone touched ≥ 2× — direct reversal forbidden, wait for a sweep + pin bar (§6.2)."
                // PROPULSION: price left this already-tapped zone again, with an imbalance, in the
                // zone's own direction. Second proof of interest — re-arm it as a fresh, stronger zone.
                // v8.2.1 · `z.fiftyHit` proves price was really INSIDE the zone, and the upper
                // distance bound keeps a trend leg that merely passes overhead from re-arming every
                // zone it leaves behind. Without both, a vertical rally stamped PROP on six to eight
                // zones at once - and PROP carries +3 priority and feeds M73, the top-scored module.
                else if z.fiftyHit and z.touches >= 1 and not z.prop and fv.newBullFvg and bar_index - z.lastTouch <= cf.propWindow and low - z.top >= cf.propImpATR * aV and low - z.top <= cf.propImpATR * aV * 3
                    z.prop      := true
                    z.touches   := 0
                    z.tapped    := false
                    z.sweepReq  := false
                    f_zReset(z)
                    changed     := true
                    fv.newProp  := true
                    fv.evtUp    := "PROP▲"
                    fv.tipUp    := "Propulsion Block: price used this zone for a strong move, returned, and departed again with an imbalance. Trade the NEXT tap of its 50% (§6.9)."
            else
                if not na(swH) and swH < z.bottom and (na(z.idmLvl) or swH > z.idmLvl)
                    z.idmLvl := swH
                if not na(z.idmLvl) and not z.idmSwept and high > z.idmLvl and high < z.bottom
                    z.idmSwept := true
                    changed := true
                if high < z.bottom and high >= z.bottom - 0.5 * aV and na(z.nearMiss)
                    z.nearMiss := high
                if not na(z.nearMiss) and not z.nearSwept and high > z.nearMiss and close < z.nearMiss
                    z.nearSwept := true
                    changed := true
                if close > z.top
                    if z.kind == "SR" and not z.flipped
                        z.bull := true
                        z.flipped := true
                        z.touches := 0
                        z.sweepReq := false
                        f_zReset(z)
                        changed := true
                        if z.kl >= 4
                            fv.evtUp := "FLIP R→S"
                            fv.tipUp := "Resistance broken on close — same wick zone now acts as support (§6.3)."
                    else if z.kind == "OB"
                        z.kind := "BRK"
                        z.bull := true
                        z.touches := 0
                        z.tapped := false
                        z.sweepReq := false
                        f_zReset(z)
                        changed := true
                        fv.evtUp := "BRK▲"
                        fv.tipUp := "Bearish OB broken on close → bullish Breaker Block (§6.7)."
                        if not onBrk and not na(z.bx)
                            box.delete(z.bx)
                            z.bx := na
                    else
                        z.broken := true
                        z.brokenAt := bar_index
                        changed := true
                else if high >= z.bottom
                    touchedNow := true
                    if not z.tapped
                        z.tapped := true
                        changed := true
                    if high >= mid and not z.fiftyHit
                        z.fiftyHit := true
                    if bar_index - z.lastTouch > cf.touchCooldown
                        z.touches := z.touches + 1
                        z.lastTouch := bar_index
                        if z.touches >= 2 and not z.sweepReq
                            z.sweepReq := true
                            changed := true
                            if z.kind == "OB" or z.kind == "BRK"
                                fv.evtDn := "⚠SWEEP REQ"
                                fv.tipDn := "Zone touched ≥ 2× — direct reversal forbidden, wait for a sweep + pin bar (§6.2)."
                // v8.2.1 · `z.fiftyHit` proves price was really INSIDE the zone, and the upper
                // distance bound keeps a trend leg that merely passes overhead from re-arming every
                // zone it leaves behind. Without both, a vertical rally stamped PROP on six to eight
                // zones at once - and PROP carries +3 priority and feeds M73, the top-scored module.
                else if z.fiftyHit and z.touches >= 1 and not z.prop and fv.newBearFvg and bar_index - z.lastTouch <= cf.propWindow and z.bottom - high >= cf.propImpATR * aV and z.bottom - high <= cf.propImpATR * aV * 3
                    z.prop      := true
                    z.touches   := 0
                    z.tapped    := false
                    z.sweepReq  := false
                    f_zReset(z)
                    changed     := true
                    fv.newProp  := true
                    fv.evtDn    := "PROP▼"
                    fv.tipDn    := "Propulsion Block: price used this zone for a strong move, returned, and departed again with an imbalance. Trade the NEXT tap of its 50% (§6.9)."
            // feature: the most significant zone price is touching right now (OB/BRK/RCB/RJB/QM > KL > SR)
            // An SR zone is created at EVERY pivot as raw material for the key-level score; it only
            // becomes a real level once it scores >= klMinCrit. Letting the unscored ones fill this
            // slot made "price is at a zone" true on almost every bar (60 zones are retained), which
            // is what gated - and therefore failed to gate - nearly every setup in the build.
            srOk = z.kind != "SR" or z.kl >= cf.klMinCrit or cf.srTradable
            // v8.2.1 · `weak` and `not confirmed` were only ever used for styling, so a rejection
            // block still waiting on its FVG (or one whose confirming candle never cleared the zone)
            // filled the active-zone slot and let M40 trade it. The review charts labelled several
            // "RJB▲ weak IDM✓" zones - all of them tradable.
            if touchedNow and not z.broken and srOk and not z.weak and z.confirmed
                priK = z.kind == "OB" ? 6 : z.kind == "BRK" ? 5 : z.kind == "RCB" ? 4 : z.kind == "QM" ? 4 : z.kind == "RJB" ? 3 : z.kl >= 3 ? 2 : 1
                pri = priK + (z.prop ? 3 : 0)
                if pri > bestPri
                    bestPri := pri
                    fv.zKind := z.kind
                    fv.zTouches := z.touches
                    fv.zSweepReq := z.sweepReq
                    fv.zFifty := z.fiftyHit
                    fv.zIdm := z.idmSwept
                    fv.zHp := z.hp
                    fv.zKl := z.kl
                    fv.zFlipped := z.flipped
                    fv.zNearSwept := z.nearSwept
                    fv.zDepStrong := z.depStrong
                    fv.atProp := z.prop
                    fv.zTop := z.top
                    fv.zBottom := z.bottom
                    if z.kind == "SR"
                        fv.atSupport := z.bull
                        fv.atResist  := not z.bull
                        fv.atDemand  := false
                        fv.atSupply  := false
                    else
                        fv.atDemand := z.bull
                        fv.atSupply := not z.bull
                        fv.atSupport := false
                        fv.atResist  := false
            if z.broken and not na(z.bx)
                box.set_extend(z.bx, extend.none)
                box.set_right(z.bx, bar_index)
            if changed
                f_zStyle(v, z)
            if not z.tapped and bar_index - z.idx > cf.zoneMaxAge
                if not na(z.bx)
                    box.delete(z.bx)
                array.remove(cx.zones, i)
                continue
    // caps — SR has its own budget
    srCnt = 0
    nzc = array.size(cx.zones)
    if nzc > 0
        for i = 0 to nzc - 1
            if array.get(cx.zones, i).kind == "SR"
                srCnt += 1
    if srCnt > cf.maxZones and nzc > 0
        for i = 0 to nzc - 1
            zz = array.get(cx.zones, i)
            if zz.kind == "SR"
                if not na(zz.bx)
                    box.delete(zz.bx)
                array.remove(cx.zones, i)
                break
    while array.size(cx.zones) > cf.maxZones * 2
        old = array.shift(cx.zones)
        if not na(old.bx)
            box.delete(old.bx)

// ── L5 HTF — pairing table + ONE security tuple ──────────────────────────────
f_htfAuto(mode) =>
    s = timeframe.in_seconds()
    aggr = mode == "Aggressive"
    s <= 60 ? "15" :
     s <= 180 ? "30" :
     s <= 300 ? (aggr ? "30" : "60") :
     s <= 900 ? (aggr ? "60" : "240") :
     s <= 1800 ? "240" :
     s <= 14400 ? "D" :
     s <= 86400 ? "W" : "M"

htfTF = i_mode == "Manual" ? i_manual : f_htfAuto(i_mode)

[hO1, hH1, hL1, hC1, hO2, hH2, hL2, hC2, hPH, hPL] = request.security(syminfo.tickerid, htfTF,
     [open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2],
      ta.pivothigh(high, i_htfSwing, i_htfSwing)[1], ta.pivotlow(low, i_htfSwing, i_htfSwing)[1]],
     lookahead = barmerge.lookahead_on)
newHtf = timeframe.change(htfTF)

f_htf(cf, cx, fv, isNew, o1, h1, l1, c1, o2, h2, l2, c2, ph, pl) =>
    if isNew and not na(c1)
        cx.hBarCount := cx.hBarCount + 1
        if not na(cx.hCurHigh) and not cx.hHiBroken and h1 > cx.hCurHigh and c1 <= cx.hCurHigh
            cx.sweepUpAt := cx.hBarCount
        if not na(cx.hCurLow) and not cx.hLoBroken and l1 < cx.hCurLow and c1 >= cx.hCurLow
            cx.sweepDnAt := cx.hBarCount
        bBOS = not na(cx.hCurHigh) and not cx.hHiBroken and c1 > cx.hCurHigh
        sBOS = not na(cx.hCurLow)  and not cx.hLoBroken and c1 < cx.hCurLow
        if sBOS
            cx.hLoBroken := true
            if not na(cx.hPrevHigh) and cx.hCurHigh < cx.hPrevHigh
                cx.hMajorHigh := cx.hCurHigh
            cx.hTrend := "BEAR"
        if bBOS
            cx.hHiBroken := true
            if not na(cx.hPrevLow) and cx.hCurLow > cx.hPrevLow
                cx.hMajorLow := cx.hCurLow
            cx.hTrend := "BULL"
        if cx.hTrend == "BEAR" and not na(cx.hMajorHigh) and c1 > cx.hMajorHigh
            cx.hTrend := "BULL"
        if cx.hTrend == "BULL" and not na(cx.hMajorLow) and c1 < cx.hMajorLow
            cx.hTrend := "BEAR"
        if not na(ph)
            cx.hPrevHigh := cx.hCurHigh
            cx.hCurHigh  := ph
            cx.hHiBroken := false
        if not na(pl)
            cx.hPrevLow  := cx.hCurLow
            cx.hCurLow   := pl
            cx.hLoBroken := false
    fv.htfBias    := cx.hTrend
    fv.htfSweepUp := cx.hBarCount - cx.sweepUpAt < cf.sweepValidHTF
    fv.htfSweepDn := cx.hBarCount - cx.sweepDnAt < cf.sweepValidHTF
    if not na(c1) and not na(c2)
        rr1  = h1 - l1
        upW = rr1 > 0 ? (h1 - math.max(o1, c1)) / rr1 : 0.0
        dnW = rr1 > 0 ? (math.min(o1, c1) - l1) / rr1 : 0.0
        fv.htfManipBull := l1 < l2 and c1 > h2 and c1 > o1 and dnW >= cf.manipWickRatio
        fv.htfManipBear := h1 > h2 and c1 < l2 and c1 < o1 and upW >= cf.manipWickRatio
        fv.htfRejBear   := upW >= cf.rejWickRatio and c1 < o1
        fv.htfRejBull   := dnW >= cf.rejWickRatio and c1 > o1

// §7.3 gate + M13 trend filter: 2 pass · 1 warn · 0 block
f_gate(cf, bias, trend, sigBull) =>
    htfOk = bias == "NEUTRAL" or (sigBull and bias == "BULL") or (not sigBull and bias == "BEAR")
    trOk  = trend == "RANGE" or (sigBull and trend == "BULLISH") or (not sigBull and trend == "BEARISH")
    ok = htfOk and trOk
    cf.gateMode == "OFF" or ok ? 2 : cf.gateMode == "WARN" ? 1 : 0

// ── GLOBAL-SCOPE SERIES (blacklist #4/#5) ────────────────────────────────────
atrV    = ta.atr(i_atrLen)
swingHi = ta.pivothigh(high, i_swingLen, i_swingLen)
swingLo = ta.pivotlow(low,  i_swingLen, i_swingLen)
extHi   = ta.highest(high, i_extLB)
extLo   = ta.lowest(low,  i_extLB)
rangeW  = ta.highest(high, i_wyckLB) - ta.lowest(low, i_wyckLB)
volSma  = ta.sma(volume, i_volLen)
volLr   = ta.linreg(volume, 10, 0)
volSlopeNeg = volLr < volLr[1]
rngHiN  = ta.highest(high, i_rangeLen)
rngLoN  = ta.lowest(low,  i_rangeLen)
rngLr   = ta.linreg(high - low, 8, 0)
rangeShrinkG = rngLr < rngLr[1]
[pdhRaw, pdlRaw] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwhRaw, pwlRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
newDay  = i_showPD and timeframe.isintraday and timeframe.change("D")
newWeek = i_showPW and (timeframe.isintraday or timeframe.isdaily) and timeframe.change("W")
// ── NEW · sessions (killzones). Only meaningful intraday; on ≥ daily every bar spans them all,
// so the flags are forced open and the filter becomes a no-op rather than blocking everything.
ssnIntra = timeframe.isintraday
inAsia   = ssnIntra and not na(time(timeframe.period, i_ssnAsia))
inLon    = ssnIntra and not na(time(timeframe.period, i_ssnLon))
inNY     = ssnIntra and not na(time(timeframe.period, i_ssnNY))
lonOpen  = inLon and not inLon[1]

// ── ORCHESTRATION — every engine exactly once per bar, in layer order ────────
ft = Feat.new()
refLo = nz(ctx.curLow, low[1])
refHi = nz(ctx.curHigh, high[1])
preHigh = ctx.curHigh
preLow  = ctx.curLow
// the index that belongs to preHigh/preLow: f_structure may shift cur -> prev this bar, so neither
// ctx.curHighIdx nor ctx.prevHighIdx is reliable afterwards. Trend likewise flips inside the call.
preHighIdx = ctx.curHighIdx
preLowIdx  = ctx.curLowIdx
preTrend   = ctx.trend
cd = f_candle(cfg, atrV, refLo, refHi)
f_fvg(cfg, ctx, vis, ft, atrV, d_fvg, d_fvgMit)
st = f_structure(cfg, ctx, swingHi, swingLo, rangeW, atrV)
if st.bullSweep
    ctx.sweptHighBar := bar_index
if st.bearSweep
    ctx.sweptLowBar := bar_index

// L2 strength — only at BOS (departure) and CHoCH (M30 real/fake)
var Move mv = Move.new()
bosEvt = st.bullBOS or st.bearBOS
if bosEvt and barstate.isconfirmed
    // the leg origin is the index as it stood BEFORE f_structure shifted it (see preHighIdx above);
    // reading ctx.curLowIdx here measured only the last swingLen bars on any pivot-confirming bar
    mv := f_moveStrength(cfg, ctx, st.bullBOS ? preLowIdx : preHighIdx, bar_index, atrV)
    ctx.lastDepStrong  := mv.strong
    ctx.lastBOSBar     := bar_index
    ctx.lastBOSAvgBody := mv.avgBody
if (st.bullCHoCH or st.bearCHoCH) and barstate.isconfirmed
    mc = f_moveStrength(cfg, ctx, st.bullCHoCH ? preLowIdx : preHighIdx, bar_index, atrV)
    ctx.chochReal := mc.fvgCount >= 1
ft.dispBull      := st.bullBOS and mv.strong
ft.dispBear      := st.bearBOS and mv.strong
ft.lastDepStrong := ctx.lastDepStrong
ft.chochReal     := ctx.chochReal
// NEW — dispScore / dispDir were declared and never written. Displacement quality of the break
// that just printed: 0 = none, 3 = strong body, ≥2 gaps and a clean efficiency reading.
ft.dispDir   := st.bullBOS ? 1 : st.bearBOS ? -1 : 0
ft.dispScore := ft.dispDir == 0 ? 0 : (mv.strong ? 1 : 0) + (mv.fvgCount >= 2 ? 1 : 0) + (mv.bodyEff >= 0.7 ? 1 : 0)

// ── NEW · session feature + Asia-range liquidity (SESH / SESL) ───────────────
// `Feat.sessName` / `Feat.sbSessOk` were declared in the type and never written, and the sweep
// classifier already treated "SESH"/"SESL" as external liquidity with nothing producing them.
ft.sessName := inLon ? "London" : inNY ? "NY" : inAsia ? "Asia" : ""
ft.sbSessOk := not i_ssnOn or not ssnIntra or ft.sessName != ""
var float asiaHi = na
var float asiaLo = na
if inAsia
    if not inAsia[1]
        asiaHi := high
        asiaLo := low
    else
        asiaHi := math.max(nz(asiaHi, high), high)
        asiaLo := math.min(nz(asiaLo, low), low)
// added BEFORE f_liq so the level joins this bar's list and is tracked from the next bar on
if i_ssnLvl and lonOpen and barstate.isconfirmed and not na(asiaHi) and not na(asiaLo)
    if array.size(ctx.lv) > 0
        for i = array.size(ctx.lv) - 1 to 0
            Lx = array.get(ctx.lv, i)
            if not Lx.done and (Lx.kind == "SESH" or Lx.kind == "SESL")
                f_resolve(vis, Lx, "EXPIRED")
    f_addLevel(cfg, ctx, vis, atrV, asiaHi, bar_index, true,  "SESH", true, d_liq)
    f_addLevel(cfg, ctx, vis, atrV, asiaLo, bar_index, false, "SESL", true, d_liq)

f_liq(cfg, ctx, vis, ft, atrV, swingHi, swingLo, extHi, extLo, pdhRaw, pdlRaw, pwhRaw, pwlRaw, newDay, newWeek, d_liq)
volOk = volume > volSma * i_klVolMult
f_zones(cfg, ctx, vis, ft, atrV, swingHi, swingLo, st.bullBOS, st.bearBOS, st.bullCHoCH, st.bearCHoCH,
     mv.strong, mv.fvgCount, volOk, d_sr, d_kl, d_ob, d_brk, d_rcb, d_rjb, d_qm)
f_htf(cfg, ctx, ft, newHtf, hO1, hH1, hL1, hC1, hO2, hH2, hL2, hC2, hPH, hPL)
// §M9 — st.trend has already been flipped by THIS bar's own BOS/CHoCH, so reading it here made the
// LTF half of the gate agree with every breakout by construction. `preTrend` is the trend as the
// bar opened, which is what a filter is supposed to compare against.
gateTrend = i_gateTrend == "Entering bar" ? preTrend : st.trend
ft.gateUp := f_gate(cfg, ft.htfBias, gateTrend, true)
ft.gateDn := f_gate(cfg, ft.htfBias, gateTrend, false)

// ── §Premium / Discount array ───────────────────────────────────────────
// v8.2.1 · the range is the last COMPLETED swing (curLow..curHigh). majorLow / majorHigh are the
// CHoCH INVALIDATION levels, and in a trend they sit outside price: pdPct clamped to 1.0 (or 0.0)
// for the whole leg, so the score term degenerated into a constant anti-trend bias - long -1,
// short +1, in an uptrend. All four review charts read exactly "100% premium" while price was
// printing highs. Price outside the swing is EXPANSION, which is neither premium nor discount, so
// it scores and gates neutral rather than maximally hostile.
pdHi = ctx.curHigh
pdLo = ctx.curLow
pdIn = not na(pdHi) and not na(pdLo) and pdHi > pdLo and close <= pdHi and close >= pdLo
ft.pdPct      := pdIn ? (close - pdLo) / (pdHi - pdLo) : 0.5
ft.inDiscount := pdIn and ft.pdPct <= 0.5
ft.inPremium  := pdIn and ft.pdPct >= 0.5
// only gate INSIDE a range - outside it both flags are false and a hard gate would block both sides
if i_pdGate and pdIn
    if not ft.inDiscount
        ft.gateUp := 0
    if not ft.inPremium
        ft.gateDn := 0

// §4.5 arrival strength — only when a zone is touched (event), cached 10 bars
zoneTouch = ft.zKind != ""
// the cache must be keyed on the SIDE too: a demand touch 3 bars after a supply touch was reusing
// the up-leg's verdict, which blocked every long at that demand and killed M42
arrDirNow = ft.atDemand or ft.atSupport ? 1 : -1
if zoneTouch and barstate.isconfirmed and (bar_index - ctx.arrivalBar > 5 or ctx.arrivalDir != arrDirNow)
    fromIdx = arrDirNow == 1 ? ctx.curHighIdx : ctx.curLowIdx
    ma = f_moveStrength(cfg, ctx, fromIdx, bar_index, atrV)
    ctx.arrivalStrong  := ma.strong
    ctx.arrivalBar     := bar_index
    ctx.arrivalDir     := arrDirNow
    ctx.arrivalAvgBody := ma.avgBody
    ctx.arrivalMixed   := ma.mixed
if zoneTouch and bar_index - ctx.arrivalBar <= 10
    ft.arrivalStrong := ctx.arrivalStrong
    ft.arrivalWeak   := not ctx.arrivalStrong
    // §M10 — the mixed ratio now expires with the rest of the arrival verdict instead of being
    // read straight off Ctx, where it kept the previous event's value indefinitely
    ft.arrivalMixed  := ctx.arrivalMixed
    ft.retestValid   := ctx.lastBOSAvgBody > 0 and ctx.arrivalAvgBody < ctx.lastBOSAvgBody * cfg.retestBodyRatio

// volume
ft.volHigh     := volume > volSma * cfg.volHighMult
ft.volSlopeNeg := volSlopeNeg

// leg counters — a leg restarts when a valid pullback confirms (§3.5) or a BOS prints
if st.pbValidUp or st.pbValidDn or bosEvt
    ctx.pinBullInLeg := 0
    ctx.pinBearInLeg := 0
    ctx.dojiInLeg    := 0
ctx.pinBullInLeg := ctx.pinBullInLeg + (cd.pinBull ? 1 : 0)
ctx.pinBearInLeg := ctx.pinBearInLeg + (cd.pinBear ? 1 : 0)
ctx.dojiInLeg    := ctx.dojiInLeg + (cd.doji ? 1 : 0)
ctx.greenRun     := cd.isBull ? ctx.greenRun + 1 : 0
ctx.redRun       := cd.isBear ? ctx.redRun + 1 : 0
ft.pinBullInLeg  := ctx.pinBullInLeg
ft.pinBearInLeg  := ctx.pinBearInLeg
ft.dojiInLeg     := ctx.dojiInLeg
ft.greenRun      := ctx.greenRun
ft.redRun        := ctx.redRun

// wick sequences (M01 / M02 strength rule): three consecutive long same-side wicks, growing or shrinking
wk = 0.4
ft.upWickInc := cd.upWickRatio >= wk and ctx.upR1 >= wk and ctx.upR2 >= wk and cd.upWick > ctx.upW1 and ctx.upW1 > ctx.upW2
ft.upWickDec := cd.upWickRatio >= 0.25 and ctx.upW1 > cd.upWick and ctx.upW2 > ctx.upW1 and ctx.upW2 > 0
ft.dnWickInc := cd.dnWickRatio >= wk and ctx.dnR1 >= wk and ctx.dnR2 >= wk and cd.dnWick > ctx.dnW1 and ctx.dnW1 > ctx.dnW2
ft.dnWickDec := cd.dnWickRatio >= 0.25 and ctx.dnW1 > cd.dnWick and ctx.dnW2 > ctx.dnW1 and ctx.dnW2 > 0
// keep the wick RATIO history separately — the absolute distances are only comparable to each other
ctx.upW2 := ctx.upW1
ctx.upW1 := cd.upWick
ctx.dnW2 := ctx.dnW1
ctx.dnW1 := cd.dnWick
ctx.upR2 := ctx.upR1
ctx.upR1 := cd.upWickRatio
ctx.dnR2 := ctx.dnR1
ctx.dnR1 := cd.dnWickRatio

// breakout state (M01/M02/M03/M05/M14/M15/M22/M24): a level break = BOS or liquidity RUN
ft.breakUp := st.bullBOS or ft.runUp
ft.breakDn := st.bearBOS or ft.runDn
if ft.breakUp or ft.breakDn
    ctx.breakDir := ft.breakUp ? 1 : -1
    // a RUN break carries its own level (runPrice); only a sweep carries sweptPrice
    ctx.breakLvl := ft.breakUp ? (st.bullBOS ? preHigh : nz(ft.runPrice, ft.sweptPrice)) : (st.bearBOS ? preLow : nz(ft.runPrice, ft.sweptPrice))
    if na(ctx.breakLvl)
        ctx.breakLvl := ft.breakUp ? preHigh : preLow
    ctx.breakBar := bar_index
    ctx.breakLo  := low
    ctx.breakHi  := high
ft.breakAgo   := bar_index - ctx.breakBar
ft.fakeBreak  := ft.breakAgo == 1 and not na(ctx.breakLvl) and (ctx.breakDir == 1 ? close < ctx.breakLvl : close > ctx.breakLvl)
ft.insideOk   := ft.breakAgo == 1 and cd.insideBar and not na(ctx.breakLo) and
                 (ctx.breakDir == 1 ? low >= ctx.breakLo + (ctx.breakHi - ctx.breakLo) * 0.5 : high <= ctx.breakHi - (ctx.breakHi - ctx.breakLo) * 0.5)
ft.breakPinBull := ft.breakUp and cd.pinBull and not na(ctx.breakLvl) and low < ctx.breakLvl
ft.breakPinBear := ft.breakDn and cd.pinBear and not na(ctx.breakLvl) and high > ctx.breakLvl

// wick dominance over the last 8 bars (M38 P3/P5)
lowerCnt = 0
upperCnt = 0
// §M6 — na history makes both subtractions na and every comparison false, so on the first bars the
// counters silently under-reported instead of being undefined. Skip the window until it exists.
if bar_index >= 8
    for k = 0 to 7
        uw = high[k] - math.max(close[k], open[k])
        dw = math.min(close[k], open[k]) - low[k]
        if dw > uw
            lowerCnt += 1
        if uw > dw
            upperCnt += 1
ft.wickLowerDom := lowerCnt >= 5
ft.wickUpperDom := upperCnt >= 5
// panel: last structural event
if st.bullCHoCH or st.bearCHoCH
    ctx.lastEvt := (st.bullCHoCH ? "CHoCH▲" : "CHoCH▼") + (ctx.chochReal ? " (real)" : " (fake)")
    ctx.lastEvtBar := bar_index
else if bosEvt
    ctx.lastEvt := (st.bullBOS ? "BOS▲" : "BOS▼") + (mv.strong ? " strong" : " weak")
    ctx.lastEvtBar := bar_index
else if st.cisdBull or st.cisdBear
    ctx.lastEvt := st.cisdBull ? "CISD▲" : "CISD▼"
    ctx.lastEvtBar := bar_index
else if ft.sweptHigh or ft.sweptLow
    ctx.lastEvt := "SWEEP " + ft.sweptKind
    ctx.lastEvtBar := bar_index
// alert: price entered an OB / S&D and tapped 50% (edge)
fiftyNow = ft.zKind == "OB" and ft.zFifty
ft.enteredOb50 := fiftyNow and not ctx.fiftyPrev
ctx.fiftyPrev := fiftyNow

// ── P7b features ─────────────────────────────────────────────────────────────
// range (§8 helper): no BOS/CHoCH for rangeLen bars AND width ≤ rangeMaxATR × ATR
ft.inRange := ctx.barsSinceEvt >= cfg.rangeLen and (rngHiN - rngLoN) <= atrV * cfg.rangeMaxATR
// rngHiN/rngLoN include THIS bar, so refreshing the stored levels before the break test made
// `close > ctx.rangeHi` impossible on any bar where the range was still live
prevRgHi = ctx.rangeHi
prevRgLo = ctx.rangeLo
if ft.inRange
    ctx.rangeHi := rngHiN
    ctx.rangeLo := rngLoN
if ctx.inRangePrev and not na(prevRgLo) and close < prevRgLo
    ctx.rangeBrkDir := -1
    ctx.rangeBrkBar := bar_index
if ctx.inRangePrev and not na(prevRgHi) and close > prevRgHi
    ctx.rangeBrkDir := 1
    ctx.rangeBrkBar := bar_index
// §M12 — rangeBrkDir was set once and never cleared, so a fresh range inherited the direction of
// the break that ended the PREVIOUS one; M50/M53 then read a stale polarity.
if ft.inRange and not ctx.inRangePrev
    ctx.rangeBrkDir := 0
    ctx.rangeBrkBar := -999
ctx.inRangePrev := ft.inRange
ft.rangeShrink  := rangeShrinkG
// price inside an unmitigated FVG (reaction zone for M46/M50/M52)
nF = array.size(ctx.fvgs)
if nF > 0
    for i = 0 to nF - 1
        g = array.get(ctx.fvgs, i)
        if not g.mitigated and g.idx < bar_index - 1
            if g.isBull and low <= g.top and high >= g.bottom
                ft.atBullFvg := true
            if not g.isBull and high >= g.bottom and low <= g.top
                ft.atBearFvg := true
if ft.newBullFvg
    ctx.bullFvgBar := bar_index
if ft.newBearFvg
    ctx.bearFvgBar := bar_index
if ft.hiddenSSL
    ctx.hidSSLBar := bar_index
if ft.hiddenBSL
    ctx.hidBSLBar := bar_index
if ft.atDemand
    ctx.demandTouchBar := bar_index
if ft.atSupply
    ctx.supplyTouchBar := bar_index
// §3.4 · §M7 — these two are a sweep followed by a BOS, which is a continuation shape, and they
// were named "sweepCHoCH" while never being able to coincide with a CHoCH (a BOS flips the trend
// before the CHoCH test runs). Both forms are now detected under honest names and M45 arms off
// either: ±1 = sweep + BOS, ±2 = sweep + real CHoCH, which is the reversal the module documents.
ft.sweepBosBear   := bar_index - ctx.sweptHighBar <= 10 and ctx.sweptHighBar >= 0 and st.bearBOS
ft.sweepBosBull   := bar_index - ctx.sweptLowBar  <= 10 and ctx.sweptLowBar  >= 0 and st.bullBOS
ft.sweepChochBear := bar_index - ctx.sweptHighBar <= 10 and ctx.sweptHighBar >= 0 and st.bearCHoCH
ft.sweepChochBull := bar_index - ctx.sweptLowBar  <= 10 and ctx.sweptLowBar  >= 0 and st.bullCHoCH
if ft.sweepBosBear
    ctx.m45Dir := -1
    ctx.m45Bar := bar_index
if ft.sweepBosBull
    ctx.m45Dir := 1
    ctx.m45Bar := bar_index
if ft.sweepChochBear
    ctx.m45Dir := -2
    ctx.m45Bar := bar_index
if ft.sweepChochBull
    ctx.m45Dir := 2
    ctx.m45Bar := bar_index
// M41: sweep then STRONG move with FVG (armed) / weak move (NO TRADE, dir = ±9)
if st.bearBOS and bar_index - ctx.sweptHighBar <= 20 and ctx.sweptHighBar >= 0
    ctx.m41Dir := mv.strong ? -1 : -9
    ctx.m41Bar := bar_index
if st.bullBOS and bar_index - ctx.sweptLowBar <= 20 and ctx.sweptLowBar >= 0
    ctx.m41Dir := mv.strong ? 1 : 9
    ctx.m41Bar := bar_index
// M46: CISD + at least one reliability condition (HTF rejection/sweep · power-reversal FVG · sweep before)
// §3.6 the three high-probability conditions, counted: 1 HTF rejection/sweep · 2 power reversal (fresh FVG) · 3 liquidity sweep just before
relCntBear = (ft.htfRejBear or ft.htfSweepUp ? 1 : 0) + (bar_index - ctx.bearFvgBar <= 3 ? 1 : 0) + (bar_index - ctx.sweptHighBar <= 5 ? 1 : 0)
relCntBull = (ft.htfRejBull or ft.htfSweepDn ? 1 : 0) + (bar_index - ctx.bullFvgBar <= 3 ? 1 : 0) + (bar_index - ctx.sweptLowBar  <= 5 ? 1 : 0)
relBear = relCntBear > 0
relBull = relCntBull > 0
ft.cisdRel := st.cisdBear ? relCntBear : st.cisdBull ? relCntBull : 0
if st.cisdBear and relBear
    ctx.m46Dir := -1
    ctx.m46Bar := bar_index
if st.cisdBull and relBull
    ctx.m46Dir := 1
    ctx.m46Bar := bar_index
// M48: fake CHoCH — LTF CHoCH against a still-aligned HTF bias
if st.bearCHoCH and ft.htfBias == "BULL"
    ctx.m48Dir := 1
    ctx.m48Bar := bar_index
if st.bullCHoCH and ft.htfBias == "BEAR"
    ctx.m48Dir := -1
    ctx.m48Bar := bar_index
// M52: rejection from supply → CHoCH down (mirror: demand → CHoCH up)
if st.bearCHoCH and bar_index - ctx.supplyTouchBar <= 20
    ctx.m52Dir := -1
    ctx.m52Bar := bar_index
if st.bullCHoCH and bar_index - ctx.demandTouchBar <= 20
    ctx.m52Dir := 1
    ctx.m52Bar := bar_index
// M54: demand touch → stop-hunt sweep → BOS up → retrace (bull) · mirror (bear)
if ft.atDemand and ctx.m54Stage == 0
    ctx.m54Stage := 1
    ctx.m54Bar := bar_index
if ctx.m54Stage == 1 and bar_index > ctx.m54Bar and (ft.sweptLow or st.bearSweep)
    ctx.m54Stage := 2
    ctx.m54Bar   := bar_index
if ctx.m54Stage == 2 and bar_index > ctx.m54Bar and st.bullBOS
    ctx.m54Stage := 3
    ctx.m54Bar   := bar_index
if ctx.m54Stage > 0 and bar_index - ctx.m54Bar > cfg.armBars * 2
    ctx.m54Stage := 0
if ft.atSupply and ctx.m54StageB == 0
    ctx.m54StageB := 1
    ctx.m54BarB := bar_index
if ctx.m54StageB == 1 and bar_index > ctx.m54BarB and (ft.sweptHigh or st.bullSweep)
    ctx.m54StageB := 2
    ctx.m54BarB   := bar_index
if ctx.m54StageB == 2 and bar_index > ctx.m54BarB and st.bearBOS
    ctx.m54StageB := 3
    ctx.m54BarB   := bar_index
if ctx.m54StageB > 0 and bar_index - ctx.m54BarB > cfg.armBars * 2
    ctx.m54StageB := 0

// ── §M38-P6 · M49 · M01/M02 pre-conditions — structural counters ─────────────
// swings collected while the leg walked into the level (reset on the structural break itself)
ft.swLoInLeg := ctx.swLoInLeg
ft.swHiInLeg := ctx.swHiInLeg
if bosEvt or st.bullCHoCH or st.bearCHoCH
    ctx.swLoInLeg := 0
    ctx.swHiInLeg := 0
if st.swingLow
    ctx.swLoInLeg := ctx.swLoInLeg + 1
if st.swingHigh
    ctx.swHiInLeg := ctx.swHiInLeg + 1
// §M49 internal liquidity: a swing that sits INSIDE the leg (above the major low / below the major high)
if st.swingLow and not na(ctx.curLow) and (na(ctx.majorLow) or ctx.curLow > ctx.majorLow)
    ctx.intLowB := ctx.curLow
if st.swingHigh and not na(ctx.curHigh) and (na(ctx.majorHigh) or ctx.curHigh < ctx.majorHigh)
    ctx.intHighB := ctx.curHigh
if not na(ctx.intLowB) and low < ctx.intLowB and close > ctx.intLowB
    ctx.intSwpBull := bar_index
if not na(ctx.intHighB) and high > ctx.intHighB and close < ctx.intHighB
    ctx.intSwpBear := bar_index
ft.intSweptBull := ctx.intSwpBull > 0 and bar_index - ctx.intSwpBull <= 15
ft.intSweptBear := ctx.intSwpBear > 0 and bar_index - ctx.intSwpBear <= 15
// §M01/M02 pre-condition: how many separate times price rejected the level that just broke
if (ft.breakUp or ft.breakDn) and not na(ctx.breakLvl)
    tCnt  = 0
    wasAt = false
    for k = 1 to 30
        atLvl = high[k] >= ctx.breakLvl - atrV * cfg.touchTolATR and low[k] <= ctx.breakLvl + atrV * cfg.touchTolATR
        if atLvl and not wasAt
            tCnt += 1
        wasAt := atLvl
    ctx.brkTouch := tCnt
ft.brkTouches := ctx.brkTouch

// ── M64 trendline engine + M71 time-at-level (feature layer: every setup group reads these) ──
tlz = atrV * i_tlTol

// M64 — auto trendline: last two pivot lows (support) / highs (resistance); zone ± tlTol × ATR; valid at ≥2 touches
if st.swingLow and not na(ctx.prevLow) and ctx.curLow > ctx.prevLow
    o1r = bar_index - ctx.prevLowIdx
    o2r = bar_index - ctx.curLowIdx
    bodyOk = i_tlAnchor == "Body" and o1r >= 0 and o1r < 500 and o2r >= 0 and o2r < 500
    o1 = math.min(math.max(o1r, 0), 499)
    o2 = math.min(math.max(o2r, 0), 499)
    sx.tlSx1 := ctx.prevLowIdx
    sx.tlSy1 := bodyOk ? math.min(open[o1], close[o1]) : ctx.prevLow
    sx.tlSx2 := ctx.curLowIdx
    sx.tlSy2 := bodyOk ? math.min(open[o2], close[o2]) : ctx.curLow
    sx.tlSTouch := 2
    sx.tlSBroken := false
if st.swingHigh and not na(ctx.prevHigh) and ctx.curHigh < ctx.prevHigh
    p1r = bar_index - ctx.prevHighIdx
    p2r = bar_index - ctx.curHighIdx
    bodyOkR = i_tlAnchor == "Body" and p1r >= 0 and p1r < 500 and p2r >= 0 and p2r < 500
    p1 = math.min(math.max(p1r, 0), 499)
    p2 = math.min(math.max(p2r, 0), 499)
    sx.tlRx1 := ctx.prevHighIdx
    sx.tlRy1 := bodyOkR ? math.max(open[p1], close[p1]) : ctx.prevHigh
    sx.tlRx2 := ctx.curHighIdx
    sx.tlRy2 := bodyOkR ? math.max(open[p2], close[p2]) : ctx.curHigh
    sx.tlRTouch := 2
    sx.tlRBroken := false
slopeS = sx.tlSx2 > sx.tlSx1 ? (sx.tlSy2 - sx.tlSy1) / (sx.tlSx2 - sx.tlSx1) : 0.0
slopeR = sx.tlRx2 > sx.tlRx1 ? (sx.tlRy2 - sx.tlRy1) / (sx.tlRx2 - sx.tlRx1) : 0.0
tlSraw = not na(sx.tlSy2) and sx.tlSx2 > sx.tlSx1 ? sx.tlSy2 + slopeS * (bar_index - sx.tlSx2) : float(na)
tlRraw = not na(sx.tlRy2) and sx.tlRx2 > sx.tlRx1 ? sx.tlRy2 + slopeR * (bar_index - sx.tlRx2) : float(na)
// §M14 — an anchor pair is only replaced when a new HL / LH prints, so a line defined by two pivots
// hundreds of bars back kept being extrapolated and drawn far away from price while still counting
// as "valid" (touch ≥ 2). Expire the anchors by age and by distance; tlSraw / tlRraw stay as the
// unfiltered projection the freshness test itself is measured against.
// v8.2.1 · also cap the SLOPE. Two pivots a few bars apart project a near-vertical line that
// passes the age and distance tests at the anchor and then runs off the chart - visible on all four
// review charts - and M12 / M65 read that line as a level.
tlSFresh = not na(tlSraw) and bar_index - sx.tlSx1 <= 250 and math.abs(close - tlSraw) <= atrV * 10 and math.abs(slopeS) <= atrV * 0.5
tlRFresh = not na(tlRraw) and bar_index - sx.tlRx1 <= 250 and math.abs(close - tlRraw) <= atrV * 10 and math.abs(slopeR) <= atrV * 0.5
tlS = sx.tlSBroken or not tlSFresh ? float(na) : tlSraw
tlR = sx.tlRBroken or not tlRFresh ? float(na) : tlRraw
if not na(tlS) and bar_index > sx.tlSx2 + 1
    if low <= tlS + tlz and low >= tlS - tlz and close > tlS
        sx.tlSTouch := sx.tlSTouch + 1
    if close < tlS - tlz
        sx.tlSBroken := true
if not na(tlR) and bar_index > sx.tlRx2 + 1
    if high >= tlR - tlz and high <= tlR + tlz and close < tlR
        sx.tlRTouch := sx.tlRTouch + 1
    if close > tlR + tlz
        sx.tlRBroken := true
// tlSTouch starts at 2 — the two anchor pivots ARE two touches — so `>= 2` alone never gated
// anything. i_tlConfirm raises the bar to a third, confirming touch.
tlNeed = i_tlConfirm ? 3 : 2
ft.tlSupValid := not na(tlS) and sx.tlSTouch >= tlNeed
ft.tlResValid := not na(tlR) and sx.tlRTouch >= tlNeed
ft.atTLsup := ft.tlSupValid and low <= tlS + tlz and close >= tlS - tlz
ft.atTLres := ft.tlResValid and high >= tlR - tlz and close <= tlR + tlz

// M71 — IDM-1: time spent at the level before the break (bars touching level ± 0.5 ATR in the 10 bars before)
if (ft.breakUp or ft.breakDn) and not na(ctx.breakLvl)
    cntAt = 0
    for k = 1 to 10
        if high[k] >= ctx.breakLvl - atrV * 0.5 and low[k] <= ctx.breakLvl + atrV * 0.5
            cntAt += 1
    sx.brkTimeAt := cntAt
ft.brkTimeOk := sx.brkTimeAt >= i_idmTime

// ── L6 SETUPS — groups A–I (M01–M38). Feature-vector: each setup is ONE boolean over cd / st / ft ──
gM = "11 · Setups A–I (toggle)"
en_M01 = f_en(input.bool(true,  "M01 Breakout rejection trap", group = gM, inline = "a"), true)
en_M02 = f_en(input.bool(true,  "M02 Pin bar liquidity trap", group = gM, inline = "a"), true)
en_M03 = f_en(input.bool(false, "M03 Inside bar breakout", group = gM, inline = "b"), false)
en_M04 = f_en(input.bool(false, "M04 Doji move reversal", group = gM, inline = "b"), false)
en_M05 = f_en(input.bool(true,  "M05 Pin bar after breakout", group = gM, inline = "c"), true)
en_M06 = f_en(input.bool(false, "M06 Multi pin bars on pullback", group = gM, inline = "c"), false)
en_M07 = f_en(input.bool(false, "M07 Multi pin bars on impulse (trap)", group = gM, inline = "d"), false)
en_M08 = f_en(input.bool(true,  "M08 Pin bar on retracement", group = gM, inline = "d"), true)
en_M09 = f_en(input.bool(true,  "M09 Pin bar + liquidity", group = gM, inline = "e"), true)
en_M10 = f_en(input.bool(true,  "M10 Sweep reversal", group = gM, inline = "e"), true)
en_M11 = f_en(input.bool(false, "M11 Doji + breakout", group = gM, inline = "f"), false)
en_M12 = f_en(input.bool(false, "M12 Confluence zone", group = gM, inline = "f"), false)
en_M14 = f_en(input.bool(false, "M14 Pin bar after breakout (S/R)", group = gM, inline = "g"), false)
en_M15 = f_en(input.bool(true,  "M15 Breakout with pin bar", group = gM, inline = "g"), true)
en_M21 = f_en(input.bool(false, "M21 Resistance volume reversal", group = gM, inline = "h"), false)
en_M22 = f_en(input.bool(false, "M22 Real (high-volume) breakout", group = gM, inline = "h"), false)
en_M23 = f_en(input.bool(false, "M23 Volume-price divergence", group = gM, inline = "i"), false)
en_M24 = f_en(input.bool(false, "M24 Displacement trap (fake breakout)", group = gM, inline = "i"), false)
en_M25 = f_en(input.bool(false, "M25 FOMO trap", group = gM, inline = "j"), false)
en_M29 = f_en(input.bool(false, "M29 Strong move trap (no FVG)", group = gM, inline = "j"), false)
en_M33 = f_en(input.bool(true,  "M33 Zone flip model", group = gM, inline = "k"), true)
en_M36 = f_en(input.bool(true,  "M36 Weak retracement on OB", group = gM, inline = "k"), true)
en_M37 = f_en(input.bool(true,  "M37 Inducement block", group = gM, inline = "l"), true)
en_M38 = f_en(input.bool(false, "M38 Liquidity patterns P1–P7", group = gM, inline = "l"), false)
gN = "12 · Setup filters"
fl_M19 = input.bool(true,  "M19 suppress reversal after STRONG arrival", group = gN, inline = "n")
fl_M26 = input.bool(true,  "M26 pullback must be corrective (mixed)", group = gN, inline = "n")
fl_M31 = input.bool(false, "M31 retest body-size rule", group = gN, inline = "o")
fl_SwR = input.bool(true,  "§6.2 block reversal at touch≥2 unless swept", group = gN, inline = "o")
fl_50  = input.bool(true,  "§6.6 S&D 50% rule", group = gN)
fl_M01T = input.bool(true, "M01/M02 require the broken level to have been rejected ≥2×", group = gN)

// shorthand predicates (evaluated once)
revBull  = cd.pinBull or cd.engulfBull or cd.ifcBull or cd.manipBull
revBear  = cd.pinBear or cd.engulfBear or cd.ifcBear or cd.manipBear
strongRevBear = cd.pinBear or cd.engulfBear or (cd.longWickRej and cd.isBear)
strongRevBull = cd.pinBull or cd.engulfBull or (cd.longWickRej and cd.isBull)
atBullZone = ft.atDemand or ft.atSupport
atBearZone = ft.atSupply or ft.atResist
bullTrend  = st.trend == "BULLISH"
bearTrend  = st.trend == "BEARISH"
retrace    = st.movePhase == "RETRACEMENT"
// zone-quality gates shared by every reversal-at-zone setup
zoneOkBull = atBullZone and (not fl_SwR or not ft.zSweepReq or ft.sweptLow) and (not fl_50 or ft.zKind == "SR" or ft.zFifty)
zoneOkBear = atBearZone and (not fl_SwR or not ft.zSweepReq or ft.sweptHigh) and (not fl_50 or ft.zKind == "SR" or ft.zFifty)
arrOkBull  = not fl_M19 or not ft.arrivalStrong
arrOkBear  = arrOkBull
pbOk       = not fl_M26 or not ft.arrivalStrong or ft.arrivalMixed >= 0.35   // §M10
rtOk       = not fl_M31 or not (ft.zKind != "" and ft.retestValid == false and ctx.lastBOSAvgBody > 0)
brkWin     = ft.breakAgo >= 1 and ft.breakAgo <= 8
brkTouchOk = not fl_M01T or ft.brkTouches >= 2

// ── candidates: [cond, name, dir(+1/-1), base score, note] ───────────────────
// A — price action
s01 = en_M01 and ctx.breakDir == 1 and brkWin and brkTouchOk and ft.upWickInc and cd.isBear and cd.bodyRatio >= 0.5 and close < ctx.breakLvl
s02 = en_M02 and ctx.breakDir == 1 and brkWin and brkTouchOk and ft.upWickDec and (cd.pinBull or cd.engulfBull)
s01b = en_M01 and ctx.breakDir == -1 and brkWin and brkTouchOk and ft.dnWickInc and cd.isBull and cd.bodyRatio >= 0.5 and close > ctx.breakLvl
s02b = en_M02 and ctx.breakDir == -1 and brkWin and brkTouchOk and ft.dnWickDec and (cd.pinBear or cd.engulfBear)
// M03 — inside bar after breakout, entry on close beyond the inside bar (state kept in ctx.breakHi/Lo of the IB)
var float ibHigh = na
var float ibLow  = na
var int   ibDir  = 0
var int   ibBar  = -999
if ft.insideOk
    ibHigh := high
    ibLow  := low
    ibDir  := ctx.breakDir
    ibBar  := bar_index
s03  = en_M03 and ibDir == 1  and bar_index - ibBar >= 1 and bar_index - ibBar <= 5 and close > ibHigh
s03b = en_M03 and ibDir == -1 and bar_index - ibBar >= 1 and bar_index - ibBar <= 5 and close < ibLow
if s03 or s03b
    ibDir := 0
s04  = en_M04 and zoneOkBear and ft.zDepStrong and ft.dojiInLeg >= cfg.dojiCountMin and strongRevBear
s04b = en_M04 and zoneOkBull and ft.zDepStrong and ft.dojiInLeg >= cfg.dojiCountMin and strongRevBull
// B — pin bars
s05  = en_M05 and ctx.breakDir == 1  and ft.breakAgo == 1 and cd.pinBull
s05b = en_M05 and ctx.breakDir == -1 and ft.breakAgo == 1 and cd.pinBear
s06  = en_M06 and bullTrend and retrace and ft.pinBullInLeg >= cfg.pinCountMin and zoneOkBull and cd.pinBull
s06b = en_M06 and bearTrend and retrace and ft.pinBearInLeg >= cfg.pinCountMin and zoneOkBear and cd.pinBear
w07  = en_M07 and bullTrend and not retrace and ft.pinBullInLeg >= 2 and cd.pinBull
w07b = en_M07 and bearTrend and not retrace and ft.pinBearInLeg >= 2 and cd.pinBear
s07  = en_M07 and bullTrend and ft.pinBullInLeg >= 2 and (cd.starBear or cd.engulfBear)
s07b = en_M07 and bearTrend and ft.pinBearInLeg >= 2 and (cd.starBull or cd.engulfBull)
s08  = en_M08 and bullTrend and zoneOkBull and cd.pinBull
s08b = en_M08 and bearTrend and zoneOkBear and cd.pinBear
s09  = en_M09 and zoneOkBull and cd.pinBull and cd.dnWickRatio >= 0.65 and ft.bslAbove >= 2
s09b = en_M09 and zoneOkBear and cd.pinBear and cd.upWickRatio >= 0.65 and ft.sslBelow >= 2
// C — liquidity hunting (IMMEDIATE mode: sweep candle itself rejects)
s10  = en_M10 and ft.sweptLow  and (ft.sweptPool or ft.zKind != "") and cd.dnWickRatio >= cfg.sweepWickMin and close > ft.sweptPriceLo
s10b = en_M10 and ft.sweptHigh and (ft.sweptPool or ft.zKind != "") and cd.upWickRatio >= cfg.sweepWickMin and close < ft.sweptPriceHi
// D — S/R
var float dojiHi = na
var float dojiLo = na
var float dojiZt = na
var float dojiZb = na
var int   dojiBar = -999
if cd.doji and ft.zKind != ""
    dojiHi := high
    dojiLo := low
    dojiZt := ft.zTop
    dojiZb := ft.zBottom
    dojiBar := bar_index
s11  = en_M11 and bar_index - dojiBar == 1 and close > dojiHi and close > dojiZt
s11b = en_M11 and bar_index - dojiBar == 1 and close < dojiLo and close < dojiZb
// §M12: trendline and a flipped S/R overlap (both are "at price" here) — or a key level as fallback
s12  = en_M12 and zoneOkBull and ft.zFlipped and (ft.atTLsup or ft.zKl >= 3) and revBull
s12b = en_M12 and zoneOkBear and ft.zFlipped and (ft.atTLres or ft.zKl >= 3) and revBear
s14  = en_M14 and ctx.breakDir == 1  and ft.breakAgo == 1 and low  < ctx.breakLvl and cd.pinBull and close > ctx.breakLvl
s14b = en_M14 and ctx.breakDir == -1 and ft.breakAgo == 1 and high > ctx.breakLvl and cd.pinBear and close < ctx.breakLvl
s15  = en_M15 and ft.breakPinBull
s15b = en_M15 and ft.breakPinBear
// E — volume
s21  = en_M21 and zoneOkBear and ft.zDepStrong and ft.arrivalWeak and revBear and ft.volHigh
s21b = en_M21 and zoneOkBull and ft.zDepStrong and ft.arrivalWeak and revBull and ft.volHigh
s22  = en_M22 and ft.breakUp and cd.isBull and cd.bodyRatio >= 0.6 and ft.volHigh and not ctx.arrivalStrong
s22b = en_M22 and ft.breakDn and cd.isBear and cd.bodyRatio >= 0.6 and ft.volHigh and not ctx.arrivalStrong
s23  = en_M23 and bullTrend and retrace and ft.volSlopeNeg and zoneOkBull and revBull
s23b = en_M23 and bearTrend and retrace and ft.volSlopeNeg and zoneOkBear and revBear
w24  = en_M24 and ft.breakUp and ft.volHigh and ctx.arrivalStrong and bar_index - ctx.arrivalBar <= 10
w24b = en_M24 and ft.breakDn and ft.volHigh and ctx.arrivalStrong and bar_index - ctx.arrivalBar <= 10
var int trap24 = 0
var int trap24Bar = -999
if w24 or w24b
    trap24 := w24 ? 1 : -1
    trap24Bar := bar_index
s24  = en_M24 and trap24 == 1  and bar_index - trap24Bar >= 1 and bar_index - trap24Bar <= 3 and (revBear or close < ctx.breakLvl)
s24b = en_M24 and trap24 == -1 and bar_index - trap24Bar >= 1 and bar_index - trap24Bar <= 3 and (revBull or close > ctx.breakLvl)
// consume: `close < breakLvl` is a level, not an event, so without this the trap stayed true for the
// whole 3-bar window and emitted the same signal three times
if s24 or s24b
    trap24 := 0
w25  = en_M25 and ft.greenRun >= 3 and cd.largeRange and ft.volHigh and not st.bullBOS
w25b = en_M25 and ft.redRun >= 3 and cd.largeRange and ft.volHigh and not st.bearBOS
var int fomo = 0
var int fomoBar = -999
if w25 or w25b
    fomo := w25 ? 1 : -1
    fomoBar := bar_index
s25  = en_M25 and fomo == 1  and bar_index - fomoBar >= 1 and bar_index - fomoBar <= 4 and (cd.pinBear or cd.engulfBear)
s25b = en_M25 and fomo == -1 and bar_index - fomoBar >= 1 and bar_index - fomoBar <= 4 and (cd.pinBull or cd.engulfBull)
if s25 or s25b
    fomo := 0
// F — structure hacks
w29  = en_M29 and st.bullBOS and not mv.strong and cd.largeRange
w29b = en_M29 and st.bearBOS and not mv.strong and cd.largeRange
s29  = en_M29 and ctx.lastBOSBar > 0 and bar_index - ctx.lastBOSBar >= 1 and bar_index - ctx.lastBOSBar <= 5 and not ctx.lastDepStrong and ctx.breakDir == 1 and revBear
s29b = en_M29 and ctx.lastBOSBar > 0 and bar_index - ctx.lastBOSBar >= 1 and bar_index - ctx.lastBOSBar <= 5 and not ctx.lastDepStrong and ctx.breakDir == -1 and revBull
// G — zone flip
s33  = en_M33 and zoneOkBull and ft.zFlipped and ft.zDepStrong and ft.arrivalWeak and revBull and bullTrend and ft.htfBias == "BULL"
s33b = en_M33 and zoneOkBear and ft.zFlipped and ft.zDepStrong and ft.arrivalWeak and revBear and bearTrend and ft.htfBias == "BEAR"
// H — order blocks
obBull = zoneOkBull and (ft.zKind == "OB" or ft.zKind == "BRK")
obBear = zoneOkBear and (ft.zKind == "OB" or ft.zKind == "BRK")
s36  = en_M36 and obBull and ft.arrivalWeak and (cd.engulfBull or cd.pinBull or ft.sweptLow)
s36b = en_M36 and obBear and ft.arrivalWeak and (cd.engulfBear or cd.pinBear or ft.sweptHigh)
s37  = en_M37 and obBull and ft.zIdm and revBull
s37b = en_M37 and obBear and ft.zIdm and revBear
// I — liquidity patterns (M38)
p1   = en_M38 and ft.breakUp and mv.strong and not ctx.arrivalStrong                       // real: weak approach → strong breakout
p2   = en_M38 and ft.breakUp and not mv.strong and ctx.arrivalStrong                       // fake: strong expansion → weak breakout
p3   = en_M38 and ctx.breakDir == 1 and brkWin and ft.wickLowerDom and revBear              // lower-wick trap
p4   = en_M38 and ctx.breakDir == 1 and brkWin and ft.hiddenBSL and zoneOkBull and revBull  // shadow-high liquidity
p5   = en_M38 and ctx.breakDir == 1 and brkWin and ft.wickUpperDom and revBear              // weak breakout trap
p7   = en_M38 and ctx.breakDir == 1 and brkWin and ft.atSupply and not ctx.lastDepStrong and revBear
p1b  = en_M38 and ft.breakDn and mv.strong and not ctx.arrivalStrong
p2b  = en_M38 and ft.breakDn and not mv.strong and ctx.arrivalStrong
p3b  = en_M38 and ctx.breakDir == -1 and brkWin and ft.wickUpperDom and revBull
p4b  = en_M38 and ctx.breakDir == -1 and brkWin and ft.hiddenSSL and zoneOkBear and revBear
p5b  = en_M38 and ctx.breakDir == -1 and brkWin and ft.wickLowerDom and revBull
p7b  = en_M38 and ctx.breakDir == -1 and brkWin and ft.atDemand and not ctx.lastDepStrong and revBull
// P6 — structural trap: the leg stepped into the level through several swings, so liquidity is stacked behind it
p6   = en_M38 and ft.breakDn and ft.swLoInLeg >= 2 and cd.isBear and cd.bodyRatio >= 0.5
p6b  = en_M38 and ft.breakUp and ft.swHiInLeg >= 2 and cd.isBull and cd.bodyRatio >= 0.5

// ── score & pick the best LONG and best SHORT (one signal per side per bar) ──
liqBonusL = ft.bslAbove >= 1 ? 1 : 0
liqBonusS = ft.sslBelow >= 1 ? 1 : 0
m20L = ft.zDepStrong and ft.arrivalWeak ? 2 : 0
m20S = m20L
hpB  = ft.zHp ? 1 : 0

// strictly greater, so an equal score keeps the earlier candidate (see the M13 note in the header)
f_bid(b, cond, name, sc, note) =>
    if cond and sc > b.s
        b.n := name
        b.s := sc
        b.t := note

bL = Best.new()
bS = Best.new()

// LONG candidates
f_bid(bL, s02 and arrOkBull, "M02", 4 + liqBonusL, "Pin-bar liquidity trap: shrinking upper wicks after breakout → LONG, TP = jammed liquidity above")
f_bid(bL, s01b and arrOkBull, "M01", 4 + liqBonusL, "Breakout rejection trap (mirror): growing lower wicks then strong close back above")
f_bid(bL, s03, "M03", 3 + liqBonusL, "Inside-bar breakout: close above the inside bar (IB held above 50% of breakout candle)")
f_bid(bL, s04b and arrOkBull and pbOk, "M04", 3 + (bullTrend ? 1 : 0) + m20L, "Doji move reversal at strong level: weak arrival (dojis) + reversal candle")
f_bid(bL, s05, "M05", 3 + liqBonusL, "Pin bar right after breakout: flipped support held")
f_bid(bL, s06 and arrOkBull and pbOk, "M06", 4 + m20L + liqBonusL, "Multiple pin bars on pullback + pin bar at support/demand")
f_bid(bL, s07b, "M07", 3, "Multi pin bars on impulse → liquidity built above, reversal candle at top (counter-trend)")
f_bid(bL, s08 and arrOkBull and pbOk and rtOk, "M08", 3 + m20L + liqBonusL, "Trend + support/demand + bullish pin bar")
f_bid(bL, s09 and arrOkBull, "M09", 6 + m20L, "HIGH QUALITY: strong pin bar at level with ≥2 liquidity targets above")
f_bid(bL, s10, "M10", 5 + liqBonusL, "Liquidity SWEEP reversal (IMMEDIATE): swept " + ft.sweptKindLo + ", closed back above. SL below sweep low")
f_bid(bL, s11, "M11", 3, "Doji at level + next candle broke doji high AND the level")
f_bid(bL, s12 and arrOkBull, "M12", 4 + m20L, "Confluence: flipped zone + key level + reversal candle")
f_bid(bL, s14, "M14", 3 + liqBonusL, "Dip below flipped level, rejection, bullish pin close → breakout confirmed")
f_bid(bL, s15, "M15", 4 + liqBonusL, "Breakout candle is itself a bullish pin bar (took liquidity below first)")
f_bid(bL, s21b and arrOkBull, "M21", 6, "Support volume reversal: strong departure, weak arrival, reversal candle + high volume")
f_bid(bL, s22, "M22", 4 + (ft.brkTimeOk ? 1 : 0), "REAL breakout: weak approach, strong body + volume spike")
f_bid(bL, s23 and arrOkBull, "M23", 3 + m20L, "Volume fading on pullback + reversal at support (real pullback)")
f_bid(bL, s24b, "M24", 4, "Displacement trap reversed: fake breakdown after strong arrival → LONG")
f_bid(bL, s25b, "M25", 3, "FOMO trap (mirror): exhaustion sell-off, reversal candle")
f_bid(bL, s29b, "M29", 3, "Strong-move trap: big candles without FVG → reversal, TP = their highs")
f_bid(bL, s33 and rtOk, "M33", 6 + liqBonusL, "Zone flip model: strong breakout → weak retest → refusal, trend + HTF aligned")
f_bid(bL, s36 and pbOk, "M36", 5 + hpB + liqBonusL, "Weak retracement into valid OB + bullish reversal")
f_bid(bL, s37, "M37", 7 + hpB + liqBonusL, "Inducement block: EQL swept before the OB tap + reversal (highest quality)")
f_bid(bL, p1, "M38-P1", 4, "Compression→expansion: real breakout with imbalance — buy the retest")
f_bid(bL, p4 and arrOkBull, "M38-P4", 4, "Shadow-high liquidity above (long upper wicks, no break) + support retest")
f_bid(bL, p3b or p5b, "M38-P3/5", 3, "Wick-bias trap during breakdown → reversal LONG")
f_bid(bL, p2b or p7b, "M38-P2/7", 4, "Fake breakdown (weak move / demand right below) → LONG")
f_bid(bL, p6b, "M38-P6", 4, "Structural breakout trap (mirror): several swing highs stepped into the level → liquidity above → LONG on the close through")

// SHORT candidates
f_bid(bS, s01 and arrOkBear, "M01", 4 + liqBonusS, "Breakout rejection trap: growing upper wicks after breakout, strong close back below → SHORT")
f_bid(bS, s02b and arrOkBear, "M02", 4 + liqBonusS, "Pin-bar liquidity trap (mirror): shrinking lower wicks → SHORT")
f_bid(bS, s03b, "M03", 3 + liqBonusS, "Inside-bar breakdown: close below the inside bar")
f_bid(bS, s04 and arrOkBear and pbOk, "M04", 3 + (bearTrend ? 1 : 0) + m20S, "Doji move reversal at strong resistance")
f_bid(bS, s05b, "M05", 3 + liqBonusS, "Pin bar right after breakdown")
f_bid(bS, s06b and arrOkBear and pbOk, "M06", 4 + m20S + liqBonusS, "Multiple pin bars on pullback + pin bar at resistance/supply")
f_bid(bS, s07, "M07", 3, "Multi pin bars on impulse → liquidity below, shooting star / engulfing at top")
f_bid(bS, s08b and arrOkBear and pbOk and rtOk, "M08", 3 + m20S + liqBonusS, "Trend + resistance/supply + bearish pin bar")
f_bid(bS, s09b and arrOkBear, "M09", 6 + m20S, "HIGH QUALITY: strong pin bar at level with ≥2 liquidity targets below")
f_bid(bS, s10b, "M10", 5 + liqBonusS, "Liquidity SWEEP reversal (IMMEDIATE): swept " + ft.sweptKindHi + ", closed back below. SL above sweep high")
f_bid(bS, s11b, "M11", 3, "Doji at level + next candle broke doji low AND the level")
f_bid(bS, s12b and arrOkBear, "M12", 4 + m20S, "Confluence: flipped zone + key level + reversal candle")
f_bid(bS, s14b, "M14", 3 + liqBonusS, "Pop above flipped level, rejection, bearish pin close")
f_bid(bS, s15b, "M15", 4 + liqBonusS, "Breakdown candle is itself a bearish pin bar")
f_bid(bS, s21 and arrOkBear, "M21", 6, "Resistance volume reversal")
f_bid(bS, s22b, "M22", 4 + (ft.brkTimeOk ? 1 : 0), "REAL breakdown: weak approach, strong body + volume spike")
f_bid(bS, s23b and arrOkBear, "M23", 3 + m20S, "Volume fading on pullback + reversal at resistance")
f_bid(bS, s24, "M24", 4, "Displacement trap: high-volume breakout after STRONG arrival → smart money exit → SHORT")
f_bid(bS, s25, "M25", 3, "FOMO trap: ≥3 green + spike + no BOS → reversal candle")
f_bid(bS, s29, "M29", 3, "Strong-move trap: big candles without FVG → reversal, TP = their lows")
f_bid(bS, s33b and rtOk, "M33", 6 + liqBonusS, "Zone flip model (bearish)")
f_bid(bS, s36b and pbOk, "M36", 5 + hpB + liqBonusS, "Weak retracement into valid bearish OB + reversal")
f_bid(bS, s37b, "M37", 7 + hpB + liqBonusS, "Inducement block (bearish): EQH swept before OB tap")
f_bid(bS, p1b, "M38-P1", 4, "Compression→expansion breakdown with imbalance — sell the retest")
f_bid(bS, p4b and arrOkBear, "M38-P4", 4, "Shadow-low liquidity below + resistance retest")
f_bid(bS, p3 or p5, "M38-P3/5", 3, "Wick-bias trap during breakout → reversal SHORT")
f_bid(bS, p2 or p7, "M38-P2/7", 4, "Fake breakout (weak move / supply right above) → SHORT")
f_bid(bS, p6, "M38-P6", 4, "Structural breakout trap: several swing lows stepped into the level → liquidity below → SHORT on the close through")

// warnings (not trades) — priority label only
warnUp = w07 ? "⚠M07 liq below" : w25 ? "⚠M25 FOMO" : w29 ? "⚠M29 weak move" : w24 ? "⚠M24 trap?" : ft.runUp and en_M10 and (d_liqAll or ft.runMajor) ? "RUN — avoid" : ""
warnDn = w07b ? "⚠M07 liq above" : w25b ? "⚠M25 FOMO" : w29b ? "⚠M29 weak move" : w24b ? "⚠M24 trap?" : ft.runDn and en_M10 and (d_liqAll or ft.runMajor) ? "RUN — avoid" : ""

// ── L6 SETUPS — groups J–R (M39–M54). bids into the same bL / bS accumulators ──
gM2 = "13 · Setups J–R (toggle)"
en_M39 = f_en(input.bool(true,  "M39 Reclaimed block retest", group = gM2, inline = "a"), true)
en_M40 = f_en(input.bool(true,  "M40 Rejection block retest", group = gM2, inline = "a"), true)
en_M41 = f_en(input.bool(true,  "M41 Sweep + FVG confluence", group = gM2, inline = "b"), true)
en_M42 = f_en(input.bool(true,  "M42 High-probability S&D", group = gM2, inline = "b"), true)
en_M43 = f_en(input.bool(false, "M43 Hidden liquidity reversal", group = gM2, inline = "c"), false)
en_M44 = f_en(input.bool(false, "M44 Key level approach (C1/C2/C3)", group = gM2, inline = "c"), false)
en_M45 = f_en(input.bool(true,  "M45 Sweep-based CHoCH retest", group = gM2, inline = "d"), true)
en_M46 = f_en(input.bool(true,  "M46 CISD setup", group = gM2, inline = "d"), true)
en_M47 = f_en(input.bool(false, "M47 Manipulated breakout (sweep of HH)", group = gM2, inline = "e"), false)
en_M48 = f_en(input.bool(false, "M48 Fake CHoCH (HTF still aligned)", group = gM2, inline = "e"), false)
en_M49 = f_en(input.bool(false, "M49 Internal liquidity gap", group = gM2, inline = "f"), false)
en_M50 = f_en(input.bool(false, "M50 Range manipulation", group = gM2, inline = "f"), false)
en_M51 = f_en(input.bool(true,  "M51 Smart BOS model", group = gM2, inline = "g"), true)
en_M52 = f_en(input.bool(false, "M52 Smart reversal model", group = gM2, inline = "g"), false)
en_M53 = f_en(input.bool(false, "M53 Smart pullback trap", group = gM2, inline = "h"), false)
en_M54 = f_en(input.bool(true,  "M54 Smart S&D trap", group = gM2, inline = "h"), true)
armed(dirWant, dirHave, atBar) => dirHave == dirWant and bar_index - atBar >= 1 and bar_index - atBar <= cfg.armBars
// §M7 — M45 accepts both encodings: ±1 (sweep + BOS) and ±2 (sweep + real CHoCH, the stronger form)
armedSw(dirWant, dirHave, atBar) => (dirHave == dirWant or dirHave == dirWant * 2) and bar_index - atBar >= 1 and bar_index - atBar <= cfg.armBars
reactBull = zoneOkBull or ft.atBullFvg
reactBear = zoneOkBear or ft.atBearFvg
recentHi  = ctx.rangeBrkBar > 0 and bar_index - ctx.rangeBrkBar <= cfg.armBars

// J — ICT blocks (zone engine already validated them; entry = retest + reversal)
s39  = en_M39 and zoneOkBull and ft.zKind == "RCB" and revBull
s39b = en_M39 and zoneOkBear and ft.zKind == "RCB" and revBear
s40  = en_M40 and zoneOkBull and ft.zKind == "RJB" and revBull
s40b = en_M40 and zoneOkBear and ft.zKind == "RJB" and revBear
// K — sweep + FVG (armed by 05: strong move with FVG after the sweep)
s41  = en_M41 and armed(1, ctx.m41Dir, ctx.m41Bar)  and reactBull and revBull
s41b = en_M41 and armed(-1, ctx.m41Dir, ctx.m41Bar) and reactBear and revBear
w41  = en_M41 and (ctx.m41Dir == 9 or ctx.m41Dir == -9) and bar_index == ctx.m41Bar
// L — high-probability S&D (5 criteria live in the zone: OB with depStrong, 50% rule, unmitigated) + strongest variant ★★
s42  = en_M42 and zoneOkBull and ft.zKind == "OB" and ft.zDepStrong and ft.zFifty and ft.arrivalWeak and revBull
s42b = en_M42 and zoneOkBear and ft.zKind == "OB" and ft.zDepStrong and ft.zFifty and ft.arrivalWeak and revBear
// M — hidden liquidity: liquidity building below → at a level expect DOWN move, fade the breakout
s43b = en_M43 and bar_index - ctx.hidSSLBar <= cfg.armBars and ctx.hidSSLBar >= 0 and atBearZone and revBear
s43  = en_M43 and bar_index - ctx.hidBSLBar <= cfg.armBars and ctx.hidBSLBar >= 0 and atBullZone and revBull
// N — key level approach (KL ≥ 3): C1 choppy arrival · C2 liquidity build-up (trend into the level) · C3 depletion
klBear = zoneOkBear and ft.zKl >= 3
klBull = zoneOkBull and ft.zKl >= 3
s44b = en_M44 and klBear and revBear and (ft.arrivalWeak or bullTrend or ft.rangeShrink)
s44  = en_M44 and klBull and revBull and (ft.arrivalWeak or bearTrend or ft.rangeShrink)
// O — sweep-based CHoCH → retest at breaker / OB
s45  = en_M45 and armedSw(1, ctx.m45Dir, ctx.m45Bar)  and zoneOkBull and (ft.zKind == "BRK" or ft.zKind == "OB") and revBull
s45b = en_M45 and armedSw(-1, ctx.m45Dir, ctx.m45Bar) and zoneOkBear and (ft.zKind == "BRK" or ft.zKind == "OB") and revBear
m45Strong = math.abs(ctx.m45Dir) == 2
// P — CISD (armed with ≥1 reliability condition) → reversal at breaker / OB / FVG (harami counts here)
s46  = en_M46 and armed(1, ctx.m46Dir, ctx.m46Bar)  and reactBull and (revBull or cd.harami)
s46b = en_M46 and armed(-1, ctx.m46Dir, ctx.m46Bar) and reactBear and (revBear or cd.harami)
// Q — smart money manipulation
s47b = en_M47 and bullTrend and st.bullSweep and cd.upWickRatio >= cfg.sweepWickMin
s47  = en_M47 and bearTrend and st.bearSweep and cd.dnWickRatio >= cfg.sweepWickMin
s48  = en_M48 and armed(1, ctx.m48Dir, ctx.m48Bar)  and zoneOkBull and (ft.zKind == "OB" or ft.zKind == "BRK") and revBull
s48b = en_M48 and armed(-1, ctx.m48Dir, ctx.m48Bar) and zoneOkBear and (ft.zKind == "OB" or ft.zKind == "BRK") and revBear
// §M49: the swept low must be INTERNAL (inside the leg, above the major low) — not any swing low
s49  = en_M49 and bullTrend and ft.intSweptBull and reactBull and revBull
s49b = en_M49 and bearTrend and ft.intSweptBear and reactBear and revBear
// the manipulation leg of a LONG range-trap is a stop hunt BELOW the range -> sweptLow (M53 below
// has the same shape and gets it right); the zone terms were already polarised correctly
s50  = en_M50 and bullTrend and recentHi and ctx.rangeBrkDir == -1 and (ft.atDemand or (ft.sweptLow and reactBull)) and revBull
s50b = en_M50 and bearTrend and recentHi and ctx.rangeBrkDir == 1  and (ft.atSupply or (ft.sweptHigh and reactBear)) and revBear
// R — golden strategies
s51  = en_M51 and bullTrend and ctx.lastDepStrong and bar_index - ctx.lastBOSBar <= 40 and zoneOkBull and revBull
s51b = en_M51 and bearTrend and ctx.lastDepStrong and bar_index - ctx.lastBOSBar <= 40 and zoneOkBear and revBear
w51  = en_M51 and st.bullBOS and not mv.strong
w51b = en_M51 and st.bearBOS and not mv.strong
s52b = en_M52 and armed(-1, ctx.m52Dir, ctx.m52Bar) and reactBear and revBear
s52  = en_M52 and armed(1, ctx.m52Dir, ctx.m52Bar)  and reactBull and revBull
s53  = en_M53 and bearTrend and recentHi and ctx.rangeBrkDir == -1 and (ft.sweptLow or (not na(ctx.curLow) and low <= ctx.curLow + atrV * 0.2)) and revBull
s53alt = en_M53 and i_m53Alt and bearTrend and ctx.rangeBrkDir == 1 and bar_index == ctx.rangeBrkBar and cd.isBull
s53b = en_M53 and bullTrend and recentHi and ctx.rangeBrkDir == 1 and (ft.sweptHigh or (not na(ctx.curHigh) and high >= ctx.curHigh - atrV * 0.2)) and revBear
s54  = en_M54 and ctx.m54Stage == 3 and zoneOkBull and revBull
s54b = en_M54 and ctx.m54StageB == 3 and zoneOkBear and revBear
// consume the latch: without this the machine stays at stage 3 and re-fires M54 on every zone
// touch until the timeout (every other multi-step setup in the build consumes its latch too)
if s54
    ctx.m54Stage := 0
if s54b
    ctx.m54StageB := 0

// continue the LONG bids
f_bid(bL, s39 and arrOkBull, "M39", 5 + liqBonusL, "Reclaimed block retest + bullish reversal")
f_bid(bL, s40, "M40", 4 + liqBonusL, "Rejection block (wick zone) retest + reversal")
f_bid(bL, s41, "M41", 6 + liqBonusL, "Sweep + FVG confluence: low swept, STRONG move left FVG, retrace reversal")
f_bid(bL, s42, "M42", 6 + (ft.zNearSwept ? 2 : 0) + hpB, "High-probability demand: strong departure · 50% tapped · weak arrival" + (ft.zNearSwept ? " · ★★ near-miss then sweep (strongest)" : ""))
f_bid(bL, s43, "M43", 4, "Hidden BUY-side liquidity above → fade the breakdown at a level")
f_bid(bL, s44 and arrOkBull, "M44", 5 + m20L, "Key level approach: choppy / build-up / depletion → reversal")
f_bid(bL, s45, "M45", 6 + liqBonusL + (m45Strong ? 1 : 0), "Sweep → BOS/CHoCH → breaker/OB retest (★ = the CHoCH form, +1)")
f_bid(bL, s46, "M46", 5 + liqBonusL + (ft.cisdRel >= 2 ? 1 : 0), "CISD (early reversal) with reliability → zone reaction. SL beyond zone")
f_bid(bL, s47, "M47", 3, "Manipulated breakdown: sweep candle below LL in bearish trend → LONG, TP nearest reaction zone (trail after TP1)")
f_bid(bL, s48, "M48", 5, "Fake CHoCH: LTF broke major low but HTF still BULL (inducement) → OB rejection LONG")
f_bid(bL, s49, "M49", 4 + liqBonusL, "Internal liquidity gap: internal low swept, reaction zone reversal")
f_bid(bL, s50, "M50", 5, "Range manipulation: range broke DOWN against trend → OB / FVG reversal. TP = external liquidity above range")
f_bid(bL, s51 and pbOk, "M51", 5 + liqBonusL, "Smart BOS: aggressive BOS with FVG → OB/support retest")
f_bid(bL, s52, "M52", 5, "Smart reversal (mirror): demand rejection → CHoCH up → retrace reversal")
f_bid(bL, s53 or s53alt, "M53", s53alt ? 3 : 5, s53alt ? "Smart pullback trap — alternative range break-UP entry" : "Smart pullback trap: bearish pullback → range → break down → reversal at recent low")
f_bid(bL, s54, "M54", 6 + liqBonusL, "Smart S&D trap: demand reject → stop hunt → BOS up → retrace reversal")

// continue the SHORT bids
f_bid(bS, s39b and arrOkBear, "M39", 5 + liqBonusS, "Reclaimed block retest + bearish reversal")
f_bid(bS, s40b, "M40", 4 + liqBonusS, "Rejection block (wick zone) retest + reversal")
f_bid(bS, s41b, "M41", 6 + liqBonusS, "Sweep + FVG confluence: high swept, STRONG move left FVG, retrace reversal")
f_bid(bS, s42b, "M42", 6 + (ft.zNearSwept ? 2 : 0) + hpB, "High-probability supply: strong departure · 50% tapped · weak arrival" + (ft.zNearSwept ? " · ★★ near-miss then sweep (strongest)" : ""))
f_bid(bS, s43b, "M43", 4, "Hidden SELL-side liquidity below → fade the breakout at a level, TP = those lows")
f_bid(bS, s44b and arrOkBear, "M44", 5 + m20S, "Key level approach: choppy / build-up / depletion → reversal")
f_bid(bS, s45b, "M45", 6 + liqBonusS + (m45Strong ? 1 : 0), "Sweep → BOS/CHoCH → breaker/OB retest (★ = the CHoCH form, +1)")
f_bid(bS, s46b, "M46", 5 + liqBonusS + (ft.cisdRel >= 2 ? 1 : 0), "CISD (early reversal) with reliability → zone reaction. SL beyond zone")
f_bid(bS, s47b, "M47", 3, "Manipulated breakout: sweep candle above HH in bullish trend → SHORT, TP nearest reaction zone (trail after TP1)")
f_bid(bS, s48b, "M48", 5, "Fake CHoCH (mirror): LTF broke major high but HTF still BEAR → OB rejection SHORT")
f_bid(bS, s49b, "M49", 4 + liqBonusS, "Internal liquidity gap (mirror)")
f_bid(bS, s50b, "M50", 5, "Range manipulation (mirror): range broke UP against trend → supply / FVG reversal")
f_bid(bS, s51b and pbOk, "M51", 5 + liqBonusS, "Smart BOS (bearish): aggressive BOS with FVG → OB/resistance retest")
f_bid(bS, s52b, "M52", 5, "Smart reversal: supply rejection → CHoCH down → retrace to FVG/supply/OB → SHORT")
f_bid(bS, s53b, "M53", 5, "Smart pullback trap (mirror)")
f_bid(bS, s54b, "M54", 6 + liqBonusS, "Smart S&D trap (mirror): supply reject → stop hunt → BOS down → retrace")

// extra warnings from J–R
warnUp := warnUp != "" ? warnUp : w41 and ctx.m41Dir == 9 ? "M41 NO TRADE (no FVG)" : w51 ? "⚠M51 weak BOS — consolidation risk" : ""
warnDn := warnDn != "" ? warnDn : w41 and ctx.m41Dir == -9 ? "M41 NO TRADE (no FVG)" : w51b ? "⚠M51 weak BOS — consolidation risk" : ""

// ── L6 SETUPS — groups S–AB (M58–M73), bidding into the same bL / bS accumulators ──
gM3 = "15 · Setups S–AB (toggle)"
en_M58 = f_en(input.bool(true,  "M58 Double top / bottom", group = gM3, inline = "b"), true)
en_M62 = f_en(input.bool(true,  "M62 Fakeout trap", group = gM3, inline = "d"), true)
en_M63 = f_en(input.bool(false, "M63 Direct breakout (no retest)", group = gM3, inline = "d"), false)
en_M64 = f_en(input.bool(true,  "M64 Auto trendline (draw)", group = gM3, inline = "e"), true)
en_M65 = f_en(input.bool(false, "M65 Trendline + flipped level", group = gM3, inline = "e"), false)
en_M68 = f_en(input.bool(true,  "M68 HTF sweep → LTF entry", group = gM3, inline = "f"), true)
en_M69 = f_en(input.bool(true,  "M69 IFC candle", group = gM3, inline = "g"), true)
en_M70 = f_en(input.bool(true,  "M70 Quasimodo", group = gM3, inline = "g"), true)
en_M72 = f_en(input.bool(true,  "M72 Operator trap (consolidation after breakout)", group = gM3, inline = "h"), true)
en_M73 = f_en(input.bool(true,  "M73 Propulsion Block (ICT)", group = gM3, inline = "i"), true)
gP = "16 · S–AB parameters"
i_dtTol   = input.float(0.15, "Double top tolerance × ATR", minval = 0.05, step = 0.05, group = gP, inline = "p1")
i_consMin = input.int(4,    "M72 consolidation min bars", minval = 2, group = gP, inline = "p3")
i_consMax = input.float(1.5, "M72 consolidation max width × ATR", minval = 0.5, step = 0.25, group = gP, inline = "p3")
i_noRetest = input.int(8,   "M63 no-retest window (bars)", minval = 3, group = gP)

// ── state machines / features for S–AB (global, once per bar) ────────────────

// M58 — double top / bottom on consecutive pivots; neckline = intervening swing
if st.swingHigh and not na(ctx.prevHigh) and math.abs(ctx.curHigh - ctx.prevHigh) <= atrV * i_dtTol and ctx.curLowIdx > ctx.prevHighIdx
    sx.dtDir  := -1
    sx.dtBar  := bar_index
    sx.dtNeck := ctx.curLow
if st.swingLow and not na(ctx.prevLow) and math.abs(ctx.curLow - ctx.prevLow) <= atrV * i_dtTol and ctx.curHighIdx > ctx.prevLowIdx
    sx.dtDir  := 1
    sx.dtBar  := bar_index
    sx.dtNeck := ctx.curHigh
if sx.dtDir != 0 and bar_index - sx.dtBar > cfg.armBars * 2
    sx.dtDir := 0

// M62 — fakeout: break then back inside within 1–2 bars → armed to fade on level tap
if ft.fakeBreak or (ft.breakAgo == 2 and not na(ctx.breakLvl) and ((ctx.breakDir == 1 and close < ctx.breakLvl) or (ctx.breakDir == -1 and close > ctx.breakLvl)))
    sx.m62Dir := -ctx.breakDir
    sx.m62Bar := bar_index
    sx.m62Lvl := ctx.breakLvl
tapM62 = sx.m62Dir != 0 and bar_index - sx.m62Bar >= 1 and bar_index - sx.m62Bar <= cfg.armBars and math.abs(close - sx.m62Lvl) <= tlz

// M63 — direct breakout: no return within noRetest bars → level becomes high-probability rejection
if ft.breakUp or ft.breakDn
    sx.dbDir  := 0
    sx.dbNear := false
if ft.breakAgo >= 1 and ft.breakAgo <= i_noRetest and not na(ctx.breakLvl) and math.abs(close - ctx.breakLvl) <= atrV * 0.3
    sx.dbNear := true
if ft.breakAgo == i_noRetest and not sx.dbNear and not na(ctx.breakLvl)
    sx.dbDir := ctx.breakDir
    sx.dbLvl := ctx.breakLvl
    sx.dbBar := bar_index
tapM63 = sx.dbDir != 0 and bar_index - sx.dbBar <= cfg.armBars * 3 and low <= sx.dbLvl + tlz and high >= sx.dbLvl - tlz
if sx.dbDir != 0 and ((sx.dbDir == 1 and close < sx.dbLvl - atrV) or (sx.dbDir == -1 and close > sx.dbLvl + atrV))
    sx.dbDir := 0

var line tlSupLn = na
var line tlResLn = na
if en_M64 and barstate.isconfirmed
    if ft.tlSupValid
        line.delete(tlSupLn)
        tlSx1c = f_xb(sx.tlSx1)
        tlSupLn := line.new(tlSx1c, sx.tlSy1 + slopeS * (tlSx1c - sx.tlSx1), bar_index, tlS, color = color.new(vis.bull, 30), style = line.style_solid, width = 2, extend = extend.right)
    else if not na(tlSupLn) and sx.tlSBroken
        line.set_extend(tlSupLn, extend.none)
        line.set_color(tlSupLn, color.new(vis.inv, 60))
    if ft.tlResValid
        line.delete(tlResLn)
        tlRx1c = f_xb(sx.tlRx1)
        tlResLn := line.new(tlRx1c, sx.tlRy1 + slopeR * (tlRx1c - sx.tlRx1), bar_index, tlR, color = color.new(vis.bear, 30), style = line.style_solid, width = 2, extend = extend.right)
    else if not na(tlResLn) and sx.tlRBroken
        line.set_extend(tlResLn, extend.none)
        line.set_color(tlResLn, color.new(vis.inv, 60))

// M65 — trendline + flipped/key level confluence → reversal → entry when the short-term counter move breaks
if ft.atTLsup and (ft.zFlipped or ft.zKl >= 3) and atBullZone and revBull
    sx.m65Dir := 1
    sx.m65Bar := bar_index
    sx.m65Ref := high
if ft.atTLres and (ft.zFlipped or ft.zKl >= 3) and atBearZone and revBear
    sx.m65Dir := -1
    sx.m65Bar := bar_index
    sx.m65Ref := low
// §M65 step 3: the short-term counter trendline — every lower high (bull) / higher low (bear)
// during the pullback pulls the break level in, so entry = break of that line, not of one candle
if sx.m65Dir == 1 and bar_index > sx.m65Bar and high < sx.m65Ref
    sx.m65Ref := high
if sx.m65Dir == -1 and bar_index > sx.m65Bar and low > sx.m65Ref
    sx.m65Ref := low
trg65  = sx.m65Dir == 1  and bar_index - sx.m65Bar >= 1 and bar_index - sx.m65Bar <= 6 and close > sx.m65Ref
trg65b = sx.m65Dir == -1 and bar_index - sx.m65Bar >= 1 and bar_index - sx.m65Bar <= 6 and close < sx.m65Ref
if trg65 or trg65b or bar_index - sx.m65Bar > 6
    sx.m65Dir := 0

// M68 — §7.4: HTF sweep + LTF CHoCH → armed → reaction zone + reversal
if ft.htfSweepDn and st.bullCHoCH
    sx.m68Dir := 1
    sx.m68Bar := bar_index
if ft.htfSweepUp and st.bearCHoCH
    sx.m68Dir := -1
    sx.m68Bar := bar_index

// M69 — IFC candle at a zone → entry on close beyond IFC high/low within 10 bars (§2.3)
if cd.ifcBull and (atBullZone or ft.sweptLow)
    sx.ifcDir := 1
    sx.ifcBar := bar_index
    sx.ifcHi  := high
    sx.ifcLo  := low
if cd.ifcBear and (atBearZone or ft.sweptHigh)
    sx.ifcDir := -1
    sx.ifcBar := bar_index
    sx.ifcHi  := high
    sx.ifcLo  := low
if sx.ifcDir != 0 and (bar_index - sx.ifcBar > 10 or (sx.ifcDir == 1 and close < sx.ifcLo) or (sx.ifcDir == -1 and close > sx.ifcHi))
    sx.ifcDir := 0

// M72 — consolidation right above (below) the broken level with rejection wicks
if ft.breakUp or ft.breakDn
    sx.m72Cnt  := 0
    sx.m72Wick := 0
    sx.m72Dir  := ft.breakUp ? 1 : -1
if sx.m72Dir != 0 and ft.breakAgo >= 1 and not na(ctx.breakLvl)
    inBand = sx.m72Dir == 1 ? (close >= ctx.breakLvl and close <= ctx.breakLvl + atrV * i_consMax) : (close <= ctx.breakLvl and close >= ctx.breakLvl - atrV * i_consMax)
    if inBand
        sx.m72Cnt  := sx.m72Cnt + 1
        sx.m72Wick := sx.m72Wick + ((sx.m72Dir == 1 and cd.upWickRatio >= 0.4) or (sx.m72Dir == -1 and cd.dnWickRatio >= 0.4) ? 1 : 0)
    else if (sx.m72Dir == 1 and close > ctx.breakLvl + atrV * i_consMax) or (sx.m72Dir == -1 and close < ctx.breakLvl - atrV * i_consMax)
        sx.m72Dir := 0                                         // price left — no trap
consolOk = sx.m72Dir != 0 and sx.m72Cnt >= i_consMin and sx.m72Wick * 2 >= sx.m72Cnt

// ── setups ───────────────────────────────────────────────────────────────────
s58b = en_M58 and sx.dtDir == -1 and not na(sx.dtNeck) and close < sx.dtNeck and close[1] >= sx.dtNeck
s58  = en_M58 and sx.dtDir == 1  and not na(sx.dtNeck) and close > sx.dtNeck and close[1] <= sx.dtNeck
s62  = en_M62 and tapM62 and sx.m62Dir == 1  and revBull
s62b = en_M62 and tapM62 and sx.m62Dir == -1 and revBear
s63  = en_M63 and tapM63 and sx.dbDir == 1  and revBull
s63b = en_M63 and tapM63 and sx.dbDir == -1 and revBear
s65  = en_M65 and trg65
s65b = en_M65 and trg65b
s68  = en_M68 and armed(1, sx.m68Dir, sx.m68Bar)  and reactBull and revBull
s68b = en_M68 and armed(-1, sx.m68Dir, sx.m68Bar) and reactBear and revBear
s69  = en_M69 and sx.ifcDir == 1  and bar_index - sx.ifcBar >= 1 and close > sx.ifcHi
s69b = en_M69 and sx.ifcDir == -1 and bar_index - sx.ifcBar >= 1 and close < sx.ifcLo
s70  = en_M70 and zoneOkBull and ft.zKind == "QM" and revBull
s70b = en_M70 and zoneOkBear and ft.zKind == "QM" and revBear
s72b = en_M72 and consolOk and sx.m72Dir == 1  and close < ctx.breakLvl and cd.isBear and cd.bodyRatio >= 0.6
s72  = en_M72 and consolOk and sx.m72Dir == -1 and close > ctx.breakLvl and cd.isBull and cd.bodyRatio >= 0.6
if s69 or s69b
    sx.ifcDir := 0
if s72 or s72b
    sx.m72Dir := 0
if s58 or s58b
    sx.dtDir := 0
// M62 was the only latch in the build that was never consumed: price chopping within tlz of the
// failed-break level re-emitted the same signal on every reversal candle for armBars bars
if s62 or s62b
    sx.m62Dir := 0

// M73 — ICT Propulsion Block: the zone proved interest twice, so the third visit is the entry.
// Deliberately does NOT require `not ft.zSweepReq`: a propulsion zone is by definition on its 2nd+
// touch, and the sweep-required rule is what would otherwise veto the strongest zone on the chart.
s73  = en_M73 and ft.atProp and ft.atDemand and ft.zFifty and revBull
s73b = en_M73 and ft.atProp and ft.atSupply and ft.zFifty and revBear

// LONG chain → bL
f_bid(bL, s58, "M58", 4 + (ft.zKl >= 4 ? 1 : 0), "Double bottom: neckline broken on close")
f_bid(bL, s62, "M62", 4 + liqBonusL, "Fakeout trap: break failed within 1–2 bars → level tap + reversal against the break")
f_bid(bL, s63, "M63", 5 + liqBonusL, "Direct breakout (no retest) level revisited → rejection in breakout direction")
f_bid(bL, s65, "M65", 6, "Trendline + flipped/key level confluence → reversal → counter-move broken")
f_bid(bL, s68, "M68", 6 + liqBonusL, "HTF sweep of low + LTF CHoCH up → zone/FVG reaction → LONG (SL beyond FVG, TP nearest swing)")
f_bid(bL, s69, "M69", 5 + liqBonusL, "IFC candle at zone: close above IFC high → BUY (TP just below nearest swing high)")
f_bid(bL, s70, "M70", 5 + liqBonusL, "Quasimodo left-leg demand + bullish candle (TP1 = CHoCH high)")
f_bid(bL, s72, "M72", 5, "Operator trap (mirror): breakdown → consolidation under level with lower wicks → strong bullish close back above")
f_bid(bL, s73, "M73", 7, "Propulsion Block: zone made a strong move, was retraced into, departed again with an imbalance — now tapped at 50% + bullish reversal")

// SHORT chain → bS
f_bid(bS, s58b, "M58", 4 + (ft.zKl >= 4 ? 1 : 0), "Double top: neckline broken on close")
f_bid(bS, s62b, "M62", 4 + liqBonusS, "Fakeout trap: failed breakout → level tap + reversal SHORT")
f_bid(bS, s63b, "M63", 5 + liqBonusS, "Direct breakdown level revisited → rejection SHORT")
f_bid(bS, s65b, "M65", 6, "Trendline + flipped/key level confluence (bearish)")
f_bid(bS, s68b, "M68", 6 + liqBonusS, "HTF sweep of high + LTF CHoCH down → zone/FVG reaction → SHORT")
f_bid(bS, s69b, "M69", 5 + liqBonusS, "IFC candle at zone: close below IFC low → SELL")
f_bid(bS, s70b, "M70", 5 + liqBonusS, "Quasimodo left-leg supply + bearish candle")
f_bid(bS, s72b, "M72", 5, "Operator trap: breakout → consolidation above level with upper wicks → strong bearish close back below")
f_bid(bS, s73b, "M73", 7, "Propulsion Block: zone made a strong move, was retraced into, departed again with an imbalance — now tapped at 50% + bearish reversal")

// ── L7 TRADE ENGINE — §9.1 entry · §9.2 SL priority · §9.3 TP · §9.4 confluence score ──
gT = "14 · Trade (L7)"
i_slBuf     = input.float(0.15, "SL buffer × ATR", minval = 0.0, step = 0.05, group = gT, inline = "t1")
i_maxSL     = input.float(2.0,  "Max SL distance × ATR (major HL/LH rule)", minval = 0.5, step = 0.5, group = gT, inline = "t1")
i_minRR     = input.float(2.0,  "Min R:R — signals below this are hidden", minval = 1.0, step = 0.5, group = gT, inline = "t2")
// v8.2.1 · TP1 only had a floor, so when the nearest real level beyond minRR happened to be far
// away it became the target regardless: the review charts showed 7R, 12R and 17.4R labels on a
// 1-minute chart, i.e. empty space between entry and TP1. A target that far is not a target.
i_maxRR     = input.float(6.0,  "Max R:R — a target further than this does not count", minval = 2.0, step = 0.5, group = gT, inline = "t2b")
i_fixedR    = input.bool(false, "Fixed-R mode", group = gT, inline = "t2")
i_fixedRm   = input.float(2.0,  "Fixed R multiple (TP1; TP2 = +1R)", minval = 0.5, step = 0.5, group = gT, inline = "t2")
i_rrReal    = input.bool(true,  "Require a REAL target (zone / FVG / liquidity) at Min R:R", group = gT,
     tooltip = "On = a signal shows only when an actual opposite zone, FVG or liquidity level sits at least Min R:R away. Off = a synthetic Min R:R target is used, which may point at empty space.")
i_minScore  = input.int(3,      "Min confluence score to show", minval = 0, maxval = 10, group = gT, inline = "t3")
i_sigGap    = input.int(10,     "Min bars between signals (both sides)", minval = 0, maxval = 100, group = gT,
     tooltip = "Only the LABELS were spaced before; the signal, its trade lines and its alerts were not. One swing through one zone emitted a fresh signal on every reversal candle, so the same move counted as many trades. An opposite-side signal with a strictly HIGHER score still overrides - a real reversal is not blocked.")
i_entryMode = input.string("IMMEDIATE", "M10 entry mode", options = ["IMMEDIATE", "RETEST", "BOTH"], group = gT, inline = "t3")
i_tradeLn   = input.bool(true,  "Draw entry / SL / TP lines", group = gT, inline = "t4")
i_tradeBars = input.int(20,     "Trade line length (bars)", minval = 5, maxval = 100, group = gT, inline = "t4")

// nearest opposite reaction zone / FVG beyond price (TP1) — event-only scans
// nearest opposite level that is AT LEAST minDist beyond px. Taking the nearest one of ANY distance
// is what made TP1 a ~1R target: with 30 zones and 40 FVGs tracked there is almost always one close.
f_nearestOpp(cx, isLong, px, minDist, maxDist) =>
    best = float(na)
    nzc = array.size(cx.zones)
    if nzc > 0
        for i = 0 to nzc - 1
            z = array.get(cx.zones, i)
            if z.broken or z.bull == isLong
                continue
            lvl = isLong ? z.bottom : z.top
            dz = isLong ? lvl - px : px - lvl
            closer = isLong ? lvl < best : lvl > best
            if dz >= minDist and dz <= maxDist and (na(best) or closer)
                best := lvl
    nf = array.size(cx.fvgs)
    if nf > 0
        for i = 0 to nf - 1
            g = array.get(cx.fvgs, i)
            if g.mitigated or g.isBull == isLong
                continue
            lvl = isLong ? g.bottom : g.top
            dg = isLong ? lvl - px : px - lvl
            closer = isLong ? lvl < best : lvl > best
            if dg >= minDist and dg <= maxDist and (na(best) or closer)
                best := lvl
    best

// nearest unresolved liquidity beyond a price (TP2: EQH/EQL · BSL/SSL · PDH/PDL · PWH/PWL)
f_nearestLiq(cx, isLong, px) =>
    best = float(na)
    n = array.size(cx.lv)
    if n > 0
        for i = 0 to n - 1
            L = array.get(cx.lv, i)
            if L.done or L.isHigh != isLong
                continue
            if (isLong and L.price > px and (na(best) or L.price < best)) or (not isLong and L.price < px and (na(best) or L.price > best))
                best := L.price
    best

// §9.4 confluence score (spec is the authority; setup base score only chose the candidate)
// takes the trend as a string (§M9: the caller decides whether that is this bar's trend or the
// trend as the bar opened) instead of the whole Struct, which it only ever used for `.trend`
f_conf(fv, trendStr, isLong) =>
    sc = 1
    sc += (isLong and fv.htfBias == "BULL") or (not isLong and fv.htfBias == "BEAR") ? 1 : 0
    sc += (isLong and trendStr == "BULLISH") or (not isLong and trendStr == "BEARISH") ? 1 : 0
    sc += fv.zDepStrong and fv.arrivalWeak ? 1 : 0
    sc += (isLong and fv.bslAbove >= 1) or (not isLong and fv.sslBelow >= 1) ? 1 : 0
    sc += fv.zKind != "" and fv.zTouches <= 1 ? 1 : 0
    sc += (isLong and (fv.sweptLow or fv.zIdm)) or (not isLong and (fv.sweptHigh or fv.zIdm)) ? 1 : 0
    sc += fv.zKl >= 4 ? 1 : 0
    sc += fv.zKind != "" and ((isLong and fv.atBullFvg) or (not isLong and fv.atBearFvg)) ? 1 : 0
    sc -= fv.arrivalStrong ? 2 : 0
    sc -= fv.zSweepReq and not ((isLong and fv.sweptLow) or (not isLong and fv.sweptHigh)) ? 2 : 0
    sc -= trendStr == "RANGE" ? 1 : 0
    // NEW · premium / discount — buy the lower half of the dealing range, sell the upper half
    if i_pdOn
        sc += (isLong and fv.inDiscount) or (not isLong and fv.inPremium) ? 1 : 0
        sc -= (isLong and fv.pdPct > i_pdDeep) or (not isLong and fv.pdPct < 1.0 - i_pdDeep) ? 1 : 0
    // NEW · killzone — the London and NY windows are where the sweeps this engine hunts get run
    if i_ssnScore
        sc += fv.sessName == "London" or fv.sessName == "NY" ? 1 : 0
    sc

// §9.2 SL: 1 zone-based → 2 sweep-based → 3 major HL/LH (if within maxSLATR) → fallback candle extreme
f_stop(cf, cx, fv, isLong, aV, bufA, maxA) =>
    buf = aV * bufA
    sl = float(na)
    // the zone at price is the most significant one TOUCHED, regardless of direction — a long can be
    // standing inside an overhead supply zone, whose bottom sits a tick under close. Only a zone on
    // the trade's own side may define the stop.
    zOk = isLong ? (fv.atDemand or fv.atSupport) : (fv.atSupply or fv.atResist)
    if fv.zKind != "" and zOk
        sl := isLong ? fv.zBottom - buf : fv.zTop + buf
    else if (isLong and fv.sweptLow) or (not isLong and fv.sweptHigh)
        sl := isLong ? low - buf : high + buf
    else
        maj = isLong ? cx.majorLow : cx.majorHigh
        if not na(maj) and math.abs(close - maj) <= aV * maxA
            sl := isLong ? maj - buf : maj + buf
        else
            sl := isLong ? low - buf : high + buf
    // sanity: SL must sit on the correct side of price (zone edge can be beyond close when the
    // touched zone is the opposite kind, or too wide vs maxA) -> fall back to the candle extreme
    if (isLong and (sl >= close or close - sl > aV * maxA * 2)) or (not isLong and (sl <= close or sl - close > aV * maxA * 2))
        sl := isLong ? math.min(low, close) - buf : math.max(high, close) + buf
    sl

// build one Sig (entry / SL / TP1 / TP2 / score / grade)
f_sig(cf, cx, fv, trendStr, name, note, isLong, aV, eMode, slBufA, maxSLA, fixedR, fixedRm, minRR, maxRR, rrReal) =>
    g = Sig.new()
    g.name  := name
    g.dir   := isLong ? 1 : -1
    g.entry := close
    m10px = isLong ? fv.sweptPriceLo : fv.sweptPriceHi
    if name == "M10" and eMode != "IMMEDIATE" and not na(m10px)
        g.entry := m10px
        g.note  := eMode == "RETEST" ? "RETEST limit @ swept level · " : "BOTH: immediate + retest limit @ level · "
    g.sl := f_stop(cf, cx, fv, isLong, aV, slBufA, maxSLA)
    // f_stop only knows `close`. M10 RETEST/BOTH moves the entry down (long) / up (short) to the
    // swept level, so a zone stop between that level and close passes f_stop yet sits on the wrong
    // side of the entry. Re-check here and fall back to beyond the sweep extreme.
    if (isLong and g.sl >= g.entry) or (not isLong and g.sl <= g.entry)
        g.sl := isLong ? math.min(low, g.entry) - aV * slBufA : math.max(high, g.entry) + aV * slBufA
    risk = math.abs(g.entry - g.sl)
    if risk <= 0
        risk := aV * 0.5
        g.sl := isLong ? g.entry - risk : g.entry + risk
    okRR = true
    if fixedR
        g.tp1 := isLong ? g.entry + fixedRm * risk : g.entry - fixedRm * risk
        g.tp2 := isLong ? g.tp1 + risk : g.tp1 - risk
        g.tp3 := isLong ? g.tp2 + risk : g.tp2 - risk
    else
        // TP1 = nearest real opposite level at least minRR away. The old rule took the nearest level
        // of ANY distance and only demanded 1R, so the average winner was ~1R while every loser was
        // 1R — negative expectancy below a 50% win rate no matter how good the setup was.
        need = risk * minRR
        cap  = risk * maxRR
        tpA  = f_nearestOpp(cx, isLong, g.entry, need, cap)
        // §C4 — the confluence score, the HTF/trend gate and this R:R test all depend on the
        // direction and the feature vector, never on WHICH setup won the chain, so they cannot
        // single out one candidate: if they reject the top pick they would reject every other
        // candidate on that side too, and no second-best slot would help. The single real
        // exception is M10 in RETEST / BOTH mode, which moves the entry to the swept level and so
        // measures a different risk. Fall back to the immediate entry instead of dropping it.
        if na(tpA) and g.entry != close
            g.entry := close
            g.note  := "R:R fallback → IMMEDIATE entry · "
            g.sl    := f_stop(cf, cx, fv, isLong, aV, slBufA, maxSLA)
            risk    := math.abs(g.entry - g.sl)
            if risk <= 0
                risk := aV * 0.5
                g.sl := isLong ? g.entry - risk : g.entry + risk
            need := risk * minRR
            cap  := risk * maxRR
            tpA  := f_nearestOpp(cx, isLong, g.entry, need, cap)
        if na(tpA)
            if rrReal
                okRR := false                       // no real target that far -> not worth taking
            else
                tpA := isLong ? g.entry + need : g.entry - need
        g.tp1 := tpA
        // each further target must clear the previous one by at least 1R, so the ladder advances
        tpB = f_nearestLiq(cx, isLong, na(g.tp1) ? g.entry : g.tp1)
        g.tp2 := not na(tpB) and ((isLong and tpB >= g.tp1 + risk) or (not isLong and tpB <= g.tp1 - risk)) ? tpB : (isLong ? g.tp1 + risk : g.tp1 - risk)
        tpC = f_nearestLiq(cx, isLong, na(g.tp2) ? g.entry : g.tp2)
        g.tp3 := not na(tpC) and ((isLong and tpC >= g.tp2 + risk) or (not isLong and tpC <= g.tp2 - risk)) ? tpC : (isLong ? g.tp2 + risk : g.tp2 - risk)
    g.rr    := risk > 0 and not na(g.tp1) ? math.abs(g.tp1 - g.entry) / risk : 0.0
    g.score := f_conf(fv, trendStr, isLong)
    g.note  := g.note + note
    // an empty name hides the signal everywhere: label, trade lines, alerts and the panel
    g.name  := okRR ? name : ""
    g

var Sig sigL = Sig.new()
var Sig sigS = Sig.new()
sigL := Sig.new()
sigS := Sig.new()
// `ft.sbSessOk` is the NEW killzone filter (open unless the user switched it on)
if bL.n != "" and ft.gateUp > 0 and ft.sbSessOk
    sigL := f_sig(cfg, ctx, ft, gateTrend, bL.n, bL.t, true, atrV, i_entryMode, i_slBuf, i_maxSL, i_fixedR, i_fixedRm, i_minRR, i_maxRR, i_rrReal)
    if ft.gateUp == 1
        sigL.score := sigL.score - 1
        sigL.note  := sigL.note + " · ⚠vs HTF/trend"
    // §M8 — the 4-factor verdict used to append a note and nothing else: the `incomplete` flag was
    // written and never read anywhere, so an incomplete setup displayed exactly like a complete one.
    // It now costs a point, which can push a marginal signal under the minimum score.
    if ft.gateUp != 2 or not ((ft.zKind != "" and (ft.atDemand or ft.atSupport)) or ft.atBullFvg or ft.atTLsup)
        sigL.note  := sigL.note + " · INCOMPLETE (4-factor)"
        sigL.score := sigL.score - 1
        ft.incomplete := true
    if sigL.score < i_minScore
        sigL := Sig.new()
if bS.n != "" and ft.gateDn > 0 and ft.sbSessOk
    sigS := f_sig(cfg, ctx, ft, gateTrend, bS.n, bS.t, false, atrV, i_entryMode, i_slBuf, i_maxSL, i_fixedR, i_fixedRm, i_minRR, i_maxRR, i_rrReal)
    if ft.gateDn == 1
        sigS.score := sigS.score - 1
        sigS.note  := sigS.note + " · ⚠vs HTF/trend"
    if ft.gateDn != 2 or not ((ft.zKind != "" and (ft.atSupply or ft.atResist)) or ft.atBearFvg or ft.atTLres)
        sigS.note  := sigS.note + " · INCOMPLETE (4-factor)"
        sigS.score := sigS.score - 1
        ft.incomplete := true
    if sigS.score < i_minScore
        sigS := Sig.new()

// ── one signal at a time ────────────────────────────────────────────────────
// state is per-chart and tiny, so it stays here rather than in Ctx (which is at its 254-element cap)
var int sigBar   = -999
var int sigDir   = 0
var int sigScore = 0
okL = sigL.name != ""
okS = sigS.name != ""
// same bar, both directions: they cannot both be right — keep the stronger one
if okL and okS
    if sigL.score >= sigS.score
        sigS := Sig.new()
        okS  := false
    else
        sigL := Sig.new()
        okL  := false
// inside the gap only a stronger OPPOSITE-side signal gets through (a genuine reversal)
gapOk = bar_index - sigBar >= i_sigGap
if okL and not gapOk and not (sigDir == -1 and sigL.score > sigScore)
    sigL := Sig.new()
    okL  := false
if okS and not gapOk and not (sigDir == 1 and sigS.score > sigScore)
    sigS := Sig.new()
    okS  := false
if barstate.isconfirmed and (okL or okS)
    sigBar   := bar_index
    sigDir   := okL ? 1 : -1
    sigScore := okL ? sigL.score : sigS.score

// trade lines (entry solid · SL red dotted · TP1/TP2 green dashed) for each shown signal, FIFO
var array<line> tradeLns = array.new<line>()
f_tradeLines(v, g, nBars) =>
    xEnd = bar_index + nBars
    array.push(tradeLns, line.new(bar_index, g.entry, xEnd, g.entry, color = color.new(v.htf, 10), style = line.style_solid, width = 2))
    array.push(tradeLns, line.new(bar_index, g.sl,    xEnd, g.sl,    color = color.new(v.bear, 20), style = line.style_dashed, width = 1))
    array.push(tradeLns, line.new(bar_index, g.tp1,   xEnd, g.tp1,   color = color.new(v.bull, 30), style = line.style_dashed, width = 1))
    array.push(tradeLns, line.new(bar_index, g.tp2,   xEnd, g.tp2,   color = color.new(v.bull, 55), style = line.style_dashed, width = 1))
    array.push(tradeLns, line.new(bar_index, g.tp3,   xEnd, g.tp3,   color = color.new(v.bull, 75), style = line.style_dashed, width = 1))
    while array.size(tradeLns) > 50
        line.delete(array.shift(tradeLns))

if i_tradeLn and barstate.isconfirmed
    if sigL.name != ""
        f_tradeLines(vis, sigL, i_tradeBars)
    if sigS.name != ""
        f_tradeLines(vis, sigS, i_tradeBars)

// ── DRAWING — shared label system (P1 signature), priority-pick per side ──────
f_lbl(arr, v, mx, isUp, y, s, tip, col, szOverride) =>
    lblSt = isUp ? label.style_label_up : label.style_label_down
    bgc = color.new(col, v.filled ? v.fillT : 100)
    tc  = v.filled ? v.txt : col
    lb  = label.new(bar_index, y, s, style = lblSt, color = bgc, textcolor = tc, size = szOverride == "" ? v.sz : szOverride, tooltip = tip)
    array.push(arr, lb)
    if array.size(arr) > mx
        label.delete(array.shift(arr))

// NOTE: signal labels used to be sized by grade (A+ normal / A small / B tiny), which silently
// overrode the user's "Label size" input and made most of them unreadable. The grade is already
// in the text twice (the ▲▲ / ▲ / · prefix and the A5 suffix), so the size no longer encodes it.
// first writer wins; `rank` records which tier of the priority chain that was
f_add(x, rank, cond, tag, tip, col) =>
    if cond and x.t == ""
        x.t := tag
        x.p := tip
        x.c := col
        x.r := rank

f_gradeTxt(sc) => sc >= 6 ? "A+" : sc >= 4 ? "A" : "B"

var array<label> labs   = array.new<label>()
var array<line>  lns    = array.new<line>()
var array<line>  hLines = array.new<line>()
var line hiLine = na
var line loLine = na
var int  lastUp = -1
var int  lastDn = -1
var int  upStack = 0
var int  dnStack = 0

yUp = low  - atrV * vis.offATR
yDn = high + atrV * vis.offATR
hasL = sigL.name != "" and sigL.dir == 1
hasS = sigS.name != "" and sigS.dir == -1
// a target is only meaningful next to its R multiple — 77,400 means nothing on its own
f_rTxt(px, ep, rk) =>
    rk > 0 and not na(px) ? str.tostring(px, format.mintick) + "  (" + str.tostring(math.abs(px - ep) / rk, "#.#") + "R)" : "—"
f_tpTip(sg) =>
    rk = math.abs(sg.entry - sg.sl)
    sg.note + "\nentry " + str.tostring(sg.entry, format.mintick) + " · SL " + str.tostring(sg.sl, format.mintick) +
     "\nTP1 " + f_rTxt(sg.tp1, sg.entry, rk) + "\nTP2 " + f_rTxt(sg.tp2, sg.entry, rk) + "\nTP3 " + f_rTxt(sg.tp3, sg.entry, rk) +
     "\nscore " + str.tostring(sg.score) + " (" + f_gradeTxt(sg.score) + ")"
sigTipL = f_tpTip(sigL)
sigTipS = f_tpTip(sigS)
modTxtL = (sigL.score >= 6 ? "▲▲ " : sigL.score >= 4 ? "▲ " : "· ") + sigL.name + " " + f_gradeTxt(sigL.score) + str.tostring(sigL.score) + " · " + str.tostring(sigL.rr, "#.#") + "R"
modTxtS = (sigS.score >= 6 ? "▼▼ " : sigS.score >= 4 ? "▼ " : "· ") + sigS.name + " " + f_gradeTxt(sigS.score) + str.tostring(sigS.score) + " · " + str.tostring(sigS.rr, "#.#") + "R"
sigTxtL = modTxtL
sigTxtS = modTxtS
// §3.4 / M45: a CHoCH that followed a liquidity sweep is the stronger variant — mark it ✕
// ft.sweepBosBull/Bear are BOS-derived and a BOS flips the trend before the CHoCH test, so they
// can never coincide with a CHoCH. Derive the marker per side from the swept-bar state instead.
chochBase = ft.chochReal ? "CHoCH" : "CHoCH?"
chochUpX  = ctx.sweptLowBar  >= 0 and bar_index - ctx.sweptLowBar  <= 10 ? "✕" : ""
chochDnX  = ctx.sweptHighBar >= 0 and bar_index - ctx.sweptHighBar <= 10 ? "✕" : ""
// a bar can sweep a high AND a low; each label must name its own side's level
swKUp = str.replace(str.replace(ft.sweptKindLo, "POOL·", ""), "·ext", "")
swKDn = str.replace(str.replace(ft.sweptKindHi, "POOL·", ""), "·ext", "")
// §3.6: CISD is plotted next to CHoCH — a high-probability one (≥2 reliability conditions) survives "Key events"
// judge "counter-trend" against the trend as it stood ENTERING the bar — st.trend is already flipped
// by this bar's own BOS/CHoCH, which would hide the CISD on the very bar the reversal confirms
cisdUpOk = st.cisdBull and (d_cisdAll or preTrend != "BULLISH")
cisdDnOk = st.cisdBear and (d_cisdAll or preTrend != "BEARISH")
cisdHP   = ft.cisdRel >= 2
chochTip = ft.chochReal ? "REAL CHoCH — imbalance inside the move (M30). Retracement tradable." : "FAKE CHoCH — no FVG in the move (M30). Do not trade."

xU = Tag.new()
xD = Tag.new()
// below-bar side (bull): signal > CHoCH▲ > BOS▲ > CISD▲ > sweep of low > zone evt > HTF > warn > PB > candle tag
f_add(xU, 1, d_sig and hasL, sigTxtL, sigTipL, ft.gateUp == 1 ? vis.inv : vis.bull)
f_add(xU, 2, d_struct and tierKey and st.bullCHoCH and (tierAll or ft.chochReal), chochBase + chochUpX + "▲", chochTip, ft.chochReal ? vis.bull : vis.inv)
f_add(xU, 3, d_struct and tierKey and st.bullBOS and (ft.dispBull or d_weakBos), (ft.dispBull ? "BOS▲ ·" + str.tostring(mv.fvgCount) + "FVG" : "BOS▲ weak"), ft.dispBull ? "Bullish BOS with displacement (STRONG)" : "Bullish BOS without imbalance — WEAK move, not tradable", ft.dispBull ? vis.bull : vis.inv)
f_add(xU, 4, d_struct and (tierAll or (tierKey and cisdHP)) and cisdUpOk, "CISD▲" + (cisdHP ? "★" : ""), "Bullish CISD (close > impulse open) — early reversal", vis.bull)
f_add(xU, 5, d_liqEvt and tierKey and ft.sweptLow and (d_liqAll or ft.sweptMajor), "SWEEP✕ " + swKUp, "Liquidity sweep of " + ft.sweptKindLo + " — reversal context", vis.bull)
f_add(xU, 6, ft.evtUp != "" and (d_obDiag or not str.startswith(ft.evtUp, "T")) and (tierAll or str.startswith(ft.evtUp, "BRK")), ft.evtUp, ft.tipUp, str.startswith(ft.evtUp, "BRK") ? vis.brk : str.startswith(ft.evtUp, "T") ? vis.inv : vis.bull)
f_add(xU, 7, d_htfEvt and tierKey and newHtf and ft.htfSweepDn and ctx.hBarCount == ctx.sweepDnAt, "HTF SWEEP↓", "HTF candle swept below the last HTF swing low and closed back", vis.bull)
f_add(xU, 8, d_htfEvt and tierKey and newHtf and ft.htfManipBull, "HTF MANIP▲", "HTF manipulative candle — trade its O/H/L/C levels", vis.bull)
f_add(xU, 9, tierAll and warnUp != "", warnUp, "Warning marker — not a trade", vis.inv)
f_add(xU, 10, d_liqEvt and tierAll and ft.hiddenSSL, "hSSL", "Hidden sell-side liquidity building below", vis.inv)
f_add(xU, 11, d_pb and st.pbValidUp, "PB✓", "Valid bullish pullback confirmed (§3.5)", vis.bull)
f_add(xU, 12, d_candle and (cd.pinBull or cd.ifcBull or cd.manipBull or cd.engulfBull), cd.ifcBull ? "IFC▲" : cd.manipBull ? "MAN▲" : cd.pinBull ? "PIN▲" : "ENG▲", "Candle pattern (L0)", vis.bull)

// above-bar side (bear/neutral)
f_add(xD, 1, d_sig and hasS, sigTxtS, sigTipS, ft.gateDn == 1 ? vis.inv : vis.bear)
f_add(xD, 2, d_struct and tierKey and st.bearCHoCH and (tierAll or ft.chochReal), chochBase + chochDnX + "▼", chochTip, ft.chochReal ? vis.bear : vis.inv)
f_add(xD, 3, d_struct and tierKey and st.bearBOS and (ft.dispBear or d_weakBos), (ft.dispBear ? "BOS▼ ·" + str.tostring(mv.fvgCount) + "FVG" : "BOS▼ weak"), ft.dispBear ? "Bearish BOS with displacement (STRONG)" : "Bearish BOS without imbalance — WEAK move, not tradable", ft.dispBear ? vis.bear : vis.inv)
f_add(xD, 4, d_struct and (tierAll or (tierKey and cisdHP)) and cisdDnOk, "CISD▼" + (cisdHP ? "★" : ""), "Bearish CISD (close < impulse open) — early reversal", vis.bear)
f_add(xD, 5, d_liqEvt and tierKey and ft.sweptHigh and (d_liqAll or ft.sweptMajor), "SWEEP✕ " + swKDn, "Liquidity sweep of " + ft.sweptKindHi + " — reversal context", vis.bear)
f_add(xD, 6, d_struct and tierAll and (st.bullSweep or st.bearSweep) and not ft.sweptHigh and not ft.sweptLow, "✖SWEEP", "Invalid BOS — wick beyond swing, close back (buyers/sellers weakening)", vis.inv)
f_add(xD, 7, ft.evtDn != "" and (d_obDiag or not str.startswith(ft.evtDn, "T")) and (tierAll or str.startswith(ft.evtDn, "BRK")), ft.evtDn, ft.tipDn, str.startswith(ft.evtDn, "BRK") ? vis.brk : str.startswith(ft.evtDn, "T") ? vis.inv : vis.bear)
f_add(xD, 8, d_htfEvt and tierKey and newHtf and ft.htfSweepUp and ctx.hBarCount == ctx.sweepUpAt, "HTF SWEEP↑", "HTF candle swept above the last HTF swing high and closed back", vis.bear)
f_add(xD, 9, d_htfEvt and tierKey and newHtf and ft.htfManipBear, "HTF MANIP▼", "HTF manipulative candle — trade its O/H/L/C levels", vis.bear)
f_add(xD, 10, tierAll and warnDn != "", warnDn, "Warning marker — not a trade", vis.inv)
f_add(xD, 11, d_liqEvt and tierAll and ft.hiddenBSL, "hBSL", "Hidden buy-side liquidity building above", vis.inv)
f_add(xD, 12, d_pb and st.pbValidDn, "PB✓", "Valid bearish pullback confirmed (§3.5)", vis.bear)
f_add(xD, 13, d_candle and (cd.pinBear or cd.ifcBear or cd.manipBear or cd.engulfBear or cd.starBear), cd.ifcBear ? "IFC▼" : cd.manipBear ? "MAN▼" : cd.starBear ? "SS" : cd.pinBear ? "PIN▼" : "ENG▼", "Candle pattern (L0)", vis.bear)

// anti-overlap: consecutive labels on the same side within `stackWin` bars step further away
stackWin = cfg.minGapBars * 2
// a label whose winner came from the top of the priority chain (ranks 1-5: signal · CHoCH · BOS ·
// CISD · sweep) must not be swallowed by a cooldown a bottom-tier candle tag started two bars ago
priUp = xU.r >= 1 and xU.r <= 5
priDn = xD.r >= 1 and xD.r <= 5
// only an A+ signal jumps the cooldown; A and B queue like everything else. Letting EVERY signal
// bypass it is what produced the tight overlapping clusters on a 3m chart.
// v8.2.1 · the bypass now keeps a two-bar floor. Every A+ skipping the cooldown is what still
// produced overlapping label pairs on the review charts, and KL★ / PROP inflation made A+ common.
apL = hasL and sigL.score >= 6 and (lastUp < 0 or bar_index - lastUp >= 2)
apS = hasS and sigS.score >= 6 and (lastDn < 0 or bar_index - lastDn >= 2)
if barstate.isconfirmed
    if xU.t != "" and (lastUp < 0 or bar_index - lastUp >= cfg.minGapBars or apL or priUp)
        // decay one step per quiet gap instead of only resetting after a long one, otherwise the
        // stack pins at the cap in any busy stretch and labels float permanently off their candles
        upStack := lastUp >= 0 and bar_index - lastUp <= stackWin ? math.min(upStack + 1, 4) : math.max(upStack - 1, 0)
        f_lbl(labs, vis, cfg.maxLabels, true,  yUp - atrV * vis.offATR * 2.0 * upStack, xU.t, xU.p, xU.c, "")
        lastUp := bar_index
    if xD.t != "" and (lastDn < 0 or bar_index - lastDn >= cfg.minGapBars or apS or priDn)
        dnStack := lastDn >= 0 and bar_index - lastDn <= stackWin ? math.min(dnStack + 1, 4) : math.max(dnStack - 1, 0)
        f_lbl(labs, vis, cfg.maxLabels, false, yDn + atrV * vis.offATR * 2.0 * dnStack, xD.t, xD.p, xD.c, "")
        lastDn := bar_index

// §11.1 structure lines: BOS solid · sweep dashed grey · CHoCH solid (fake = dashed grey) · CISD dotted
f_evLine(arr, xa, y, col, sty, mx) =>
    array.push(arr, line.new(f_xb(xa), y, bar_index, y, color = col, style = sty, width = 1))
    while array.size(arr) > mx
        line.delete(array.shift(arr))

if d_struct and barstate.isconfirmed
    if st.bullBOS and not na(preHigh)
        f_evLine(lns, preHighIdx, preHigh, color.new(ft.dispBull ? vis.bull : vis.inv, 20), line.style_solid, cfg.maxLines)
    if st.bearBOS and not na(preLow)
        f_evLine(lns, preLowIdx, preLow, color.new(ft.dispBear ? vis.bear : vis.inv, 20), line.style_solid, cfg.maxLines)
    if st.bullSweep and not na(preHigh)
        f_evLine(lns, preHighIdx, preHigh, color.new(vis.inv, 30), line.style_dashed, cfg.maxLines)
    if st.bearSweep and not na(preLow)
        f_evLine(lns, preLowIdx, preLow, color.new(vis.inv, 30), line.style_dashed, cfg.maxLines)
    if st.bullCHoCH and not na(ctx.majorHigh)
        f_evLine(lns, ctx.majorHighIdx, ctx.majorHigh, color.new(ft.chochReal ? vis.bull : vis.inv, 10), ft.chochReal ? line.style_solid : line.style_dashed, cfg.maxLines)
    if st.bearCHoCH and not na(ctx.majorLow)
        f_evLine(lns, ctx.majorLowIdx, ctx.majorLow, color.new(ft.chochReal ? vis.bear : vis.inv, 10), ft.chochReal ? line.style_solid : line.style_dashed, cfg.maxLines)
    if st.cisdBear and not na(ctx.cisdUpOpen)
        f_evLine(lns, math.max(ctx.cisdUpBar, bar_index - 30), ctx.cisdUpOpen, color.new(vis.bear, 40), line.style_dotted, cfg.maxLines)
    if st.cisdBull and not na(ctx.cisdDnOpen)
        f_evLine(lns, math.max(ctx.cisdDnBar, bar_index - 30), ctx.cisdDnOpen, color.new(vis.bull, 40), line.style_dotted, cfg.maxLines)
    // live major H/L (CHoCH trigger levels)
    if not na(ctx.majorHigh)
        line.delete(hiLine)
        hiLine := line.new(f_xb(ctx.majorHighIdx), ctx.majorHigh, bar_index, ctx.majorHigh, color = color.new(vis.bear, 50), style = line.style_dashed, width = 1)
    if not na(ctx.majorLow)
        line.delete(loLine)
        loLine := line.new(f_xb(ctx.majorLowIdx), ctx.majorLow, bar_index, ctx.majorLow, color = color.new(vis.bull, 50), style = line.style_dashed, width = 1)

// HTF candle O/H/L/C levels
if d_htf and newHtf and not na(hC1)
    cc = color.new(vis.htf, vis.lineT)
    array.push(hLines, line.new(bar_index, hH1, bar_index + 1, hH1, color = cc, style = line.style_solid,  extend = extend.right))
    array.push(hLines, line.new(bar_index, hL1, bar_index + 1, hL1, color = cc, style = line.style_solid,  extend = extend.right))
    array.push(hLines, line.new(bar_index, hO1, bar_index + 1, hO1, color = cc, style = line.style_dotted, extend = extend.right))
    array.push(hLines, line.new(bar_index, hC1, bar_index + 1, hC1, color = cc, style = line.style_dashed, extend = extend.right))
    nh = array.size(hLines)
    if nh > 4
        for i = 0 to nh - 5
            line.set_extend(array.get(hLines, i), extend.none)
            line.set_x2(array.get(hLines, i), bar_index)
    while array.size(hLines) > cfg.candleLookback * 4
        line.delete(array.shift(hLines))

bgcolor(d_bg ? (ft.htfBias == "BULL" ? color.new(vis.bull, 94) : ft.htfBias == "BEAR" ? color.new(vis.bear, 94) : na) : na)

// ── §11.2 INFO PANEL (12 rows) — body in a function (main scope is at the CE10295 limit) ─────
f_panel(tb, cx, fv, stc, v, sgl, sgs, hL, hS, tfHtf) =>
    tcol = stc.trend == "BULLISH" ? v.bull : stc.trend == "BEARISH" ? v.bear : v.neut
    hcol = fv.htfBias == "BULL" ? v.bull : fv.htfBias == "BEAR" ? v.bear : v.neut
    mism = (stc.trend == "BULLISH" and fv.htfBias == "BEAR") or (stc.trend == "BEARISH" and fv.htfBias == "BULL")
    nBSL = f_nearestLiq(cx, true, close)
    nSSL = f_nearestLiq(cx, false, close)
    bestSig = hL and (not hS or sgl.score >= sgs.score) ? sgl : sgs
    isL = bestSig.dir == 1
    fA = (isL and fv.htfBias == "BULL") or (not isL and fv.htfBias == "BEAR")
    fB = (isL and stc.trend == "BULLISH") or (not isL and stc.trend == "BEARISH")
    fC = fv.zDepStrong and fv.arrivalWeak
    fD = (isL and fv.bslAbove >= 1) or (not isL and fv.sslBelow >= 1)
    chk = (fA ? "✅" : "❌") + (fB ? "✅" : "❌") + (fC ? "✅" : "❌") + (fD ? "✅" : "❌")
    lab = color.new(v.neut, 60)
    table.cell(tb, 0, 0,  "Chart / HTF",   text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 0,  timeframe.period + " → " + tfHtf, text_color = chart.fg_color)
    table.cell(tb, 0, 1,  "LTF structure", text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 1,  stc.trend, text_color = v.txt, bgcolor = color.new(tcol, 40))
    table.cell(tb, 0, 2,  "HTF bias",      text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 2,  fv.htfBias + (mism ? " ⚠" : ""), text_color = v.txt, bgcolor = color.new(hcol, 40))
    table.cell(tb, 0, 3,  "Wyckoff",       text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 3,  stc.wyckoff, text_color = chart.fg_color)
    table.cell(tb, 0, 4,  "Last event",    text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 4,  cx.lastEvt + (cx.lastEvtBar >= 0 ? " · " + str.tostring(bar_index - cx.lastEvtBar) + "b ago" : ""), text_color = chart.fg_color)
    table.cell(tb, 0, 5,  "Move phase",    text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 5,  stc.movePhase, text_color = chart.fg_color)
    table.cell(tb, 0, 6,  "Active zone",   text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 6,  fv.zKind == "" ? "—" : (fv.atDemand or fv.atSupport ? "Bull " : "Bear ") + fv.zKind + (fv.zTouches <= 1 ? " (fresh)" : " (touched " + str.tostring(fv.zTouches) + ")") + (fv.zSweepReq ? " ⚠SWEEP REQ" : ""), text_color = chart.fg_color)
    table.cell(tb, 0, 7,  "Arrival",       text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 7,  fv.zKind == "" ? "—" : fv.arrivalWeak ? "WEAK ✅" : fv.arrivalStrong ? "STRONG ❌" : "—", text_color = chart.fg_color)
    table.cell(tb, 0, 8,  "Nearest BSL",   text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 8,  na(nBSL) ? "—" : str.tostring(nBSL, format.mintick), text_color = v.bear)
    table.cell(tb, 0, 9,  "Nearest SSL",   text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 9,  na(nSSL) ? "—" : str.tostring(nSSL, format.mintick), text_color = v.bull)
    table.cell(tb, 0, 10, "4-factor",      text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 10, (bestSig.name == "" ? "—" : chk) + "  (HTF·trend·dep/arr·liq)", text_color = chart.fg_color)
    table.cell(tb, 0, 11, "Signal",        text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 11, bestSig.name == "" ? "—" : bestSig.name + " " + str.tostring(bestSig.score) + " (" + f_gradeTxt(bestSig.score) + ")", text_color = v.txt, bgcolor = color.new(bestSig.name == "" ? v.neut : bestSig.dir == 1 ? v.bull : v.bear, 40))
    // NEW rows — the two filters that were declared in the type but never implemented
    pdTxt = not (fv.inPremium or fv.inDiscount) ? "outside swing (expansion)" : str.tostring(fv.pdPct * 100, "#") + "% · " + (fv.pdPct > 0.5 ? "premium (sell side)" : fv.pdPct < 0.5 ? "discount (buy side)" : "equilibrium")
    table.cell(tb, 0, 12, "PD array",      text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 12, pdTxt, text_color = fv.pdPct > 0.5 ? v.bear : fv.pdPct < 0.5 ? v.bull : chart.fg_color)
    table.cell(tb, 0, 13, "Session",       text_color = v.txt, bgcolor = lab)
    table.cell(tb, 1, 13, fv.sessName == "" ? "— (outside killzones)" : fv.sessName + (fv.sbSessOk ? "" : " ⛔"), text_color = chart.fg_color)
    tb

var table panel = table.new(position.bottom_right, 2, 14, border_width = 1)
if d_panel and barstate.islast
    f_panel(panel, ctx, ft, st, vis, sigL, sigS, hasL, hasS, htfTF)

// ── LEGEND — body in a function (main scope is at the CE10295 limit) ─────────
f_legend(tb, v) =>
    table.cell(tb, 0, 0, "▲▲ A+ · ▲ A · · B", text_color = v.txt, bgcolor = color.new(v.bull, 40))
    table.cell(tb, 1, 0, "setup signal · ▲▲ = A+ · ▲ = A · · = B · grey = ⚠vs HTF/trend", text_color = chart.fg_color)
    table.cell(tb, 0, 1, "BOS / CHoCH / CISD", text_color = v.txt, bgcolor = color.new(v.bull, 40))
    table.cell(tb, 1, 1, "solid line = valid · dashed grey = weak / fake / sweep · dotted = CISD", text_color = chart.fg_color)
    table.cell(tb, 0, 2, "SWEEP✕ · RUN", text_color = v.txt, bgcolor = color.new(v.bear, 40))
    table.cell(tb, 1, 2, "liquidity sweep (trade) · run (avoid)", text_color = chart.fg_color)
    table.cell(tb, 0, 3, "OB★ BRK RCB RJB QM", text_color = v.txt, bgcolor = color.new(v.brk, 40))
    table.cell(tb, 1, 3, "zones · dashed grey = weak/invalid · ⚠SWEEP REQ · IDM✓ · ★★", text_color = chart.fg_color)
    table.cell(tb, 0, 4, "KL / KL★", text_color = v.txt, bgcolor = color.new(v.sr, 40))
    table.cell(tb, 1, 4, "key level (criteria ≥ min) / 4+", text_color = chart.fg_color)
    table.cell(tb, 0, 5, "▮ FVG", text_color = v.bull, bgcolor = color.new(v.bull, 85))
    table.cell(tb, 1, 5, "fair value gap (no border) · grey = mitigated", text_color = chart.fg_color)
    table.cell(tb, 0, 6, "┈┈ ╌╌", text_color = v.pool, bgcolor = color.new(v.pool, 85))
    table.cell(tb, 1, 6, "dotted = BSL/SSL · thick dashed orange = POOL/EQH/EQL · grey = PDH/PDL", text_color = chart.fg_color)
    table.cell(tb, 0, 7, "━ entry ╌ SL ╌ TP", text_color = v.htf, bgcolor = color.new(v.htf, 85))
    table.cell(tb, 1, 7, "blue entry · red dashed SL · green dashed TP1/TP2/TP3 · label shows TP1 R:R · HTF candle H/L/O/C blue", text_color = chart.fg_color)
    tb

var table lgd = table.new(position.top_right, 2, 8, border_width = 1)
if d_legend and barstate.islast
    f_legend(lgd, vis)

// ── §12 ALERTS ───────────────────────────────────────────────────────────────
// 12.1 dynamic alert() per signal (once per bar close)
f_alertMsg(g, bias) =>
    str.format("{0} | {1} {2} | Score {3} | Entry {4} SL {5} TP {6} | TF {7} | HTF {8}",
     syminfo.ticker, g.name, g.dir == 1 ? "LONG" : "SHORT", g.score,
     str.tostring(g.entry, format.mintick), str.tostring(g.sl, format.mintick), str.tostring(g.tp1, format.mintick),
     timeframe.period, bias)
if barstate.isconfirmed and hasL
    alert(f_alertMsg(sigL, ft.htfBias), alert.freq_once_per_bar_close)
if barstate.isconfirmed and hasS
    alert(f_alertMsg(sigS, ft.htfBias), alert.freq_once_per_bar_close)

// 12.2 static alertconditions (blacklist #16: static messages)
// sigL/sigS are rebuilt on every tick; without the confirm gate a "once per bar" alert can fire on a
// setup that no longer exists at the close, leaving no label, no trade line and no alert() to match

// ── VALIDATION HARNESS (strategy port only) ───────────────────────────────
// One position at a time, entry at the close of the signal bar (process_orders_on_close), SL and
// TP1 exactly as the trade engine computed them. An opposite-side signal reverses the position,
// which is what the indicator's own both-sides conflict rule already implies.
//
// Reading the result: run it per symbol / timeframe with `Setup master mode = Core only`, then put
// a module name in the counter below to see which module produced the trades. A module with fewer
// than ~10 trades has no statistics yet - do not tune on it.
gSt = "17 · Strategy (validation)"
i_stLong  = input.bool(true,  "Take LONG signals",  group = gSt, inline = "st1")
i_stShort = input.bool(true,  "Take SHORT signals", group = gSt, inline = "st1")
i_stMinSc = input.int(0,      "Extra minimum score (on top of the indicator's)", minval = 0, maxval = 10, group = gSt)
i_stTP2   = input.bool(false, "Scale out: half at TP1, rest at TP2", group = gSt)
i_diagMod = input.string("",  "Count signals from module (M37, M42, …)", group = gSt)

stOkL = hasL and i_stLong  and sigL.score >= i_minScore + i_stMinSc
stOkS = hasS and i_stShort and sigS.score >= i_minScore + i_stMinSc

if barstate.isconfirmed and stOkL
    strategy.entry("L", strategy.long, comment = sigL.name)
    if i_stTP2 and not na(sigL.tp2)
        strategy.exit("L-tp1", "L", stop = sigL.sl, limit = sigL.tp1, qty_percent = 50, comment = "TP1")
        strategy.exit("L-tp2", "L", stop = sigL.sl, limit = sigL.tp2, comment = "TP2")
    else
        strategy.exit("L-x", "L", stop = sigL.sl, limit = sigL.tp1, comment = "TP1/SL")

if barstate.isconfirmed and stOkS
    strategy.entry("S", strategy.short, comment = sigS.name)
    if i_stTP2 and not na(sigS.tp2)
        strategy.exit("S-tp1", "S", stop = sigS.sl, limit = sigS.tp1, qty_percent = 50, comment = "TP1")
        strategy.exit("S-tp2", "S", stop = sigS.sl, limit = sigS.tp2, comment = "TP2")
    else
        strategy.exit("S-x", "S", stop = sigS.sl, limit = sigS.tp1, comment = "TP1/SL")

var int diagHits = 0
if barstate.isconfirmed and i_diagMod != "" and (sigL.name == i_diagMod or sigS.name == i_diagMod)
    diagHits += 1
plot(diagHits, "signals from the module named above", display = display.data_window)

// ── DATA WINDOW ──────────────────────────────────────────────────────────────
plot(sigL.score, "long score",  display = display.data_window)
plot(sigS.score, "short score", display = display.data_window)
plot(array.size(ctx.zones), "zones", display = display.data_window)
plot(array.size(ctx.lv),    "liq levels", display = display.data_window)
plot(array.size(label.all), "labels drawn", display = display.data_window)
plot(array.size(line.all),  "lines drawn",  display = display.data_window)
plot(array.size(box.all),   "boxes drawn",  display = display.data_window)
// diagnostics for the gates that are otherwise invisible on the chart
plot(ft.brkTouches, "M01/M02 · level rejections (needs ≥2)", display = display.data_window)
plot(sx.brkTimeAt,  "M22/M71 · bars at level before break",  display = display.data_window)
plot(ft.cisdRel,    "M46 · CISD reliability 0-3",            display = display.data_window)
plot(ft.swLoInLeg,  "P6 · swing lows in leg (needs ≥2)",     display = display.data_window)
plot(ft.swHiInLeg,  "P6 · swing highs in leg (needs ≥2)",    display = display.data_window)
plot(ft.zDepStrong ? 1 : 0, "zone departure STRONG (M04/M21/M33/M42 gate)", display = display.data_window)
// v8.2.0 — PD position and displacement quality. The per-module hit counter lives in the strategy
// port, where the token budget has room for it.
plot(ft.pdPct,      "PD array 0=low of range · 1=high",      display = display.data_window)
plot(ft.dispScore,  "displacement quality 0-3",              display = display.data_window)
