//@version=6
// ===========================================================================
//  SMC + ICT ENGINE - TIER A (Phase 1..16)
//  Build plan: 05_MASTER_BUILD_PLAN.md
//  Layer 1 = facts | Layer 2 = events | Layer 3 = decision (only signal door)
// ===========================================================================
indicator("SMC + ICT Engine [Tier A]", shorttitle = "SMC-ICT A", overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// === 01 - INPUTS ===========================================================
var string GRP_ST   = "1 - Structure"
var string GRP_LIQ  = "2 - Liquidity"
var string GRP_DISP = "3 - Displacement"
var string GRP_ZONE = "4 - FVG / OB / Breaker"
var string GRP_PD   = "5 - Premium / Discount"
var string GRP_HTF  = "6 - HTF Context"
var string GRP_SESS = "7 - Sessions"
var string GRP_ENT  = "8 - Entry Engine"
var string GRP_RISK = "9 - Risk"
var string GRP_VIS  = "10 - Visuals"
var string GRP_TL   = "11 - Trendline (B)"
var string GRP_CISD = "12 - CISD (B)"
var string GRP_SMT  = "13 - SMT (B)"
var string GRP_AMD  = "14 - AMD / PO3 (B)"
var string GRP_TRAP = "15 - Trap / Turtle Soup (B)"
var string GRP_SD   = "16 - Supply-Demand / MB / RB (B)"
var string GRP_BPR  = "17 - BPR / Void / Entry Ref (B)"
var string GRP_GAP  = "18 - Opening Gaps (B)"
var string GRP_DOL  = "19 - IRL / ERL / DOL (B)"
var string GRP_SB   = "20 - Silver Bullet / Macro (B)"
var string GRP_MOD  = "21 - Market Model / Unicorn (B)"
var string GRP_BIAS = "22 - Daily Bias (B)"
var string GRP_TGT  = "23 - Std Dev Targets (B)"
var string GRP_SCORE = "24 - Score Model (B)"
var string GRP_REG  = "25 - Regime Filter (C)"
var string GRP_ADR  = "26 - ADR (C)"
var string GRP_OPEN = "27 - Open Lines (C)"
var string GRP_VI   = "28 - Volume Imbalance (C)"
var string GRP_HPOI = "29 - HTF POI (C)"
var string GRP_TM   = "30 - Trade Management (C)"
var string GRP_SIZE = "31 - Position Size (C)"
var string GRP_EXIT = "32 - Exits & News (C)"
var string GRP_PRE  = "33 - Instrument Preset (C)"
var string GRP_STAT = "34 - Backtest Stats (C)"
var string GRP_ALRT = "35 - Alert Format (C)"
var string GRP_CRT  = "36 - CRT / TBS / TWS (D)"

// -- Phase 1 - Structure --
swingLen    = input.int(5, "Swing Length", minval = 3, maxval = 20, tooltip = "Pivot length for major swings. A swing confirms this many bars AFTER the candle, which is exactly why the labels never repaint. Higher = fewer, bigger swings.", group = GRP_ST)
intSwingLen = input.int(2, "Internal Swing Length", minval = 1, maxval = 5, tooltip = "Pivot length for internal (minor) structure. MSS breaks are measured against these, not the major swings.", group = GRP_ST)
bosMode     = input.string("Close", "Break Mode", options = ["Close", "Wick"], tooltip = "Close = a break needs a candle body close beyond the level (strict, default). Wick = a touch is enough (noisy).", group = GRP_ST)
showSwings  = input.bool(true, "Show Swing Labels", tooltip = "Draw the HH / HL / LH / LL labels. The last few bars never carry a label - that is correct, not a bug.", group = GRP_ST)
showBOS     = input.bool(true, "Show BOS / CHoCH", tooltip = "Draw BOS (continuation) and CHoCH (first warning) markers. CHoCH alone never produces a signal.", group = GRP_ST)

// -- Phase 2 - Liquidity --
liqOn       = input.bool(true,  "Enable Liquidity Mapping", tooltip = "Map where stop orders sit: swing highs / lows, equal highs / lows and previous day / week levels.", group = GRP_LIQ)
showBslSsl  = input.bool(true,  "Show BSL / SSL", tooltip = "Draw buy-side (above swing highs) and sell-side (below swing lows) liquidity lines.", group = GRP_LIQ)
showEq      = input.bool(true,  "Show EQH / EQL", tooltip = "Draw equal highs / lows. Two nearly identical extremes = a bigger stop pool than a single swing.", group = GRP_LIQ)
showPdhPdl  = input.bool(true,  "Show PDH / PDL", tooltip = "Draw previous day high / low. Read from closed daily candles only, so they never move intraday.", group = GRP_LIQ)
showPwhPwl  = input.bool(false, "Show PWH / PWL", tooltip = "Draw previous week high / low. Useful on 1H and above, clutter on small timeframes.", group = GRP_LIQ)
eqTol       = input.float(0.1, "EQH/EQL Tolerance (ATR x)", minval = 0.02, maxval = 0.5, step = 0.01, tooltip = "How close two extremes must be to count as equal, measured in ATR. ATR-based so the same value works on EURUSD and XAUUSD.", group = GRP_LIQ)
clusterTol  = input.float(0.3, "Cluster Tolerance (ATR x)", minval = 0.1, maxval = 1.0, step = 0.05, tooltip = "Distance in ATR within which stacked levels count as one pool. A denser pool is a stronger target.", group = GRP_LIQ)

// -- Phase 4 - Displacement --
atrLen       = input.int(14,    "ATR Length", minval = 5, maxval = 100, tooltip = "ATR period used everywhere for normalisation (displacement size, zone size, buffers).", group = GRP_DISP)
atrMult      = input.float(1.2, "ATR Multiplier", minval = 0.8, maxval = 3.0, step = 0.1, tooltip = "A displacement candle must be at least this many ATR long. Lower = more displacement, looser logic.", group = GRP_DISP)
bodyRatioMin = input.float(0.6, "Min Body Ratio", minval = 0.4, maxval = 0.9, step = 0.05, tooltip = "Minimum body / range ratio for a displacement. Blocks big two-sided candles: a large doji is a fight, not aggression.", group = GRP_DISP)
showDisp     = input.bool(false, "Mark Displacement Candles", tooltip = "Mark displacement candles with a small triangle. Useful while tuning the two thresholds above.", group = GRP_DISP)

// -- Phase 6 / 7 - Zones --
fvgOn       = input.bool(true,  "Enable FVG", tooltip = "Detect Fair Value Gaps. The middle candle must be a displacement, otherwise the gap is just noise.", group = GRP_ZONE)
minGapMult  = input.float(0.1, "Min FVG Size (ATR x)", minval = 0.02, maxval = 1.0, step = 0.02, tooltip = "Minimum FVG height in ATR. Filters out the tiny gaps that price ignores.", group = GRP_ZONE)
obOn        = input.bool(true,  "Enable Order Block", tooltip = "Detect Order Blocks: the last opposite candle before a displacement that also broke structure.", group = GRP_ZONE)
freshObOnly = input.bool(true,  "Fresh OB Only (untouched)", tooltip = "Only keep order blocks price has not returned to yet. The first return is the one that works.", group = GRP_ZONE)
bbOn        = input.bool(true,  "Enable Breaker / IFVG", tooltip = "When an FVG or OB is fully broken, create the inverse zone (IFVG / Breaker) in the opposite direction.", group = GRP_ZONE)
showZones   = input.bool(true,  "Draw Zones", tooltip = "Draw zone boxes. Turn off to keep the chart clean while still running the engine.", group = GRP_ZONE)
showCE      = input.bool(true,  "Draw Zone CE line", tooltip = "Draw the Consequent Encroachment line: the exact midpoint of every zone.", group = GRP_ZONE)
hideDead    = input.bool(true,  "Auto-hide FILLED / INVALID zones", tooltip = "Delete boxes once a zone is filled or invalid. Keeps the drawing count under the TradingView limit.", group = GRP_ZONE)

// -- Phase 8 - Premium / Discount --
pdOn        = input.bool(true,  "Enable Premium / Discount", tooltip = "Split the dealing range into premium (upper half) and discount (lower half).", group = GRP_PD)
showPd      = input.bool(true,  "Draw Range / EQ / OTE", tooltip = "Draw the range midpoint (EQ) and the two OTE bands.", group = GRP_PD)
oteLow      = input.float(0.618, "OTE Fib Low",  minval = 0.5, maxval = 0.9, step = 0.001, tooltip = "Near edge of the Optimal Trade Entry band, as a fib of the range. Default 0.618.", group = GRP_PD)
oteHigh     = input.float(0.786, "OTE Fib High", minval = 0.5, maxval = 0.95, step = 0.001, tooltip = "Far edge of the OTE band. Default 0.786. Must be larger than the OTE low.", group = GRP_PD)

// -- Phase 9 - HTF --
htfOn       = input.bool(true, "Enable HTF Context", tooltip = "Read the bias from a higher timeframe. Only closed HTF candles are used, so it cannot repaint.", group = GRP_HTF)
htfAuto     = input.bool(true, "Auto-map HTF", tooltip = "Pick the HTF automatically from the chart timeframe (1m-15m, 5m-1H, 15m-4H, 1H-D).", group = GRP_HTF)
htfManual   = input.timeframe("240", "Manual HTF", tooltip = "The HTF to read when auto-map is off. Must be higher than the chart timeframe or the module is skipped.", group = GRP_HTF)

// -- Phase 10 - Sessions --
sessOn      = input.bool(true, "Enable Sessions", tooltip = "Enable session tracking. Sweeps that happen inside London / New York are the reliable ones.", group = GRP_SESS)
sessTz      = input.string("America/New_York", "Session Timezone", tooltip = "Timezone all session inputs are interpreted in. Keep an exchange timezone - it handles DST for you.", group = GRP_SESS)
asiaSess    = input.session("2000-0000", "Asia", tooltip = "Asia session window. Typically quiet accumulation.",     group = GRP_SESS)
londonSess  = input.session("0200-0500", "London", tooltip = "London session window. Often the first sweep of the Asian range.",   group = GRP_SESS)
nySess      = input.session("0830-1100", "New York", tooltip = "New York session window. Also drives the EOD-flat exit.", group = GRP_SESS)
shadeSess   = input.bool(false, "Shade Sessions", tooltip = "Colour the chart background during each session.", group = GRP_SESS)
killZoneReq = input.bool(false, "Require Kill Zone for Entry", tooltip = "Block entries outside London / New York. Fewer signals, higher quality.", group = GRP_SESS)

// -- Phase 11 - Entry Engine --
engineOn     = input.bool(true, "Enable Entry Engine", tooltip = "Master switch for the entry state machine. Off = detection and drawing only, no signals at all.", group = GRP_ENT)
mssTimeout   = input.int(10,  "Sweep -> MSS timeout (bars)",   minval = 2, maxval = 50, tooltip = "Bars allowed between the liquidity sweep and the MSS. Past this the setup is dead - the fuel went stale.",  group = GRP_ENT)
mssValidBars = input.int(20,  "MSS -> POI timeout (bars)",     minval = 2, maxval = 80, tooltip = "Bars allowed between the MSS and a POI appearing.",  group = GRP_ENT)
poiTimeout   = input.int(50,  "POI -> Retrace timeout (bars)", minval = 5, maxval = 200, tooltip = "Bars allowed for price to return into the POI before the setup expires.", group = GRP_ENT)
tradeTimeout = input.int(200, "Max Trade Duration (bars)",     minval = 10, maxval = 1000, tooltip = "Maximum bars a trade stays tracked. After this it is closed as TIME.", group = GRP_ENT)
minScore     = input.int(7, "Min Score to Trade", minval = 0, maxval = 12, tooltip = "Minimum score v1 (max 12) required to emit. Raise for fewer, stronger signals.", group = GRP_ENT)
requireHtf   = input.bool(true, "Require HTF Alignment", tooltip = "Only take longs when HTF bias is bullish (and mirror for shorts). Turn off if you get zero signals.", group = GRP_ENT)
requirePd    = input.bool(true, "Require Premium / Discount Alignment", tooltip = "Only take longs in discount and shorts in premium. Stops you buying at the top of the range.", group = GRP_ENT)

// -- Phase 12 - Risk --
minRR        = input.float(1.5, "Min Risk:Reward", minval = 0.5, maxval = 10.0, step = 0.1, tooltip = "Minimum reward / risk. Below this the setup is discarded rather than taken - never force a trade.", group = GRP_RISK)
slBufferMult = input.float(0.2, "SL Buffer (ATR x)", minval = 0.0, maxval = 2.0, step = 0.05, tooltip = "Extra room below the sweep low (or above the sweep high) for the stop, in ATR.", group = GRP_RISK)

// -- Phase 13 - Visuals --
colBull    = input.color(#089981, "Bullish", inline = "c1", tooltip = "Colour for bullish structure, zones and signals.", group = GRP_VIS)
colBear    = input.color(#f23645, "Bearish", inline = "c1", tooltip = "Colour for bearish structure, zones and signals.", group = GRP_VIS)
colFvg     = input.color(color.new(#2962ff, 82), "FVG",       inline = "c2", tooltip = "Fill colour for Fair Value Gap boxes.", group = GRP_VIS)
colOb      = input.color(color.new(#ff9800, 80), "OB",        inline = "c2", tooltip = "Fill colour for Order Block boxes.", group = GRP_VIS)
colBb      = input.color(color.new(#9c27b0, 80), "BB / IFVG", inline = "c2", tooltip = "Fill colour for Breaker and Inverse FVG boxes.", group = GRP_VIS)
colLiq     = input.color(#787b86, "Liquidity", inline = "c3", tooltip = "Colour for liquidity lines. Swept levels are drawn faded.", group = GRP_VIS)
zoneExtend = input.int(20, "Zone Extend (bars)", minval = 0, maxval = 200, tooltip = "How many bars to the right a live zone box is extended.", group = GRP_VIS)
uiTextSize = input.string("Normal", "Text Size", options = ["Small", "Normal", "Large"], tooltip = "Size of every label, table and zone caption the indicator draws.", group = GRP_VIS)
uiPanelBg  = input.color(color.new(#131722, 10), "Panel Background", inline = "c6", tooltip = "Background behind the dashboard, debug and stats tables. Keep it opaque so the text stays readable over candles.", group = GRP_VIS)
uiTextCol  = input.color(#d1d4dc, "Panel Text", inline = "c6", tooltip = "Text colour inside the tables.", group = GRP_VIS)
showDash   = input.bool(true,  "Show Dashboard", tooltip = "Show the status dashboard (bias, regime, state machine, object counts).", group = GRP_VIS)
showDebug  = input.bool(false, "Show Debug (state machine)", tooltip = "Show the debug table. Use it when you get no signals - it tells you which state the setup is stuck in.", group = GRP_VIS)

// -- Phase 17 / 18 - Dynamic Trendline (TIER B - default off) --
tlOn        = input.bool(false, "Enable Dynamic Trendline", tooltip = "Build trendlines from confirmed swings only. A trendline is a stop address, never a buy or sell reason.", group = GRP_TL)
tlMaxAge    = input.int(200, "Max Anchor Age (bars)",    minval = 30, maxval = 1000, tooltip = "Ignore anchors older than this. Nobody trades a line drawn from ancient history.", group = GRP_TL)
tlMinBars   = input.int(10,  "Min Bars Between Anchors", minval = 5,  maxval = 100, tooltip = "Minimum bar distance between the two anchors. Blocks steep, meaningless lines.",  group = GRP_TL)
tlMaxLines  = input.int(4,   "Max Lines Per Side",       minval = 1,  maxval = 10, tooltip = "Maximum lines kept per side. Keeps the chart and the object budget under control.",   group = GRP_TL)
tlBreakMode = input.string("Close", "TL Break Mode", options = ["Close", "Wick"], tooltip = "Close = a body close through the line counts as a break. Wick = a touch is enough.", group = GRP_TL)
tlqOn       = input.bool(false, "Treat TL Break as Liquidity (TLQ)", tooltip = "Treat a trendline sweep as liquidity: it feeds the same LIQUIDITY_SWEPT step as a normal sweep, never a separate signal.", group = GRP_TL)
tlChanOn    = input.bool(false, "Draw Parallel Channel", tooltip = "Draw a parallel line through the furthest opposite extreme, forming a channel.", group = GRP_TL)
tlShow      = input.bool(true,  "Draw Trendlines", tooltip = "Draw the trendlines. Opacity reflects strength (touches, age, angle).", group = GRP_TL)

// -- Phase 19 - CISD (TIER B - default off) --
cisdOn            = input.bool(false, "Enable CISD", tooltip = "Detect Change in State of Delivery: price closes back past the open of the candle run that was defending a level.", group = GRP_CISD)
cisdMaxRun        = input.int(6, "Max Candle Run", minval = 2, maxval = 12, tooltip = "Longest candle run that still counts. Longer runs are trends, not a defended level.", group = GRP_CISD)
cisdAsDisplacement = input.bool(false, "CISD can replace Displacement", tooltip = "Let a CISD satisfy the displacement step of the sequence. More signals, slightly weaker evidence.", group = GRP_CISD)
cisdShow          = input.bool(true, "Draw CISD level", tooltip = "Draw the current bullish / bearish CISD levels.", group = GRP_CISD)

// -- Phase 20 - SMT Divergence (TIER B - default off) --
smtOn   = input.bool(false, "Enable SMT Divergence", tooltip = "Compare with a correlated symbol. One makes a new extreme, the other does not = someone is being hunted.", group = GRP_SMT)
smtSym  = input.symbol("", "Correlated Symbol", tooltip = "The correlated symbol (EURUSD-GBPUSD, ES-NQ, BTC-ETH). Leave empty to skip silently.", group = GRP_SMT)
smtInv  = input.bool(false, "Inverse Correlation (e.g. DXY)", tooltip = "Use for inversely correlated pairs such as EURUSD against DXY.", group = GRP_SMT)
smtLook = input.int(20, "Lookback", minval = 5, maxval = 60, tooltip = "How many bars back the extreme is measured over.", group = GRP_SMT)
smtShow = input.bool(true, "Mark SMT", tooltip = "Mark SMT divergences on the chart. SMT only adds score (v2), it never creates a signal.", group = GRP_SMT)

// -- Phase 21 - AMD / Power of 3 (TIER B - default off) --
amdOn     = input.bool(false, "Enable AMD / PO3", tooltip = "Track Accumulation - Manipulation - Distribution, including the London Judas swing.", group = GRP_AMD)
amdAsiaS  = input.session("2000-0000", "Accumulation (Asia)", tooltip = "Accumulation window. Its high and low are locked once the window closes.",   group = GRP_AMD)
amdJudasS = input.session("0200-0500", "Manipulation (London)", tooltip = "Manipulation window. A sweep of the Asia range here sets the day bias the opposite way.", group = GRP_AMD)
amdDistS  = input.session("0700-1100", "Distribution (NY)", tooltip = "Distribution window - where the real move usually happens.",     group = GRP_AMD)
amdShow   = input.bool(true, "Draw Asia Range Box", tooltip = "Draw the locked Asia range box.", group = GRP_AMD)

// -- Phase 22 - Trap / Turtle Soup (TIER B - default off) --
trapOn   = input.bool(false, "Enable Trap Detection", tooltip = "Detect breakouts that failed within a few bars. Trapped traders must exit, which fuels the reversal.", group = GRP_TRAP)
trapBars = input.int(5,  "Max Bars Outside", minval = 1, maxval = 15, tooltip = "Maximum bars price may stay beyond the level and still count as a trap. Longer = a real breakout.", group = GRP_TRAP)
tsOn     = input.bool(false, "Enable Turtle Soup", tooltip = "Detect Turtle Soup: a sweep of the N-bar extreme that closes back inside.", group = GRP_TRAP)
tsLook   = input.int(20, "Turtle Soup Lookback", minval = 10, maxval = 60, tooltip = "Lookback for the Turtle Soup extreme.", group = GRP_TRAP)
trapShow = input.bool(true, "Mark Trap / Turtle Soup", tooltip = "Mark traps and turtle soups on the chart.", group = GRP_TRAP)

// -- Phase 23 - Supply/Demand, Mitigation Block, Rejection Block (TIER B - default off) --
sdOn       = input.bool(false, "Enable Supply / Demand Zones", tooltip = "Detect supply / demand zones: a tight cluster of candles that a displacement leaves from.", group = GRP_SD)
sdBars     = input.int(3, "Cluster Bars", minval = 2, maxval = 6, tooltip = "How many candles form the cluster.", group = GRP_SD)
sdTight    = input.float(0.8, "Max Cluster Range (ATR x)", minval = 0.2, maxval = 2.0, step = 0.1, tooltip = "Maximum cluster height in ATR. Wider than this is not a base, it is a range.", group = GRP_SD)
mbOn       = input.bool(false, "Enable Mitigation Block", tooltip = "Detect mitigation blocks: a touched order block that never filled and then delivered again.", group = GRP_SD)
rbOn       = input.bool(false, "Enable Rejection Block", tooltip = "Detect rejection blocks, measured from the wick rather than the body.", group = GRP_SD)
rbWickMin  = input.float(0.6, "Min Wick Ratio (RB)", minval = 0.4, maxval = 0.9, step = 0.05, tooltip = "Minimum wick / range ratio for a rejection block.", group = GRP_SD)
colSd      = input.color(color.new(#26a69a, 85), "S/D", inline = "c4", tooltip = "Fill colour for supply / demand zones.", group = GRP_SD)
colRb      = input.color(color.new(#795548, 82), "MB / RB", inline = "c4", tooltip = "Fill colour for mitigation and rejection blocks.", group = GRP_SD)

// -- Phase 24 - BPR / Liquidity Void / Entry Reference (TIER B - default off) --
bprOn    = input.bool(false, "Enable BPR", tooltip = "Detect Balanced Price Range: a bullish and a bearish FVG overlapping at the same price.", group = GRP_BPR)
voidOn   = input.bool(false, "Enable Liquidity Void", tooltip = "Detect liquidity voids: several candles running with almost no overlap.", group = GRP_BPR)
voidBars = input.int(3, "Min Void Candles", minval = 3, maxval = 6, tooltip = "Minimum candles in the run.", group = GRP_BPR)
voidOv   = input.float(0.2, "Max Overlap Ratio", minval = 0.05, maxval = 0.5, step = 0.05, tooltip = "Maximum overlap ratio between consecutive candles for the run to count as a void.", group = GRP_BPR)
entryRef = input.string("Close", "Entry Reference", options = ["Close", "Zone Edge", "CE", "Zone Full"], tooltip = "Where the entry price is taken. Close keeps Tier A behaviour; CE uses the zone midpoint, which is where price usually turns.", group = GRP_BPR)
colBpr   = input.color(color.new(#e91e63, 80), "BPR", inline = "c5", tooltip = "Fill colour for BPR zones.", group = GRP_BPR)
colVoid  = input.color(color.new(#607d8b, 88), "Void", inline = "c5", tooltip = "Fill colour for liquidity voids.", group = GRP_BPR)

// -- Phase 25 - Opening Gaps (TIER B - default off) --
nwogOn  = input.bool(false, "New Week Opening Gap (NWOG)", tooltip = "Draw the gap between last week's close and this week's open. Price is drawn back to it all week.", group = GRP_GAP)
ndogOn  = input.bool(false, "New Day Opening Gap (NDOG)", tooltip = "Draw the gap between yesterday's close and today's open.", group = GRP_GAP)
orgOn   = input.bool(false, "Opening Range Gap (ORG)", tooltip = "Draw the gap at the New York session open.", group = GRP_GAP)
gapKeep = input.int(3, "Keep Last N Gaps per kind", minval = 1, maxval = 10, tooltip = "How many gaps to keep per kind. Older ones are deleted.", group = GRP_GAP)
colGap  = input.color(color.new(#00bcd4, 85), "Gap", tooltip = "Fill colour for opening gaps.", group = GRP_GAP)

// -- Phase 26 - IRL / ERL / Draw on Liquidity (TIER B - default off) --
dolOn   = input.bool(false, "Enable Draw on Liquidity", tooltip = "Work out the Draw on Liquidity: the nearest unswept pool in the direction of the bias - the magnet price is heading for.", group = GRP_DOL)
dolShow = input.bool(true,  "Draw DOL Target Line", tooltip = "Draw an arrow at the DOL target.", group = GRP_DOL)

// -- Phase 27 - Silver Bullet / Macro (TIER B - default off) --
sbOn    = input.bool(false, "Enable Silver Bullet Window", tooltip = "Enable the Silver Bullet windows - the hour slots where the move usually happens.", group = GRP_SB)
sb1     = input.session("1000-1100", "NY AM", tooltip = "New York AM window.",  group = GRP_SB)
sb2     = input.session("1400-1500", "NY PM", tooltip = "New York PM window.",  group = GRP_SB)
sb3     = input.session("0300-0400", "London", tooltip = "London window.", group = GRP_SB)
sbOnly  = input.bool(false, "Signals ONLY inside SB window", tooltip = "Only emit signals inside the windows. The state machine keeps running outside them, it just stays silent.", group = GRP_SB)
sbShade = input.bool(false, "Shade SB windows", tooltip = "Colour the background during the windows.", group = GRP_SB)
macroOn = input.bool(false, "Macro Windows (:50-:10)", tooltip = "Macro windows (:50 to :10 of each hour). Disabled automatically on 1H and above, where it is meaningless.", group = GRP_SB)

// -- Phase 28 - Market Model / Unicorn (TIER B - default off) --
uniOn   = input.bool(false, "Enable Unicorn (BB + FVG overlap)", tooltip = "Detect Unicorn setups: a breaker and an FVG overlapping at the same price. Rare and high quality.", group = GRP_MOD)
uniOv   = input.float(0.5, "Min Overlap Ratio", minval = 0.2, maxval = 0.95, step = 0.05, tooltip = "How much of the smaller zone must overlap for it to count as a Unicorn.", group = GRP_MOD)
mmOn    = input.bool(false, "Enable MMBM / MMSM tracking", tooltip = "Track the market maker buy / sell model (sweep of a range extreme followed by a reversal).", group = GRP_MOD)
colUni  = input.color(color.new(#ffd600, 75), "Unicorn", tooltip = "Fill colour for Unicorn zones.", group = GRP_MOD)

// -- Phase 29 - Daily Bias / Weekly Profile (TIER B - default off) --
dbOn    = input.bool(false, "Enable Daily Bias", tooltip = "Build a daily bias from HTF bias, which side liquidity was taken, and the weekly open.", group = GRP_BIAS)
dbShow  = input.bool(true,  "Draw Weekly / Daily Open", tooltip = "Draw the weekly and daily open lines. Both are captured from the live open, never from request.security, so they cannot repaint.", group = GRP_BIAS)

// -- Phase 30 - Std Dev Projections (TIER B - default off) --
sdevOn   = input.bool(false, "Std Dev Projections", tooltip = "Project standard deviation targets from the sweep-to-MSS distance.", group = GRP_TGT)
sdevStr  = input.string("2,2.5,4", "Multipliers (comma separated)", tooltip = "Comma separated multipliers, no spaces. Example: 2,2.5,4", group = GRP_TGT)
sdevAsTp = input.bool(false, "Use as TP when no liquidity target", tooltip = "Use the first projection as the take profit when no liquidity pool sits ahead. Last resort target.", group = GRP_TGT)

// -- Phase 31 - Score v2 (TIER B - v1 stays default so Tier A results never move) --
scoreModel  = input.string("v1", "Score Model", options = ["v1", "v2"], tooltip = "v1 = the 12 point Tier A score. v2 = the 14 point class-capped score with penalties (chop, exhausted ADR, wrong side of the range).", group = GRP_SCORE)
minScoreV2  = input.int(8, "Min Score v2", minval = 0, maxval = 14, tooltip = "Minimum score v2 required to emit. Only used when the score model is v2.", group = GRP_SCORE)

// -- Phase 32 - Visual density --
densityMode = input.string("Normal", "Visual Density", options = ["Minimal", "Normal", "Full"], tooltip = "Minimal = only the active POI and signals. Normal = plus structure and liquidity. Full = everything including volume imbalances.", group = GRP_VIS)
dashPos     = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Left"], tooltip = "Where the dashboard sits on the chart.", group = GRP_VIS)

// -- Phase 35 - Range / Chop Regime Filter (TIER C - default off) --
regimeOn   = input.bool(false, "Enable Regime Filter", tooltip = "Detect whether the market is trending, ranging or chopping. Most SMC logic is false in chop.", group = GRP_REG)
regimeLen  = input.int(20, "Regime Lookback", minval = 10, maxval = 100, tooltip = "Lookback for all three regime measures.", group = GRP_REG)
effTrend   = input.float(0.35, "Trend Efficiency >", minval = 0.1, maxval = 0.9, step = 0.05, tooltip = "Efficiency above this counts as a trend vote. Efficiency = straight line distance divided by the total path walked.", group = GRP_REG)
effChop    = input.float(0.15, "Chop Efficiency <",  minval = 0.05, maxval = 0.5, step = 0.05, tooltip = "Efficiency below this counts as a chop vote. Must be lower than the trend threshold.", group = GRP_REG)
chopBlock  = input.bool(true,  "Block signals in CHOP", tooltip = "Block signals entirely while the regime is CHOP. Usually removes a third of the signals and most of the bad ones.", group = GRP_REG)
rangeEdge  = input.bool(true,  "In RANGE take edge setups only", tooltip = "While ranging, only take setups from the outer third of the range, never from the middle.", group = GRP_REG)
regimeShade = input.bool(false, "Shade CHOP background", tooltip = "Grey the background during chop.", group = GRP_REG)

// -- Phase 36 - ADR / Daily Range Exhaustion (TIER C - default off) --
adrOn    = input.bool(false, "Enable ADR Filter", tooltip = "Track how much of the average daily range today has already used.", group = GRP_ADR)
adrLen   = input.int(14, "ADR Days", minval = 5, maxval = 30, tooltip = "How many days the average is taken over.", group = GRP_ADR)
adrCap   = input.float(1.2, "Exhausted above % of ADR", minval = 0.5, maxval = 2.0, step = 0.05, tooltip = "Above this fraction of the ADR the day counts as exhausted - continuation setups get penalised, reversals do not.", group = GRP_ADR)
adrBlockCont = input.bool(false, "Block continuation setups when exhausted", tooltip = "Also block (not just penalise) continuation setups once the day is exhausted.", group = GRP_ADR)

// -- Phase 37 - Open Lines (TIER C - default off) --
moOn   = input.bool(false, "Midnight Open (00:00)", tooltip = "Capture and draw the midnight open. Above it = bullish day bias, below = bearish.", group = GRP_OPEN)
tdoOn  = input.bool(false, "True Day Open (08:30)", tooltip = "Capture and draw the true day open (08:30 in the session timezone).", group = GRP_OPEN)
woOn   = input.bool(false, "Weekly Open", tooltip = "Include the weekly open in the bias calculation.", group = GRP_OPEN)
moSess  = input.session("0000-0100", "Midnight window", tooltip = "The one-hour window used to capture the midnight open.", group = GRP_OPEN)
tdoSess = input.session("0830-0930", "True Day Open window", tooltip = "The window used to capture the true day open.", group = GRP_OPEN)

// -- Phase 38 - Volume Imbalance (TIER C - default off) --
viOn  = input.bool(false, "Volume Imbalance", tooltip = "Detect volume imbalances: a body gap between one close and the next open where the wicks still overlap.", group = GRP_VI)
viMin = input.float(0.05, "Min VI Size (ATR x)", minval = 0.01, maxval = 0.5, step = 0.01, tooltip = "Minimum volume imbalance size in ATR. Smaller ones are meaningless.", group = GRP_VI)
colVi = input.color(color.new(#ffeb3b, 80), "VI", tooltip = "Fill colour for volume imbalances. Only drawn in Full density - there are many and they are tiny.", group = GRP_VI)

// -- Phase 39 - HTF POI projection (TIER C - default off) --
htfPoiOn  = input.bool(false, "Show HTF POI on LTF", tooltip = "Project higher timeframe FVGs onto this chart. Same price, far more traders watching them.", group = GRP_HPOI)
htfPoiCap = input.int(20, "Max HTF zones", minval = 5, maxval = 40, tooltip = "Maximum HTF zones kept.", group = GRP_HPOI)
colHtfPoi = input.color(color.new(#3f51b5, 70), "HTF POI", tooltip = "Fill colour for HTF zones.", group = GRP_HPOI)

// -- Phase 40 - Trade Management (TIER C - default off) --
tmOn    = input.bool(false, "Enable TP1/TP2/TP3 + BE + Trail", tooltip = "Manage the trade after entry: three targets, break-even and a structure trail. Off = one target, Tier A behaviour.", group = GRP_TM)
tpMode  = input.string("Liquidity", "TP Mode", options = ["Liquidity", "R-based"], tooltip = "Liquidity = targets sit on the next stop pools (realistic). R-based = fixed multiples of risk (mechanical).", group = GRP_TM)
tp1R    = input.float(1.0, "TP1 at R", minval = 0.5, maxval = 3.0, step = 0.1, tooltip = "TP1 distance in R when using R-based targets.", group = GRP_TM)
tp2R    = input.float(2.0, "TP2 at R", minval = 1.0, maxval = 6.0, step = 0.1, tooltip = "TP2 distance in R. Must be larger than TP1.", group = GRP_TM)
tp3R    = input.float(3.0, "TP3 at R", minval = 1.5, maxval = 10.0, step = 0.1, tooltip = "TP3 distance in R. Must be larger than TP2.", group = GRP_TM)
tp1Pct  = input.int(50, "Close % at TP1", minval = 0, maxval = 100, tooltip = "How much of the position you intend to close at TP1. Shown for your own records - this is an indicator, not a strategy.", group = GRP_TM)
beOnTP1 = input.bool(true,  "Move SL to BE at TP1", tooltip = "Move the stop to entry once TP1 is hit.", group = GRP_TM)
trailOn = input.bool(false, "Trail by structure (last swing)", tooltip = "Trail the stop behind each new confirmed swing. It can only ever move forward.", group = GRP_TM)
trailBuf = input.float(0.2, "Trail buffer (ATR x)", minval = 0.0, maxval = 2.0, step = 0.05, tooltip = "How far behind the swing the trailing stop sits, in ATR.", group = GRP_TM)

// -- Phase 41 - Position Size (TIER C - default off) --
sizeOn   = input.bool(false, "Show Position Size", tooltip = "Show the position size on the signal label and in the alert.", group = GRP_SIZE)
acctSize = input.float(10000, "Account Size", minval = 100, tooltip = "Account size used for the size calculation.", group = GRP_SIZE)
riskPct  = input.float(1.0, "Risk % per trade", minval = 0.1, maxval = 5.0, step = 0.1, tooltip = "Percentage of the account risked per trade. Size is approximate - your broker's maths may differ.", group = GRP_SIZE)

// -- Phase 42 - Time Exit / EOD / News (TIER C - default off) --
eodFlat   = input.bool(false, "Close at session end (EOD flat)", tooltip = "Close tracked trades when the New York session ends instead of holding them overnight.", group = GRP_EXIT)
newsOn    = input.bool(false, "News Blackout", tooltip = "Block new entries around scheduled news. Pine has no news feed, so the times are typed by hand below.", group = GRP_EXIT)
newsTimes = input.string("0830,1000,1400", "Blackout times (no spaces, session tz)", tooltip = "Comma separated times in the session timezone, no spaces. Example: 0830,1000,1400", group = GRP_EXIT)
newsPad   = input.int(15, "Blackout +/- minutes", minval = 5, maxval = 60, tooltip = "How many minutes either side of each time are blocked. Running trades keep being managed.", group = GRP_EXIT)
newsShade = input.bool(false, "Shade blackout window", tooltip = "Colour the background during the blackout windows.", group = GRP_EXIT)

// -- Phase 43 - Instrument Preset (Manual = use the raw inputs above) --
preset = input.string("Manual", "Instrument Preset", options = ["Manual", "Auto", "Forex", "Gold", "Index", "Crypto"], tooltip = "Manual uses the inputs above. The other presets override swing length, ATR multiplier, EQ tolerance and min RR for that instrument class. Auto picks one from the symbol.", group = GRP_PRE)

// -- Phase 44 - Backtest stats (approximation, not a backtester) --
statsOn = input.bool(false, "Show Stats Table", tooltip = "Show the results table. It is an approximation, not a backtester: no spread, slippage or commission, and a same-bar TP plus SL counts as SL.", group = GRP_STAT)

// -- Phase 45 - Alert format --
alertFmt = input.string("Text", "Alert Format", options = ["Text", "JSON"], tooltip = "Text for a human, JSON for a bot or webhook. The JSON is built directly, so it does not depend on placeholders.", group = GRP_ALRT)

// -- Phase 46 - Intrabar mode --
intrabar = input.bool(false, "Intrabar (early) signals - CAN REPAINT", tooltip = "Signals before the candle closes. They CAN change or disappear until the bar closes - alerts still fire only at bar close.", group = GRP_ENT)

// -- Phase 49 - CRT / TBS / TWS (TIER D - default off) --
crtOn      = input.bool(false, "Enable CRT (Candle Range Theory)", tooltip = "Treat one closed higher timeframe candle as the range. A sweep of its high or low on this chart is the trade trigger - fed into the SAME liquidity door as every other sweep.", group = GRP_CRT)
crtAuto    = input.bool(true,  "Auto-map CRT timeframe", tooltip = "Pick the CRT timeframe from the chart timeframe, following the source mapping (CRT 15m drives 1m entries, 1H drives 5m, 4H drives 5m, 1D drives 15m).", group = GRP_CRT)
crtManual  = input.timeframe("60", "Manual CRT timeframe", tooltip = "CRT timeframe when auto-map is off. Must be higher than the chart timeframe.", group = GRP_CRT)
crtMaxBody = input.float(0.7, "Max body ratio of the CRT candle", minval = 0.3, maxval = 1.0, step = 0.05, tooltip = "A ranging candle is mostly wick. If the body fills more than this share of the range it is a trend candle, not a range, and the CRT is rejected.", group = GRP_CRT)
crtValidReq = input.bool(true, "Require a POI / liquidity inside the range", tooltip = "The source treats a CRT as valid only when it interacts with earlier liquidity or a POI. With this on, a CRT range holding no zone and no unswept level is skipped.", group = GRP_CRT)
crtModel1  = input.bool(true,  "Model-1 confirmation candle", tooltip = "After the sweep, wait for one candle to CLOSE back inside the range in the trade direction before the sweep is passed on. This is the source's Model-1 step.", group = GRP_CRT)
crtFeed    = input.bool(true,  "Feed CRT sweep into the entry engine", tooltip = "Send the CRT sweep to the same LIQUIDITY_SWEPT step as SSL/BSL, TLQ and Trap. Off = CRT is drawn and alerted but never reaches the state machine.", group = GRP_CRT)
twsPenalty = input.bool(true,  "Penalise a wick-only sweep (TWS)", tooltip = "TWS = the level was taken by wick only. TBS = a body closed beyond it. The source prefers TBS; with this on a TWS-only setup loses a point in score v2.", group = GRP_CRT)
crtShow    = input.bool(true,  "Draw CRT range", tooltip = "Draw the CRT high, low and 50% line.", group = GRP_CRT)
colCrt     = input.color(color.new(#ab47bc, 88), "CRT range", tooltip = "Fill colour for the CRT range box.", group = GRP_CRT)

// === 01B - PRESETS (Phase 43) - preset only changes effective values, Manual = raw inputs
presetAuto = syminfo.type == "forex" ? (str.contains(syminfo.ticker, "XAU") ? "Gold" : "Forex") : syminfo.type == "crypto" ? "Crypto" : syminfo.type == "index" or syminfo.type == "futures" ? "Index" : "Forex"
presetUse  = preset == "Auto" ? presetAuto : preset

swingLenEff = presetUse == "Manual" ? swingLen : presetUse == "Gold" ? 7 : presetUse == "Crypto" ? 8 : 5
atrMultEff  = presetUse == "Manual" ? atrMult  : presetUse == "Gold" ? 1.5 : presetUse == "Crypto" ? 1.4 : presetUse == "Index" ? 1.3 : 1.2
eqTolEff    = presetUse == "Manual" ? eqTol    : presetUse == "Gold" ? 0.15 : presetUse == "Crypto" ? 0.12 : 0.10
minRREff    = presetUse == "Manual" ? minRR    : presetUse == "Gold" or presetUse == "Crypto" ? 2.0 : 1.5

// === 01C - INPUT VALIDATION (Phase 47) ====================================
if barstate.isfirst
    if mssTimeout > poiTimeout
        runtime.error("Sweep->MSS timeout (" + str.tostring(mssTimeout) + ") must not exceed POI->Retrace timeout (" + str.tostring(poiTimeout) + ").")
    if tp1R >= tp2R or tp2R >= tp3R
        runtime.error("Trade Management: TP1 < TP2 < TP3 required.")
    if oteLow >= oteHigh
        runtime.error("OTE Fib Low must be smaller than OTE Fib High.")
    if effChop >= effTrend
        runtime.error("Regime: Chop efficiency must be smaller than Trend efficiency.")

// === 02 - TYPES ============================================================
type Swing
    int    barIndex   = 0
    float  price      = 0.0
    bool   isHigh     = false
    string label      = "HH"
    bool   swept      = false

type LiqLevel
    string kind       = "BSL"
    float  price      = 0.0
    int    createdBar = 0
    bool   swept      = false
    int    sweptBar   = 0
    int    strength   = 1
    line   drawing    = na
    label  lbl        = na

type Zone
    string id            = ""
    string kind          = "FVG"
    string direction     = "BULL"
    float  top           = 0.0
    float  bottom        = 0.0
    float  ce            = 0.0
    int    createdBar    = 0
    string state         = "NEW"
    bool   consumed      = false
    int    touchCount    = 0
    int    lastTouchBar  = -10
    float  mitigationPct = 0.0
    bool   isHTF         = false
    box    drawing       = na
    line   ceLine        = na

type Setup
    string id            = ""
    string direction     = "LONG"
    string state         = "IDLE"
    float  sweepLevel    = 0.0
    int    sweepBar      = 0
    float  mssLevel      = 0.0
    int    mssBar        = 0
    Zone   poi           = na
    int    poiBar        = 0
    float  entryPrice    = 0.0
    float  slPrice       = 0.0
    float  slInit        = 0.0
    float  tp1           = 0.0
    float  tp2           = 0.0
    float  tp3           = 0.0
    bool   tp1Hit        = false
    bool   tp2Hit        = false
    bool   tp3Hit        = false
    bool   beActive      = false
    float  posSize       = 0.0
    string exitReason    = ""
    float  rr            = 0.0
    int    score         = 0
    int    entryBar      = 0
    bool   signalEmitted = false
    string modelName     = "STANDARD"
    float  dolTarget     = 0.0
    bool   cisdConfirmed = false
    bool   smtPresent    = false
    bool   trapConfirmed = false
    bool   tlqConfirmed  = false
    bool   poiLeft       = false
    bool   crtTbs        = false
    bool   crtTws        = false
    int    scoreCtx      = 0
    int    scoreLiq      = 0
    int    scoreStr      = 0
    int    scoreMom      = 0
    int    scorePoi      = 0
    int    scoreLoc      = 0
    int    scoreTime     = 0
    int    scoreCorr     = 0
    int    scorePen      = 0

type Trendline
    string id           = ""
    int    x1           = 0
    float  y1           = 0.0
    int    x2           = 0
    float  y2           = 0.0
    float  slope        = 0.0
    bool   isSupport    = true
    int    touchCount   = 2
    int    lastTouchBar = 0
    bool   broken       = false
    int    brokenBar    = 0
    bool   retested     = false
    float  strength     = 0.0
    float  chanOffset   = 0.0
    line   drawing      = na
    line   chanLine     = na

type Gap
    string kind       = "NWOG"
    float  top        = 0.0
    float  bottom     = 0.0
    float  ce         = 0.0
    int    createdBar = 0
    bool   filled     = false
    box    drawing    = na
    line   ceLine     = na

// === 03 - STATE (var) ======================================================
var array<Swing>    swings    = array.new<Swing>()
var array<LiqLevel> liquidity = array.new<LiqLevel>()
var array<Zone>     zones     = array.new<Zone>()

var Setup activeLong  = Setup.new(id = "L0", direction = "LONG",  state = "IDLE")
var Setup activeShort = Setup.new(id = "S0", direction = "SHORT", state = "IDLE")

var float lastSwingHigh    = na
var float lastSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na
var float prevSwingHigh    = na
var float prevSwingLow     = na

var float intHigh = na
var float intLow  = na

var string trendDir = "NEUTRAL"

var bool bslConsumed = false
var bool sslConsumed = false

var int totalLong  = 0
var int totalShort = 0

var array<Trendline> trendlines = array.new<Trendline>()
var array<Gap>       gaps       = array.new<Gap>()

var int   prevSwingHighBar = na
var int   prevSwingLowBar  = na

var float cisdBullLevel = na
var float cisdBearLevel = na
var int   runDown       = 0
var int   runUp         = 0

var float asiaHigh     = na
var float asiaLow      = na
var bool  asiaRangeSet = false
var string amdPhase    = "NONE"
var string amdBias     = "NEUTRAL"
var box   asiaBox      = na

var int barsAbove = 0
var int barsBelow = 0

var string marketModel = "NONE"
var float  dolTarget   = na
var line   dolLine     = na
var line   wOpenLn     = na
var line   dOpenLn     = na
var array<line> sdevLines = array.new<line>()

var string prevLongState  = "IDLE"
var string prevShortState = "IDLE"
var int    longStateBar   = 0
var int    shortStateBar  = 0
var int    todayLong      = 0
var int    todayShort     = 0

var float todayHigh    = na
var float todayLow     = na
var float midnightOpen = na
var float trueDayOpen  = na
var line  moLn         = na
var line  tdoLn        = na

var int   nTrades   = 0
var int   nWins     = 0
var float sumR      = 0.0
var float bestR     = 0.0
var float worstR    = 0.0
var int   lossRun   = 0
var int   maxLossRun = 0
var float sumRR     = 0.0

var float crtHigh    = na
var float crtLow     = na
var float crtMid     = na
var bool  crtOkRange = false
var bool  crtLoWick  = false
var bool  crtLoBody  = false
var bool  crtHiWick  = false
var bool  crtHiBody  = false
var bool  crtPendBull = false
var bool  crtPendBear = false
var bool  crtFiredBull = false
var bool  crtFiredBear = false
var box   crtBox     = na
var line  crtMidLn   = na

// === 04 - HELPERS ==========================================================
f_nextLiqAbove(float px) =>
    float best = na
    if array.size(liquidity) > 0
        for i = 0 to array.size(liquidity) - 1
            LiqLevel lv = array.get(liquidity, i)
            if not lv.swept and lv.price > px
                best := na(best) or lv.price < best ? lv.price : best
    best

f_nextLiqBelow(float px) =>
    float best = na
    if array.size(liquidity) > 0
        for i = 0 to array.size(liquidity) - 1
            LiqLevel lv = array.get(liquidity, i)
            if not lv.swept and lv.price < px
                best := na(best) or lv.price > best ? lv.price : best
    best

f_clusterStrength(float px, float tol) =>
    int n = 0
    if array.size(liquidity) > 0
        for i = 0 to array.size(liquidity) - 1
            LiqLevel lv = array.get(liquidity, i)
            if not lv.swept and math.abs(lv.price - px) <= tol
                n += 1
    math.max(n, 1)

f_pushLiq(string kind, float px, float tol) =>
    bool dupe = false
    if array.size(liquidity) > 0
        for i = 0 to array.size(liquidity) - 1
            LiqLevel lv = array.get(liquidity, i)
            if not lv.swept and lv.kind == kind and math.abs(lv.price - px) <= tol * 0.25
                dupe := true
    if not dupe
        array.push(liquidity, LiqLevel.new(kind = kind, price = px, createdBar = bar_index, strength = f_clusterStrength(px, tol)))
        if array.size(liquidity) > 50
            LiqLevel old = array.shift(liquidity)
            if not na(old.drawing)
                line.delete(old.drawing)
            if not na(old.lbl)
                label.delete(old.lbl)
    dupe

f_zoneLabel(string kind, string dir) =>
    string s = kind + (dir == "BULL" ? " +" : " -")
    s

// === 05 - LAYER 1 - FACTS ==================================================
atrVal    = ta.atr(atrLen)
bodySize  = math.abs(close - open)
rangeSize = math.max(high - low, syminfo.mintick)
bodyRatio = bodySize / rangeSize
eqTolAbs  = atrVal * eqTolEff
clustAbs  = atrVal * clusterTol

// -- Phase 1 - Swing Structure (pivot confirms swingLen bars later = no repaint)
ph = ta.pivothigh(high, swingLenEff, swingLenEff)
pl = ta.pivotlow(low, swingLenEff, swingLenEff)

iph = ta.pivothigh(high, intSwingLen, intSwingLen)
ipl = ta.pivotlow(low, intSwingLen, intSwingLen)

newSwingHigh = false
newSwingLow  = false
string hiLbl = ""
string loLbl = ""

if not na(ph)
    float p = high[swingLenEff]
    hiLbl := na(lastSwingHigh) ? "HH" : (p > lastSwingHigh ? "HH" : "LH")
    array.push(swings, Swing.new(bar_index - swingLenEff, p, true, hiLbl, false))
    prevSwingHigh    := lastSwingHigh
    prevSwingHighBar := lastSwingHighBar
    lastSwingHigh    := p
    lastSwingHighBar := bar_index - swingLenEff
    bslConsumed      := false
    newSwingHigh     := true

if not na(pl)
    float p = low[swingLenEff]
    loLbl := na(lastSwingLow) ? "LL" : (p < lastSwingLow ? "LL" : "HL")
    array.push(swings, Swing.new(bar_index - swingLenEff, p, false, loLbl, false))
    prevSwingLow    := lastSwingLow
    prevSwingLowBar := lastSwingLowBar
    lastSwingLow    := p
    lastSwingLowBar := bar_index - swingLenEff
    sslConsumed     := false
    newSwingLow     := true

if array.size(swings) > 100
    array.shift(swings)

if not na(iph)
    intHigh := high[intSwingLen]
if not na(ipl)
    intLow := low[intSwingLen]

// -- Phase 2 - Liquidity Mapping
[pdhRaw, pdlRaw, pdcRaw] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)
[pwhRaw, pwlRaw, pwcRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)

newDay  = ta.change(time("D")) != 0
newWeek = ta.change(time("W")) != 0

if liqOn
    if newSwingHigh
        f_pushLiq("BSL", lastSwingHigh, clustAbs)
        if not na(prevSwingHigh) and math.abs(lastSwingHigh - prevSwingHigh) <= eqTolAbs
            f_pushLiq("EQH", math.max(lastSwingHigh, prevSwingHigh), clustAbs)
    if newSwingLow
        f_pushLiq("SSL", lastSwingLow, clustAbs)
        if not na(prevSwingLow) and math.abs(lastSwingLow - prevSwingLow) <= eqTolAbs
            f_pushLiq("EQL", math.min(lastSwingLow, prevSwingLow), clustAbs)
    if newDay and not na(pdhRaw) and not na(pdlRaw)
        f_pushLiq("PDH", pdhRaw, clustAbs)
        f_pushLiq("PDL", pdlRaw, clustAbs)
    if newWeek and not na(pwhRaw) and not na(pwlRaw)
        f_pushLiq("PWH", pwhRaw, clustAbs)
        f_pushLiq("PWL", pwlRaw, clustAbs)

// -- Phase 8 - Dealing Range / Premium / Discount / OTE
rangeHigh = lastSwingHigh
rangeLow  = lastSwingLow
rangeOk   = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow
eqLevel   = rangeOk ? (rangeHigh + rangeLow) / 2 : na
rangeSpan = rangeOk ? math.max(rangeHigh - rangeLow, syminfo.mintick) : na

inDiscount = pdOn and rangeOk ? close < eqLevel : true
inPremium  = pdOn and rangeOk ? close > eqLevel : true

oteBullTop = rangeOk ? rangeHigh - rangeSpan * oteLow  : na
oteBullBot = rangeOk ? rangeHigh - rangeSpan * oteHigh : na
oteBearBot = rangeOk ? rangeLow + rangeSpan * oteLow  : na
oteBearTop = rangeOk ? rangeLow + rangeSpan * oteHigh : na

inOteBull = rangeOk and close <= oteBullTop and close >= oteBullBot
inOteBear = rangeOk and close >= oteBearBot and close <= oteBearTop

// -- Phase 9 - HTF Context (only closed HTF candles)
tfSec  = timeframe.in_seconds(timeframe.period)
autoTF = tfSec <= 60 ? "15" : tfSec <= 300 ? "60" : tfSec <= 1800 ? "240" : tfSec <= 3600 ? "D" : tfSec <= 14400 ? "D" : "W"
htfTF  = htfAuto ? autoTF : htfManual

f_htfBias() =>
    float hi = ta.highest(high, 10)[1]
    float lo = ta.lowest(low, 10)[1]
    var string b = "NEUTRAL"
    if not na(hi) and close > hi
        b := "BULL"
    else if not na(lo) and close < lo
        b := "BEAR"
    b

htfBiasRaw = request.security(syminfo.tickerid, htfTF, f_htfBias()[1], lookahead = barmerge.lookahead_off)
htfTfSec   = timeframe.in_seconds(htfTF)
htfValid   = htfTfSec > tfSec
htfBias    = htfOn and htfValid and not na(htfBiasRaw) ? htfBiasRaw : "NEUTRAL"

// -- Phase 39 - HTF POI: detect an HTF FVG from CLOSED HTF bars only
f_htfFvg() =>
    float a    = ta.atr(atrLen)[1]   // ATR of the CLOSED HTF bar - the live one would repaint the flag
    float body = math.abs(close[2] - open[2])
    float rng  = math.max(high[2] - low[2], syminfo.mintick)
    bool  disp = body / rng >= bodyRatioMin and body >= a * atrMult
    bool  bullF = low[1] > high[3] and disp and close[2] > open[2] and (low[1] - high[3]) >= a * minGapMult
    bool  bearF = high[1] < low[3] and disp and close[2] < open[2] and (low[3] - high[1]) >= a * minGapMult
    [bullF, bearF, low[1], high[3], high[1], low[3]]

[hfBull, hfBear, hfBullTop, hfBullBot, hfBearTop, hfBearBot] = request.security(syminfo.tickerid, htfTF, f_htfFvg(), lookahead = barmerge.lookahead_off)

// -- Phase 49 - CRT: one CLOSED higher timeframe candle becomes the range
crtAutoTF = tfSec <= 60 ? "15" : tfSec <= 300 ? "60" : tfSec <= 900 ? "240" : tfSec <= 3600 ? "D" : "W"
crtTF     = crtAuto ? crtAutoTF : crtManual
crtTfSec  = timeframe.in_seconds(crtTF)
crtValidTf = crtTfSec > tfSec

[crtH, crtL, crtO, crtC] = request.security(syminfo.tickerid, crtTF, [high[1], low[1], open[1], close[1]], lookahead = barmerge.lookahead_off)
newCrt = ta.change(time(crtTF)) != 0

f_crtHasPoi(float lo, float hi) =>
    bool found = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.state != "INVALID" and z.state != "FILLED" and z.top >= lo and z.bottom <= hi
                found := true
    if not found and array.size(liquidity) > 0
        for i = 0 to array.size(liquidity) - 1
            LiqLevel lv = array.get(liquidity, i)
            if lv.price >= lo and lv.price <= hi
                found := true
    found

if crtOn and crtValidTf and newCrt and not na(crtH) and not na(crtL) and crtH > crtL
    float rngC  = math.max(crtH - crtL, syminfo.mintick)
    float bodyC = math.abs(crtC - crtO)
    // a ranging candle is mostly wick; a big body is a trend candle, not a range
    bool bodyOk = bodyC / rngC <= crtMaxBody
    bool poiOk  = not crtValidReq or f_crtHasPoi(crtL, crtH)
    crtHigh    := crtH
    crtLow     := crtL
    crtMid     := (crtH + crtL) / 2
    crtOkRange := bodyOk and poiOk
    crtLoWick  := false
    crtLoBody  := false
    crtHiWick  := false
    crtHiBody  := false
    crtPendBull := false
    crtPendBear := false
    crtFiredBull := false
    crtFiredBear := false

// -- Phase 10 - Sessions / Kill Zones
inAsia   = sessOn and not na(time(timeframe.period, asiaSess, sessTz))
inLondon = sessOn and not na(time(timeframe.period, londonSess, sessTz))
inNy     = sessOn and not na(time(timeframe.period, nySess, sessTz))
inKz     = inLondon or inNy

// -- Phase 27 - Silver Bullet / Macro windows (TIER B)
inSB1   = sbOn and not na(time(timeframe.period, sb1, sessTz))
inSB2   = sbOn and not na(time(timeframe.period, sb2, sessTz))
inSB3   = sbOn and not na(time(timeframe.period, sb3, sessTz))
inSB    = inSB1 or inSB2 or inSB3
macroOk = macroOn and tfSec < 3600
minNow  = minute(time, sessTz)
inMacro = macroOk and (minNow >= 50 or minNow <= 10)

// -- Phase 29 - Weekly / Daily open (valuewhen, never request.security -> no repaint)
weeklyOpen = ta.valuewhen(newWeek, open, 0)
dailyOpen  = ta.valuewhen(newDay, open, 0)

pdhSwept = not na(pdhRaw) and high > pdhRaw
pdlSwept = not na(pdlRaw) and low  < pdlRaw

dbScore = (htfBias == "BULL" ? 2 : htfBias == "BEAR" ? -2 : 0) + (pdlSwept ? 1 : 0) + (pdhSwept ? -1 : 0) + (woOn and not na(weeklyOpen) ? (close > weeklyOpen ? 1 : -1) : 0) + (moOn and not na(midnightOpen) ? (close > midnightOpen ? 1 : -1) : 0)
dailyBias = not dbOn ? "NEUTRAL" : dbScore >= 2 ? "BULL" : dbScore <= -2 ? "BEAR" : "NEUTRAL"

// -- Phase 25 - Opening Gaps (NWOG / NDOG / ORG)
f_pushGap(string kind, float a, float b) =>
    float gTop = math.max(a, b)
    float gBot = math.min(a, b)
    if gTop - gBot >= syminfo.mintick
        array.push(gaps, Gap.new(kind = kind, top = gTop, bottom = gBot, ce = (gTop + gBot) / 2, createdBar = bar_index))
        int cnt = 0
        if array.size(gaps) > 0
            for i = array.size(gaps) - 1 to 0
                Gap g = array.get(gaps, i)
                if g.kind == kind
                    cnt += 1
                    if cnt > gapKeep
                        if not na(g.drawing)
                            box.delete(g.drawing)
                        if not na(g.ceLine)
                            line.delete(g.ceLine)
                        array.remove(gaps, i)
    true

if nwogOn and newWeek and not na(pwcRaw)
    f_pushGap("NWOG", open, pwcRaw)
if ndogOn and newDay and not na(pdcRaw)
    f_pushGap("NDOG", open, pdcRaw)
if orgOn and inNy and not inNy[1]
    f_pushGap("ORG", open, close[1])

// -- Phase 21 - AMD / Power of 3 + Judas Swing (TIER B)
inAsiaAmd = amdOn and not na(time(timeframe.period, amdAsiaS, sessTz))
inJudas   = amdOn and not na(time(timeframe.period, amdJudasS, sessTz))
inDist    = amdOn and not na(time(timeframe.period, amdDistS, sessTz))

if newDay
    asiaHigh     := na
    asiaLow      := na
    asiaRangeSet := false
    amdPhase     := "NONE"
    amdBias      := "NEUTRAL"

if inAsiaAmd
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow  := na(asiaLow)  ? low  : math.min(asiaLow,  low)
    amdPhase := "ACCUM"

if not inAsiaAmd and inAsiaAmd[1]
    asiaRangeSet := true

judasBull = inJudas and asiaRangeSet and not na(asiaLow)  and low  < asiaLow  and close > asiaLow
judasBear = inJudas and asiaRangeSet and not na(asiaHigh) and high > asiaHigh and close < asiaHigh

if judasBull
    amdPhase := "MANIP"
    amdBias  := "BULL"
if judasBear
    amdPhase := "MANIP"
    amdBias  := "BEAR"
if inDist and (amdPhase == "MANIP" or amdPhase == "DISTRIB")
    amdPhase := "DISTRIB"

// -- Phase 35 - Regime (three independent measures, two must agree)
netMove    = math.abs(close - close[regimeLen])
pathSum    = math.sum(math.abs(close - close[1]), regimeLen)
efficiency = netMove / math.max(pathSum, syminfo.mintick)
rngNow     = ta.highest(high, regimeLen) - ta.lowest(low, regimeLen)
rngAvg     = ta.sma(rngNow, regimeLen)
squeeze    = rngNow < rngAvg * 0.7

f_structConsistent() =>
    int n = array.size(swings)
    bool ok = false
    if n >= 4
        int bull = 0
        int bear = 0
        for i = n - 4 to n - 1
            Swing sw = array.get(swings, i)
            bull += sw.label == "HH" or sw.label == "HL" ? 1 : 0
            bear += sw.label == "LL" or sw.label == "LH" ? 1 : 0
        ok := bull >= 3 or bear >= 3
    ok

structOk   = f_structConsistent()
trendVotes = (efficiency > effTrend ? 1 : 0) + (not squeeze ? 1 : 0) + (structOk ? 1 : 0)
chopVotes  = (efficiency < effChop ? 1 : 0) + (squeeze ? 1 : 0) + (not structOk ? 1 : 0)
regime     = not regimeOn ? "TREND" : trendVotes >= 2 ? "TREND" : chopVotes >= 2 ? "CHOP" : "RANGE"
inChop     = regime == "CHOP"
inRange    = regime == "RANGE"

// -- Phase 36 - ADR + daily range exhaustion
adrVal = ta.sma(math.max(pdhRaw - pdlRaw, syminfo.mintick), adrLen)
if newDay
    todayHigh := high
    todayLow  := low
else
    todayHigh := na(todayHigh) ? high : math.max(todayHigh, high)
    todayLow  := na(todayLow)  ? low  : math.min(todayLow,  low)
adrUsed  = not na(adrVal) and not na(todayHigh) and not na(todayLow) ? (todayHigh - todayLow) / math.max(adrVal, syminfo.mintick) : na
adrSpent = adrOn and not na(adrUsed) and adrUsed > adrCap

// -- Phase 37 - Midnight Open / True Day Open / Weekly Open
inMoWin  = not na(time(timeframe.period, moSess, sessTz))
inTdoWin = not na(time(timeframe.period, tdoSess, sessTz))
if inMoWin and not inMoWin[1]
    midnightOpen := open
if inTdoWin and not inTdoWin[1]
    trueDayOpen := open

// === 05B - TIER B MODULES - TRENDLINE HELPERS (Phase 17 / 18) ==============
f_tlPriceAt(Trendline t, int bi) =>
    t.y2 + t.slope * (bi - t.x2)

f_tlClean(int x1, float y1, int x2, float y2, bool isSup) =>
    bool ok  = true
    int  len = x2 - x1
    float sl = len > 0 ? (y2 - y1) / len : 0.0
    if len > 0
        for i = 0 to len
            int off = bar_index - (x1 + i)
            if off >= 0 and off < 4000
                float lineY = y1 + sl * i
                if isSup and close[off] < lineY - syminfo.mintick
                    ok := false
                if not isSup and close[off] > lineY + syminfo.mintick
                    ok := false
    ok

f_tlStrength(Trendline t) =>
    float touchScore = math.min(t.touchCount, 6) * 12
    float ageScore   = math.min((bar_index - t.x1) / 10.0, 15)
    float slopeNorm  = math.abs(t.slope) / math.max(atrVal / 10.0, syminfo.mintick)
    float angleScore = slopeNorm > 0.2 and slopeNorm < 3.0 ? 13 : 0
    math.min(touchScore + ageScore + angleScore, 100)

f_tlDupe(float slope, float yNow, bool isSup) =>
    bool dupe = false
    if array.size(trendlines) > 0
        for i = 0 to array.size(trendlines) - 1
            Trendline t = array.get(trendlines, i)
            if t.isSupport == isSup and not t.broken
                float ty = f_tlPriceAt(t, bar_index)
                if math.abs(ty - yNow) < atrVal * 0.5 and math.abs(t.slope - slope) < math.max(atrVal * 0.05, syminfo.mintick)
                    dupe := true
    dupe

f_tlBuild(int x1, float y1, int x2, float y2, bool isSup) =>
    bool ok = false
    if x2 - x1 >= tlMinBars and bar_index - x1 <= tlMaxAge
        bool dirOk = isSup ? y2 > y1 : y2 < y1
        if dirOk
            float sl   = (y2 - y1) / (x2 - x1)
            float yNow = y2 + sl * (bar_index - x2)
            if not f_tlDupe(sl, yNow, isSup) and f_tlClean(x1, y1, x2, y2, isSup)
                float maxDev = 0.0
                for i = 0 to x2 - x1
                    int off = bar_index - (x1 + i)
                    if off >= 0 and off < 4000
                        float lineY = y1 + sl * i
                        float dev   = isSup ? high[off] - lineY : lineY - low[off]
                        maxDev := math.max(maxDev, dev)
                array.push(trendlines, Trendline.new(id = "TL_" + str.tostring(bar_index) + (isSup ? "S" : "R"), x1 = x1, y1 = y1, x2 = x2, y2 = y2, slope = sl, isSupport = isSup, touchCount = 2, lastTouchBar = x2, chanOffset = maxDev))
                ok := true
    ok

f_tlPrune() =>
    if array.size(trendlines) > 0
        for i = array.size(trendlines) - 1 to 0
            Trendline t = array.get(trendlines, i)
            bool expired = t.broken and bar_index - t.brokenBar > 20
            bool tooOld  = bar_index - t.x1 > tlMaxAge * 2
            if expired or tooOld
                if not na(t.drawing)
                    line.delete(t.drawing)
                    t.drawing := na
                if not na(t.chanLine)
                    line.delete(t.chanLine)
                    t.chanLine := na
                array.remove(trendlines, i)
    int nSup = 0
    int nRes = 0
    if array.size(trendlines) > 0
        for i = array.size(trendlines) - 1 to 0
            Trendline t = array.get(trendlines, i)
            if t.isSupport
                nSup += 1
                if nSup > tlMaxLines
                    if not na(t.drawing)
                        line.delete(t.drawing)
                        t.drawing := na
                    if not na(t.chanLine)
                        line.delete(t.chanLine)
                        t.chanLine := na
                    array.remove(trendlines, i)
            else
                nRes += 1
                if nRes > tlMaxLines
                    if not na(t.drawing)
                        line.delete(t.drawing)
                        t.drawing := na
                    if not na(t.chanLine)
                        line.delete(t.chanLine)
                        t.chanLine := na
                    array.remove(trendlines, i)
    true

// === 06 - LAYER 2 - EVENTS =================================================
confirmed = intrabar ? true : barstate.isconfirmed

// -- Phase 4 - Displacement
isDisp     = bodyRatio >= bodyRatioMin and bodySize >= atrVal * atrMultEff
isBullDisp = isDisp and close > open
isBearDisp = isDisp and close < open

// -- Phase 3 - BOS / CHoCH
bosUp   = false
bosDn   = false
chochUp = false
chochDn = false

brokeUp = not na(lastSwingHigh) and not bslConsumed and (bosMode == "Close" ? close > lastSwingHigh : high > lastSwingHigh)
brokeDn = not na(lastSwingLow) and not sslConsumed and (bosMode == "Close" ? close < lastSwingLow : low < lastSwingLow)

if confirmed and brokeUp
    bslConsumed := true
    if trendDir == "BEAR"
        chochUp := true
    else
        bosUp := true
    trendDir := "BULL"

if confirmed and brokeDn
    sslConsumed := true
    if trendDir == "BULL"
        chochDn := true
    else
        bosDn := true
    trendDir := "BEAR"

// -- Phase 5 - Sweep (penetrate + close back + rejection wick)
rejUp = (close - low) / rangeSize > 0.5
rejDn = (high - close) / rangeSize > 0.5

bool  sslSwept      = false
bool  bslSwept      = false
float sweptSslLevel = na
float sweptBslLevel = na

if confirmed and liqOn and array.size(liquidity) > 0
    for i = 0 to array.size(liquidity) - 1
        LiqLevel lv = array.get(liquidity, i)
        if not lv.swept
            if lv.price < close and low < lv.price and rejUp
                lv.swept      := true
                lv.sweptBar   := bar_index
                sslSwept      := true
                sweptSslLevel := na(sweptSslLevel) or lv.price > sweptSslLevel ? lv.price : sweptSslLevel
            else if lv.price > close and high > lv.price and rejDn
                lv.swept      := true
                lv.sweptBar   := bar_index
                bslSwept      := true
                sweptBslLevel := na(sweptBslLevel) or lv.price < sweptBslLevel ? lv.price : sweptBslLevel

// -- Phase 5 - MSS (sweep -> displacement -> structure break; handled in Layer 3)
mssUp = isBullDisp and not na(intHigh) and close > intHigh
mssDn = isBearDisp and not na(intLow) and close < intLow

// -- Phase 17 / 18 - Trendline build, touch, break, TLQ sweep
bool tlqBull = false
bool tlqBear = false
bool tlBreakUp = false
bool tlBreakDn = false

if tlOn and confirmed
    if newSwingLow and not na(prevSwingLow) and not na(prevSwingLowBar)
        f_tlBuild(prevSwingLowBar, prevSwingLow, lastSwingLowBar, lastSwingLow, true)
    if newSwingHigh and not na(prevSwingHigh) and not na(prevSwingHighBar)
        f_tlBuild(prevSwingHighBar, prevSwingHigh, lastSwingHighBar, lastSwingHigh, false)

if tlOn and confirmed and array.size(trendlines) > 0
    for i = 0 to array.size(trendlines) - 1
        Trendline t = array.get(trendlines, i)
        float lineY = f_tlPriceAt(t, bar_index)
        if not t.broken
            // touch (cooldown 3 bars, correct side close)
            bool near = math.abs(close - lineY) <= atrVal * 0.25
            bool side = t.isSupport ? close >= lineY : close <= lineY
            if near and side and bar_index - t.lastTouchBar >= 3
                t.touchCount   += 1
                t.lastTouchBar := bar_index
            // TLQ sweep = wick outside, close back inside
            bool sweepSup = t.isSupport and low < lineY and close > lineY and (close - low) / rangeSize > 0.5
            bool sweepRes = not t.isSupport and high > lineY and close < lineY and (high - close) / rangeSize > 0.5
            bool brokeSup = t.isSupport and (tlBreakMode == "Close" ? close < lineY : low < lineY)
            bool brokeRes = not t.isSupport and (tlBreakMode == "Close" ? close > lineY : high > lineY)
            if sweepSup
                tlqBull := true
                if tlqOn
                    array.push(liquidity, LiqLevel.new(kind = "TLQ", price = lineY, createdBar = bar_index, swept = true, sweptBar = bar_index))
            else if sweepRes
                tlqBear := true
                if tlqOn
                    array.push(liquidity, LiqLevel.new(kind = "TLQ", price = lineY, createdBar = bar_index, swept = true, sweptBar = bar_index))
            else if brokeSup or brokeRes
                t.broken    := true
                t.brokenBar := bar_index
                tlBreakDn   := brokeSup ? true : tlBreakDn
                tlBreakUp   := brokeRes ? true : tlBreakUp
        else
            // retest within 20 bars after break
            if bar_index - t.brokenBar <= 20 and math.abs(close - lineY) <= atrVal * 0.25
                t.retested := true
        t.strength := f_tlStrength(t)

if tlOn and confirmed
    f_tlPrune()

// TLQ feeds the SAME door as SSL/BSL sweep - never a separate signal path
if tlOn and tlqOn and confirmed
    if tlqBull
        sslSwept      := true
        sweptSslLevel := na(sweptSslLevel) ? low : math.max(sweptSslLevel, low)
    if tlqBear
        bslSwept      := true
        sweptBslLevel := na(sweptBslLevel) ? high : math.min(sweptBslLevel, high)

// -- Phase 19 - CISD (Change in State of Delivery)
if close < open
    runDown += 1
else
    runDown := 0
if close > open
    runUp += 1
else
    runUp := 0

if runDown >= 2 and runDown <= cisdMaxRun
    cisdBullLevel := open[runDown - 1]
if runUp >= 2 and runUp <= cisdMaxRun
    cisdBearLevel := open[runUp - 1]

bullCISD = cisdOn and not na(cisdBullLevel) and close > cisdBullLevel and close > open
bearCISD = cisdOn and not na(cisdBearLevel) and close < cisdBearLevel and close < open

// CISD may substitute displacement only when explicitly enabled
dispBullOk = isBullDisp or (cisdOn and cisdAsDisplacement and bullCISD)
dispBearOk = isBearDisp or (cisdOn and cisdAsDisplacement and bearCISD)

// -- Phase 20 - SMT Divergence (score only, never a signal)
smtSymOk  = str.length(smtSym) > 0
smtSymUse = smtOn and smtSymOk ? smtSym : syminfo.tickerid
[cHigh, cLow] = request.security(smtSymUse, timeframe.period, [high[1], low[1]], lookahead = barmerge.lookahead_off)

myLowN  = ta.lowest(low, smtLook)
myHighN = ta.highest(high, smtLook)
coLowN  = ta.lowest(cLow, smtLook)
coHighN = ta.highest(cHigh, smtLook)

smtReady = smtOn and smtSymOk and not na(cHigh) and not na(cLow)
bullSMT  = smtReady and (smtInv ? (low <= myLowN and cHigh < coHighN) : (low <= myLowN and cLow > coLowN))
bearSMT  = smtReady and (smtInv ? (high >= myHighN and cLow > coLowN) : (high >= myHighN and cHigh < coHighN))

f_zonePriority(string kind) =>
    int r = switch kind
        "UNICORN" => 7
        "HTF_FVG" => 6
        "FVG"     => 6
        "OB"      => 5
        "BPR"     => 5
        "BB"      => 4
        "IFVG"    => 4
        "MB"      => 3
        "RB"      => 2
        "SD"      => 1
        => 0
    r

f_coveredByBetter(string kind, float top, float bot) =>
    bool covered = false
    int  rank    = f_zonePriority(kind)
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.state != "INVALID" and z.state != "FILLED" and f_zonePriority(z.kind) >= rank
                if top <= z.top and bot >= z.bottom
                    covered := true
    covered

// -- Phase 6 - FVG detection
f_zoneExists(string kind, string dir, float top, float bot) =>
    bool found = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.kind == kind and z.direction == dir and z.state != "INVALID" and z.state != "FILLED"
                if top <= z.top and bot >= z.bottom
                    found := true
    found

f_pushZone(string kind, string dir, float top, float bot) =>
    string zid = kind + "_" + str.tostring(bar_index)
    Zone z = Zone.new(id = zid, kind = kind, direction = dir, top = top, bottom = bot, ce = (top + bot) / 2, createdBar = bar_index, state = "NEW")
    array.push(zones, z)
    z

bullFvgRaw = fvgOn and low > high[2] and isBullDisp[1] and (low - high[2]) >= atrVal * minGapMult
bearFvgRaw = fvgOn and high < low[2] and isBearDisp[1] and (low[2] - high) >= atrVal * minGapMult

newBullZone = false
newBearZone = false

if confirmed and bullFvgRaw and not f_zoneExists("FVG", "BULL", low, high[2])
    f_pushZone("FVG", "BULL", low, high[2])
    newBullZone := true

if confirmed and bearFvgRaw and not f_zoneExists("FVG", "BEAR", low[2], high)
    f_pushZone("FVG", "BEAR", low[2], high)
    newBearZone := true

// -- Phase 7 - Order Block (only validated: displacement + structure break)
if confirmed and obOn and isBullDisp and mssUp
    int idx = -1
    for k = 1 to 10
        if close[k] < open[k]
            idx := k
            break
    if idx > 0
        float obTop = high[idx]
        float obBot = low[idx]
        bool fresh  = not freshObOnly or low > obTop
        if fresh and obTop > obBot and not f_zoneExists("OB", "BULL", obTop, obBot)
            f_pushZone("OB", "BULL", obTop, obBot)
            newBullZone := true

if confirmed and obOn and isBearDisp and mssDn
    int idx = -1
    for k = 1 to 10
        if close[k] > open[k]
            idx := k
            break
    if idx > 0
        float obTop = high[idx]
        float obBot = low[idx]
        bool fresh  = not freshObOnly or high < obBot
        if fresh and obTop > obBot and not f_zoneExists("OB", "BEAR", obTop, obBot)
            f_pushZone("OB", "BEAR", obTop, obBot)
            newBearZone := true

// -- Phase 39 - project the HTF POI onto this chart (same zones array, isHTF flag)
if confirmed and htfPoiOn
    if hfBull and not hfBull[1] and not na(hfBullTop) and hfBullTop > hfBullBot and not f_coveredByBetter("HTF_FVG", hfBullTop, hfBullBot)
        Zone hz = f_pushZone("HTF_FVG", "BULL", hfBullTop, hfBullBot)
        hz.isHTF := true
        newBullZone := true
    if hfBear and not hfBear[1] and not na(hfBearTop) and hfBearTop > hfBearBot and not f_coveredByBetter("HTF_FVG", hfBearTop, hfBearBot)
        Zone hz2 = f_pushZone("HTF_FVG", "BEAR", hfBearTop, hfBearBot)
        hz2.isHTF := true
        newBearZone := true
    // HTF zone cap
    int nHtf = 0
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            if z.isHTF
                nHtf += 1
                if nHtf > htfPoiCap
                    if not na(z.drawing)
                        box.delete(z.drawing)
                        z.drawing := na
                    if not na(z.ceLine)
                        line.delete(z.ceLine)
                        z.ceLine := na
                    array.remove(zones, i)

// -- Phase 22 - Trap + Turtle Soup (TIER B) - feeds the SAME sweep door
if not na(lastSwingHigh) and close > lastSwingHigh
    barsAbove += 1
else
    barsAbove := 0
if not na(lastSwingLow) and close < lastSwingLow
    barsBelow += 1
else
    barsBelow := 0

bullTrap = trapOn and not na(lastSwingHigh) and barsAbove[1] >= 1 and barsAbove[1] <= trapBars and close < lastSwingHigh
bearTrap = trapOn and not na(lastSwingLow)  and barsBelow[1] >= 1 and barsBelow[1] <= trapBars and close > lastSwingLow

tsHiLevel = ta.highest(high[1], tsLook)
tsLoLevel = ta.lowest(low[1], tsLook)
tsShort   = tsOn and high > tsHiLevel and close < tsHiLevel
tsLong    = tsOn and low  < tsLoLevel and close > tsLoLevel

if confirmed and (bullTrap or tsShort)
    bslSwept      := true
    float lvl     = bullTrap ? lastSwingHigh : tsHiLevel
    sweptBslLevel := na(sweptBslLevel) ? math.max(lvl, high) : sweptBslLevel
    array.push(liquidity, LiqLevel.new(kind = "TRAP", price = lvl, createdBar = bar_index, swept = true, sweptBar = bar_index))

if confirmed and (bearTrap or tsLong)
    sslSwept      := true
    float lvl     = bearTrap ? lastSwingLow : tsLoLevel
    sweptSslLevel := na(sweptSslLevel) ? math.min(lvl, low) : sweptSslLevel
    array.push(liquidity, LiqLevel.new(kind = "TRAP", price = lvl, createdBar = bar_index, swept = true, sweptBar = bar_index))

// -- Phase 49 - TBS / TWS classification + Model-1, then into the SAME sweep door
bool crtSweepBull = false
bool crtSweepBear = false
bool crtTbsBull   = false
bool crtTbsBear   = false
bool crtTwsBull   = false
bool crtTwsBear   = false

if crtOn and confirmed and crtOkRange and not na(crtHigh) and not na(crtLow)
    // --- CRT LOW taken -> bullish side
    if low < crtLow
        if close >= crtLow
            // wick only: the level was tapped, the body never accepted below it
            if not crtLoBody
                crtLoWick := true
        else
            // a body closed beyond the level - this is the acceptance the source wants
            crtLoBody := true
    if crtLoBody and close > crtLow
        crtTbsBull := true          // closed back inside after body acceptance = TBS
    else if crtLoWick and close > crtLow and low < crtLow
        crtTwsBull := true          // wick-only sweep = TWS (lower quality)

    // --- CRT HIGH taken -> bearish side
    if high > crtHigh
        if close <= crtHigh
            if not crtHiBody
                crtHiWick := true
        else
            crtHiBody := true
    if crtHiBody and close < crtHigh
        crtTbsBear := true
    else if crtHiWick and close < crtHigh and high > crtHigh
        crtTwsBear := true

    // Model-1: wait one CLOSED candle in the trade direction before passing it on.
    // Each CRT candle fires at most once, so the pending flag cannot be re-armed forever.
    if crtModel1
        if crtPendBull and not crtFiredBull and close > open and close > crtLow
            crtSweepBull := true
            crtFiredBull := true
            crtPendBull  := false
        else if not crtFiredBull and (crtTbsBull or crtTwsBull)
            crtPendBull := true
        if crtPendBear and not crtFiredBear and close < open and close < crtHigh
            crtSweepBear := true
            crtFiredBear := true
            crtPendBear  := false
        else if not crtFiredBear and (crtTbsBear or crtTwsBear)
            crtPendBear := true
    else
        if not crtFiredBull and (crtTbsBull or crtTwsBull)
            crtSweepBull := true
            crtFiredBull := true
        if not crtFiredBear and (crtTbsBear or crtTwsBear)
            crtSweepBear := true
            crtFiredBear := true

// CRT never opens its own signal path - it feeds LIQUIDITY_SWEPT like every other sweep
if crtOn and crtFeed and confirmed
    if crtSweepBull
        sslSwept      := true
        sweptSslLevel := na(sweptSslLevel) ? math.min(crtLow, low) : sweptSslLevel
    if crtSweepBear
        bslSwept      := true
        sweptBslLevel := na(sweptBslLevel) ? math.max(crtHigh, high) : sweptBslLevel

// -- Phase 23 - Supply / Demand cluster zones (TIER B)
sdClustHigh = ta.highest(high[1], sdBars)
sdClustLow  = ta.lowest(low[1], sdBars)
sdTightOk   = (sdClustHigh - sdClustLow) < atrVal * sdTight

if confirmed and sdOn and sdTightOk and isBullDisp and not f_coveredByBetter("SD", sdClustHigh, sdClustLow)
    f_pushZone("SD", "BULL", sdClustHigh, sdClustLow)
    newBullZone := true

if confirmed and sdOn and sdTightOk and isBearDisp and not f_coveredByBetter("SD", sdClustHigh, sdClustLow)
    f_pushZone("SD", "BEAR", sdClustHigh, sdClustLow)
    newBearZone := true

// -- Phase 23 - Rejection Block (wick based)
rbUpWick   = high - math.max(open, close)
rbDownWick = math.min(open, close) - low

if confirmed and rbOn and rbDownWick / rangeSize >= rbWickMin and not f_coveredByBetter("RB", math.min(open, close), low)
    f_pushZone("RB", "BULL", math.min(open, close), low)
    newBullZone := true

if confirmed and rbOn and rbUpWick / rangeSize >= rbWickMin and not f_coveredByBetter("RB", high, math.max(open, close))
    f_pushZone("RB", "BEAR", high, math.max(open, close))
    newBearZone := true

// -- Phase 23 - Mitigation Block: touched OB that never filled, then displacement again
if confirmed and mbOn and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if z.kind == "OB" and z.state == "TOUCHED" and z.mitigationPct < 1.0
            bool again = z.direction == "BULL" ? isBullDisp : isBearDisp
            if again and not f_coveredByBetter("MB", z.top, z.bottom)
                f_pushZone("MB", z.direction, z.top, z.bottom)
                newBullZone := z.direction == "BULL" ? true : newBullZone
                newBearZone := z.direction == "BEAR" ? true : newBearZone

// -- Phase 24 - BPR: bull FVG and bear FVG overlapping at the same price
if confirmed and bprOn and (bullFvgRaw or bearFvgRaw) and array.size(zones) > 0
    float newTop = bullFvgRaw ? low : high
    float newBot = bullFvgRaw ? high[2] : low[2]
    string newDir = bullFvgRaw ? "BULL" : "BEAR"
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if z.kind == "FVG" and z.direction != newDir and z.state != "INVALID" and z.state != "FILLED"
            float bTop = math.min(newTop, z.top)
            float bBot = math.max(newBot, z.bottom)
            if bTop > bBot and not f_coveredByBetter("BPR", bTop, bBot)
                f_pushZone("BPR", newDir, bTop, bBot)
                newBullZone := newDir == "BULL" ? true : newBullZone
                newBearZone := newDir == "BEAR" ? true : newBearZone

// -- Phase 24 - Liquidity Void: voidBars candles in a row with almost no overlap
f_voidRun() =>
    bool ok = true
    for k = 1 to voidBars - 1
        float ov = math.max(0.0, math.min(high[k - 1], high[k]) - math.max(low[k - 1], low[k])) / math.max(high[k] - low[k], syminfo.mintick)
        if ov >= voidOv
            ok := false
    ok

voidRun = f_voidRun()

if confirmed and voidOn and voidRun
    float vTop = ta.highest(high, voidBars)
    float vBot = ta.lowest(low, voidBars)
    if vTop > vBot
        array.push(gaps, Gap.new(kind = "VOID", top = vTop, bottom = vBot, ce = (vTop + vBot) / 2, createdBar = bar_index))
        if array.size(gaps) > 30
            Gap og = array.shift(gaps)
            if not na(og.drawing)
                box.delete(og.drawing)
            if not na(og.ceLine)
                line.delete(og.ceLine)

// -- Phase 38 - Volume Imbalance (body gap with wick overlap) - refinement only, never main POI
bullVI = viOn and open > close[1] and low <= high[1] and (open - close[1]) >= atrVal * viMin
bearVI = viOn and open < close[1] and high >= low[1] and (close[1] - open) >= atrVal * viMin

if confirmed and bullVI
    array.push(gaps, Gap.new(kind = "VI", top = open, bottom = close[1], ce = (open + close[1]) / 2, createdBar = bar_index))
if confirmed and bearVI
    array.push(gaps, Gap.new(kind = "VI", top = close[1], bottom = open, ce = (open + close[1]) / 2, createdBar = bar_index))
if array.size(gaps) > 30
    Gap ogv = array.shift(gaps)
    if not na(ogv.drawing)
        box.delete(ogv.drawing)
    if not na(ogv.ceLine)
        line.delete(ogv.ceLine)

// -- gap lifecycle (Phase 24 / 25)
if confirmed and array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0
        Gap g = array.get(gaps, i)
        if not g.filled and low <= g.ce and high >= g.ce
            g.filled := true
        if g.filled or bar_index - g.createdBar > 500
            if not na(g.drawing)
                box.delete(g.drawing)
                g.drawing := na
            if not na(g.ceLine)
                line.delete(g.ceLine)
                g.ceLine := na
            if bar_index - g.createdBar > 500
                array.remove(gaps, i)

// -- Phase 6 / 7 - Zone lifecycle: NEW -> ACTIVE -> TOUCHED -> MITIGATED -> FILLED
if confirmed and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if z.state == "NEW" and bar_index > z.createdBar
            z.state := "ACTIVE"
        if z.state == "ACTIVE" or z.state == "TOUCHED" or z.state == "MITIGATED"
            float zh = math.max(z.top - z.bottom, syminfo.mintick)
            bool touching = low <= z.top and high >= z.bottom
            if touching
                // consecutive bars inside the zone are ONE touch, not one per bar
                if bar_index - z.lastTouchBar > 1
                    z.touchCount += 1
                z.lastTouchBar := bar_index
                float pen = z.direction == "BULL" ? (z.top - math.max(math.min(low, z.top), z.bottom)) / zh : (math.min(math.max(high, z.bottom), z.top) - z.bottom) / zh
                z.mitigationPct := math.max(z.mitigationPct, pen)
                z.state := z.mitigationPct >= 0.5 ? "MITIGATED" : "TOUCHED"
            bool killed = z.direction == "BULL" ? close < z.bottom : close > z.top
            if killed
                z.state := "FILLED"
                if bbOn
                    string invKind = z.kind == "FVG" ? "IFVG" : (z.kind == "OB" ? "BB" : "")
                    if invKind != ""
                        f_pushZone(invKind, z.direction == "BULL" ? "BEAR" : "BULL", z.top, z.bottom)

// === 07 - LAYER 3 - DECISION (the only door a signal comes out of) =========
f_latestZone(string dir) =>
    Zone found = na
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            if na(found) and z.direction == dir and not z.consumed and (z.state == "NEW" or z.state == "ACTIVE" or z.state == "TOUCHED")
                found := z
    found

f_reset(Setup s) =>
    s.state         := "IDLE"
    s.sweepLevel    := 0.0
    s.sweepBar      := 0
    s.mssLevel      := 0.0
    s.mssBar        := 0
    s.poi           := na
    s.poiBar        := 0
    s.entryPrice    := 0.0
    s.slPrice       := 0.0
    s.slInit        := 0.0
    s.tp1           := 0.0
    s.tp2           := 0.0
    s.tp3           := 0.0
    s.tp1Hit        := false
    s.tp2Hit        := false
    s.tp3Hit        := false
    s.beActive      := false
    s.posSize       := 0.0
    s.exitReason    := ""
    s.rr            := 0.0
    s.score         := 0
    s.entryBar      := 0
    s.signalEmitted := false
    s.modelName     := "STANDARD"
    s.dolTarget     := 0.0
    s.cisdConfirmed := false
    s.smtPresent    := false
    s.trapConfirmed := false
    s.tlqConfirmed  := false
    s.poiLeft       := false
    s.crtTbs        := false
    s.crtTws        := false
    s.scoreCtx      := 0
    s.scoreLiq      := 0
    s.scoreStr      := 0
    s.scoreMom      := 0
    s.scorePoi      := 0
    s.scoreLoc      := 0
    s.scoreTime     := 0
    s.scoreCorr     := 0
    s.scorePen      := 0
    true

f_score(string dir, Zone poi) =>
    int sc = 0
    sc += htfBias == (dir == "LONG" ? "BULL" : "BEAR") ? 2 : 0
    sc += 6
    if not na(poi)
        sc += (poi.kind == "FVG" or poi.kind == "IFVG") ? 1 : 0
        sc += (poi.kind == "OB" or poi.kind == "BB") ? 1 : 0
    sc += (dir == "LONG" ? inDiscount : inPremium) ? 1 : 0
    sc += inKz ? 1 : 0
    sc -= htfBias == (dir == "LONG" ? "BEAR" : "BULL") ? 3 : 0
    math.max(sc, 0)

f_entryLevel(string dir, Zone poi) =>
    float lvl = close
    if not na(poi)
        if entryRef == "Zone Edge"
            lvl := dir == "LONG" ? poi.top : poi.bottom
        else if entryRef == "CE"
            lvl := poi.ce
        else if entryRef == "Zone Full"
            lvl := dir == "LONG" ? poi.bottom : poi.top
    lvl

f_entryReached(string dir, float lvl) =>
    entryRef == "Close" ? true : (dir == "LONG" ? low <= lvl : high >= lvl)

// -- Phase 26 - IRL / ERL + Draw on Liquidity (TIER B)
dolBias   = htfBias != "NEUTRAL" ? htfBias : trendDir
dolTarget := not dolOn ? na : dolBias == "BULL" ? f_nextLiqAbove(close) : dolBias == "BEAR" ? f_nextLiqBelow(close) : na

// -- Phase 28 - Unicorn: Breaker + FVG overlap on the same price (runs only on new zone bars)
if confirmed and uniOn and (newBullZone or newBearZone) and array.size(zones) > 1
    for i = array.size(zones) - 1 to 0
        Zone za = array.get(zones, i)
        bool aliveA = za.state != "INVALID" and za.state != "FILLED"
        if aliveA and za.kind == "FVG"
            for j = array.size(zones) - 1 to 0
                Zone zb = array.get(zones, j)
                bool aliveB = zb.state != "INVALID" and zb.state != "FILLED"
                if aliveB and zb.kind == "BB" and zb.direction == za.direction
                    float ovTop = math.min(za.top, zb.top)
                    float ovBot = math.max(za.bottom, zb.bottom)
                    float hMin  = math.max(math.min(za.top - za.bottom, zb.top - zb.bottom), syminfo.mintick)
                    if ovTop > ovBot and (ovTop - ovBot) / hMin >= uniOv and not f_coveredByBetter("UNICORN", ovTop, ovBot)
                        f_pushZone("UNICORN", za.direction, ovTop, ovBot)

// -- Phase 28 - MMBM / MMSM market model
if mmOn and confirmed and rangeOk
    if sslSwept and not na(sweptSslLevel) and sweptSslLevel <= rangeLow + rangeSpan * 0.1
        marketModel := "MMBM"
    if bslSwept and not na(sweptBslLevel) and sweptBslLevel >= rangeHigh - rangeSpan * 0.1
        marketModel := "MMSM"

// -- Phase 30 - Std Dev projection helper
f_sdevTarget(string dir, float sweepLvl, float mssLvl) =>
    float lvl = na
    if sdevOn and not na(sweepLvl) and not na(mssLvl)
        float unit = math.abs(mssLvl - sweepLvl)
        if unit > 0
            array<string> parts = str.split(sdevStr, ",")
            if array.size(parts) > 0
                float m = math.abs(str.tonumber(array.get(parts, 0)))
                if not na(m)
                    lvl := dir == "LONG" ? sweepLvl + unit * m : sweepLvl - unit * m
    lvl

// -- Phase 31 - Score v2: class based, one point per class, hard caps
f_scoreV2(Setup st, string dir) =>
    bool isLong = dir == "LONG"
    // Context (max 2)
    int ctx = 0
    ctx += htfBias == (isLong ? "BULL" : "BEAR") ? 2 : 0
    ctx += dbOn and dailyBias == (isLong ? "BULL" : "BEAR") ? 1 : 0
    ctx += amdOn and amdBias == (isLong ? "BULL" : "BEAR") ? 1 : 0
    ctx := math.min(ctx, 2)
    // Liquidity (max 2)
    int liq = 2
    // Structure (max 2)
    int stc = 2
    stc += st.cisdConfirmed ? 1 : 0
    stc := math.min(stc, 2)
    // Momentum (max 2)
    int mom = 2
    // POI (max 1) + confluence (max 2)
    int poiS = na(st.poi) ? 0 : 1
    int conf = 0
    if not na(st.poi)
        conf += st.poi.kind == "UNICORN" ? 2 : 0
        conf += st.poi.kind == "BPR" ? 1 : 0
    conf := math.min(conf, 2)
    // Location (max 1)
    int loc = 0
    loc += (isLong ? inDiscount : inPremium) ? 1 : 0
    loc += (isLong ? inOteBull : inOteBear) ? 1 : 0
    loc := math.min(loc, 1)
    // Time (max 1)
    int tim = 0
    tim += inKz ? 1 : 0
    tim += inSB ? 1 : 0
    tim += inMacro ? 1 : 0
    tim += amdOn and amdPhase == "DISTRIB" ? 1 : 0
    tim := math.min(tim, 1)
    // Correlation (max 1)
    int cor = st.smtPresent ? 1 : 0
    // Penalties
    int pen = 0
    pen -= htfBias == (isLong ? "BEAR" : "BULL") ? 3 : 0
    pen -= dbOn and dailyBias == (isLong ? "BEAR" : "BULL") ? 2 : 0
    pen -= amdOn and amdPhase == "MANIP" and amdBias == (isLong ? "BEAR" : "BULL") ? 2 : 0
    pen -= not na(st.poi) and st.poi.touchCount >= 2 ? 1 : 0
    pen -= (isLong ? inPremium : inDiscount) ? 2 : 0
    pen -= regimeOn and inChop ? 3 : 0
    pen -= adrSpent and (isLong ? htfBias == "BULL" : htfBias == "BEAR") ? 2 : 0
    pen -= twsPenalty and st.crtTws and not st.crtTbs ? 1 : 0
    st.scoreCtx  := ctx
    st.scoreLiq  := liq
    st.scoreStr  := stc
    st.scoreMom  := mom
    st.scorePoi  := poiS
    st.scoreLoc  := loc
    st.scoreTime := tim
    st.scoreCorr := cor
    st.scorePen  := pen
    math.max(ctx + liq + stc + mom + poiS + conf + loc + tim + cor + pen, 0)

f_scoreFinal(Setup st, string dir) =>
    scoreModel == "v2" ? f_scoreV2(st, dir) : f_score(dir, st.poi)

f_scoreThreshold() =>
    scoreModel == "v2" ? minScoreV2 : minScore

// -- Phase 35 / 36 - regime + exhaustion gates (block only, never emit)
f_regimeOk(string dir, float entry) =>
    bool ok = true
    if regimeOn
        if inChop and chopBlock
            ok := false
        if inRange and rangeEdge and rangeOk
            float third = rangeSpan / 3.0
            ok := dir == "LONG" ? entry <= rangeLow + third : entry >= rangeHigh - third
    ok

f_adrOk(string dir) =>
    bool cont = dir == "LONG" ? htfBias == "BULL" : htfBias == "BEAR"
    not (adrSpent and adrBlockCont and cont)

// -- Phase 41 - position size (approximate - broker maths can differ)
f_posSize(float entry, float sl) =>
    float sz = 0.0
    if sizeOn
        float riskCash = acctSize * riskPct / 100.0
        float slDist   = math.abs(entry - sl)
        float pv       = math.max(syminfo.pointvalue, 0.000001)
        sz := riskCash / math.max(slDist * pv, 0.000001)
    sz

f_sizeUnit() =>
    string u = syminfo.type == "forex" ? " lot" : syminfo.type == "crypto" ? " " + syminfo.basecurrency : " contracts"
    u

// -- Phase 42 - news blackout (Pine has no news feed - times are typed by hand)
f_newsBlackout() =>
    bool b = false
    if newsOn
        int nowMin = hour(time, sessTz) * 60 + minute(time, sessTz)
        array<string> ts = str.split(newsTimes, ",")
        if array.size(ts) > 0
            for i = 0 to array.size(ts) - 1
                float v = str.tonumber(array.get(ts, i))
                if not na(v)
                    float hh   = math.floor(v / 100)
                    float mm   = v - hh * 100
                    float tMin = hh * 60 + mm
                    if math.abs(nowMin - tMin) <= newsPad
                        b := true
    b

inBlackout = f_newsBlackout()
sessionEnd = inNy[1] and not inNy

// -- Phase 40 - TP ladder
f_tpLadder(string dir, float entry, float sl, float tpLiq, int which) =>
    float risk = math.max(math.abs(entry - sl), syminfo.mintick)
    float t1 = 0.0
    float t2 = 0.0
    float t3 = 0.0
    if dir == "LONG"
        t1 := tpMode == "R-based" or na(tpLiq) ? entry + risk * tp1R : tpLiq
        float n2 = f_nextLiqAbove(t1)
        t2 := tpMode == "R-based" or na(n2) ? entry + risk * tp2R : n2
        float n3 = f_nextLiqAbove(t2)
        t3 := tpMode == "R-based" or na(n3) ? entry + risk * tp3R : n3
    else
        t1 := tpMode == "R-based" or na(tpLiq) ? entry - risk * tp1R : tpLiq
        float n2 = f_nextLiqBelow(t1)
        t2 := tpMode == "R-based" or na(n2) ? entry - risk * tp2R : n2
        float n3 = f_nextLiqBelow(t2)
        t3 := tpMode == "R-based" or na(n3) ? entry - risk * tp3R : n3
    // TP2 can never sit behind TP1, TP3 never behind TP2
    if dir == "LONG"
        t2 := math.max(t2, t1 + risk * 0.25)
        t3 := math.max(t3, t2 + risk * 0.25)
    else
        t2 := math.min(t2, t1 - risk * 0.25)
        t3 := math.min(t3, t2 - risk * 0.25)
    which == 1 ? t1 : which == 2 ? t2 : t3

ctxLongOk  = (not requireHtf or htfBias == "BULL") and (not requirePd or inDiscount)
ctxShortOk = (not requireHtf or htfBias == "BEAR") and (not requirePd or inPremium)

bool longTrigger  = false
bool shortTrigger = false

// -- Phase 31 - evidence flags collected while a setup is alive (never emit, only score)
if confirmed
    if activeLong.state != "IDLE"
        activeLong.smtPresent    := activeLong.smtPresent or bullSMT
        activeLong.cisdConfirmed := activeLong.cisdConfirmed or bullCISD
        activeLong.trapConfirmed := activeLong.trapConfirmed or bearTrap or tsLong
        activeLong.tlqConfirmed  := activeLong.tlqConfirmed or tlqBull
    if activeShort.state != "IDLE"
        activeShort.smtPresent    := activeShort.smtPresent or bearSMT
        activeShort.cisdConfirmed := activeShort.cisdConfirmed or bearCISD
        activeShort.trapConfirmed := activeShort.trapConfirmed or bullTrap or tsShort
        activeShort.tlqConfirmed  := activeShort.tlqConfirmed or tlqBear

    if activeLong.state != "IDLE"
        activeLong.crtTbs := activeLong.crtTbs or crtTbsBull
        activeLong.crtTws := activeLong.crtTws or (crtTwsBull and not crtTbsBull)
    if activeShort.state != "IDLE"
        activeShort.crtTbs := activeShort.crtTbs or crtTbsBear
        activeShort.crtTws := activeShort.crtTws or (crtTwsBear and not crtTbsBear)

// ---------------- LONG ----------------
if engineOn and confirmed
    if activeLong.state == "IDLE"
        if ctxLongOk
            activeLong.state := "CONTEXT_FOUND"
    else if activeLong.state == "CONTEXT_FOUND"
        if not ctxLongOk
            activeLong.state := "IDLE"
        else if sslSwept and not na(sweptSslLevel)
            activeLong.state      := "LIQUIDITY_SWEPT"
            activeLong.sweepLevel := math.min(sweptSslLevel, low)
            activeLong.sweepBar   := bar_index
    else if activeLong.state == "LIQUIDITY_SWEPT"
        if bar_index - activeLong.sweepBar > mssTimeout
            activeLong.state := "INVALIDATED"
        else if dispBullOk and bar_index > activeLong.sweepBar
            activeLong.state := "DISPLACEMENT_CONFIRMED"
    else if activeLong.state == "DISPLACEMENT_CONFIRMED"
        if bar_index - activeLong.sweepBar > mssTimeout
            activeLong.state := "INVALIDATED"
        else if mssUp
            activeLong.state    := "MSS_CONFIRMED"
            activeLong.mssLevel := intHigh
            activeLong.mssBar   := bar_index
    else if activeLong.state == "MSS_CONFIRMED"
        if bar_index - activeLong.mssBar > mssValidBars
            activeLong.state := "INVALIDATED"
        else
            Zone cand = f_latestZone("BULL")
            if not na(cand) and cand.createdBar >= activeLong.sweepBar
                activeLong.state  := "POI_CREATED"
                activeLong.poi    := cand
                activeLong.poiBar := bar_index
    else if activeLong.state == "POI_CREATED"
        if na(activeLong.poi) or bar_index - activeLong.poiBar > poiTimeout
            activeLong.state := "INVALIDATED"
        else if activeLong.poi.state == "FILLED" or activeLong.poi.state == "INVALID"
            activeLong.state := "INVALIDATED"
        else
            // price must LEAVE the POI before a return counts as a retrace
            bool touchingL = low <= activeLong.poi.top and high >= activeLong.poi.bottom
            if not touchingL
                activeLong.poiLeft := true
            else if activeLong.poiLeft
                activeLong.state := "RETRACE_WAIT"
    else if activeLong.state == "RETRACE_WAIT"
        if na(activeLong.poi) or activeLong.poi.state == "FILLED" or activeLong.poi.state == "INVALID" or bar_index - activeLong.poiBar > poiTimeout
            activeLong.state := "INVALIDATED"
        else
            float entryL  = f_entryLevel("LONG", activeLong.poi)
            bool  reachL  = f_entryReached("LONG", entryL)
            float slL     = activeLong.sweepLevel - atrVal * slBufferMult
            float riskL   = math.max(entryL - slL, syminfo.mintick)
            float tpLiqL  = f_nextLiqAbove(entryL)
            float tpSdL   = f_sdevTarget("LONG", activeLong.sweepLevel, activeLong.mssLevel)
            float tpL     = not na(tpLiqL) ? tpLiqL : (sdevOn and sdevAsTp and not na(tpSdL) ? tpSdL : entryL + riskL * 2.0)
            float rrL     = (tpL - entryL) / riskL
            int   scL     = f_scoreFinal(activeLong, "LONG")
            bool  kzOkL   = not killZoneReq or inKz
            bool  sbOkL   = not sbOnly or inSB
            bool  regOkL  = f_regimeOk("LONG", entryL) and f_adrOk("LONG") and not inBlackout
            if reachL and sbOkL and regOkL and rrL >= minRREff and scL >= f_scoreThreshold() and kzOkL and entryL > slL
                activeLong.entryPrice := entryL
                activeLong.slPrice    := slL
                activeLong.slInit     := slL
                float l1 = f_tpLadder("LONG", entryL, slL, tpLiqL, 1)
                activeLong.tp1        := tmOn ? l1 : tpL
                activeLong.tp2        := f_tpLadder("LONG", entryL, slL, tpLiqL, 2)
                activeLong.tp3        := f_tpLadder("LONG", entryL, slL, tpLiqL, 3)
                activeLong.posSize    := f_posSize(entryL, slL)
                activeLong.rr         := rrL
                activeLong.score      := scL
                activeLong.state      := "ENTRY_TRIGGERED"
                activeLong.modelName  := not na(activeLong.poi) and activeLong.poi.kind == "UNICORN" ? "UNICORN" : inSB ? "SILVER_BULLET" : marketModel == "MMBM" ? "MMBM" : "STANDARD"
                activeLong.dolTarget  := na(dolTarget) ? 0.0 : dolTarget
                longTrigger           := true
    else if activeLong.state == "TRADE_ACTIVE"
        if not tmOn
            if low <= activeLong.slPrice or high >= activeLong.tp1 or bar_index - activeLong.entryBar > tradeTimeout or (eodFlat and sessionEnd)
                activeLong.exitReason := low <= activeLong.slPrice ? "SL" : high >= activeLong.tp1 ? "TP1" : (eodFlat and sessionEnd) ? "EOD" : "TIME"
                activeLong.state := "INVALIDATED"
        else
            // SL first - same bar SL and TP counts as SL (conservative)
            if low <= activeLong.slPrice
                activeLong.exitReason := activeLong.beActive ? "BE" : "SL"
                activeLong.state := "INVALIDATED"
            else
                if not activeLong.tp1Hit and high >= activeLong.tp1
                    activeLong.tp1Hit := true
                    if beOnTP1
                        activeLong.slPrice := activeLong.entryPrice
                        activeLong.beActive := true
                if not activeLong.tp2Hit and high >= activeLong.tp2
                    activeLong.tp2Hit := true
                if not activeLong.tp3Hit and high >= activeLong.tp3
                    activeLong.tp3Hit := true
                    activeLong.exitReason := "TP3"
                    activeLong.state := "INVALIDATED"
                if trailOn and newSwingLow and not na(lastSwingLow)
                    float newSl = lastSwingLow - atrVal * trailBuf
                    activeLong.slPrice := math.max(activeLong.slPrice, newSl)
                if activeLong.state == "TRADE_ACTIVE" and (bar_index - activeLong.entryBar > tradeTimeout or (eodFlat and sessionEnd))
                    activeLong.exitReason := eodFlat and sessionEnd ? "EOD" : "TIME"
                    activeLong.state := "INVALIDATED"

// ---------------- SHORT ----------------
if engineOn and confirmed
    if activeShort.state == "IDLE"
        if ctxShortOk
            activeShort.state := "CONTEXT_FOUND"
    else if activeShort.state == "CONTEXT_FOUND"
        if not ctxShortOk
            activeShort.state := "IDLE"
        else if bslSwept and not na(sweptBslLevel)
            activeShort.state      := "LIQUIDITY_SWEPT"
            activeShort.sweepLevel := math.max(sweptBslLevel, high)
            activeShort.sweepBar   := bar_index
    else if activeShort.state == "LIQUIDITY_SWEPT"
        if bar_index - activeShort.sweepBar > mssTimeout
            activeShort.state := "INVALIDATED"
        else if dispBearOk and bar_index > activeShort.sweepBar
            activeShort.state := "DISPLACEMENT_CONFIRMED"
    else if activeShort.state == "DISPLACEMENT_CONFIRMED"
        if bar_index - activeShort.sweepBar > mssTimeout
            activeShort.state := "INVALIDATED"
        else if mssDn
            activeShort.state    := "MSS_CONFIRMED"
            activeShort.mssLevel := intLow
            activeShort.mssBar   := bar_index
    else if activeShort.state == "MSS_CONFIRMED"
        if bar_index - activeShort.mssBar > mssValidBars
            activeShort.state := "INVALIDATED"
        else
            Zone candS = f_latestZone("BEAR")
            if not na(candS) and candS.createdBar >= activeShort.sweepBar
                activeShort.state  := "POI_CREATED"
                activeShort.poi    := candS
                activeShort.poiBar := bar_index
    else if activeShort.state == "POI_CREATED"
        if na(activeShort.poi) or bar_index - activeShort.poiBar > poiTimeout
            activeShort.state := "INVALIDATED"
        else if activeShort.poi.state == "FILLED" or activeShort.poi.state == "INVALID"
            activeShort.state := "INVALIDATED"
        else
            bool touchingS = low <= activeShort.poi.top and high >= activeShort.poi.bottom
            if not touchingS
                activeShort.poiLeft := true
            else if activeShort.poiLeft
                activeShort.state := "RETRACE_WAIT"
    else if activeShort.state == "RETRACE_WAIT"
        if na(activeShort.poi) or activeShort.poi.state == "FILLED" or activeShort.poi.state == "INVALID" or bar_index - activeShort.poiBar > poiTimeout
            activeShort.state := "INVALIDATED"
        else
            float entryS = f_entryLevel("SHORT", activeShort.poi)
            bool  reachS = f_entryReached("SHORT", entryS)
            float slS    = activeShort.sweepLevel + atrVal * slBufferMult
            float riskS  = math.max(slS - entryS, syminfo.mintick)
            float tpLiqS = f_nextLiqBelow(entryS)
            float tpSdS  = f_sdevTarget("SHORT", activeShort.sweepLevel, activeShort.mssLevel)
            float tpS    = not na(tpLiqS) ? tpLiqS : (sdevOn and sdevAsTp and not na(tpSdS) ? tpSdS : entryS - riskS * 2.0)
            float rrS    = (entryS - tpS) / riskS
            int   scS    = f_scoreFinal(activeShort, "SHORT")
            bool  kzOkS  = not killZoneReq or inKz
            bool  sbOkS  = not sbOnly or inSB
            bool  regOkS = f_regimeOk("SHORT", entryS) and f_adrOk("SHORT") and not inBlackout
            if reachS and sbOkS and regOkS and rrS >= minRREff and scS >= f_scoreThreshold() and kzOkS and slS > entryS
                activeShort.entryPrice := entryS
                activeShort.slPrice    := slS
                activeShort.slInit     := slS
                float s1 = f_tpLadder("SHORT", entryS, slS, tpLiqS, 1)
                activeShort.tp1        := tmOn ? s1 : tpS
                activeShort.tp2        := f_tpLadder("SHORT", entryS, slS, tpLiqS, 2)
                activeShort.tp3        := f_tpLadder("SHORT", entryS, slS, tpLiqS, 3)
                activeShort.posSize    := f_posSize(entryS, slS)
                activeShort.rr         := rrS
                activeShort.score      := scS
                activeShort.state      := "ENTRY_TRIGGERED"
                activeShort.modelName  := not na(activeShort.poi) and activeShort.poi.kind == "UNICORN" ? "UNICORN" : inSB ? "SILVER_BULLET" : marketModel == "MMSM" ? "MMSM" : "STANDARD"
                activeShort.dolTarget  := na(dolTarget) ? 0.0 : dolTarget
                shortTrigger           := true
    else if activeShort.state == "TRADE_ACTIVE"
        if not tmOn
            if high >= activeShort.slPrice or low <= activeShort.tp1 or bar_index - activeShort.entryBar > tradeTimeout or (eodFlat and sessionEnd)
                activeShort.exitReason := high >= activeShort.slPrice ? "SL" : low <= activeShort.tp1 ? "TP1" : (eodFlat and sessionEnd) ? "EOD" : "TIME"
                activeShort.state := "INVALIDATED"
        else
            if high >= activeShort.slPrice
                activeShort.exitReason := activeShort.beActive ? "BE" : "SL"
                activeShort.state := "INVALIDATED"
            else
                if not activeShort.tp1Hit and low <= activeShort.tp1
                    activeShort.tp1Hit := true
                    if beOnTP1
                        activeShort.slPrice := activeShort.entryPrice
                        activeShort.beActive := true
                if not activeShort.tp2Hit and low <= activeShort.tp2
                    activeShort.tp2Hit := true
                if not activeShort.tp3Hit and low <= activeShort.tp3
                    activeShort.tp3Hit := true
                    activeShort.exitReason := "TP3"
                    activeShort.state := "INVALIDATED"
                if trailOn and newSwingHigh and not na(lastSwingHigh)
                    float newSl = lastSwingHigh + atrVal * trailBuf
                    activeShort.slPrice := math.min(activeShort.slPrice, newSl)
                if activeShort.state == "TRADE_ACTIVE" and (bar_index - activeShort.entryBar > tradeTimeout or (eodFlat and sessionEnd))
                    activeShort.exitReason := eodFlat and sessionEnd ? "EOD" : "TIME"
                    activeShort.state := "INVALIDATED"

// -- same bar LONG + SHORT -> reject both
if longTrigger and shortTrigger
    activeLong.state  := "INVALIDATED"
    activeShort.state := "INVALIDATED"
    longTrigger       := false
    shortTrigger      := false

longSignal  = longTrigger  and not activeLong.signalEmitted
shortSignal = shortTrigger and not activeShort.signalEmitted

if longSignal
    activeLong.signalEmitted := true
    activeLong.entryBar      := bar_index
    activeLong.state         := "TRADE_ACTIVE"
    totalLong                += 1
    todayLong                += 1
    if not na(activeLong.poi)
        activeLong.poi.consumed := true

if shortSignal
    activeShort.signalEmitted := true
    activeShort.entryBar      := bar_index
    activeShort.state         := "TRADE_ACTIVE"
    totalShort                += 1
    todayShort                += 1
    if not na(activeShort.poi)
        activeShort.poi.consumed := true

// -- Phase 32 - bars-in-state tracking
if activeLong.state != prevLongState
    prevLongState := activeLong.state
    longStateBar  := bar_index
if activeShort.state != prevShortState
    prevShortState := activeShort.state
    shortStateBar  := bar_index
if newDay
    todayLong  := 0
    todayShort := 0

// -- Phase 44 - R of a closed trade (pure: functions cannot write globals in Pine)
f_tradeR(Setup st) =>
    float r = na
    if st.state == "INVALIDATED" and st.entryBar > 0 and st.exitReason != ""
        float exitPx = st.exitReason == "SL" ? st.slPrice : st.exitReason == "BE" ? st.entryPrice : st.exitReason == "TP1" ? st.tp1 : st.exitReason == "TP3" ? st.tp3 : close
        float den    = math.max(math.abs(st.entryPrice - st.slInit), syminfo.mintick)
        r := (st.direction == "LONG" ? exitPx - st.entryPrice : st.entryPrice - exitPx) / den
    r

// === 08 - CLEANUP ==========================================================
if confirmed
    if activeLong.state == "INVALIDATED"
        float rL = f_tradeR(activeLong)
        if not na(rL)
            nTrades += 1
            sumR    += rL
            sumRR   += activeLong.rr
            bestR   := nTrades == 1 ? rL : math.max(bestR, rL)
            worstR  := nTrades == 1 ? rL : math.min(worstR, rL)
            if rL > 0
                nWins   += 1
                lossRun := 0
            else if rL < 0
                lossRun    += 1
                maxLossRun := math.max(maxLossRun, lossRun)
        f_reset(activeLong)
    if activeShort.state == "INVALIDATED"
        float rS = f_tradeR(activeShort)
        if not na(rS)
            nTrades += 1
            sumR    += rS
            sumRR   += activeShort.rr
            bestR   := nTrades == 1 ? rS : math.max(bestR, rS)
            worstR  := nTrades == 1 ? rS : math.min(worstR, rS)
            if rS > 0
                nWins   += 1
                lossRun := 0
            else if rS < 0
                lossRun    += 1
                maxLossRun := math.max(maxLossRun, lossRun)
        f_reset(activeShort)

if confirmed and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        bool dead = (z.state == "FILLED" or z.state == "INVALID") and hideDead
        bool aged = bar_index - z.createdBar > 500
        if dead or aged
            if not na(z.drawing)
                box.delete(z.drawing)
                z.drawing := na
            if not na(z.ceLine)
                line.delete(z.ceLine)
                z.ceLine := na
            array.remove(zones, i)

// a swept level is history - drop it so the cap does not evict live levels instead
if confirmed and array.size(liquidity) > 0
    for i = array.size(liquidity) - 1 to 0
        LiqLevel lv = array.get(liquidity, i)
        if lv.swept and bar_index - lv.sweptBar > 50
            if not na(lv.drawing)
                line.delete(lv.drawing)
            if not na(lv.lbl)
                label.delete(lv.lbl)
            array.remove(liquidity, i)

// liquidity hard cap (TLQ / TRAP pushes bypass f_pushLiq)
if array.size(liquidity) > 50
    LiqLevel oldL = array.shift(liquidity)
    if not na(oldL.drawing)
        line.delete(oldL.drawing)
    if not na(oldL.lbl)
        label.delete(oldL.lbl)

if array.size(zones) > 100
    Zone oldZ = array.shift(zones)
    if not na(oldZ.drawing)
        box.delete(oldZ.drawing)
    if not na(oldZ.ceLine)
        line.delete(oldZ.ceLine)

// === 09 - DRAWING ==========================================================
// -- Phase 1 - swing labels
densFull = densityMode == "Full"
densNorm = densityMode == "Full" or densityMode == "Normal"

// one text size for everything the script draws
tSize    = uiTextSize == "Large" ? size.large : uiTextSize == "Small" ? size.small : size.normal
tSizeSub = uiTextSize == "Large" ? size.normal : uiTextSize == "Small" ? size.tiny : size.small

if showSwings and densNorm and not na(ph)
    label.new(bar_index - swingLenEff, high[swingLenEff], hiLbl, style = label.style_label_down, color = color.new(colBear, 20), textcolor = color.white, size = tSizeSub)
if showSwings and densNorm and not na(pl)
    label.new(bar_index - swingLenEff, low[swingLenEff], loLbl, style = label.style_label_up, color = color.new(colBull, 20), textcolor = color.white, size = tSizeSub)

// -- Phase 3 - BOS / CHoCH
if showBOS and densNorm and (bosUp or chochUp) and not na(lastSwingHigh) and not na(lastSwingHighBar)
    line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color = colBull, style = line.style_dashed, width = 1)
    label.new(bar_index, lastSwingHigh, chochUp ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(chochUp ? color.orange : colBull, 20), textcolor = color.white, size = tSizeSub)

if showBOS and densNorm and (bosDn or chochDn) and not na(lastSwingLow) and not na(lastSwingLowBar)
    line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color = colBear, style = line.style_dashed, width = 1)
    label.new(bar_index, lastSwingLow, chochDn ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(chochDn ? color.orange : colBear, 20), textcolor = color.white, size = tSizeSub)

// -- Phase 4 - displacement marker
plotshape(showDisp and isBullDisp, title = "Bull Displacement", style = shape.triangleup, location = location.belowbar, color = colBull, size = size.tiny)
plotshape(showDisp and isBearDisp, title = "Bear Displacement", style = shape.triangledown, location = location.abovebar, color = colBear, size = size.tiny)

// -- Phase 2 - liquidity lines
if liqOn and densNorm and array.size(liquidity) > 0
    for i = 0 to array.size(liquidity) - 1
        LiqLevel lv = array.get(liquidity, i)
        bool vis = lv.kind == "BSL" or lv.kind == "SSL" ? showBslSsl : lv.kind == "EQH" or lv.kind == "EQL" ? showEq : lv.kind == "PDH" or lv.kind == "PDL" ? showPdhPdl : showPwhPwl
        if vis and na(lv.drawing)
            lv.drawing := line.new(lv.createdBar, lv.price, bar_index, lv.price, color = colLiq, style = line.style_dotted, width = 1)
            lv.lbl     := label.new(lv.createdBar, lv.price, lv.kind, style = label.style_none, textcolor = color.new(colLiq, 0), size = tSizeSub)
        if not na(lv.drawing)
            if not lv.swept
                line.set_x2(lv.drawing, bar_index)
            else
                line.set_color(lv.drawing, color.new(colLiq, 70))

// -- Phase 6 / 7 - zone boxes
if showZones and array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        bool isPoiNow = (not na(activeLong.poi) and z.id == activeLong.poi.id) or (not na(activeShort.poi) and z.id == activeShort.poi.id)
        bool kindOn = z.kind == "FVG" ? fvgOn : z.kind == "OB" ? obOn : z.kind == "SD" ? sdOn : z.kind == "MB" ? mbOn : z.kind == "RB" ? rbOn : z.kind == "BPR" ? bprOn : z.kind == "UNICORN" ? uniOn : z.kind == "HTF_FVG" ? htfPoiOn : bbOn
        bool vis = kindOn and (densNorm or isPoiNow)
        color zc = z.kind == "FVG" ? colFvg : z.kind == "OB" ? colOb : z.kind == "SD" ? colSd : (z.kind == "MB" or z.kind == "RB") ? colRb : z.kind == "BPR" ? colBpr : z.kind == "UNICORN" ? colUni : z.kind == "HTF_FVG" ? colHtfPoi : colBb
        if vis and na(z.drawing)
            z.drawing := box.new(z.createdBar, z.top, z.createdBar + zoneExtend, z.bottom, border_color = color.new(zc, 40), bgcolor = zc, text = f_zoneLabel(z.kind, z.direction), text_size = size.small, text_color = uiTextCol, text_halign = text.align_left)
            box.set_text_size(z.drawing, tSizeSub)
            if showCE
                z.ceLine := line.new(z.createdBar, z.ce, z.createdBar + zoneExtend, z.ce, color = color.new(zc, 30), style = line.style_dashed, width = 1)
        if not na(z.drawing)
            bool alive = z.state == "NEW" or z.state == "ACTIVE" or z.state == "TOUCHED" or z.state == "MITIGATED"
            if alive and bar_index + zoneExtend > box.get_right(z.drawing)
                box.set_right(z.drawing, bar_index + zoneExtend)
                if not na(z.ceLine)
                    line.set_x2(z.ceLine, bar_index + zoneExtend)

// -- Phase 8 - dealing range / EQ / OTE
var line  eqLn   = na
var box   oteBxL = na
var box   oteBxS = na
if pdOn and showPd and rangeOk and barstate.islast and not na(lastSwingHighBar) and not na(lastSwingLowBar)
    int xLeft = math.min(lastSwingHighBar, lastSwingLowBar)
    if na(eqLn)
        eqLn := line.new(xLeft, eqLevel, bar_index + 10, eqLevel, color = color.new(color.gray, 20), style = line.style_dotted)
    else
        line.set_xy1(eqLn, xLeft, eqLevel)
        line.set_xy2(eqLn, bar_index + 10, eqLevel)
    if na(oteBxL)
        oteBxL := box.new(xLeft, oteBullTop, bar_index + 10, oteBullBot, border_color = color.new(colBull, 100), bgcolor = color.new(colBull, 90))
    else
        box.set_lefttop(oteBxL, xLeft, oteBullTop)
        box.set_rightbottom(oteBxL, bar_index + 10, oteBullBot)
    if na(oteBxS)
        oteBxS := box.new(xLeft, oteBearTop, bar_index + 10, oteBearBot, border_color = color.new(colBear, 100), bgcolor = color.new(colBear, 90))
    else
        box.set_lefttop(oteBxS, xLeft, oteBearTop)
        box.set_rightbottom(oteBxS, bar_index + 10, oteBearBot)

// -- Phase 10 - session shading
bgcolor(shadeSess and inAsia   ? color.new(color.blue,   93) : na, title = "Asia")
bgcolor(shadeSess and inLondon ? color.new(color.orange, 93) : na, title = "London")
bgcolor(shadeSess and inNy     ? color.new(color.green,  93) : na, title = "New York")

// -- Phase 12 / 14 - signal visuals
if longSignal
    label.new(bar_index, low, (intrabar and not barstate.isconfirmed ? "LIVE " : "") + "LONG\nE " + str.tostring(activeLong.entryPrice, format.mintick) + "\nSL " + str.tostring(activeLong.slPrice, format.mintick) + "\nTP " + str.tostring(activeLong.tp1, format.mintick) + "\nRR " + str.tostring(activeLong.rr, "#.##") + " | S" + str.tostring(activeLong.score) + (sizeOn ? "\nSize " + str.tostring(activeLong.posSize, "#.##") + f_sizeUnit() : ""), style = label.style_label_up, color = colBull, textcolor = color.white, size = tSize)
    line.new(bar_index, activeLong.slPrice, bar_index + 20, activeLong.slPrice, color = colBear, style = line.style_solid, width = 1)
    line.new(bar_index, activeLong.tp1,     bar_index + 20, activeLong.tp1,     color = colBull, style = line.style_solid, width = 1)

if shortSignal
    label.new(bar_index, high, (intrabar and not barstate.isconfirmed ? "LIVE " : "") + "SHORT\nE " + str.tostring(activeShort.entryPrice, format.mintick) + "\nSL " + str.tostring(activeShort.slPrice, format.mintick) + "\nTP " + str.tostring(activeShort.tp1, format.mintick) + "\nRR " + str.tostring(activeShort.rr, "#.##") + " | S" + str.tostring(activeShort.score) + (sizeOn ? "\nSize " + str.tostring(activeShort.posSize, "#.##") + f_sizeUnit() : ""), style = label.style_label_down, color = colBear, textcolor = color.white, size = tSize)
    line.new(bar_index, activeShort.slPrice, bar_index + 20, activeShort.slPrice, color = colBear, style = line.style_solid, width = 1)
    line.new(bar_index, activeShort.tp1,     bar_index + 20, activeShort.tp1,     color = colBull, style = line.style_solid, width = 1)

// -- Phase 17 / 18 - trendline drawing
if tlOn and tlShow and densNorm and array.size(trendlines) > 0
    for i = 0 to array.size(trendlines) - 1
        Trendline t = array.get(trendlines, i)
        color tc = t.isSupport ? colBull : colBear
        int   tp = int(math.max(0, math.min(80, 80 - t.strength * 0.6)))
        if na(t.drawing)
            t.drawing := line.new(t.x1, t.y1, bar_index, f_tlPriceAt(t, bar_index), color = color.new(tc, tp), width = 1)
        else
            line.set_color(t.drawing, color.new(t.broken ? color.gray : tc, tp))
            if not t.broken
                line.set_xy2(t.drawing, bar_index, f_tlPriceAt(t, bar_index))
        if tlChanOn and not t.broken and t.chanOffset >= atrVal * 1.5
            float off1 = t.isSupport ? t.y1 + t.chanOffset : t.y1 - t.chanOffset
            float off2 = t.isSupport ? f_tlPriceAt(t, bar_index) + t.chanOffset : f_tlPriceAt(t, bar_index) - t.chanOffset
            if na(t.chanLine)
                t.chanLine := line.new(t.x1, off1, bar_index, off2, color = color.new(tc, 70), style = line.style_dotted, width = 1)
            else
                line.set_xy1(t.chanLine, t.x1, off1)
                line.set_xy2(t.chanLine, bar_index, off2)

// -- Phase 19 - CISD level
var line cisdLnB = na
var line cisdLnS = na
if cisdOn and cisdShow and barstate.islast
    if not na(cisdBullLevel)
        if na(cisdLnB)
            cisdLnB := line.new(bar_index - 20, cisdBullLevel, bar_index + 5, cisdBullLevel, color = color.new(colBull, 40), style = line.style_dashed)
        else
            line.set_xy1(cisdLnB, bar_index - 20, cisdBullLevel)
            line.set_xy2(cisdLnB, bar_index + 5, cisdBullLevel)
    if not na(cisdBearLevel)
        if na(cisdLnS)
            cisdLnS := line.new(bar_index - 20, cisdBearLevel, bar_index + 5, cisdBearLevel, color = color.new(colBear, 40), style = line.style_dashed)
        else
            line.set_xy1(cisdLnS, bar_index - 20, cisdBearLevel)
            line.set_xy2(cisdLnS, bar_index + 5, cisdBearLevel)

// -- Phase 20 - SMT marker
plotshape(smtShow and bullSMT, title = "Bull SMT", style = shape.xcross, location = location.belowbar, color = color.new(colBull, 0), size = size.tiny)
plotshape(smtShow and bearSMT, title = "Bear SMT", style = shape.xcross, location = location.abovebar, color = color.new(colBear, 0), size = size.tiny)

// -- Phase 21 - Asia range box
if amdOn and amdShow and barstate.islast and not na(asiaHigh) and not na(asiaLow)
    if na(asiaBox)
        asiaBox := box.new(bar_index - 50, asiaHigh, bar_index, asiaLow, border_color = color.new(color.purple, 40), bgcolor = color.new(color.purple, 92))
    else
        box.set_lefttop(asiaBox, bar_index - 50, asiaHigh)
        box.set_rightbottom(asiaBox, bar_index, asiaLow)

// -- Phase 22 - trap / turtle soup markers
plotshape(trapShow and (bullTrap or tsShort), title = "Bull Trap", style = shape.labeldown, location = location.abovebar, color = color.new(colBear, 20), text = "TRAP", textcolor = color.white, size = size.small)
plotshape(trapShow and (bearTrap or tsLong),  title = "Bear Trap", style = shape.labelup,   location = location.belowbar, color = color.new(colBull, 20), text = "TRAP", textcolor = color.white, size = size.small)

// -- Phase 24 - liquidity void boxes
if voidOn and array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap g = array.get(gaps, i)
        if na(g.drawing) and not g.filled
            g.drawing := box.new(g.createdBar - 2, g.top, g.createdBar + zoneExtend, g.bottom, border_color = color.new(colVoid, 60), bgcolor = colVoid, text = g.kind, text_size = size.small, text_color = uiTextCol)
            box.set_text_size(g.drawing, tSizeSub)
            g.ceLine  := line.new(g.createdBar - 2, g.ce, g.createdBar + zoneExtend, g.ce, color = color.new(colVoid, 30), style = line.style_dashed)
        if not na(g.drawing) and not g.filled and bar_index + zoneExtend > box.get_right(g.drawing)
            box.set_right(g.drawing, bar_index + zoneExtend)
            if not na(g.ceLine)
                line.set_x2(g.ceLine, bar_index + zoneExtend)

// -- Phase 25 - opening gap boxes
if array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap g = array.get(gaps, i)
        bool gvis = g.kind == "VOID" ? voidOn : g.kind == "NWOG" ? nwogOn : g.kind == "NDOG" ? ndogOn : orgOn
        if gvis and na(g.drawing) and not g.filled and g.kind != "VOID"
            g.drawing := box.new(g.createdBar, g.top, g.createdBar + zoneExtend, g.bottom, border_color = color.new(colGap, 60), bgcolor = colGap, text = g.kind, text_size = size.small, text_color = uiTextCol)
            box.set_text_size(g.drawing, tSizeSub)
            g.ceLine  := line.new(g.createdBar, g.ce, g.createdBar + zoneExtend, g.ce, color = color.new(colGap, 30), style = line.style_dashed)
        if gvis and not na(g.drawing) and not g.filled and bar_index + zoneExtend > box.get_right(g.drawing)
            box.set_right(g.drawing, bar_index + zoneExtend)
            if not na(g.ceLine)
                line.set_x2(g.ceLine, bar_index + zoneExtend)

// -- Phase 26 - DOL target line
if dolOn and dolShow and barstate.islast and not na(dolTarget)
    if na(dolLine)
        dolLine := line.new(bar_index - 30, dolTarget, bar_index + 15, dolTarget, color = color.new(color.yellow, 20), style = line.style_arrow_right, width = 2)
    else
        line.set_xy1(dolLine, bar_index - 30, dolTarget)
        line.set_xy2(dolLine, bar_index + 15, dolTarget)

// -- Phase 27 - SB window shading
bgcolor(sbShade and inSB ? color.new(color.teal, 90) : na, title = "Silver Bullet")

// -- Phase 29 - weekly / daily open lines
if dbOn and dbShow and barstate.islast
    if not na(weeklyOpen)
        if na(wOpenLn)
            wOpenLn := line.new(bar_index - 60, weeklyOpen, bar_index + 10, weeklyOpen, color = color.new(color.orange, 30), style = line.style_dotted, width = 2)
        else
            line.set_xy1(wOpenLn, bar_index - 60, weeklyOpen)
            line.set_xy2(wOpenLn, bar_index + 10, weeklyOpen)
    if not na(dailyOpen)
        if na(dOpenLn)
            dOpenLn := line.new(bar_index - 30, dailyOpen, bar_index + 10, dailyOpen, color = color.new(color.blue, 30), style = line.style_dotted, width = 1)
        else
            line.set_xy1(dOpenLn, bar_index - 30, dailyOpen)
            line.set_xy2(dOpenLn, bar_index + 10, dailyOpen)

// -- Phase 30 - std dev projection lines for the active setup
if sdevOn and barstate.islast
    if array.size(sdevLines) > 0
        for i = array.size(sdevLines) - 1 to 0
            line.delete(array.get(sdevLines, i))
            array.remove(sdevLines, i)
    Setup act = activeLong.state != "IDLE" ? activeLong : activeShort
    if act.state != "IDLE" and act.sweepLevel != 0.0 and act.mssLevel != 0.0
        float unit = math.abs(act.mssLevel - act.sweepLevel)
        array<string> mparts = str.split(sdevStr, ",")
        if unit > 0 and array.size(mparts) > 0
            for i = 0 to array.size(mparts) - 1
                float m = math.abs(str.tonumber(array.get(mparts, i)))
                if not na(m)
                    float lvl = act.direction == "LONG" ? act.sweepLevel + unit * m : act.sweepLevel - unit * m
                    array.push(sdevLines, line.new(bar_index - 5, lvl, bar_index + 12, lvl, color = color.new(color.gray, 40), style = line.style_dotted))

// -- Phase 35 - chop shading
bgcolor(regimeOn and regimeShade and inChop ? color.new(color.gray, 92) : na, title = "CHOP")

// -- Phase 37 - open lines (stop at the end of their own day / week)
if barstate.islast
    if moOn and not na(midnightOpen)
        if na(moLn)
            moLn := line.new(bar_index - 40, midnightOpen, bar_index + 8, midnightOpen, color = color.new(color.fuchsia, 20), style = line.style_solid, width = 1)
        else
            line.set_xy1(moLn, bar_index - 40, midnightOpen)
            line.set_xy2(moLn, bar_index + 8, midnightOpen)
    if tdoOn and not na(trueDayOpen)
        if na(tdoLn)
            tdoLn := line.new(bar_index - 40, trueDayOpen, bar_index + 8, trueDayOpen, color = color.new(color.aqua, 20), style = line.style_solid, width = 1)
        else
            line.set_xy1(tdoLn, bar_index - 40, trueDayOpen)
            line.set_xy2(tdoLn, bar_index + 8, trueDayOpen)

// -- Phase 38 - VI boxes (only in Full density, they are tiny and many)
if viOn and densFull and array.size(gaps) > 0
    for i = 0 to array.size(gaps) - 1
        Gap g = array.get(gaps, i)
        if g.kind == "VI" and na(g.drawing) and not g.filled
            g.drawing := box.new(g.createdBar, g.top, g.createdBar + 10, g.bottom, border_color = color.new(colVi, 60), bgcolor = colVi)

// -- Phase 42 - news blackout shading
bgcolor(newsOn and newsShade and inBlackout ? color.new(color.red, 92) : na, title = "News blackout")

// -- Phase 40 - TP ladder lines for the live trade
if tmOn and barstate.islast
    Setup lt = na
    if activeLong.state == "TRADE_ACTIVE"
        lt := activeLong
    else if activeShort.state == "TRADE_ACTIVE"
        lt := activeShort
    if not na(lt)
        line.new(lt.entryBar, lt.slPrice, bar_index + 6, lt.slPrice, color = lt.beActive ? colBull : colBear, style = line.style_solid, width = 1)
        line.new(lt.entryBar, lt.tp1, bar_index + 6, lt.tp1, color = color.new(colBull, lt.tp1Hit ? 70 : 0), style = line.style_dashed)
        line.new(lt.entryBar, lt.tp2, bar_index + 6, lt.tp2, color = color.new(colBull, lt.tp2Hit ? 70 : 20), style = line.style_dashed)
        line.new(lt.entryBar, lt.tp3, bar_index + 6, lt.tp3, color = color.new(colBull, lt.tp3Hit ? 70 : 40), style = line.style_dashed)

// -- Phase 49 - CRT range, 50% line
if crtOn and crtShow and crtOkRange and barstate.islast and not na(crtHigh) and not na(crtLow)
    if na(crtBox)
        crtBox := box.new(bar_index - 30, crtHigh, bar_index + 10, crtLow, border_color = color.new(colCrt, 40), bgcolor = colCrt, text = "CRT", text_size = size.small, text_color = uiTextCol)
        box.set_text_size(crtBox, tSizeSub)
    else
        box.set_lefttop(crtBox, bar_index - 30, crtHigh)
        box.set_rightbottom(crtBox, bar_index + 10, crtLow)
    if na(crtMidLn)
        crtMidLn := line.new(bar_index - 30, crtMid, bar_index + 10, crtMid, color = color.new(colCrt, 20), style = line.style_dashed)
    else
        line.set_xy1(crtMidLn, bar_index - 30, crtMid)
        line.set_xy2(crtMidLn, bar_index + 10, crtMid)

plotshape(crtOn and crtShow and crtTbsBull, title = "TBS bull", style = shape.diamond, location = location.belowbar, color = color.new(#ab47bc, 0), size = size.tiny)
plotshape(crtOn and crtShow and crtTbsBear, title = "TBS bear", style = shape.diamond, location = location.abovebar, color = color.new(#ab47bc, 0), size = size.tiny)
plotshape(crtOn and crtShow and crtTwsBull and not crtTbsBull, title = "TWS bull", style = shape.circle, location = location.belowbar, color = color.new(#ab47bc, 45), size = size.tiny)
plotshape(crtOn and crtShow and crtTwsBear and not crtTbsBear, title = "TWS bear", style = shape.circle, location = location.abovebar, color = color.new(#ab47bc, 45), size = size.tiny)

// === 10 - DASHBOARD ========================================================
dashPosition = dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Left" ? position.bottom_left : position.top_right
var table dash = table.new(position.top_right, 2, 11, border_width = 1)
if showDash and barstate.islast
    table.set_position(dash, dashPosition)
    table.cell(dash, 0, 0, intrabar ? "SMC-ICT (LIVE)" : "SMC-ICT", text_color = intrabar ? color.yellow : color.white, bgcolor = color.new(color.blue, 0), text_size = tSize)
    table.cell(dash, 1, 0, timeframe.period + " / " + (htfValid ? htfTF : "HTF<TF!") + " | " + presetUse, text_color = color.white, bgcolor = color.new(color.blue, 0), text_size = tSize)
    table.cell(dash, 0, 1, "HTF / Daily Bias", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 1, htfBias + " / " + dailyBias, text_color = htfBias == "BULL" ? colBull : htfBias == "BEAR" ? colBear : uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 2, "AMD / Session", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 2, amdPhase + " / " + (inNy ? "NY" : inLondon ? "LONDON" : inAsia ? "ASIA" : "-") + (inSB ? " +SB" : ""), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 3, "Trend / Model", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 3, trendDir + " / " + marketModel, text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 4, "P/D | Regime | ADR", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 4, (rangeOk ? (inDiscount ? "DISC" : "PREM") : "n/a") + " | " + regime + " | " + (na(adrUsed) ? "-" : str.tostring(adrUsed * 100, "#") + "%"), text_color = inChop ? color.gray : adrSpent ? colBear : color.gray, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 5, "LONG state", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 5, activeLong.state + " (" + str.tostring(bar_index - longStateBar) + "b)", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 6, "SHORT state", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 6, activeShort.state + " (" + str.tostring(bar_index - shortStateBar) + "b)", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 7, "Score (" + scoreModel + ")", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 7, str.tostring(activeLong.score) + " L / " + str.tostring(activeShort.score) + " S  [thr " + str.tostring(f_scoreThreshold()) + "]", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 8, "DOL target", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 8, na(dolTarget) ? "-" : str.tostring(dolTarget, format.mintick) + "  (" + str.tostring(math.abs(dolTarget - close) / math.max(atrVal, syminfo.mintick), "#.#") + " ATR)", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 9, "Objects z/l/g/t", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 9, str.tostring(array.size(zones)) + "/" + str.tostring(array.size(liquidity)) + "/" + str.tostring(array.size(gaps)) + "/" + str.tostring(array.size(trendlines)), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 0, 10, "Signals today / all", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)
    table.cell(dash, 1, 10, str.tostring(todayLong + todayShort) + " / " + str.tostring(totalLong + totalShort), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSize)

var table dbg = table.new(position.bottom_right, 2, 6, border_width = 1)
if showDebug and barstate.islast
    table.cell(dbg, 0, 0, "DEBUG", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = tSizeSub)
    table.cell(dbg, 1, 0, "bar " + str.tostring(bar_index), text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = tSizeSub)
    table.cell(dbg, 0, 1, "ATR", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 1, 1, str.tostring(atrVal, format.mintick), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 0, 2, "Disp (body/ATR)", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 1, 2, str.tostring(bodyRatio, "#.##") + " / " + str.tostring(bodySize / math.max(atrVal, syminfo.mintick), "#.##"), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 0, 3, "Swept L / S", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 1, 3, str.tostring(activeLong.sweepLevel, format.mintick) + " / " + str.tostring(activeShort.sweepLevel, format.mintick), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 0, 4, "Signals L / S", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 1, 4, str.tostring(totalLong) + " / " + str.tostring(totalShort), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 0, 5, "Int H / L", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(dbg, 1, 5, str.tostring(intHigh, format.mintick) + " / " + str.tostring(intLow, format.mintick), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)

f_alertMsg(Setup st, string side) =>
    string m = ""
    if alertFmt == "JSON"
        m := '{"sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","side":"' + side + '","entry":' + str.tostring(st.entryPrice, format.mintick) + ',"sl":' + str.tostring(st.slPrice, format.mintick) + ',"tp1":' + str.tostring(st.tp1, format.mintick) + ',"tp2":' + str.tostring(st.tp2, format.mintick) + ',"tp3":' + str.tostring(st.tp3, format.mintick) + ',"rr":' + str.tostring(st.rr, "#.##") + ',"score":' + str.tostring(st.score) + ',"model":"' + st.modelName + '","size":' + str.tostring(st.posSize, "#.##") + ',"time":' + str.tostring(time) + '}'
    else
        m := side + " " + syminfo.ticker + " | E:" + str.tostring(st.entryPrice, format.mintick) + " SL:" + str.tostring(st.slPrice, format.mintick) + " TP:" + str.tostring(st.tp1, format.mintick) + " RR:" + str.tostring(st.rr, "#.##") + " Score:" + str.tostring(st.score) + " Model:" + st.modelName + (sizeOn ? " Size:" + str.tostring(st.posSize, "#.##") + f_sizeUnit() : "") + (tmOn ? " TP1close:" + str.tostring(tp1Pct) + "%" : "")
    m

var table stats = table.new(position.bottom_left, 2, 8, border_width = 1)
if statsOn and barstate.islast
    float winRate = nTrades > 0 ? nWins / nTrades * 100.0 : 0.0
    float expect  = nTrades > 0 ? sumR / nTrades : 0.0
    float avgRR   = nTrades > 0 ? sumRR / nTrades : 0.0
    table.cell(stats, 0, 0, "STATS (approx)", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = tSizeSub)
    table.cell(stats, 1, 0, str.tostring(nTrades) + " trades", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = tSizeSub)
    table.cell(stats, 0, 1, "Win rate", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 1, 1, str.tostring(winRate, "#.#") + "%", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 0, 2, "Total R", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 1, 2, str.tostring(sumR, "#.##") + "R", text_color = sumR >= 0 ? colBull : colBear, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 0, 3, "Expectancy", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 1, 3, str.tostring(expect, "#.##") + "R / trade", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 0, 4, "Avg planned RR", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 1, 4, str.tostring(avgRR, "#.##"), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 0, 5, "Best / Worst", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 1, 5, str.tostring(bestR, "#.##") + "R / " + str.tostring(worstR, "#.##") + "R", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 0, 6, "Max consec. loss", text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 1, 6, str.tostring(maxLossRun), text_color = uiTextCol, bgcolor = uiPanelBg, text_size = tSizeSub)
    table.cell(stats, 0, 7, "No spread / slippage / commission.", text_size = tSizeSub, text_color = color.new(uiTextCol, 30), bgcolor = uiPanelBg)
    table.cell(stats, 1, 7, "Same-bar TP+SL counted as SL.", text_size = tSizeSub, text_color = color.new(uiTextCol, 30), bgcolor = uiPanelBg)

// === 11 - ALERTS ===========================================================
if longSignal and barstate.isconfirmed
    alert(f_alertMsg(activeLong, "LONG"), alert.freq_once_per_bar_close)

if shortSignal and barstate.isconfirmed
    alert(f_alertMsg(activeShort, "SHORT"), alert.freq_once_per_bar_close)

if confirmed and (bosUp or bosDn)
    alert("BOS " + (bosUp ? "UP" : "DOWN") + " " + syminfo.ticker, alert.freq_once_per_bar_close)

if confirmed and (chochUp or chochDn)
    alert("CHoCH " + (chochUp ? "UP" : "DOWN") + " " + syminfo.ticker, alert.freq_once_per_bar_close)

if confirmed and (sslSwept or bslSwept)
    alert("Liquidity sweep " + (sslSwept ? "SSL" : "BSL") + " " + syminfo.ticker, alert.freq_once_per_bar_close)

if confirmed and (newBullZone or newBearZone)
    alert("New POI zone " + syminfo.ticker, alert.freq_once_per_bar_close)

if confirmed and tlOn and (tlBreakUp or tlBreakDn)
    alert("Trendline break " + (tlBreakUp ? "UP" : "DOWN") + " " + syminfo.ticker, alert.freq_once_per_bar_close)

if confirmed and crtOn and (crtSweepBull or crtSweepBear)
    alert("CRT " + (crtSweepBull ? "LOW swept (bullish)" : "HIGH swept (bearish)") + " " + (crtTbsBull or crtTbsBear ? "TBS" : "TWS") + " " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(longSignal,  title = "LONG signal",  message = "SMC-ICT LONG signal")
alertcondition(shortSignal, title = "SHORT signal", message = "SMC-ICT SHORT signal")
alertcondition(bosUp or bosDn,     title = "BOS",   message = "SMC-ICT BOS")
alertcondition(chochUp or chochDn, title = "CHoCH", message = "SMC-ICT CHoCH")
alertcondition(sslSwept or bslSwept, title = "Liquidity Sweep", message = "SMC-ICT liquidity sweep")
