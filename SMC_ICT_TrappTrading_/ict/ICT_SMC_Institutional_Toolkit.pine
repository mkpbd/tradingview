//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//  ICT + SMC INSTITUTIONAL TOOLKIT                                                    v1.0.0
//  Pine Script v6 — single-indicator institutional order-flow suite
//
//  ARCHITECTURE (top-down, Pine resolves identifiers in declaration order)
//  ----------------------------------------------------------------------
//   1. Constants & palette
//   2. Inputs — grouped settings panel
//   3. User defined types
//   4. Global state & drawing registries
//   5. Core series + utility / drawing helpers
//   6. Higher timeframe data layer (batched, non-repainting request.security)
//   7. Pivot & displacement engine
//   8. Market structure (BOS / CHoCH / MSS / CISD)
//   9. Liquidity (EQH / EQL / BSL / SSL / sweep / grab / raid)
//  10. Order blocks (fresh / mitigated / invalidated / breaker / reclaimed / nested / HTF)
//  11. Imbalances (FVG / IFVG / BPR / VI / opening gap / stacked)
//  12. Premium–Discount, auto fib, OTE
//  13. PD-array levels (PDH/PDL/PWH/PWL/PMH/PML/PQH/PQL/PYH/PYL/CDH/CDL)
//  14. Sessions & kill zones
//  15. ICT time model (opens, verticals, silver bullet, macros, PO3)
//  16. Trend engine & HTF bias
//  17. Entry model & confidence score
//  18. Dashboard
//  19. Alerts
//
//  NON-REPAINTING CONTRACT
//  -----------------------
//   * Structure is confirmed only by candle CLOSE beyond a *confirmed* pivot. Pivots are
//     ta.pivothigh/low, which by definition lag `right` bars and never revise.
//   * Every HTF read is `expr[1]` combined with lookahead_on — the canonical idiom that
//     returns the last CLOSED higher-timeframe value with correct historical alignment.
//     No future data can leak into a historical bar.
//   * Nothing is derived from an unconfirmed intrabar value.
//
//  OBJECT DISCIPLINE
//  -----------------
//   * Every box / line / label is owned by a UDT held in an array. Arrays are trimmed to the
//     user's cap and the underlying drawing is deleted on eviction (true recycling, never a leak).
//   * Object construction never sits inside a `?:` — Pine evaluates both ternary branches, which
//     would silently create an object on every bar. All creation is inside `if na(x)` guards.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

indicator("ICT + SMC Institutional Toolkit", "ICT│SMC", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1500)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 1. CONSTANTS & PALETTE
// ═══════════════════════════════════════════════════════════════════════════════════════════════

G_GEN = "⚙  General"
G_MS  = "①  Market Structure"
G_LQ  = "②  Liquidity"
G_OB  = "③  Order Blocks"
G_FV  = "④  Fair Value Gaps"
G_PD  = "⑤  Premium / Discount"
G_HL  = "⑥  Previous Highs & Lows"
G_SS  = "⑦  Sessions & Kill Zones"
G_TM  = "⑧  ICT Time Model"
G_HT  = "⑨  Higher Timeframe"
G_TR  = "⑩  Trend Engine"
G_EM  = "⑪  Entry Model & Confidence"
G_DB  = "⑫  Dashboard"
G_AL  = "⑬  Alerts"
G_CL  = "⑭  Colors & Style"
G_PF  = "⑮  Performance"
G_DG  = "⑯  Debug"

DEF_BULL   = #089981
DEF_BEAR   = #f23645
DEF_NEUT   = #787b86
DEF_ACCENT = #ffb300
DEF_INK    = #d1d4dc
DEF_PANEL  = #14161a
DEF_GRID   = #2a2e39
DEF_VIOLET = #7e57c2

// Zone lifecycle states
ST_FRESH     = 0    // untouched
ST_MITIGATED = 1    // wick tagged the zone
ST_INVALID   = 2    // body closed through the zone
ST_BREAKER   = 3    // invalidated, then retested from the far side
ST_RECLAIMED = 4    // invalidated, then reclaimed by a close back inside

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 2. INPUTS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// ── General ───────────────────────────────────────────────────────────────────────────────────
tzInput     = input.string("America/New_York", "Reference Timezone", options = ["America/New_York", "Europe/London", "Asia/Tokyo", "Australia/Sydney", "UTC", "Exchange"], group = G_GEN, tooltip = "All session and time-model logic is evaluated in this timezone.")
tz          = tzInput == "Exchange" ? syminfo.timezone : tzInput
atrLen      = input.int(14, "ATR Length", minval = 2, group = G_GEN)
labelSize   = input.string("normal", "Label Size", options = ["tiny", "small", "normal", "large"], group = G_GEN, tooltip = "Primary size for structure/signal labels. Secondary labels (zone tags, liquidity, times) render one step smaller.")
// Primary size — structure breaks, signals
lblSz       = labelSize == "tiny" ? size.tiny : labelSize == "small" ? size.small : labelSize == "large" ? size.large : size.normal
// Secondary size — zone tags, liquidity, swing points, time marks (one step below primary)
lblSzSm     = labelSize == "tiny" ? size.tiny : labelSize == "small" ? size.tiny : labelSize == "large" ? size.normal : size.small
autoHide    = input.bool(true, "Auto-hide insignificant drawings", group = G_GEN, tooltip = "Zones thinner than the noise floor (ATR × factor) are never drawn.")
noiseFactor = input.float(0.15, "Noise Floor (× ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G_GEN)

// ── Market structure ──────────────────────────────────────────────────────────────────────────
msEnable    = input.bool(true, "Enable Market Structure", group = G_MS)
msIntLen    = input.int(3, "Internal Swing Length", minval = 1, group = G_MS, tooltip = "Short pivot length → internal (minor) structure.")
msExtLen    = input.int(8, "External Swing Length", minval = 2, group = G_MS, tooltip = "Long pivot length → external (major) structure.")
msShowInt   = input.bool(true,  "Internal Structure", inline = "msie", group = G_MS)
msShowExt   = input.bool(true,  "External Structure", inline = "msie", group = G_MS)
msShowBOS   = input.bool(true,  "BOS",   inline = "mslbl", group = G_MS)
msShowCHoCH = input.bool(true,  "CHoCH", inline = "mslbl", group = G_MS)
msShowMSS   = input.bool(true,  "MSS",   inline = "mslbl", group = G_MS)
msShowCISD  = input.bool(true,  "CISD",  inline = "mslbl", group = G_MS)
msShowSwings= input.bool(false, "Swing Points (HH / HL / LH / LL)", group = G_MS)
msArrows    = input.bool(false, "Arrows on Structure Break", group = G_MS)
msColorBars = input.bool(false, "Trend Coloring on Candles", group = G_MS)
msDispMult  = input.float(1.5, "Displacement Filter (× ATR)", minval = 0.0, step = 0.1, group = G_MS, tooltip = "A CHoCH is promoted to MSS only when the breaking candle range is at least this size.")
msMaxDraw   = input.int(8, "Max Structure Drawings", minval = 1, maxval = 60, group = G_MS)

// ── Liquidity ─────────────────────────────────────────────────────────────────────────────────
lqEnable    = input.bool(true, "Enable Liquidity", group = G_LQ)
lqEqTol     = input.float(0.12, "Equal H/L Tolerance (× ATR)", minval = 0.01, step = 0.01, group = G_LQ)
lqShowEq    = input.bool(true,  "Equal Highs / Equal Lows", group = G_LQ)
lqShowPools = input.bool(true,  "Buyside / Sellside Pools", group = G_LQ)
lqShowInt   = input.bool(false, "Internal Liquidity", inline = "lqie", group = G_LQ)
lqShowExt   = input.bool(true,  "External Liquidity", inline = "lqie", group = G_LQ)
lqShowSweep = input.bool(true,  "Sweep / Grab / Raid", group = G_LQ)
lqSweepClose= input.bool(true,  "Sweep requires close back inside", group = G_LQ, tooltip = "ON = strict sweep (wick through, body rejects). OFF = any penetration counts as a grab.")
lqRaidMult  = input.float(0.35, "Raid Displacement (× ATR)", minval = 0.0, step = 0.05, group = G_LQ, tooltip = "A sweep followed by displacement of this extra size is upgraded to a RAID.")
lqLabels    = input.bool(true, "Liquidity Labels", group = G_LQ)
lqRemove    = input.bool(true, "Auto-remove after mitigation", group = G_LQ)
lqMax       = input.int(8, "Max Liquidity Levels", minval = 1, maxval = 60, group = G_LQ)

// ── Order blocks ──────────────────────────────────────────────────────────────────────────────
obEnable    = input.bool(true, "Enable Order Blocks", group = G_OB)
obSource    = input.string("Wick", "Block Body", options = ["Wick", "Body"], group = G_OB)
obPick      = input.string("Extreme Candle", "Origin Candle", options = ["Extreme Candle", "Last Opposite Candle"], group = G_OB)
obLookback  = input.int(20, "Origin Search Lookback", minval = 3, maxval = 60, group = G_OB)
obShowLast  = input.int(3, "Show Last X per side", minval = 1, maxval = 20, group = G_OB)
obExtend    = input.int(20, "Extend Right (bars)", minval = 0, maxval = 200, group = G_OB)
obTransp    = input.int(86, "Transparency", minval = 0, maxval = 95, group = G_OB)
obShowMit   = input.bool(true,  "Keep Mitigated",   inline = "obk", group = G_OB)
obShowInv   = input.bool(false, "Keep Invalidated", inline = "obk", group = G_OB)
obBreaker   = input.bool(true,  "Breaker Blocks",    inline = "obt", group = G_OB)
obReclaim   = input.bool(true,  "Reclaimed Blocks",  inline = "obt", group = G_OB)
obNested    = input.bool(true,  "Flag Nested Order Blocks", group = G_OB)
obLabels    = input.bool(true,  "Order Block Labels", group = G_OB)

// ── Imbalances ────────────────────────────────────────────────────────────────────────────────
fvEnable    = input.bool(true, "Enable Imbalances", group = G_FV)
fvShowFVG   = input.bool(true, "FVG",  inline = "fv1", group = G_FV)
fvShowIFVG  = input.bool(true, "IFVG", inline = "fv1", group = G_FV)
fvShowBPR   = input.bool(true, "BPR",  inline = "fv1", group = G_FV)
fvShowVI    = input.bool(false,"Volume Imbalance", inline = "fv2", group = G_FV)
fvShowOG    = input.bool(true, "Opening Gap",      inline = "fv2", group = G_FV)
fvMinMult   = input.float(0.15, "Min Gap Size (× ATR)", minval = 0.0, step = 0.01, group = G_FV)
fvVolFilter = input.bool(false, "Volume-confirmed gaps only", group = G_FV, tooltip = "Requires displacement-candle volume above its SMA.")
fvVolLen    = input.int(20, "Volume SMA Length", minval = 2, group = G_FV)
fvMerge     = input.bool(true, "Auto-merge overlapping gaps", group = G_FV)
fvShrink    = input.bool(true, "Shrink box to unfilled portion", group = G_FV)
fvShowFill  = input.bool(true, "Show Fill %", group = G_FV)
fvRemoveFill= input.float(100.0, "Auto-remove at Fill %", minval = 1, maxval = 100, step = 5, group = G_FV)
fvStack     = input.int(3, "Stacked / Triple threshold", minval = 2, maxval = 6, group = G_FV)
fvExtend    = input.int(20, "Extend Right (bars)", minval = 0, maxval = 200, group = G_FV)
fvTransp    = input.int(88, "Transparency", minval = 0, maxval = 95, group = G_FV)
fvMax       = input.int(4, "Show Last X per side", minval = 1, maxval = 25, group = G_FV)

// ── Premium / discount ────────────────────────────────────────────────────────────────────────
pdEnable    = input.bool(true, "Enable Premium / Discount", group = G_PD)
pdSource    = input.string("External", "Dealing Range", options = ["External", "Internal"], group = G_PD)
pdShowEQ    = input.bool(true, "Equilibrium (50%)", group = G_PD)
pdShowZones = input.bool(false, "Premium / Discount Zones (full-range shading)", group = G_PD, tooltip = "Paints the whole dealing range. EQ line + fib + OTE carry the same information with far less ink — leave this off for a clean chart.")
pdShowFib   = input.bool(true, "Auto Fibonacci (62 / 70.5 / 79)", group = G_PD)
pdShowOTE   = input.bool(true, "OTE Zone", group = G_PD)
pdTransp    = input.int(95, "Zone Transparency", minval = 0, maxval = 97, group = G_PD)
pdLabels    = input.bool(true, "Level Labels", group = G_PD)

// ── Previous highs / lows ─────────────────────────────────────────────────────────────────────
hlEnable    = input.bool(true, "Enable Previous H/L", group = G_HL)
hlPD        = input.bool(true,  "PDH / PDL", inline = "hl1", group = G_HL)
hlPW        = input.bool(true,  "PWH / PWL", inline = "hl1", group = G_HL)
hlPM        = input.bool(false, "PMH / PML", inline = "hl2", group = G_HL)
hlPQ        = input.bool(false, "PQH / PQL", inline = "hl2", group = G_HL)
hlPY        = input.bool(false, "PYH / PYL", inline = "hl3", group = G_HL)
hlCurD      = input.bool(false, "Current Day H/L", inline = "hl3", group = G_HL)
hlStyleIn   = input.string("Dashed", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = G_HL)
hlWidth     = input.int(1, "Line Width", minval = 1, maxval = 4, group = G_HL)
hlLabels    = input.bool(true, "Labels",      inline = "hl4", group = G_HL)
hlExtend    = input.bool(true, "Auto Extend", inline = "hl4", group = G_HL)
hlOffset    = input.int(6, "Label Offset (bars)", minval = 0, maxval = 60, group = G_HL)
hlFade      = input.bool(true, "Fade level once broken", group = G_HL)

// ── Sessions ──────────────────────────────────────────────────────────────────────────────────
ssEnable = input.bool(true, "Enable Sessions", group = G_SS)
ssBg     = input.bool(true,  "Background Shading", inline = "ssv1", group = G_SS)
ssBox    = input.bool(true,  "Range Boxes",        inline = "ssv1", group = G_SS)
ssHiLo   = input.bool(true,  "Session High / Low", inline = "ssv2", group = G_SS)
ssMid    = input.bool(false, "Session Midpoint",   inline = "ssv2", group = G_SS)
ssSweep  = input.bool(true,  "Session Sweep Detection", group = G_SS)
ssKeep   = input.int(3, "Session ranges to keep", minval = 1, maxval = 10, group = G_SS)
sSydOn   = input.bool(false, "Sydney",   inline = "s1", group = G_SS)
sSyd     = input.session("1700-0200", "", inline = "s1", group = G_SS)
sTokOn   = input.bool(true,  "Tokyo",    inline = "s2", group = G_SS)
sTok     = input.session("2000-0400", "", inline = "s2", group = G_SS)
sLonOn   = input.bool(true,  "London",   inline = "s3", group = G_SS)
sLon     = input.session("0300-1130", "", inline = "s3", group = G_SS)
sNyOn    = input.bool(true,  "New York", inline = "s4", group = G_SS)
sNy      = input.session("0800-1700", "", inline = "s4", group = G_SS)
kzEnable = input.bool(true, "Enable Kill Zones", group = G_SS)
kAsiaOn  = input.bool(true,  "Asian Range",  inline = "k1", group = G_SS)
kAsia    = input.session("2000-0000", "", inline = "k1", group = G_SS)
kLonOn   = input.bool(true,  "London Open",  inline = "k2", group = G_SS)
kLon     = input.session("0200-0500", "", inline = "k2", group = G_SS)
kNyOn    = input.bool(true,  "NY Open",      inline = "k3", group = G_SS)
kNy      = input.session("0700-1000", "", inline = "k3", group = G_SS)
kLunOn   = input.bool(true,  "NY Lunch",     inline = "k4", group = G_SS)
kLun     = input.session("1200-1300", "", inline = "k4", group = G_SS)
kLcOn    = input.bool(true,  "London Close", inline = "k5", group = G_SS)
kLc      = input.session("1000-1200", "", inline = "k5", group = G_SS)

// ── ICT time model ────────────────────────────────────────────────────────────────────────────
tmEnable    = input.bool(true, "Enable Time Model", group = G_TM)
tmMidnight  = input.bool(true,  "Midnight Open (00:00)", inline = "tm1", group = G_TM)
tmDayOpen   = input.bool(true,  "Daily Open",            inline = "tm1", group = G_TM)
tmWeekOpen  = input.bool(false, "Weekly Open",           inline = "tm2", group = G_TM)
tmMonOpen   = input.bool(false, "Monthly Open",          inline = "tm2", group = G_TM)
tmVerticals = input.bool(true,  "Key Time Verticals (08:30 · 09:30 · 10:00 · 11:00 · 13:30 · 15:00)", group = G_TM)
tmSilver    = input.bool(true,  "Silver Bullet Windows", inline = "tm3", group = G_TM)
tmMacros    = input.bool(true,  "ICT Macros",            inline = "tm3", group = G_TM)
tmPO3       = input.bool(false, "Power of Three (Accumulation → Manipulation → Distribution)", group = G_TM)
tmKeepDays  = input.int(3, "Days of time drawings to keep", minval = 1, maxval = 10, group = G_TM)

// ── Higher timeframe ──────────────────────────────────────────────────────────────────────────
htEnable     = input.bool(true, "Enable HTF Layer", group = G_HT)
htAuto       = input.bool(true, "Auto HTF (derive from chart timeframe)", group = G_HT)
htTfManual   = input.timeframe("240", "HTF (manual)", options = ["1", "5", "15", "60", "240", "D", "W", "M"], group = G_HT)
htShowFVG    = input.bool(true,  "HTF FVG",          inline = "ht1", group = G_HT)
htShowOB     = input.bool(true,  "HTF Order Block",  inline = "ht1", group = G_HT)
htShowSwings = input.bool(true,  "HTF Swing Levels", inline = "ht2", group = G_HT)
htShowPrev   = input.bool(false, "HTF Prev H/L",     inline = "ht2", group = G_HT)
htSwingLen   = input.int(5, "HTF Swing Length", minval = 2, group = G_HT)
htEmaLen     = input.int(50, "HTF EMA (bias fallback)", minval = 2, group = G_HT)
htMax        = input.int(2, "Max HTF zones per side", minval = 1, maxval = 12, group = G_HT)

// ── Trend engine ──────────────────────────────────────────────────────────────────────────────
trEnable    = input.bool(true, "Enable Trend Engine", group = G_TR)
trUseStruct = input.bool(true,  "Swing Structure", inline = "tr1", group = G_TR)
trUseEma    = input.bool(false, "EMA Filter",      inline = "tr1", group = G_TR)
trEmaFast   = input.int(21, "EMA Fast", minval = 2, inline = "tr2", group = G_TR)
trEmaSlow   = input.int(55, "EMA Slow", minval = 3, inline = "tr2", group = G_TR)
trUseHtf    = input.bool(true,  "HTF Bias",            inline = "tr3", group = G_TR)
trUseLiq    = input.bool(true,  "Liquidity Direction", inline = "tr3", group = G_TR)
trUseFlow   = input.bool(true,  "Order Flow (CISD / displacement)", group = G_TR)
trRibbon    = input.bool(false, "Trend Ribbon", group = G_TR)

// ── Entry model ───────────────────────────────────────────────────────────────────────────────
emEnable    = input.bool(true, "Enable Entry Model", group = G_EM)
emWindow    = input.int(12, "Confluence Window (bars)", minval = 2, maxval = 60, group = G_EM, tooltip = "How recently each confirmation must have printed to still count.")
emMinScore  = input.int(65, "Minimum Confidence Score", minval = 0, maxval = 100, group = G_EM)
emNeedShift = input.bool(true, "Require MSS or CISD",      inline = "em1", group = G_EM)
emNeedSweep = input.bool(true, "Require Liquidity Sweep",  inline = "em1", group = G_EM)
emNeedZone  = input.bool(true, "Require OB or FVG",        inline = "em2", group = G_EM)
emNeedPd    = input.bool(true, "Require Discount / Premium", inline = "em2", group = G_EM)
emNeedHtf   = input.bool(true, "Require HTF Bias Alignment", group = G_EM)
emKzOnly    = input.bool(false,"Kill Zones only", group = G_EM)
emOneAtATime= input.bool(true, "One signal per structural leg", group = G_EM)
emCooldown  = input.int(10, "Signal Cooldown (bars)", minval = 0, maxval = 200, group = G_EM, tooltip = "Hard minimum distance between two signals, regardless of structure. Stops back-to-back prints when consecutive BOS re-arm the leg lock.")
wSweep      = input.int(20, "Sweep",    inline = "w1", group = G_EM)
wOb         = input.int(20, "OB",       inline = "w1", group = G_EM)
wFvg        = input.int(15, "FVG",      inline = "w1", group = G_EM)
wHtf        = input.int(15, "HTF Trend",inline = "w2", group = G_EM)
wOte        = input.int(10, "OTE",      inline = "w2", group = G_EM)
wSess       = input.int(10, "Session",  inline = "w2", group = G_EM)
wCisd       = input.int(10, "CISD",     inline = "w3", group = G_EM)
wVol        = input.int(0,  "Volume",   inline = "w3", group = G_EM, tooltip = "Optional. Keep at 0 to leave the scale at 100.")
emShowSl    = input.bool(true, "Draw invalidation / target guides", group = G_EM)
emRR        = input.float(2.0, "Target R multiple", minval = 0.5, step = 0.5, group = G_EM)

// ── Dashboard ─────────────────────────────────────────────────────────────────────────────────
dbEnable    = input.bool(true, "Enable Dashboard", group = G_DB)
dbPos       = input.string("Top Right", "Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = G_DB)
dbSize      = input.string("Normal", "Size", options = ["Compact", "Normal"], group = G_DB)
dbRowTrend  = input.bool(true, "Trend",     inline = "db1", group = G_DB)
dbRowHtf    = input.bool(true, "HTF Trend", inline = "db1", group = G_DB)
dbRowStruct = input.bool(true, "Structure", inline = "db2", group = G_DB)
dbRowPd     = input.bool(true, "Prem/Disc", inline = "db2", group = G_DB)
dbRowSess   = input.bool(true, "Session",   inline = "db3", group = G_DB)
dbRowLiq    = input.bool(true, "Liquidity", inline = "db3", group = G_DB)
dbRowSig    = input.bool(true, "Signal",    inline = "db4", group = G_DB)
dbRowAtr    = input.bool(true, "ATR",       inline = "db4", group = G_DB)
dbRowTick   = input.bool(true, "Tick",      inline = "db5", group = G_DB)
dbRowStatus = input.bool(true, "Status",    inline = "db5", group = G_DB)

// ── Alerts ────────────────────────────────────────────────────────────────────────────────────
alEnable  = input.bool(true, "Enable alert() firing", group = G_AL, tooltip = "alertcondition() slots are always compiled and appear in the alert dialog; this switch gates the dynamic alert() calls.")
alStruct  = input.bool(true, "Structure (BOS / CHoCH / MSS / CISD)", group = G_AL)
alLiq     = input.bool(true, "Liquidity Sweep / Raid", group = G_AL)
alOb      = input.bool(true, "OB Created / Mitigated / Breaker", group = G_AL)
alFvg     = input.bool(true, "FVG / IFVG", group = G_AL)
