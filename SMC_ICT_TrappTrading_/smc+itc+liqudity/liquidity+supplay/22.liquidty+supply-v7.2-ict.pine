     options = ["Bottom right", "Bottom left", "Middle right", "Top left"], group = grpDB)

// ═══════════════════════════════════════ MODULE 2 · CONSTANTS + HELPERS
// Named constants only — no magic numbers in the engines below.
// ═════════════════════════════════════════════════════════════════════════════
RUNAWAY_ATR      = 3.0    // breakout ran this far past the level → no trap, stop watching
NEAR_LVL_ATR     = 0.25   // tolerance for "price is at the level"
SL_PAD_ATR       = 0.25   // stop padding beyond the structural level
STRONG_CLOSE_PCT = 0.30   // close in the outer 30 % of its candle = displacement-grade close
CISD_NEUTRAL_PCT = 0.10   // body ≤ 10 % of range = neutral candle → ends a CISD series
PIN_OPP_PCT      = 0.35   // pin bar: opposite wick ≤ 35 % of range (BUG-23 — no body dependence)
TRIG_LOOK        = 10     // bars a structure shift / CISD stays a live trigger for the score
IFC_LOOK         = 3      // prior bars whose extreme an IFC candle must take
BRK_BODY_ATR     = 0.5    // min body for a meaningful breakout / rejection close
TRADE_BARS       = 15     // length of entry/SL/TP lines
OTE_1            = 0.62   // optimal trade entry — shallow bound
OTE_2            = 0.79   // optimal trade entry — deep bound
OTE_M            = 0.70   // V7.1 · the prime 62-70 % band ends here; 70-79 % is a DEEP, grade-A-max entry
PD_EXTREME       = 0.25   // within 25 % of a range extreme = premium/discount extreme
POOL_CONSUME_ATR = 4.0    // price this far from a reacted pool → pool consumed
MSS_MIN_SEP_ATR  = 0.10   // an MSS level this close to the raid extreme is the raid itself, not a shift
DISP_HOLD_FRAC   = 0.55   // V7.1 · a displacement must close in this fraction of its own range — an expansion candle that hands it straight back is a liquidity grab, not delivery
POI_LEAVE_ATR    = 0.10   // V7.1 · displacement must close OUTSIDE the POI by at least this (0.00 let a close ON the edge count)
FVG_OWN_MAX      = 2      // the displacement candle must be one of the 3 candles forming its FVG
COL_BULL         = #089981
COL_BEAR         = #f23645
COL_NEU          = #787b86

// pool kinds — kept as ints so the registry stays a flat numeric array
PK_SWING = 0
PK_EXT   = 1
PK_EQ    = 2
PK_SES   = 3
PK_PD    = 4
PK_PW    = 5    // V5.6 · previous WEEK high / low
PK_TL    = 6    // V7.0 · §22 · trendline liquidity, registered where it was swept
PK_HTF   = 7    // V7.0 · §7 / §25 · a CLOSED HTF swing extreme
PK_N     = 8    // number of kinds — the confluence mask is PK_N bits wide

// V5.6 · LIQUIDITY STRENGTH (§5). A classification, never a probability.
LS_WEAK  = 1
LS_MOD   = 2
LS_STR   = 3
LS_EXT   = 4

// pool lifecycle states
PS_NEW   = 0    // CREATED
PS_VAL   = 1    // VALIDATED (has been respected at least once)
PS_RAID  = 2    // RAIDED (wick through, close back inside)
PS_REACT = 3    // REVERSAL CONFIRMED (displacement / MSS away from it)
PS_DONE  = 4    // CONSUMED (broken, expired, or spent by a setup)

// setup machine states — the ONLY path to an entry
ST_NONE  = 0
ST_CTX   = 1
ST_TGT   = 2
ST_RAID  = 3
ST_POI   = 4
ST_MSS   = 5
ST_DISP  = 6
ST_FVG   = 7
ST_ENTRY = 8
ST_DEAD  = 9

// raid quality grades (V5-5)
RQ_NONE = 0
RQ_C    = 1
RQ_B    = 2
RQ_A    = 3

// signal grades (V5-9)
GR_NONE = 0
GR_B    = 1
GR_A    = 2
GR_AP   = 3

// producer ranks (MASTER SIGNAL PRIORITY — lower wins). V7.0: PR_CRT and
// PR_TBS were rungs 4 and 5; both producers are gone and the trap engine
// moves up. Every comparison in the file is `<` / `<=` on these, so closing
// the gap changes no ordering.
PR_FEM  = 1
PR_MACH = 2
PR_SD   = 3
PR_TRAP = 4

// V7.0 · PD-ARRAY CLASS (§40 ranking). Which KIND of institutional array a
// zone is. Ranked so the POI stage can prefer the array ICT ranks higher when
// two of them both contain the raid.
PA_FVG  = 0
PA_OB   = 1
PA_BRK  = 2
PA_MIT  = 3
PA_IFVG = 4
PA_BPR  = 5
PA_REJ  = 6

// V7.0 · MARKET REGIME (§36). Read from price action only.
RG_TREND = 0
RG_RANGE = 1
RG_EXP   = 2
RG_CHOP  = 3

// V7.0 · ENTRY TIMING (§48)
TM_PREM = 0     // liquidity / MSS / displacement not complete
TM_VALID = 1
TM_LATE  = 2


// V5.5-E · SHARED LIFECYCLE VOCABULARY (§12 / §13 / §14). CRT, turtle soup and
// TWS are state machines now and they walk the same shape, so they share ONE set
// of state constants rather than three near-identical ones.
LC_IDLE  = 0    // nothing armed
LC_ARMED = 1    // reference range / extreme registered, and CLOSED
LC_SWEPT = 2    // that reference was taken; penetration graded
LC_RECL  = 3    // price reclaimed it — a close back through, later bar
LC_CONF  = 4    // reclaim THEN displacement = the pattern is confirmed
LC_INVAL = 5    // the sweep became a break, or the clock ran out
LC_W1    = 6    // TWS only · first liquidity interaction
LC_W2    = 7    // TWS only · the deeper raid = the manipulation wave

// liquidity-run classes (§11)
RN_NONE   = 0
RN_UNCONF = 1   // one leg taken — nothing established yet
RN_CONT   = 2   // pool A broken → pool B broken, same direction = a RUN
RN_EXH    = 3   // the next pool was RAIDED, not broken → exhaustion
RN_REV    = 4   // exhaustion, then an opposing shift with displacement

// micro-mark rendering (cisd / ifc / BOS / CHoCH / session tags)
mkSize  = uiMicroBig ? size.small : size.tiny
mkTrans = uiMicroBig ? 0 : 35

// ---- text sizes, resolved once and used everywhere -------------------------
f_szPick(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge

sigSize   = f_szPick(uiSizeOpt)     // the LONG / SHORT entry label
infoSize  = f_szPick(uiInfoSize)    // entry / SL / TP, next zone, liquidity targets
dashSize  = f_szPick(dashSizeOpt)   // dashboard rows
dashSize2 = dashSizeOpt == "Tiny" ? size.tiny : dashSizeOpt == "Small" ? size.tiny : dashSizeOpt == "Normal" ? size.small : size.normal
dbgSize   = f_szPick(dbgSizeOpt)    // debug panel

// f_chip moved into MODULE 3 (v6.0) — it needs `atr` for its lane spacing.

f_recent(int b, int look) => not na(b) and bar_index - b <= look

// ---- V5.6 · liquidity primitives --------------------------------------------
// CONFLUENCE MASK. Pine has no bitwise operators, so it is arithmetic: one bit
// per pool kind. When two different level TYPES resolve to the same price the
// registry keeps ONE pool (it always did) and now REMEMBERS that both were
// there — which is what §5 calls a confluence, and what separates an EXTREME
// level from a merely strong one.
f_maskAdd(int m, int k) =>
    int b = int(math.pow(2, k))
    m % (2 * b) >= b ? m : m + b

f_maskN(int m) =>
    int c = 0
    for k = 0 to PK_N - 1
        int b = int(math.pow(2, k))
        if m % (2 * b) >= b
            c += 1
    c

// §13 static priority of a level TYPE, used for label ranking and for the
// optional weakest-first prune. Higher = more likely to hold real stops.
f_kindPri(int k) =>
    k == PK_HTF ? 7 : k == PK_PW ? 6 : k == PK_PD ? 5 : k == PK_EQ ? 5 :
         k == PK_EXT ? 4 : k == PK_TL ? 4 : k == PK_SES ? 3 : 1

f_kindTxt(int k) =>
    k == PK_HTF ? "HTF SWING" : k == PK_PW ? "PWH/PWL" : k == PK_PD ? "PDH/PDL" :
         k == PK_EQ ? "EQ" : k == PK_EXT ? "EXT SWING" : k == PK_TL ? "TRENDLINE" :
         k == PK_SES ? "SESSION" : "SWING"

f_lsTxt(int s) =>
    s == LS_EXT ? "EXTREME" : s == LS_STR ? "STRONG" : s == LS_MOD ? "MODERATE" : "WEAK"

f_lsStars(int s) =>
    s == LS_EXT ? "★★★★" : s == LS_STR ? "★★★" : s == LS_MOD ? "★★" : "★"

f_lsMin() =>
    lqMinStr == "EXTREME" ? LS_EXT : lqMinStr == "STRONG" ? LS_STR :
         lqMinStr == "MODERATE" ? LS_MOD : LS_WEAK

f_tick(bool ok) => ok ? "✓" : "✗"
// V7.0 · §36 regime and §48 timing, printed by the dashboard and the debug panel
f_rgTxt(int r) => r == RG_TREND ? "TREND" : r == RG_EXP ? "EXPANSION" : r == RG_CHOP ? "CHOP" : "RANGE"
f_tmTxt(int t) => t == TM_LATE ? "LATE" : t == TM_VALID ? "VALID" : "PREMATURE"
// §40 · the PD-array ladder, most institutional first. Used to break a tie when
// two live arrays both contain the same raid.
f_paTxt(int a) =>
    a == PA_OB ? "OB" : a == PA_BRK ? "BREAKER" : a == PA_MIT ? "MITIGATION" :
         a == PA_IFVG ? "IFVG" : a == PA_BPR ? "BPR" : a == PA_REJ ? "REJECTION" : "FVG"
f_paRank(int a) =>
    a == PA_OB ? 0 : a == PA_BRK ? 1 : a == PA_IFVG ? 2 : a == PA_BPR ? 3 :
         a == PA_FVG ? 4 : a == PA_MIT ? 5 : 6
f_rqTxt(int q) => q == RQ_A ? "A" : q == RQ_B ? "B" : q == RQ_C ? "C" : "—"
f_grTxt(int g) => g == GR_AP ? "A+" : g == GR_A ? "A" : g == GR_B ? "B" : "—"
f_grMin(string s) => s == "A+" ? GR_AP : s == "A" ? GR_A : GR_B
// V5.5-E · lifecycle / penetration / run vocabulary, printed by the dashboard,
// the debug panel and the event descriptor list
f_lcTxt(int s) =>
    s == LC_IDLE ? "idle" : s == LC_ARMED ? "armed" : s == LC_SWEPT ? "swept" :
         s == LC_RECL ? "reclaim" : s == LC_CONF ? "CONF" : s == LC_INVAL ? "invalid" :
         s == LC_W1 ? "wave1" : s == LC_W2 ? "wave2" : "—"
f_rnTxt(int c) =>
    c == RN_CONT ? "RUN" : c == RN_EXH ? "exhausted" : c == RN_REV ? "REVERSED" :
         c == RN_UNCONF ? "1 leg" : "none"

// ---- V5.1-A · numeric hygiene for the risk ladders ---------------------------
// v5 compared reconstructed prices against their own multiplier, so with the
// default rrMult == rrAplus == 2.0 the A+ floor failed on float cancellation
// alone (rr came out 1.9999999997). Every RR comparison now goes through f_geq.
f_geq(float a, float b) => a >= b - 1e-6

// v5 validated no relationship BETWEEN the floors. With rrAplus < rrA the A+
// rung became EASIER to reach than A, and with minRiskAtr > maxRiskAtr f_slOk
// rejected every structural level and silently fell through to the ATR stop.
// The engine reads the normalised values; the inputs keep the user's numbers.
rrAn     = math.max(rrA, rrB)
rrAPn    = math.max(rrAplus, math.max(rrA, rrB))
minRiskN = math.min(minRiskAtr, maxRiskAtr)
maxRiskN = math.max(minRiskAtr, maxRiskAtr)

// "no opposing liquidity at all" is na, never a 99.0 sentinel (v5 printed
// "opposing liquidity only 99.00R away" in the debug panel).
f_roomTxt(float r) => na(r) ? "∞" : str.tostring(r, "#.##") + "R"

// ═══════════════════════════════ MODULE 3 · CORE SERIES + CANDLE ANATOMY
// Candle psychology, confirmation candles, CISD, IFC. Every state latch in
// this file is gated on `confirmed` (ARCH-9) — nothing advances intrabar.
// ═════════════════════════════════════════════════════════════════════════════
atr     = ta.atr(atrLen)

// chip = text on a solid pill — readable on any candle background.
// V6.0-UI2: chips used to anchor at yloc.above/belowbar, which is one fixed y
// per bar per side, so two chips on one candle drew at the same point. Each
// side now keeps a per-bar counter and the nth chip is pushed one
// uiChipGap × ATR step further from the candle. Slots: 0 = above count,
// 1 = below count, 2 = the bar those counts belong to.
var int[] chipLn = array.new_int(3, -1)
f_chip(bool below, string txt, color bg, color tc, string sz) =>
    if array.get(chipLn, 2) != bar_index
        array.set(chipLn, 2, bar_index)
        array.set(chipLn, 0, 0)
        array.set(chipLn, 1, 0)
    int   k  = below ? 1 : 0
    int   n  = array.get(chipLn, k)
    array.set(chipLn, k, n + 1)
    float st = nz(atr, high - low) * (0.45 + n * uiChipGap)
    label.new(bar_index, below ? low - st : high + st, txt,
         style = below ? label.style_label_up : label.style_label_down,
         color = bg, textcolor = tc, size = sz)
body    = math.abs(close - open)
rng     = high - low
upWick  = high - math.max(open, close)
dnWick  = math.min(open, close) - low
bullBar = close > open
bearBar = close < open

// V7.1 · UNCONDITIONAL, and now honestly so. v7.0 shipped a `confirmOnly` input
// that nothing read — every transition and every signal in this file has always
// committed on bar close only. The input is gone; the behaviour it claimed to
// control is the behaviour, and the developing-setup preview it described in its
// tooltip is the separate `showDev` toggle.
confirmed = barstate.isconfirmed
// developing preview is only ever offered on the live, unclosed bar
devBar    = showDev and barstate.islast and not barstate.isconfirmed

// BUG-23: the opposite-wick cap is a fraction of RANGE, not of body. A clean
// hammer has a near-zero body, which made v2's `upWick <= body` test false.
bullPin    = rng > 0 and dnWick >= 2 * body and dnWick >= 0.45 * rng and upWick <= PIN_OPP_PCT * rng and dnWick >= minWickAtr * atr
bearPin    = rng > 0 and upWick >= 2 * body and upWick >= 0.45 * rng and dnWick <= PIN_OPP_PCT * rng and upWick >= minWickAtr * atr
bullEngulf = bullBar and bearBar[1] and close >= open[1] and open <= close[1] and body > body[1]
bearEngulf = bearBar and bullBar[1] and close <= open[1] and open >= close[1] and body > body[1]
bullConfirm = bullPin or bullEngulf
bearConfirm = bearPin or bearEngulf

// displacement = a real expansion candle closing in its own outer third.
// One definition, used by every engine (v2 had three near-duplicates).
strongUp = rng > 0 and close >= high - STRONG_CLOSE_PCT * rng
strongDn = rng > 0 and close <= low + STRONG_CLOSE_PCT * rng
dispUpBar = bullBar and body >= dispFactor * atr and strongUp
dispDnBar = bearBar and body >= dispFactor * atr and strongDn

// ---- CISD: change in state of delivery ---------------------------------------
// The OPEN of the first candle of the most recent consecutive bull / bear run.
// A confirmed displacement close through that origin open = delivery flipped.
// A neutral candle (body ≤ CISD_NEUTRAL_PCT of range) ends BOTH series.
cisdNeutral = rng == 0 or body <= CISD_NEUTRAL_PCT * rng
// V7.0 · renamed from cisdBull / cisdBear: these mark a candle that CONTINUES
// a directional run, which is the input to the CISD test, not the CISD itself.
// §5 uses the cisdBull / cisdBear names for the delivery flip (MODULE 4).
cisdSeqUp   = bullBar and not cisdNeutral
cisdSeqDn   = bearBar and not cisdNeutral
var float bullRunOpen = na
var float bearRunOpen = na
var int   bullRunLen  = 0
var int   bearRunLen  = 0
var int   bullRunBar  = na    // V5: origin bar of the run whose OPEN a CISD breaks
var int   bearRunBar  = na
var bool  cisdDnDone  = false
var bool  cisdUpDone  = false
if confirmed
    if cisdNeutral
        bullRunOpen := na
        bearRunOpen := na
        bullRunLen  := 0
        bearRunLen  := 0
    if cisdSeqUp and not cisdSeqUp[1]
        bullRunOpen := open
        bullRunBar  := bar_index
        bullRunLen  := 1
        cisdDnDone  := false
    else if cisdSeqUp
        bullRunLen += 1
    if cisdSeqDn and not cisdSeqDn[1]
        bearRunOpen := open
        bearRunBar  := bar_index
        bearRunLen  := 1
        cisdUpDone  := false
    else if cisdSeqDn
        bearRunLen += 1
cisdDn = confirmed and not na(bullRunOpen) and not cisdDnDone and cisdSeqDn and close < bullRunOpen and bullRunLen >= 2 and body >= BRK_BODY_ATR * atr and strongDn
cisdUp = confirmed and not na(bearRunOpen) and not cisdUpDone and cisdSeqUp and close > bearRunOpen and bearRunLen >= 2 and body >= BRK_BODY_ATR * atr and strongUp
if cisdDn
    cisdDnDone := true
if cisdUp
    cisdUpDone := true
if showCisd and cisdDn
    f_chip(false, "CISD", color.new(COL_BEAR, 55), color.white, mkSize)
if showCisd and cisdUp
    f_chip(true, "CISD", color.new(COL_BULL, 55), color.white, mkSize)

// ---- IFC candle: institutional funding candle --------------------------------
// Takes a REAL pool (the prior IFC_LOOK-bar extreme) with meaningful
// penetration, then closes past the prior candle's midpoint in the outer
// STRONG_CLOSE_PCT of its own range with a displacement body.
prevMid  = (high[1] + low[1]) / 2
ifcPoolL = ta.lowest(low, IFC_LOOK)[1]
ifcPoolH = ta.highest(high, IFC_LOOK)[1]
ifcBull = low < ifcPoolL and ifcPoolL - low >= NEAR_LVL_ATR * atr and bullBar and close > prevMid and strongUp and body >= BRK_BODY_ATR * atr
ifcBear = high > ifcPoolH and high - ifcPoolH >= NEAR_LVL_ATR * atr and bearBar and close < prevMid and strongDn and body >= BRK_BODY_ATR * atr
if showIFC and ifcBull and confirmed
    f_chip(true, "IFC", color.new(color.gray, 55), color.new(COL_BULL, 0), mkSize)
if showIFC and ifcBear and confirmed
    f_chip(false, "IFC", color.new(color.gray, 55), color.new(COL_BEAR, 0), mkSize)

// retest confirmation used by the POI / trendline / machine execution stages
zoneBullConf = bullConfirm or ifcBull or (cisdAsConf and cisdUp)
zoneBearConf = bearConfirm or ifcBear or (cisdAsConf and cisdDn)

// ═════════════════════════════ MODULE 4 · STRUCTURE (INTERNAL + EXTERNAL)
// ARCH-3 / BUG-1 / BUG-2. One engine, two INDEPENDENT instances:
//   EXTERNAL (extPiv) — context, major BOS / CHoCH, protected levels, range.
//   INTERNAL (pivLen) — MSS / execution confirmation ONLY.
// The protected swing is the ACTUAL ORIGINATING PIVOT of the leg that made
// the last BOS, not a running min/max. A weak (non-displacement) close through
// a level is a liquidity RUN: it is reported, it does NOT set the break latch,
// and the level therefore stays available for a real structural break later.
// ═════════════════════════════════════════════════════════════════════════════
type Struct
    int   dir       = 0
    float swHi      = na    // latest confirmed pivot high (BOS-up level)
    int   swHiBar   = na
    float swLo      = na    // latest confirmed pivot low  (BOS-dn level)
    int   swLoBar   = na
    bool  hiBroken  = false // once-per-level structural latch
    bool  loBroken  = false
    bool  hiRun     = false // once-per-level weak-run latch (BUG-2)
    bool  loRun     = false
    float protLo    = na    // protected low  = origin pivot of the last bull leg
    int   protLoBar = na
    float protHi    = na
    int   protHiBar = na
    int   bosUpBar  = na
    int   bosDnBar  = na
    int   chUpBar   = na
    int   chDnBar   = na
    float evLvlUp   = na    // the level the last bullish event actually broke
    float evLvlDn   = na
    int   evBarUp   = na    // V5: the bar the broken level's pivot formed on
    int   evBarDn   = na

// Mutates the passed instance (a UDT field write is a reference write, not a
// global assignment, so this is legal inside a function) and reports the event.
f_structUpdate(Struct s, float pvH, float pvL, simple int pvLen) =>
    bool bosU = false
    bool bosD = false
    bool chU  = false
    bool chD  = false
    bool runU = false
    bool runD = false
    if confirmed
        // 1) register newly confirmed pivots — these are the ONLY structural levels
        if not na(pvH)
            s.swHi     := pvH
            s.swHiBar  := bar_index - pvLen
            s.hiBroken := false
            s.hiRun    := false
        if not na(pvL)
            s.swLo     := pvL
            s.swLoBar  := bar_index - pvLen
            s.loBroken := false
            s.loRun    := false
        bool disp = body >= structDisp * atr
        // 2) CHoCH first — a displaced close through the PROTECTED swing
        if s.dir == 1 and not na(s.protLo) and close < s.protLo and disp
            chD          := true
            s.dir        := -1
            s.chDnBar    := bar_index
            s.evLvlDn    := s.protLo
            s.evBarDn    := s.protLoBar
            s.protHi     := s.swHi          // origin of the new down-leg
            s.protHiBar  := s.swHiBar
            s.protLo     := na
            s.protLoBar  := na
            s.loBroken   := false
        else if s.dir == -1 and not na(s.protHi) and close > s.protHi and disp
            chU          := true
            s.dir        := 1
            s.chUpBar    := bar_index
            s.evLvlUp    := s.protHi
            s.evBarUp    := s.protHiBar
            s.protLo     := s.swLo          // origin of the new up-leg
            s.protLoBar  := s.swLoBar
            s.protHi     := na
            s.protHiBar  := na
            s.hiBroken   := false
        // 3) BOS — a displaced close through the latest pivot in the trend
        else if not na(s.swHi) and not s.hiBroken and close > s.swHi and s.dir >= 0
            if disp
                bosU        := true
                s.hiBroken  := true
                s.dir       := 1
                s.bosUpBar  := bar_index
                s.evLvlUp   := s.swHi
                s.evBarUp   := s.swHiBar
                s.protLo    := s.swLo       // the pivot low that originated this leg
                s.protLoBar := s.swLoBar
            else if not s.hiRun
                runU     := true            // liquidity run: level NOT burned (BUG-2)
                s.hiRun  := true
        else if not na(s.swLo) and not s.loBroken and close < s.swLo and s.dir <= 0
            if disp
                bosD        := true
                s.loBroken  := true
                s.dir       := -1
                s.bosDnBar  := bar_index
                s.evLvlDn   := s.swLo
                s.evBarDn   := s.swLoBar
                s.protHi    := s.swHi
                s.protHiBar := s.swHiBar
            else if not s.loRun
                runD     := true
                s.loRun  := true
        // 4) counter-trend pivot breaks with no protected level yet (first leg)
        else if s.dir == 1 and na(s.protLo) and not na(s.swLo) and not s.loBroken and close < s.swLo and disp
            chD         := true
            s.dir       := -1
            s.chDnBar   := bar_index
            s.evLvlDn   := s.swLo
            s.evBarDn   := s.swLoBar
            s.loBroken  := true
            s.protHi    := s.swHi
            s.protHiBar := s.swHiBar
        else if s.dir == -1 and na(s.protHi) and not na(s.swHi) and not s.hiBroken and close > s.swHi and disp
            chU         := true
            s.dir       := 1
            s.chUpBar   := bar_index
            s.evLvlUp   := s.swHi
            s.evBarUp   := s.swHiBar
            s.hiBroken  := true
            s.protLo    := s.swLo
            s.protLoBar := s.swLoBar
    [bosU, bosD, chU, chD, runU, runD]

// ---- internal scale (execution) ----------------------------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var Struct sInt = Struct.new()
[bosUp, bosDn, chochUp, chochDn, runUp, runDn] = f_structUpdate(sInt, ph, pl, pivLen)

// ---- external scale (context) -------------------------------------------------
eph = ta.pivothigh(high, extPiv, extPiv)
epl = ta.pivotlow(low, extPiv, extPiv)
var Struct sExt = Struct.new()
[eBosUp, eBosDn, eChochUp, eChochDn, eRunUp, eRunDn] = f_structUpdate(sExt, eph, epl, extPiv)

msDir    = sInt.dir
extDir   = sExt.dir
protLowI  = sInt.protLo
protHighI = sInt.protHi
protLowE  = sExt.protLo
protHighE = sExt.protHi
lastRes  = sInt.swHi          // latest internal swing high — buy-side liquidity above
lastSup  = sInt.swLo          // latest internal swing low  — sell-side liquidity below
lastResBar = sInt.swHiBar
lastSupBar = sInt.swLoBar
extRes   = sExt.swHi
extSup   = sExt.swLo
extResBar = sExt.swHiBar
extSupBar = sExt.swLoBar

// structural break flags reused by the pattern engines (①②③) — these must be
// the STRUCTURAL breaks, so a weak run no longer arms a pattern watch.
brokeUp = bosUp or eBosUp or chochUp or eChochUp
brokeDn = bosDn or eBosDn or chochDn or eChochDn
// the level the break actually took (needed by the ①/②/③ watch state machines)
brkUpLvl = bosUp or chochUp ? sInt.evLvlUp : eBosUp or eChochUp ? sExt.evLvlUp : na
brkDnLvl = bosDn or chochDn ? sInt.evLvlDn : eBosDn or eChochDn ? sExt.evLvlDn : na

// ---- separate trigger memories: internal ≠ external (BUG-3) -------------------
var int iChUpBar   = na
var int iChDnBar   = na
var int eChUpBar   = na
var int eChDnBar   = na
var int eBosUpBar2 = na
var int eBosDnBar2 = na
var int cisdUpBar  = na
var int cisdDnBar  = na
var int dispUpBar2 = na
var int dispDnBar2 = na
if confirmed
    if chochUp
        iChUpBar := bar_index
    if chochDn
        iChDnBar := bar_index
    if eChochUp
        eChUpBar := bar_index
    if eChochDn
        eChDnBar := bar_index
    if eBosUp
        eBosUpBar2 := bar_index
    if eBosDn
        eBosDnBar2 := bar_index
    if cisdUp
        cisdUpBar := bar_index
    if cisdDn
        cisdDnBar := bar_index
    if dispUpBar
        dispUpBar2 := bar_index
    if dispDnBar
        dispDnBar2 := bar_index

recentIChUp  = f_recent(iChUpBar, TRIG_LOOK)
recentIChDn  = f_recent(iChDnBar, TRIG_LOOK)
recentEChUp  = f_recent(eChUpBar, TRIG_LOOK)
recentEChDn  = f_recent(eChDnBar, TRIG_LOOK)
recentEBosUp = f_recent(eBosUpBar2, TRIG_LOOK)
recentEBosDn = f_recent(eBosDnBar2, TRIG_LOOK)
recentCisdUp = f_recent(cisdUpBar, TRIG_LOOK)
recentCisdDn = f_recent(cisdDnBar, TRIG_LOOK)
recentDispUp = f_recent(dispUpBar2, 3)
recentDispDn = f_recent(dispDnBar2, 3)
// ═══ V7.0 · §5 · FOUR SEPARATE STRUCTURAL VOCABULARIES ══════════════════
// BOS   · continuation. The trend broke its own last pivot, with displacement.
// CHoCH · potential change of direction. The PROTECTED swing broke — the origin
//         pivot of the leg that made the last BOS, not any recent pivot.
// MSS   · a MEANINGFUL shift: a CHoCH is one by construction (f_structUpdate
//         already demands a displacement body). A CISD is one only when the
//         same candle also displaces, and only while mssNeedDisp allows it.
// CISD  · delivery flipped: price closed through the ORIGIN OPEN of the last
//         directional run. That is an order-flow statement, not a structural
//         one, and v6.4 treating it as identical to a CHoCH is why "MSS" fired
//         on candles where no level had been broken at all.
// Every consumer below now says which of the four it means.
// the CISD promotion test, applied once here rather than at each call site
cisdMssUp = cisdUp and (not mssNeedDisp or dispUpBar or strongUp)
cisdMssDn = cisdDn and (not mssNeedDisp or dispDnBar or strongDn)
mssBull = chochUp or cisdMssUp
mssBear = chochDn or cisdMssDn
// SHIFT = the loosest reading, "delivery or structure turned". Used only where
// a directional hint is enough (the pool reaction promotion, the run engine's
// exhaustion test) — never as a setup's stage-5 MSS.
shiftUp = chochUp or cisdUp
shiftDn = chochDn or cisdDn
recentMssUp = recentIChUp or recentCisdUp
recentMssDn = recentIChDn or recentCisdDn
// structure direction preferring the external narrative (context)
structDir = extDir != 0 ? extDir : msDir

// ---- structure marks: external bright, internal muted, runs optional ---------
if showStruct and (eBosUp or eChochUp)
    f_chip(true, eChochUp ? "CHoCH" : "BOS", color.new(COL_BULL, 15), color.white, size.small)
if showStruct and (eBosDn or eChochDn)
    f_chip(false, eChochDn ? "CHoCH" : "BOS", color.new(COL_BEAR, 15), color.white, size.small)
if showStruct and (bosUp or chochUp)
    f_chip(true, chochUp ? "iCHoCH" : "ibos", color.new(color.gray, 35), color.new(COL_BULL, 0), mkSize)
if showStruct and (bosDn or chochDn)
    f_chip(false, chochDn ? "iCHoCH" : "ibos", color.new(color.gray, 35), color.new(COL_BEAR, 0), mkSize)
if showRuns and (runUp or eRunUp)
    f_chip(true, "run", color.new(COL_NEU, 45), color.white, mkSize)
if showRuns and (runDn or eRunDn)
    f_chip(false, "run", color.new(COL_NEU, 45), color.white, mkSize)

// ---- order-flow zigzag (internal legs) ---------------------------------------
var float zzPrevP = na
var int   zzPrevB = na
var zzLines = array.new<line>()
if showOF and confirmed and (not na(ph) or not na(pl))
    float p = not na(ph) ? ph : pl
    int   b = bar_index - pivLen
    if not na(zzPrevP)
        array.push(zzLines, line.new(zzPrevB, zzPrevP, b, p,
             color = p > zzPrevP ? color.new(COL_BULL, 35) : color.new(COL_BEAR, 35), width = 1))
        if array.size(zzLines) > 40
            line.delete(array.get(zzLines, 0))
            array.remove(zzLines, 0)
    zzPrevP := p
    zzPrevB := b

// ═══════════════════════ MODULE 5 · SESSIONS · KILLZONES · SILVER BULLET
// Session state is computed ALWAYS; the display toggles only affect drawing
// (BUG-6 — in v2 turning a display off silently disabled score terms).
// ═════════════════════════════════════════════════════════════════════════════
f_inSes(simple string ses) =>
    not na(time(timeframe.period, ses, "America/New_York"))

inAsia = f_inSes(asiaSes)
inLon  = f_inSes(lonSes)
inNY   = f_inSes(nySes)
inSbLO = f_inSes(sbSesLO)
inSbAM = f_inSes(sbSesAM)
inSbPM = f_inSes(sbSesPM)
inSB   = inSbLO or inSbAM or inSbPM
inKZ   = inAsia or inLon or inNY or inSB
kzOK   = not useKZ or not timeframe.isintraday or inKZ

// SCHEDULED VOLATILITY FILTER — fixed clock slots, NOT a live economic
// calendar. Named and documented as such (Phase 21).
inVol  = f_inSes(news1Ses) or f_inSes(news2Ses) or f_inSes(news3Ses)
volOK  = not useNews or not timeframe.isintraday or not inVol

// Silver Bullet is a FILTER, never a signal (Phase 20).
sbActive = sbRole != "Off" and timeframe.isintraday and inSB
sbGate   = not sbOnlyIn or not timeframe.isintraday or inSB

// ---- opening prices: 00:00 midnight + 08:30 NY -------------------------------
inMidWin = f_inSes("0000-0005")
in830Win = f_inSes("0830-0835")
newMid  = inMidWin and not inMidWin[1]
new830  = in830Win and not in830Win[1]

var float midOpen    = na
var float ny830Open  = na
var line  midLn      = na
var label midLb      = na
var line  ny830Ln    = na
var label ny830Lb    = na
var int   lastMidBar = na
var int   last830Bar = na

// a bar's OPEN is fixed on its first tick → safe to draw immediately, but the
// re-entry guard keeps it to one draw per bar
if timeframe.isintraday and newMid and (na(lastMidBar) or lastMidBar != bar_index)
    lastMidBar := bar_index
    midOpen    := open
    if showOpens
        line.delete(midLn)
        label.delete(midLb)
        midLn := line.new(bar_index, open, bar_index + 1, open,
             color = color.new(color.white, 45), style = line.style_dotted, extend = extend.right)
        midLb := label.new(bar_index, open, "00:00", style = label.style_label_left,
             color = color.new(color.gray, 45), textcolor = color.white, size = infoSize)
if timeframe.isintraday and new830 and (na(last830Bar) or last830Bar != bar_index)
    last830Bar := bar_index
    ny830Open  := open
    if showOpens
        line.delete(ny830Ln)
        label.delete(ny830Lb)
        ny830Ln := line.new(bar_index, open, bar_index + 1, open,
             color = color.new(color.orange, 45), style = line.style_dotted, extend = extend.right)
        ny830Lb := label.new(bar_index, open, "08:30", style = label.style_label_left,
             color = color.new(color.orange, 45), textcolor = color.white, size = infoSize)

// ---- session extremes: tracked live, FROZEN on the session close -------------
// The frozen level is resting liquidity and is handed to the pool registry;
// raid / break detection lives there, so every pool kind shares one lifecycle.
type Ses
    float hi    = na
    float lo    = na
    float fhi   = na
    float flo   = na
    bool  fresh = false
    line  hiLn  = na
    line  loLn  = na
    label hiLb  = na
    label loLb  = na

f_sesTrack(Ses s, bool active, string tag, color col) =>
    s.fresh := false
    if active
        if not active[1]
            s.hi := high
            s.lo := low
        else
            s.hi := math.max(nz(s.hi, high), high)
            s.lo := math.min(nz(s.lo, low), low)
    if not active and active[1] and confirmed and not na(s.hi)
        s.fhi   := s.hi
        s.flo   := s.lo
        s.fresh := true
        if showSesHL
            line.delete(s.hiLn)
            line.delete(s.loLn)
            label.delete(s.hiLb)
            label.delete(s.loLb)
            s.hiLn := line.new(bar_index, s.fhi, bar_index + 1, s.fhi, color = color.new(col, 35), extend = extend.right)
            s.loLn := line.new(bar_index, s.flo, bar_index + 1, s.flo, color = color.new(col, 35), extend = extend.right)
            s.hiLb := label.new(bar_index, s.fhi, tag + " H", style = label.style_label_left,
                 color = color.new(col, 45), textcolor = color.white, size = infoSize)
            s.loLb := label.new(bar_index, s.flo, tag + " L", style = label.style_label_left,
                 color = color.new(col, 45), textcolor = color.white, size = infoSize)
    s.fresh

var Ses sesAsia = Ses.new()
var Ses sesLon  = Ses.new()
var Ses sesNY   = Ses.new()
asiaFresh = f_sesTrack(sesAsia, inAsia and timeframe.isintraday, "Asia", color.purple)
lonFresh  = f_sesTrack(sesLon,  inLon  and timeframe.isintraday, "Lon",  color.blue)
nyFresh   = f_sesTrack(sesNY,   inNY   and timeframe.isintraday, "NY",   color.orange)

// ═══════════════════════════════════ MODULE 6 · HTF CONTEXT ENGINE
// The HTF answers "WHERE is price likely to react?", never "BUY".
//
// V4-BUG-9 / V5-10 · EVERY read here is the LAST CLOSED HTF BAR: the expression
// inside the request is indexed [1] and the call uses lookahead_on. v4 used a
// bare expression with lookahead_off, which returns the HTF bar that is still
// BEING BUILT — not a future-data leak, but a value that changes under the
// script as the HTF candle forms, which is exactly what "repainting HTF bias"
// means. The [1] steps back to the closed bar; lookahead_on then serves that
// closed bar from the first chart bar of the new HTF candle instead of an
// entire HTF candle later. The remaining delay is the honest one: an HTF event
// is usable on the first chart bar after the HTF candle that produced it has
// closed.
// ═════════════════════════════════════════════════════════════════════════════
f_autoHtf() =>
    switch timeframe.period
        "1"   => "15"
        "2"   => "30"
        "3"   => "30"
        "5"   => "60"
        "10"  => "120"
        "15"  => "240"
        "30"  => "240"
        "60"  => "D"
        "120" => "D"
        "240" => "D"
        => "D"

// V7.2 BUG-01 · a request.security to a timeframe BELOW the chart leaks future
// data through lookahead_on, whatever the [1] inside the requested expression
// says: the [1] steps back one bar of the REQUESTED series, not one chart bar.
// Auto is always >= the chart; the manual options were not constrained at all.
f_tfUp(simple string tf) => timeframe.in_seconds(tf) < timeframe.in_seconds() ? timeframe.period : tf
htfTf    = f_tfUp(htfSel    == "Auto" ? f_autoHtf() : htfSel)
htfCtxTf = f_tfUp(htfCtxSel == "Auto" ? f_autoHtf() : htfCtxSel)
htfLive  = htfTf != timeframe.period

// ---- MTF bias row (dashboard + optional counter-trend filter) ----------------
// V5-10 / V4-BUG-9. `lookahead_off` does NOT mean "the last closed HTF bar" — it
// means "no future data", and the HTF bar that is still forming is not future
// data, so v4 read a bar that changed as it built. The only combination that is
// both leak-free AND stable is expr[1] + lookahead_on: the [1] steps back to the
// bar that has already closed, and lookahead_on then makes that closed bar
// available from the first chart bar of the new HTF candle instead of one HTF
// candle later. Every HTF read in this module now uses it.
f_biasSrc() =>
    _v = close > ta.ema(close, biasLen) ? 1 : -1
    _v[1]

f_bias(simple string tf) =>
    request.security(syminfo.tickerid, f_tfUp(tf), f_biasSrc(), lookahead = barmerge.lookahead_on)

b5   = nz(f_bias("5"),   0)
b15  = nz(f_bias("15"),  0)
b60  = nz(f_bias("60"),  0)
b240 = nz(f_bias("240"), 0)
bD   = nz(f_bias("D"),   0)

filtBias = switch biasFilter
    "5"   => b5
    "15"  => b15
    "60"  => b60
    "240" => b240
    "D"   => bD
    => 0

// ---- HTF context bundle: direction, external swings, premium / discount -----
// BUG-16: the CONTEXT timeframe is now independent of the FILTER timeframe, so
// enabling the counter-trend filter no longer changes the score.
f_htfCtx() =>
    _dir = close > ta.ema(close, biasLen) ? 1 : -1
    _ph  = ta.pivothigh(high, 3, 3)
    _pl  = ta.pivotlow(low, 3, 3)
    var float _hi = na
    var float _lo = na
    if not na(_ph)
        _hi := _ph
    if not na(_pl)
        _lo := _pl
    _w  = not na(_hi) and not na(_lo) and _hi > _lo ? _hi - _lo : na
    _pd = na(_w) ? na : (close - _lo) / _w
    [_dir[1], _pd[1]]

[htfDirRaw, htfPdRaw] = request.security(syminfo.tickerid, htfCtxTf, f_htfCtx(),
     lookahead = barmerge.lookahead_on)
htfDir = nz(htfDirRaw, 0)
htfPd  = htfPdRaw

// ---- previous day high / low (external liquidity) ---------------------------
// The [1] inside the request is what makes lookahead_on safe here: only the
// COMPLETED previous day is ever read, on historical and realtime bars alike.
[pdhRaw, pdlRaw] = request.security(syminfo.tickerid, "D", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)
newDay = ta.change(time("D")) != 0

// ---- V5.6 · previous WEEK high / low (§2 · the top of the external ladder) --
// Same construction and the same safety argument as PDH/PDL: the [1] is INSIDE
// the request, so only the COMPLETED previous week is ever visible, on history
// and in realtime alike. v5.5 had no weekly liquidity at all, which left the
// single most obvious external stop pool on any intraday chart unmarked.
[pwhRaw, pwlRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)
newWeek = ta.change(time("W")) != 0
// weekly levels are meaningful intraday and on the daily; on weekly+ they are
// the chart's own previous bar and carry no information
pwUsable = showPW and (timeframe.isintraday or timeframe.isdaily)

// ---- V7.0 · HTF STRUCTURE + HTF LIQUIDITY (§6 / §25 / §26) ------------------
// This request.security slot used to publish the HTF CRT / turtle-soup pair.
// Those producers are gone; the SAME call, at the same cost, now publishes what
// the hierarchy actually needs: the HTF's own confirmed swing extremes (real
// external liquidity, registered as PK_HTF pools) and its external structure
// direction, so an LTF internal shift can never be mistaken for an HTF one.
// NON-REPAINTING: every value is indexed [1] INSIDE the request, so only a
// CLOSED HTF candle is ever visible, and the pivots are ta.pivot*(2,2) which
// are themselves only confirmed two HTF bars later.
f_htfStruct() =>
    _ph = ta.pivothigh(high, 2, 2)
    _pl = ta.pivotlow(low, 2, 2)
    var float _hi = na
    var float _lo = na
    var int   _d  = 0
    if not na(_ph)
        _hi := _ph
    if not na(_pl)
        _lo := _pl
    if not na(_hi) and close > _hi
        _d := 1
    if not na(_lo) and close < _lo
        _d := -1
    [_hi[1], _lo[1], _d[1], time[1]]

[hSwHi, hSwLo, hStrDirRaw, hT] = request.security(syminfo.tickerid, htfTf, f_htfStruct(),
     lookahead = barmerge.lookahead_on)
hStrDir   = nz(hStrDirRaw, 0)
newHtfBar = htfLive and not na(hT) and hT != nz(hT[1])


// ---- HTF FVG POI (the fractal model's "where") ------------------------------
// BUG-17: displacement required, HTF-direction filter, and the bar/touch
// counters are reset when the POI dies.
f_htfPoi() =>
    _atr = ta.atr(atrLen)
    _dir = close > ta.ema(close, biasLen) ? 1 : -1
    _dU  = close[1] > open[1] and math.abs(close[1] - open[1]) >= hPoiDisp * _atr
    _dD  = close[1] < open[1] and math.abs(close[1] - open[1]) >= hPoiDisp * _atr
    var float bTop = na
    var float bBot = na
    var int   bBar = na
    var int   bIn  = 0
    var float sTop = na
    var float sBot = na
    var int   sBar = na
    var int   sIn  = 0
    if low > high[2] and _dU and (not hPoiNeedDir or _dir > 0)
        bTop := low
        bBot := high[2]
        bBar := bar_index
        bIn  := 0
    if high < low[2] and _dD and (not hPoiNeedDir or _dir < 0)
        sBot := high
        sTop := low[2]
        sBar := bar_index
        sIn  := 0
    if not na(bTop) and not na(bBar) and bar_index > bBar and low <= bTop
        bIn += 1
    if not na(sTop) and not na(sBar) and bar_index > sBar and high >= sBot
        sIn += 1
    if not na(bBot) and (close < bBot or bar_index - bBar > hPoiMaxAge or bIn > hPoiMaxTouch)
        bTop := na
        bBot := na
        bBar := na
        bIn  := 0
    if not na(sTop) and (close > sTop or bar_index - sBar > hPoiMaxAge or sIn > hPoiMaxTouch)
        sTop := na
        sBot := na
        sBar := na
        sIn  := 0
    [bTop[1], bBot[1], sTop[1], sBot[1], bIn[1], sIn[1]]

[hPoiBTop, hPoiBBot, hPoiSTop, hPoiSBot, hPoiBIn, hPoiSIn] = request.security(syminfo.tickerid, htfTf, f_htfPoi(),
     lookahead = barmerge.lookahead_on)

// HTF context verdict, per direction. This is CONTEXT — it enables a setup, it
// never triggers one.
//
// V4-BUG-16: v4 OR'd four unrelated conditions together, so a long taken while
// the HTF was bearish looked exactly like a long taken with the HTF. v5 answers
// two separate questions:
//   CONTINUATION — the closed HTF agrees, and price is on the correct side of
//                  the HTF dealing range (or sitting in an HTF POI).
//   REVERSAL     — the closed HTF disagrees. Allowed only from an HTF premium /
//                  discount EXTREME or an opposing HTF FVG POI, and MODULE 15
//                  additionally demands a grade-A raid, a tier-1 POI and a
//                  CHoCH-grade MSS before such a setup may be graded above B.
htfContLong  = htfDir > 0 and (na(htfPd) or htfPd <= 0.5 or not na(hPoiBTop))
htfContShort = htfDir < 0 and (na(htfPd) or htfPd >= 0.5 or not na(hPoiSTop))
htfRevLong   = allowRev and htfDir < 0 and ((not na(htfPd) and htfPd <= PD_EXTREME) or not na(hPoiBTop))
htfRevShort  = allowRev and htfDir > 0 and ((not na(htfPd) and htfPd >= 1 - PD_EXTREME) or not na(hPoiSTop))
// "this setup is fighting the HTF" — carried into the setup and into the grade
htfIsRevLong  = not htfContLong  and htfDir < 0
htfIsRevShort = not htfContShort and htfDir > 0
// V5.1-A3b: `not needHtfAlign or ...` made the whole clause tautological, so
// turning the HTF alignment requirement OFF also switched off allowRev AND the
// premium/discount-EXTREME requirement that htfRevLong carries — counter-HTF
// setups armed with neither. Alignment-off now means "continuation OR a
// qualified reversal OR flat/neutral HTF", not "anything at all".
htfCtxLong   = htfContLong  or htfRevLong  or (not needHtfAlign and not htfIsRevLong)
htfCtxShort  = htfContShort or htfRevShort or (not needHtfAlign and not htfIsRevShort)

// ONE tolerance for equality, dedupe and clustering, evaluated ONCE per bar as
// a global rather than as a function: f_poolPush is inlined 16 times, so a
// series variable read costs one token there where the expression costs seven.
// ATR-driven as before, with an optional tick floor for quantised instruments
// (§3). At eqTickMin = 0 it is exactly the v5.5 expression, eqTol * atr.
lqTol   = math.max(eqTol * atr, eqTickMin * syminfo.mintick)
lqReact = math.max(lqTol * 2, 0.5 * atr)   // the v5.5 EQH/EQL reaction floor

// ═════════════════════════════════ MODULE 7 · LIQUIDITY REGISTRY (ARCH-2)
// Every meaningful level becomes a POOL with a real lifecycle:
//   CREATED → VALIDATED → RAIDED → REACTION CONFIRMED → CONSUMED
// A raid is BOUND to at most one setup (BUG-10), dies if there is no reaction
// inside reactWin, and dies the moment price closes the wrong side of the
// level (which is what made v2's "in play" test wrong, BUG-9).
// ═════════════════════════════════════════════════════════════════════════════
type Pool
    float  px         = na
    int    kind       = 0
    bool   buySide    = true
    int    bornBar    = na
    int    state      = 0
    int    raidBar    = na
    float  raidExt    = na
    bool   raidStrong = false
    int    brkBar     = na     // bar the level was BROKEN (close beyond) on
    int    bound      = 0      // setup id that claimed this raid (0 = free)
    int    id         = 0      // V5-3: stable identity — a setup binds to THIS pool
    int    touches    = 0      // V5: prior reactions/tests = how real the level is
    int    lastTouch  = na
    int    rq         = 0      // V5-5: raid grade RQ_A / RQ_B / RQ_C
    bool   spent      = false  // an entry was already produced from this pool
    line   ln         = na
    string tag        = ""
    string desc       = ""     // V5.5-E · §7/§8 · descriptors of THIS ONE event
    int    descN      = 0
    // ---- V5.6 · liquidity marking layer. DISPLAY STATE ONLY: nothing below is
    //      read by the setup machine, the score, the gates or the risk ladder.
    int    kmask      = 0      // confluence: which level TYPES resolved here
    int    legs       = 1      // how many pivots were fused into this level
    int    lstr       = 0      // LS_WEAK … LS_EXT, recomputed on the last bar
    int    lscore     = 0
    int    cluN       = 1      // members of this liquidity cluster
    float  cluHi      = na     // cluster price span
    float  cluLo      = na
    bool   cluRep     = true   // this pool speaks for its cluster
    bool   isExt      = false  // external liquidity, relative to the LIVE range

var pools = array.new<Pool>()
// a function may not assign to a global scalar, but it may mutate a global
// array — so the id sequence lives in a one-element array
var poolSeq = array.new<int>(1, 0)

// na-safe accessors (see the module note): the object is a parameter, and the
// field is only touched inside an `if` that has already proved it exists.
f_poolSpent(Pool p) =>
    bool sp = false
    if not na(p)
        sp := p.spent
    sp

f_poolTouch(Pool p) =>
    int tc = 0
    if not na(p)
        tc := p.touches
    tc

// V5.2-B4: na-safe read of the bar a pool was BROKEN on (close beyond the
// level). The machine invalidates a setup whose raided pool was reclaimed.
f_poolBrkBar(Pool p) =>
    int bb = na
    if not na(p)
        bb := p.brkBar
    bb

// V5.5-E · §7 / §8 · EVENT IDENTITY AND DESCRIPTORS.
// ONE physical market event = ONE Pool = one id. A single sell-side raid that is
// simultaneously a CRT low sweep, a turtle-soup extreme, a TWS wave-2 and a bear
// trap is ONE liquidity event carrying FOUR DESCRIPTORS — it is not four
// independent confirmations. Descriptors are appended here and printed on the
// dashboard, the debug panel and the entry reason, and they are worth a CAPPED
// context bonus in f_score. They can never pay a single LIQUIDITY point: that
// block is paid once, from this pool's own raid grade, class and touch history.
// That is the anti-inflation rule made structural instead of asserted.
f_evTag(Pool p, string d) =>
    bool added = false
    if not na(p) and d != ""
        if not str.contains(p.desc, d)
            p.desc  := p.desc == "" ? d : p.desc + "+" + d
            p.descN += 1
            added   := true
    added

f_poolDesc(Pool p) =>
    string dd = ""
    if not na(p)
        dd := p.desc
    dd

f_poolDescN(Pool p) =>
    int dn = 0
    if not na(p)
        dn := p.descN
    dn

// V5.5-E7 · na-safe price read. The pool dedupe compares PRICE as well as id,
// because a retired pool's level can re-register under a brand-new id.
f_poolPx(Pool p) =>
    float px = na
    if not na(p)
        px := p.px
    px


f_poolVisible(int kind) =>
    kind == PK_SES ? false :
         kind == PK_TL ? (showPools and showTL) :
         kind == PK_HTF ? (showPools and htfLiqReg) :
         kind == PK_PW ? (showPools and showPW) :
         kind == PK_EQ ? (showPools and showEq) :
         kind == PK_PD ? (showPools and showPD) :
         showPools

f_poolCol(int kind, bool buySide) =>
    kind == PK_HTF ? color.new(color.fuchsia, 25) :
         kind == PK_TL ? color.new(color.aqua, 35) :
         kind == PK_EQ ? (buySide ? color.new(COL_BEAR, 25) : color.new(COL_BULL, 25)) :
         kind == PK_PD ? color.new(color.yellow, 35) :
         kind == PK_PW ? color.new(color.orange, 25) :
         kind == PK_EXT ? (buySide ? color.new(COL_BEAR, 40) : color.new(COL_BULL, 40)) :
         color.new(COL_NEU, 62)

f_poolStyle(int kind) =>
    kind == PK_EQ ? line.style_dotted : kind == PK_SWING ? line.style_dashed : line.style_solid

// V5.6-L12 · the two statements every registry path repeated. A touch counts
// once per eqMinSep bars; a retired / raided line stops extending and restyles.
f_poolTouchInc(Pool p) =>
    if na(p.lastTouch) or bar_index - p.lastTouch >= eqMinSep
        p.touches   += 1
        p.lastTouch := bar_index
    true

f_lnEnd(line ln, string sty) =>
    line.set_extend(ln, extend.none)
    line.set_x2(ln, bar_index)
    line.set_style(ln, sty)
    true

// registers a pool unless a live pool of the same side already sits there.
// V5.2-B1: a duplicate that OUTRANKS a live un-raided SWING pool upgrades that
// pool in place (kind, tag, px, +touch) instead of being refused. EQH/EQL and
// EXT levels sit by construction at prices where a swing pool already lives,
// so the old refusal meant the registry almost never held engineered or
// external pools at all. Identity (id, bound, bornBar, touches) is preserved,
// and a pool that has already been RAIDED is never re-classified.
// V5.6: the refusal / upgrade decision is UNCHANGED. Two things are added, and
// neither can alter it — the tolerance gains an optional tick floor (0 by
// default → the identical eqTol * atr expression), and the surviving pool
// records the KIND of every level that resolved to it, so "PDH sitting on an
// EQH sitting on a major swing" is one pool that knows it is three things.
f_poolPush(float px, int kind, bool buySide, string tag, int startBar, bool validated, int legs) =>
    bool ok = not na(px)
    if ok and array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool q = array.get(pools, i)
            if q.state < PS_DONE and q.buySide == buySide and math.abs(q.px - px) <= lqTol
                ok := false
                q.kmask := f_maskAdd(q.kmask, kind)
                q.legs  := math.max(q.legs, legs)
                if kind != PK_SWING and q.kind == PK_SWING and q.state <= PS_VAL
                    q.kind  := kind
                    q.tag   := tag
                    q.px    := px
                    q.state := PS_VAL
                    f_poolTouchInc(q)
                    line.set_y1(q.ln, px)
                    line.set_y2(q.ln, px)
                    line.set_color(q.ln, f_poolVisible(kind) ? f_poolCol(kind, buySide) : color.new(color.gray, 100))
                    line.set_style(q.ln, f_poolStyle(kind))
                    line.set_width(q.ln, kind == PK_EQ or kind == PK_PD or kind == PK_PW ? 2 : 1)
                break
    if ok
        array.set(poolSeq, 0, array.get(poolSeq, 0) + 1)
        Pool p = Pool.new(px = px, kind = kind, buySide = buySide, bornBar = startBar,
             state = validated ? PS_VAL : PS_NEW, tag = tag, id = array.get(poolSeq, 0),
             touches = validated ? 1 : 0, kmask = f_maskAdd(0, kind), legs = legs)
        // the line is always created (never na → no setter guards anywhere) and
        // simply drawn fully transparent when its display group is off
        p.ln := line.new(startBar, px, bar_index + 1, px,
             color = f_poolVisible(kind) ? f_poolCol(kind, buySide) : color.new(color.gray, 100),
             style = f_poolStyle(kind), width = kind == PK_EQ or kind == PK_PD or kind == PK_PW ? 2 : 1,
             extend = extend.right)
        array.push(pools, p)
        // §13/§19 · CAP. v5.5 always evicts slot 0 — the OLDEST pool — which is
        // backwards for liquidity: a previous-day high that has stood untouched
        // all session is the most crowded level on the chart and the first to
        // die. With lqPrunePri ON the weakest un-raided pool goes instead.
        // OFF is the v5.5 eviction order, byte for byte.
        while array.size(pools) > poolMaxN
            int victim = 0
            if lqPrunePri
                float worst = 1e18
                for i = 0 to array.size(pools) - 1
                    Pool o = array.get(pools, i)
                    // a live raid is evidence in flight and is evicted last
                    float w = f_kindPri(o.kind) * 10 + f_maskN(o.kmask) * 6 + math.min(o.touches, 4) * 4 +
                         (o.state == PS_RAID or o.state == PS_REACT ? 100 : 0) + (o.bound != 0 ? 100 : 0) +
                         i * 0.001
                    if w < worst
                        worst  := w
                        victim := i
            Pool v = array.get(pools, victim)
            line.delete(v.ln)
            array.remove(pools, victim)
    ok

// ═══ V5.6-BUDGET · THE REGISTRATION QUEUE ═══════════════════════════════════
// Pine INLINES a user-defined function at every call site before it counts
// tokens. f_poolPush above is a ~690-token body and v5.5 called it fourteen
// times: ~9 700 compiled tokens for one function, and every token added inside
// it cost fourteen. v5.6 tipped that over the 100 256 limit.
//
// The fix is structural, not cosmetic. Every registration now enqueues, and the
// queue is drained through ONE call site just before the lifecycle scan. Order
// is preserved exactly — it is the same calls in the same sequence — and
// nothing between the registrations reads `pools`, so the behaviour is
// identical. One inlined copy instead of sixteen also left enough headroom to
// keep the weakest-first prune, the confluence mask and the fused-leg count,
// all of which had to be stripped when the budget was tight.
var qPx   = array.new<float>()
var qKind = array.new<int>()
var qSide = array.new<bool>()
var qTag  = array.new<string>()
var qBar  = array.new<int>()
var qVal  = array.new<bool>()
var qLeg  = array.new<int>()

f_qPush(float px, int kind, bool buySide, string tag, int startBar, bool validated, int legs) =>
    array.push(qPx, px)
    array.push(qKind, kind)
    array.push(qSide, buySide)
    array.push(qTag, tag)
    array.push(qBar, startBar)
    array.push(qVal, validated)
    array.push(qLeg, legs)
    0

f_qFlush() =>
    if array.size(qPx) > 0
        for i = 0 to array.size(qPx) - 1
            bool pushed = f_poolPush(array.get(qPx, i), array.get(qKind, i), array.get(qSide, i),
                 array.get(qTag, i), array.get(qBar, i), array.get(qVal, i), array.get(qLeg, i))
        array.clear(qPx)
        array.clear(qKind)
        array.clear(qSide)
        array.clear(qTag)
        array.clear(qBar)
        array.clear(qVal)
        array.clear(qLeg)
    0

// PHASE 7 lifecycle scan — one pass per confirmed bar over the whole registry.
// The `confirmed` guard lives INSIDE the function on purpose: Pine evaluates
// both branches of a ternary, so gating the CALL would still have mutated pool
// state on every intrabar tick.
f_poolScan() =>
    int raided = 0
    if confirmed and array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Pool p = array.get(pools, i)
            if p.state == PS_DONE
                if poolLife > 0 and bar_index - p.bornBar > poolLife + 50
                    line.delete(p.ln)
                    array.remove(pools, i)
                continue
            if poolLife > 0 and bar_index - p.bornBar > poolLife
                p.state := PS_DONE
                f_lnEnd(p.ln, line.style_dotted)
                continue
            // ---- penetration handling: RAID (wick, close back) vs BREAK
            //      V4-BUG-10 / V5-5. A raid needs raidMinAtr of real penetration
            //      and is then graded A / B / C from depth and rejection. Below
            //      that depth the bar is a TEST: it raises the pool's quality
            //      (price respected the level) and the pool stays hunting.
            // V5.6-L12 · ONE branch for both sides. `sg` is +1 for buy-side
            // liquidity (above price, taken by the HIGH) and -1 for sell-side
            // (taken by the LOW); `pex` is the candle extreme on the pool's side.
            // Every sign product below is exact (×±1.0), so `sg * (ext - p.px)
            // > 0` IS `high > p.px` / `low < p.px`. The two comparisons whose
            // float rearrangement could differ by an ulp — the rejection leg and
            // the approach band — are kept in their original per-side form.
            float sg  = p.buySide ? 1.0 : -1.0
            float pex = p.buySide ? high : low
            if sg * (pex - p.px) > 0
                if sg * (close - p.px) < 0
                    float pen = sg * (pex - p.px) / atr
                    // §11 · WICK vs BODY, now configurable. Leg 1 is the
                    // v5.5 relative test (the close sits back from the swept
                    // extreme by a fraction of the raid candle's own range);
                    // leg 2 is an optional ABSOLUTE close-back in ATR, which
                    // is what actually kills one-tick pokes on instruments
                    // whose bar ranges swing wildly. Defaults reproduce v5.5.
                    bool  rej = (p.buySide ? close <= high - raidRejFrac * rng : close >= low + raidRejFrac * rng) and
                         (raidBackAtr <= 0 or sg * (p.px - close) >= raidBackAtr * atr)
                    if p.state <= PS_VAL and pen >= raidMinAtr
                        p.state      := PS_RAID
                        p.raidBar    := bar_index
                        p.raidExt    := pex
                        p.raidStrong := rej
                        p.rq         := pen >= raidDeepAtr and rej ? RQ_A : pen >= raidDeepAtr or rej ? RQ_B : RQ_C
                        p.desc       := p.rq == RQ_A ? "DEEP RAID" : p.rq == RQ_B ? "SWEEP" : "WICK"
                        p.descN      := 1
                        raided += 1
                        f_lnEnd(p.ln, line.style_dashed)
                    else if p.state <= PS_VAL
                        p.state := PS_VAL
                        f_poolTouchInc(p)
                    else
                        p.raidExt := p.buySide ? math.max(nz(p.raidExt, high), high) : math.min(nz(p.raidExt, low), low)
                else
                    p.state  := PS_DONE           // BROKEN → expansion, not a raid
                    p.brkBar := bar_index
                    f_lnEnd(p.ln, line.style_dotted)
                    continue
            else if p.state <= PS_VAL and (p.buySide ? high >= p.px - NEAR_LVL_ATR * atr : low <= p.px + NEAR_LVL_ATR * atr)
                p.state := PS_VAL                 // approached and respected
                f_poolTouchInc(p)
            // ---- reaction / staleness: a raid does NOT stay valid forever
            if p.state == PS_RAID or p.state == PS_REACT
                if sg * (close - p.px) > 0
                    p.state  := PS_DONE               // raid failed → became a break
                    p.brkBar := bar_index             // V5.2-B4: a reclaim IS a break
                else if p.state == PS_RAID
                    if bar_index - p.raidBar > reactWin
                        p.state := PS_DONE            // no reaction in time → stale
                    else if bar_index > p.raidBar and (p.buySide ? (dispDnBar or shiftDn) : (dispUpBar or shiftUp))
                        // V5.5-E1 · THE RAID CANDLE CANNOT BE ITS OWN REACTION. v5.4
                        // ran this test on the raid bar too, so a shallow poke whose
                        // candle happened to carry an unrelated internal CHoCH / CISD
                        // was promoted PS_RAID → PS_REACT immediately AND had its raid
                        // grade lifted RQ_C → RQ_B — which is exactly what f_grade
                        // needs for grade A. Same family as V4-BUG-6/7 (an event
                        // confirming itself) and V4-BUG-5 (a global flag paying a
                        // specific setup).
                        // V7.2 BUG-05 · the reaction promotes the pool STATE, never the
                        //   raid GRADE: rq describes the raid candle (depth x rejection)
                        //   and rq >= RQ_B is the grade-A rung's own requirement.
                        p.state    := PS_REACT
                else if bar_index - p.raidBar > sweepLook or math.abs(close - p.px) > POOL_CONSUME_ATR * atr
                    p.state := PS_DONE
    raided

// ---- pivot memory (EQH / EQL construction + reaction depth) -----------------
// V5.6 · §3 / §2 (double + TRIPLE tops). v5.5 held exactly ONE previous pivot
// per side, so equality was only ever tested against the pivot immediately
// before. A triple top whose middle leg overshoots by half an ATR, or a level
// re-tested two pivots later, produced no engineered pool at all — one of the
// reasons the registry rarely held PK_EQ levels (the v5.2-B1 note above says
// the same thing from the other end).
//
// The memory is now a ring of `eqScanN` pivots, each carrying its OWN reaction
// extreme (the deepest pullback since THAT pivot — a single global `sinceHiMin`
// is only correct for the most recent one). ALL stored legs that satisfy
// tolerance + separation + reaction are fused into ONE pool at their mean and
// tagged with the leg count. eqScanN = 1 reduces to the v5.5 expression exactly:
// one slot, one comparison, mean of the pair, tag "EQH" / "EQL".
//
// NON-REPAINTING: `ph` / `pl` are ta.pivothigh/low(pivLen, pivLen), so a leg is
// only ever read pivLen bars after it printed, and the pool is registered on
// the confirming bar with bornBar back-dated to the pivot. No future reference.
var phVal = array.new<float>()
var phBar = array.new<int>()
var phMin = array.new<float>()    // deepest pullback since that pivot
var plVal = array.new<float>()
var plBar = array.new<int>()
var plMax = array.new<float>()
// v5.5's lastPhVal / lastPhBar / lastPlVal / lastPlBar / sinceHiMin /
// sinceLoMax were the one-slot version of the ring above. Nothing outside this
// block ever read them, so they are gone rather than left as write-only state
// (same housekeeping rule as V5.5-E6).
if confirmed
    if array.size(phMin) > 0
        for i = 0 to array.size(phMin) - 1
            array.set(phMin, i, math.min(array.get(phMin, i), low))
    if array.size(plMax) > 0
        for i = 0 to array.size(plMax) - 1
            array.set(plMax, i, math.max(array.get(plMax, i), high))

if confirmed and not na(ph)
    int   pbH   = bar_index - pivLen
    float sum   = ph
    int   n     = 1
    int   first = pbH
    if array.size(phVal) > 0
        for i = 0 to array.size(phVal) - 1
            float v = array.get(phVal, i)
            int   b = array.get(phBar, i)
            // BUG-7 (preserved): ATR tolerance AND time separation AND a real
            // reaction between the legs. The pool sits at the MEAN of the legs,
            // never at the highest of them.
            if math.abs(ph - v) <= lqTol and pbH - b >= eqMinSep
                bool reactH = not eqNeedReact or (not na(array.get(phMin, i)) and math.min(ph, v) - array.get(phMin, i) >= lqReact)
                if reactH
                    sum   += v
                    n     += 1
                    first := math.min(first, b)
    if n >= 2
        f_qPush(sum / n, PK_EQ, true, n > 2 ? "EQH×" + str.tostring(n) : "EQH", first, true, n)
    array.push(phVal, ph)
    array.push(phBar, pbH)
    array.push(phMin, ta.lowest(low, pivLen))
    while array.size(phVal) > eqScanN
        array.shift(phVal)
        array.shift(phBar)
        array.shift(phMin)
    f_qPush(ph, PK_SWING, true, "SH", pbH, false, 1)
if confirmed and not na(pl)
    int   pbL   = bar_index - pivLen
    float sumL  = pl
    int   nL    = 1
    int   firstL = pbL
    if array.size(plVal) > 0
        for i = 0 to array.size(plVal) - 1
            float v = array.get(plVal, i)
            int   b = array.get(plBar, i)
            if math.abs(pl - v) <= lqTol and pbL - b >= eqMinSep
                bool reactL = not eqNeedReact or (not na(array.get(plMax, i)) and array.get(plMax, i) - math.max(pl, v) >= lqReact)
                if reactL
                    sumL   += v
                    nL     += 1
                    firstL := math.min(firstL, b)
    if nL >= 2
        f_qPush(sumL / nL, PK_EQ, false, nL > 2 ? "EQL×" + str.tostring(nL) : "EQL", firstL, true, nL)
    array.push(plVal, pl)
    array.push(plBar, pbL)
    array.push(plMax, ta.highest(high, pivLen))
    while array.size(plVal) > eqScanN
        array.shift(plVal)
        array.shift(plBar)
        array.shift(plMax)
    f_qPush(pl, PK_SWING, false, "SL", pbL, false, 1)

// external swings, session extremes and PDH / PDL are pre-VALIDATED pools —
// known resting liquidity, not candidates
if confirmed and not na(eph)
    f_qPush(eph, PK_EXT, true, "EXT-H", bar_index - extPiv, true, 1)
if confirmed and not na(epl)
    f_qPush(epl, PK_EXT, false, "EXT-L", bar_index - extPiv, true, 1)
if asiaFresh
    f_qPush(sesAsia.fhi, PK_SES, true,  "Asia H", bar_index, true, 1)
    f_qPush(sesAsia.flo, PK_SES, false, "Asia L", bar_index, true, 1)
if lonFresh
    f_qPush(sesLon.fhi, PK_SES, true,  "Lon H", bar_index, true, 1)
    f_qPush(sesLon.flo, PK_SES, false, "Lon L", bar_index, true, 1)
if nyFresh
    f_qPush(sesNY.fhi, PK_SES, true,  "NY H", bar_index, true, 1)
    f_qPush(sesNY.flo, PK_SES, false, "NY L", bar_index, true, 1)
if confirmed and newDay and timeframe.isintraday
    f_qPush(pdhRaw, PK_PD, true,  "PDH", bar_index, true, 1)
    f_qPush(pdlRaw, PK_PD, false, "PDL", bar_index, true, 1)

// ---- V5.6 · PWH / PWL ------------------------------------------------------
// Registered as ordinary PK_PW pools rather than hand-drawn. v5.6 first shipped
// a bespoke line + label + sweep tracker for these, which duplicated ~250
// compiled tokens of machinery the registry already owns. As pools they inherit
// all of it: raid vs break, penetration grading, the lifecycle, the ◇ mark and
// the MODULE 8B annotation — and they become real targets, which is what a
// previous-week extreme is.
if confirmed and newWeek and pwUsable and not na(pwhRaw) and not na(pwlRaw)
    f_qPush(pwhRaw, PK_PW, true,  "PWH", bar_index, true, 1)
    f_qPush(pwlRaw, PK_PW, false, "PWL", bar_index, true, 1)

// ═══ V7.0 · §7 / §25 · HTF SWING LIQUIDITY ════════════════════════════
// The single most relevant external liquidity an intraday chart has, and v6.4
// tracked none of it. hSwHi / hSwLo are CLOSED HTF pivots (see MODULE 6), so
// registering them here is not a look-ahead: the level existed, closed and was
// confirmed on the HTF before this chart bar opened. Once registered they are
// ordinary pools — same raid grading, same lifecycle, same marking, and they
// outrank everything else in f_kindPri because that is what they are.
if confirmed and newHtfBar and htfLiqReg
    f_qPush(hSwHi, PK_HTF, true,  "HTF-H " + htfTf, bar_index, true, 1)
    f_qPush(hSwLo, PK_HTF, false, "HTF-L " + htfTf, bar_index, true, 1)

// ═══ V7.0 · §22 · DYNAMIC TRENDLINE LIQUIDITY ════════════════════════
// The v5.4 trendline engine was removed in v5.5 (header R1) because it drew
// decoration and then let a BREAK of that decoration fire a trade. This one is
// built the other way round and can never emit anything by itself:
//   1 · anchors are two CONFIRMED external pivots of the same side, so the line
//       is only ever drawn behind price, never projected off an unconfirmed leg;
//   2 · the slope has to be the right way round — descending highs for a
//       resistance line, ascending lows for a support line. A line through two
//       random pivots is not a trendline;
//   3 · it must be TOUCHED tlMinTouch times. Untouched geometry holds no stops,
//       and stops are the only reason a trendline matters;
//   4 · only a SWEEP registers it — taken and closed back inside. At that moment
//       the projected price is frozen and pushed into the registry as a PK_TL
//       pool, which is what makes a moving line into a fixed liquidity event.
// From there it is indistinguishable from any other pool: it must still be
// raided by a setup that locked it, still needs a POI, an MSS, displacement and
// an FVG. "A trendline break alone must NOT generate a trade" is structural.
f_trendline() =>
    var float tlHp1 = na
    var float tlHp2 = na
    var int   tlHb1 = na
    var int   tlHb2 = na
    var int   tlHn  = 0
    var bool  tlHhit = false
    var float tlLp1 = na
    var float tlLp2 = na
    var int   tlLb1 = na
    var int   tlLb2 = na
    var int   tlLn  = 0
    var bool  tlLhit = false
    if showTL and confirmed
        if not na(eph)
            tlHp2 := tlHp1
            tlHb2 := tlHb1
            tlHp1 := eph
            tlHb1 := bar_index - extPiv
            tlHn  := 0
            tlHhit := false
        if not na(epl)
            tlLp2 := tlLp1
            tlLb2 := tlLb1
            tlLp1 := epl
            tlLb1 := bar_index - extPiv
            tlLn  := 0
            tlLhit := false
    tlHy = showTL and not na(tlHp2) and not na(tlHp1) and tlHb1 > tlHb2 and tlHp1 < tlHp2 ? tlHp1 + (tlHp1 - tlHp2) / (tlHb1 - tlHb2) * (bar_index - tlHb1) : na
    tlLy = showTL and not na(tlLp2) and not na(tlLp1) and tlLb1 > tlLb2 and tlLp1 > tlLp2 ? tlLp1 + (tlLp1 - tlLp2) / (tlLb1 - tlLb2) * (bar_index - tlLb1) : na
    if confirmed and not na(tlHy) and not tlHhit
        if high >= tlHy - NEAR_LVL_ATR * atr and high <= tlHy + NEAR_LVL_ATR * atr and close < tlHy
            tlHn += 1
        else if high > tlHy and close < tlHy and tlHn >= tlMinTouch
            tlHhit := true
            f_qPush(tlHy, PK_TL, true, "TL-H ×" + str.tostring(tlHn), bar_index, true, 1)
    if confirmed and not na(tlLy) and not tlLhit
        if low <= tlLy + NEAR_LVL_ATR * atr and low >= tlLy - NEAR_LVL_ATR * atr and close > tlLy
            tlLn += 1
        else if low < tlLy and close > tlLy and tlLn >= tlMinTouch
            tlLhit := true
            f_qPush(tlLy, PK_TL, false, "TL-L ×" + str.tostring(tlLn), bar_index, true, 1)
    0
tlN = f_trendline()

// V5.3-C5 · registration runs first so the scan SEES this bar's new levels.
// That ordering does not itself prevent same-bar raids — pivot construction
// does: a SWING/EQ pool confirms only after pivLen lower/higher bars, so the
// confirming bar cannot be beyond it. A same-bar raid of a freshly frozen
// session or PDH/PDL level is a REAL event and is allowed to register.
poolFlush = f_qFlush()
poolRaids = f_poolScan()

// ---- one pass for LIQUIDITY INTENT (Phase 6) + this bar's pool events -------
float  tgtBuy     = na     // best live buy-side pool ABOVE price  → bearish intent
float  tgtSell    = na     // best live sell-side pool BELOW price → bullish intent
// V7.0 · §7 · the RANK of the pool currently holding each slot. v6.4 compared
// prices ("is this one nearer?"), which is why a three-bar-old minor swing
// outranked a previous-week high standing four ATR away. The comparison is now
// LEVEL QUALITY minus a distance penalty, and a pool further than tgtMaxAtr is
// not a draw on price at all, however good it looks.
float  tgtBuyW    = -1e18
float  tgtSellW   = -1e18
// V7.0 · §38 · INDUCEMENT. The most recent raid of an INTERNAL (minor swing)
// pool on each side, harvested from the loop that already walks the registry.
// A setup whose external raid was preceded by one of these took the liquidity
// that was engineered to pay for it.
int    indLoBar   = -1
int    indHiBar   = -1
int    indLoId    = 0
int    indHiId    = 0
string tgtBuyTag  = ""
string tgtSellTag = ""
Pool   tgtBuyPool  = na    // V5-3: the machine locks the OBJECT, not the price
Pool   tgtSellPool = na
bool   sesHiBroke = false
bool   sesLoBroke = false
bool   poolBrkUp  = false
bool   poolBrkDn  = false
// V5.5-E4 · what the liquidity-run engine needs, harvested from the loop that
// already walks the registry — no second scan
int    brkUpKind  = -1
int    brkDnKind  = -1
float  brkUpPx    = na
float  brkDnPx    = na
if array.size(pools) > 0
    for i = 0 to array.size(pools) - 1
        Pool p = array.get(pools, i)
        // §38 · inducement bookkeeping
        if (p.state == PS_RAID or p.state == PS_REACT) and p.kind == PK_SWING and not na(p.raidBar)
            if p.buySide and p.raidBar > indHiBar
                indHiBar := p.raidBar
                indHiId  := p.id
            if not p.buySide and p.raidBar > indLoBar
                indLoBar := p.raidBar
                indLoId  := p.id
        if p.state <= PS_VAL and not p.spent and p.touches >= poolMinTouch
            float dAtr = math.abs(p.px - close) / math.max(atr, syminfo.mintick)
            if dAtr <= tgtMaxAtr
                float w = f_kindPri(p.kind) * 10.0 + f_maskN(p.kmask) * 5.0 +
                     math.min(p.touches, 4) * 4.0 + p.legs * 2.0 - dAtr * tgtDistW
                if p.buySide and p.px > close and w > tgtBuyW
                    tgtBuyW    := w
                    tgtBuy     := p.px
                    tgtBuyTag  := p.tag
                    tgtBuyPool := p
                if not p.buySide and p.px < close and w > tgtSellW
                    tgtSellW    := w
                    tgtSell     := p.px
                    tgtSellTag  := p.tag
                    tgtSellPool := p
        if p.brkBar == bar_index
            if p.buySide
                poolBrkUp  := true
                brkUpKind  := p.kind
                brkUpPx    := p.px
                sesHiBroke := sesHiBroke or p.kind == PK_SES
            else
                poolBrkDn  := true
                brkDnKind  := p.kind
                brkDnPx    := p.px
                sesLoBroke := sesLoBroke or p.kind == PK_SES

// ---- bindable raid lookup (the setup machine's liquidity stage) --------------
// dir 1 (long) wants a SELL-side pool that has been raided; dir -1 wants a
// buy-side one. Freshest qualifying raid wins; already-bound raids are skipped.
// Returns the POOL OBJECT, never an array index: f_poolScan can remove pools,
// which would silently re-point a stored index at a different pool.
// V7.2 BUG-07 · the trap engine's first ingredient claims "the broken level was
//   TRACKED liquidity". v7.1 only asked whether SOME pool of that side closed
//   through on the arming bar and never compared it with the level that armed the
//   trap. These two say it properly, at registry tolerance.
tPoolU = poolBrkUp and math.abs(brkUpPx - brkUpLvl) <= lqTol
tPoolD = poolBrkDn and math.abs(brkDnPx - brkDnLvl) <= lqTol

f_findRaid(int dir, bool freeOnly, int minBar) =>
    Pool   bp   = na
    float  bpx  = na
    int    bbar = na
    float  bext = na
    bool   bstr = false
    int    bknd = 0
    string btag = ""
    int    bid  = 0
    int    brq  = 0
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            bool sideOk = dir == 1 ? not p.buySide : p.buySide
            bool newer  = p.raidBar > nz(minBar, -1)
            if sideOk and (p.state == PS_RAID or p.state == PS_REACT) and (p.bound == 0 or not freeOnly) and not p.spent and newer and f_recent(p.raidBar, sweepLook)
                if na(bp) or p.raidBar > bbar
                    bp   := p
                    bpx  := p.px
                    bbar := p.raidBar
                    bext := p.raidExt
                    bstr := p.raidStrong
                    bknd := p.kind
                    btag := p.tag
                    bid  := p.id
                    brq  := p.rq
    [bp, bpx, bbar, bext, bstr, bknd, btag, bid, brq]

// ANY live raid (bound or free). Zone grading, the confluence producers, the
// dashboard and the debug panel read these. The state machine does NOT: it binds
// to the POOL OBJECT it locked as its target at state 2, so "the freshest raid
// anywhere on this side" can never satisfy a setup any more (V4-BUG-3).
[anyLoPool, anyLoPx, anyLoBar, anyLoExt, anyLoStrong, anyLoKind, anyLoTag, anyLoId, anyLoRq] = f_findRaid(1, false, -1)
[anyHiPool, anyHiPx, anyHiBar, anyHiExt, anyHiStrong, anyHiKind, anyHiTag, anyHiId, anyHiRq] = f_findRaid(-1, false, -1)

// convenience flags used by the score, the S/D producer and the dashboard
sslInPlay = not na(anyLoPool)
bslInPlay = not na(anyHiPool)
sslStrong = sslInPlay and anyLoStrong
bslStrong = bslInPlay and anyHiStrong

// ---- the ◆ / ◈ sweep marks v2 drew: kept, now sourced from the registry -----
sslSweep  = confirmed and not na(lastSup) and low < lastSup and close > lastSup
bslSweep  = confirmed and not na(lastRes) and high > lastRes and close < lastRes
eqlSwept  = confirmed and sslInPlay and anyLoBar == bar_index and anyLoKind == PK_EQ
eqhSwept  = confirmed and bslInPlay and anyHiBar == bar_index and anyHiKind == PK_EQ
sesLoRaid = confirmed and sslInPlay and anyLoBar == bar_index and anyLoKind == PK_SES
// V5.6 · the raid marks v5.5 never had: EXTERNAL liquidity (previous day /
// previous week / external swing) taken THIS bar. Registry-sourced, so a mark
// only prints where a real pool moved to PS_RAID; plus the drawn-only PWH/PWL
// sweep — PWH/PWL are ordinary PK_PW pools, so they arrive through the same
// path as everything else.
extHiRaidNow = confirmed and bslInPlay and anyHiBar == bar_index and (anyHiKind == PK_PD or anyHiKind == PK_PW or anyHiKind == PK_EXT)
extLoRaidNow = confirmed and sslInPlay and anyLoBar == bar_index and (anyLoKind == PK_PD or anyLoKind == PK_PW or anyLoKind == PK_EXT)
lqExtHiMark  = lqRaidChar and extHiRaidNow
lqExtLoMark  = lqRaidChar and extLoRaidNow
sesHiRaid = confirmed and bslInPlay and anyHiBar == bar_index and anyHiKind == PK_SES

// ════════════════════════ MODULE 8 · DEALING RANGE · PREMIUM / DISCOUNT · OTE
// External swings by default (the real impulse leg); internal is the fallback
// until an external pair exists. OTE only projects against a FRESH leg.
// ═════════════════════════════════════════════════════════════════════════════
useExtRng = rangeSrc == "External" and not na(extRes) and not na(extSup)
rngHi     = useExtRng ? extRes    : lastRes
rngLo     = useExtRng ? extSup    : lastSup
rngHiBar  = useExtRng ? extResBar : lastResBar
rngLoBar  = useExtRng ? extSupBar : lastSupBar
rangeOK   = not na(rngHi) and not na(rngLo) and rngHi > rngLo
bullRange = rangeOK and not na(rngHiBar) and not na(rngLoBar) and rngHiBar > rngLoBar
bearRange = rangeOK and not na(rngHiBar) and not na(rngLoBar) and rngLoBar > rngHiBar
rngW    = rangeOK ? rngHi - rngLo : na
eqLvl   = rangeOK ? rngLo + rngW / 2 : na
pdPos   = rangeOK ? (close - rngLo) / rngW : na
oteBuyTop  = rangeOK ? rngHi - OTE_1 * rngW : na
oteBuyBot  = rangeOK ? rngHi - OTE_2 * rngW : na
oteSellBot = rangeOK ? rngLo + OTE_1 * rngW : na
oteSellTop = rangeOK ? rngLo + OTE_2 * rngW : na
inOTEbuy   = bullRange and close <= oteBuyTop  and close >= oteBuyBot
inOTEsell  = bearRange and close >= oteSellBot and close <= oteSellTop
// premium / discount EXTREMES — the only place a counter-trend fade belongs
inDiscExt  = rangeOK and pdPos <= PD_EXTREME
inPremExt  = rangeOK and pdPos >= 1 - PD_EXTREME
discOK     = not rangeOK or pdPos <= 0.5
premOK     = not rangeOK or pdPos >= 0.5

// ══════════════════ MODULE 8B · LIQUIDITY MARKING LAYER (V5.6, DISPLAY-ONLY)
// This module READS the pool registry and writes nothing that any other module
// consumes. It exists because v5.5 TRACKED liquidity beautifully and MARKED it
// almost not at all: a pool was an anonymous grey line with no side, no name,
// no strength, no internal / external classification, no cluster and no
// lifecycle text. Everything below is annotation.
//
// WHY IT SITS HERE AND NOT IN MODULE 7. Internal vs external (§8) is a question
// about the CURRENT DEALING RANGE, and the dealing range is MODULE 8. Pine is
// single-pass and forbids forward references, so the classification cannot live
// with the registry — it has to live after the range that defines it.
//
// COST (§19). The scoring pass is O(n) on confirmed bars, n ≤ poolMaxN ≤ 60.
// Clustering and rendering run ONLY on barstate.islast, so the sort and the
// label / box churn happen once per tick on one bar and never on history.
// Objects live in two arrays that are fully deleted and rebuilt on every
// render: a bounded budget, and no leak is possible.
// ═════════════════════════════════════════════════════════════════════════════

// §8 · EXTERNAL = liquidity at or beyond the extreme of the LIVE dealing range;
// INTERNAL = liquidity inside it. This is a question about POSITION, not about
// which pivot engine produced the level — v5.5's PK_EXT only ever meant "an
// extPiv pivot made this", which is a different statement and is wrong as often
// as it is right once price has traded away from that pivot. PDH/PDL and
// PWH/PWL are external by definition: they are draws on the daily and weekly
// range, not features of the intraday one.
LQ_EXT_PAD = 0.15    // an ATR of slack around the range extreme
f_lqIsExt(Pool p) =>
    bool byKind = p.kind == PK_PD or p.kind == PK_PW or p.kind == PK_HTF
    bool byPos  = not rangeOK ? (p.kind == PK_EXT or p.kind == PK_SES) :
         p.buySide ? p.px >= rngHi - LQ_EXT_PAD * atr : p.px <= rngLo + LQ_EXT_PAD * atr
    byKind or byPos

// §5 · STRENGTH. An ordinal classification of how CROWDED a level is, built
// only from things that were actually observed: what type of level it is, how
// many different types resolved to the same price (the confluence mask), how
// many pivot legs were fused into it, how many times price has already
// respected it, whether it is external, and how long it has stood. It is not a
// probability, and it is never read by the score, the grade or any gate.
f_lqScore(Pool p) =>
    int s = 0
    s += f_kindPri(p.kind) * 2                                 // 2 … 12
    s += math.min(math.max(f_maskN(p.kmask) - 1, 0), 2) * 3    // confluence ≤ 6
    s += math.min(math.max(p.legs - 2, 0), 3) * 2              // triple top ≤ 6
    s += math.min(p.touches, 4) * 2                            // respect   ≤ 8
    // NOTE: the stacking bonus is NOT here. Cluster size is only known after
    // the grouping pass below, which adds it in place.
    s += p.isExt ? 4 : 0
    s += not na(p.bornBar) and bar_index - p.bornBar >= 100 ? 2 : 0
    s

f_lqClass(int s) =>
    s >= 22 ? LS_EXT : s >= 15 ? LS_STR : s >= 9 ? LS_MOD : LS_WEAK

// §18 · LIFECYCLE, rendered as text. The registry already owns these states;
// this only names them, and it is what makes it impossible for a swept level to
// keep being shown as if it were still resting (§9).
f_lqState(Pool p) =>
    p.state == PS_REACT ? "SWEPT✓REV" :
         p.state == PS_RAID ? "SWEPT" :
         p.state == PS_DONE ? (na(p.brkBar) ? "OLD" : "BROKEN") :
         p.state == PS_NEW ? "NEW" :
         (p.buySide ? high >= p.px - NEAR_LVL_ATR * atr : low <= p.px + NEAR_LVL_ATR * atr) ? "NEAR" :
         "REST"

// v5.6 first scored every pool on every confirmed bar. Nothing reads a score
// except the render, the render only happens on the last bar, and the pass cost
// an inlined copy of f_lqIsExt + f_lqScore + f_lqClass. It is gone; clustering
// now seeds the scores it needs itself.
//
// ---- pass 1 · CLUSTERING (§6 / §7), last bar only ---------------------------
// The registry already fuses levels closer together than lqTol into ONE
// pool, so a cluster is what lives in the band BETWEEN that tolerance and
// lqCluTol: four distinct highs at 100.20 / .21 / .22 / .23 are four pools and
// one stop pool. The strongest member speaks for the group and the rest are
// silenced, so the chart shows one honest "BSL CLUSTER ×4" instead of four
// competing lines (§21).
// ONE call, both sides: the body is inlined at every call site, so the buy /
// sell split is an inner loop rather than two invocations.
f_lqCluster() =>
    for sd = 0 to 1
        bool bs  = sd == 0
        idx = array.new<int>()
        pxs = array.new<float>()
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if p.buySide == bs
                p.cluRep := true
                p.cluN   := 1
                p.isExt  := f_lqIsExt(p)
                p.lscore := f_lqScore(p)
                p.lstr   := f_lqClass(p.lscore)
                if p.state <= PS_VAL
                    array.push(idx, i)
                    array.push(pxs, p.px)
        if array.size(idx) > 1
            ord = array.sort_indices(pxs, order.ascending)
            int g0 = 0
            while g0 < array.size(ord)
                int g1 = g0
                // grow the group while the NEXT level up is inside the radius
                while g1 + 1 < array.size(ord) and array.get(pxs, array.get(ord, g1 + 1)) - array.get(pxs, array.get(ord, g1)) <= lqCluTol * atr
                    g1 += 1
                int   n    = g1 - g0 + 1
                int   best = -1
                float bw   = -1e18
                // representative = highest score; ties go to the FAR edge of
                // the pool — the price a raid has to reach to clear it
                for k = g0 to g1
                    Pool q = array.get(pools, array.get(idx, array.get(ord, k)))
                    float w = q.lscore * 100.0 + (bs ? q.px : -q.px) * 1e-6
                    if w > bw
                        bw   := w
                        best := array.get(idx, array.get(ord, k))
                for k = g0 to g1
                    Pool r = array.get(pools, array.get(idx, array.get(ord, k)))
                    r.cluN   := n >= lqCluMin ? n : 1
                    r.cluLo  := array.get(pxs, array.get(ord, g0))
                    r.cluHi  := array.get(pxs, array.get(ord, g1))
                    r.cluRep := array.get(idx, array.get(ord, k)) == best
                    // §6 · stacked stops are the whole point: the pool is
                    // stronger than any single level inside it
                    if r.cluN > 1
                        r.lscore += math.min(r.cluN - 1, 3) * 2
                        r.lstr   := f_lqClass(r.lscore)
                g0 := g1 + 1
    0

// ---- pass 3 · RENDER, last bar only -----------------------------------------
var lqLbs = array.new<label>()
var lqBxs = array.new<box>()

f_lqClear() =>
    while array.size(lqLbs) > 0
        label.delete(array.pop(lqLbs))
    while array.size(lqBxs) > 0
        box.delete(array.pop(lqBxs))
    0

f_lqSideCol(bool bs, int st) =>
    st >= PS_RAID ? color.new(COL_NEU, 45) : bs ? color.new(COL_BEAR, 35) : color.new(COL_BULL, 35)

if barstate.islast
    lqWiped = f_lqClear()
    if lqMark and array.size(pools) > 0
        lqGrouped = f_lqCluster()
        // ---- eligibility: §13 priority + §21 anti-clutter -------------------
        cand = array.new<int>()
        rank = array.new<float>()
        for i = 0 to array.size(pools) - 1
            Pool pe = array.get(pools, i)
            bool swept = pe.state >= PS_RAID
            bool live  = pe.state <= PS_VAL
            bool ok = pe.cluRep and (pe.buySide ? lqShowBSL : lqShowSSL) and (pe.isExt ? lqShowExt : lqShowInt) and pe.lstr >= f_lsMin() and (live or (lqShowSwept and swept and f_recent(nz(pe.raidBar, pe.brkBar), lqSweptBars)))
            if ok
                array.push(cand, i)
                // resting liquidity outranks history, then strength, then how
                // close price is to it — the levels in play win the label budget
                array.push(rank, (live ? 1e6 : 0.0) + pe.lscore * 1000.0 - math.abs(pe.px - close) / math.max(atr, syminfo.mintick))
        if array.size(cand) > 0
            ord2 = array.sort_indices(rank, order.descending)
            int shown = 0
            int bxN   = 0
            for k = 0 to array.size(ord2) - 1
                if shown >= lqMaxLbl
                    break
                Pool p = array.get(pools, array.get(cand, array.get(ord2, k)))
                bool   clu  = lqShowClu and p.cluN >= lqCluMin
                string side = p.buySide ? "BSL" : "SSL"
                // the whole record on one line: side · pool size · level name ·
                // strength · location · confluence · lifecycle state
                string txt = side + (clu ? " POOL ×" + str.tostring(p.cluN) : "") + " " + p.tag + " " + f_lsStars(p.lstr) + " " + (p.isExt ? "EXT" : "INT") + " " + f_lqState(p)
                // the tooltip carries the full forensic record, so the on-chart
                // text can stay short (§21) without anything being hidden
                string tip = (p.buySide ? "BUY-SIDE LIQUIDITY (BSL)" : "SELL-SIDE LIQUIDITY (SSL)") +
                     "\nLevel      " + str.tostring(p.px, format.mintick) +
                     "\nType       " + f_kindTxt(p.kind) + " (" + p.tag + ")" +
                     (p.legs > 1 ? " · " + str.tostring(p.legs) + " equal legs" : "") +
                     "\nStrength   " + f_lsTxt(p.lstr) + " (score " + str.tostring(p.lscore) + ")" +
                     "\nLocation   " + (p.isExt ? "EXTERNAL — at / beyond the dealing range" : "INTERNAL — inside the dealing range") +
                     "\nPool       " + (p.cluN > 1 ? str.tostring(p.cluN) + " stacked levels " + str.tostring(p.cluLo, format.mintick) + " → " + str.tostring(p.cluHi, format.mintick) : "single level") +
                     "\nConfluence " + str.tostring(f_maskN(p.kmask)) + " level type(s) resolve here" +
                     "\nTouches    " + str.tostring(p.touches) +
                     "\nState      " + f_lqState(p) +
                     (p.state >= PS_RAID ? " · raid grade " + f_rqTxt(p.rq) + (p.desc != "" ? " · " + p.desc : "") : "") +
                     "\nAge        " + str.tostring(bar_index - nz(p.bornBar, bar_index)) + " bars · pool #" + str.tostring(p.id)
                array.push(lqLbs, label.new(bar_index + 2 * TRADE_BARS, p.px, txt,
                     style = label.style_label_left, color = f_lqSideCol(p.buySide, p.state),
                     textcolor = color.new(color.white, mkTrans), size = infoSize, tooltip = tip))
                // the line itself carries the strength as width, so the
                // chart reads before the text does
                line.set_width(p.ln, p.lstr >= LS_EXT ? 3 : p.lstr >= LS_STR ? 2 : 1)
                // §7 · the POOL, not the level: a translucent band across the
                // whole stack of stops, one box per cluster
                if clu and bxN < 6 and not na(p.cluHi) and not na(p.cluLo) and p.cluHi > p.cluLo
                    array.push(lqBxs, box.new(bar_index - 5, p.cluHi, bar_index + TRADE_BARS, p.cluLo,
                         border_color = color.new(p.buySide ? COL_BEAR : COL_BULL, 55), border_width = 1,
                         bgcolor = color.new(p.buySide ? COL_BEAR : COL_BULL, 90)))
                    bxN += 1
                shown += 1

// ---- §9 · retire the session H / L lines once their pool is taken -----------
// v5.5's f_sesTrack draws the Asia / London / NY extremes with extend.right and
// never touches them again, so a session high swept two hours ago still renders
// as live resting liquidity — the one place the indicator contradicted its own
// registry. The line is matched to its pool by side and price and inherits that
// pool's state. f_sesTrack itself is untouched; it re-creates these lines at
// each session close, which is what resets the state.
var sesAll = array.from(sesAsia, sesLon, sesNY)
if lqSesState and showSesHL and confirmed and array.size(pools) > 0
    for i = 0 to array.size(pools) - 1
        Pool p = array.get(pools, i)
        if p.kind == PK_SES and p.state >= PS_RAID
            for j = 0 to 2
                Ses  s    = array.get(sesAll, j)
                bool isHi = p.buySide and not na(s.fhi) and math.abs(p.px - s.fhi) <= syminfo.mintick
                bool isLo = not p.buySide and not na(s.flo) and math.abs(p.px - s.flo) <= syminfo.mintick
                if isHi or isLo
                    line  ln  = isHi ? s.hiLn : s.loLn
                    label lb  = isHi ? s.hiLb : s.loLb
                    bool  brk = p.state == PS_DONE and not na(p.brkBar)
                    if not na(ln)
                        line.set_extend(ln, extend.none)
                        line.set_x2(ln, bar_index)
                        line.set_style(ln, brk ? line.style_dotted : line.style_dashed)
                        line.set_color(ln, color.new(COL_NEU, 55))
                    if not na(lb) and not str.contains(label.get_text(lb), "✓") and not str.contains(label.get_text(lb), "BROKEN")
                        label.set_text(lb, label.get_text(lb) + (brk ? " ⇡ BROKEN" : " ✓ SWEPT"))

// ═══════════════ MODULE 9 · SUPPLY / DEMAND + FVG (LIFECYCLE + TIERS)
// ARCH-4 / Phase 9 / Phase 10. Every POI carries a lifecycle state and a
// quality tier. TIER 3 is VISUAL INFORMATION ONLY — it can never produce a
// trade above the "Minimum POI tier" setting. A 50 % tap is SETUP
// PREPARATION, never an entry. The whole update loop is confirmed-gated
// (BUG-4) and nothing here consumes a zone — only the TRADE ENGINE can
// (BUG-5).
// ═════════════════════════════════════════════════════════════════════════════
type Zone
    box    bx
    line   mid
    bool   isSupply
    float  top         = na    // V5.4-D1: geometry cache — the box's coords never
    float  bot         = na    //          change after creation, so hot loops read these
    int    state       = 0     // 0 fresh · 1 touched · 2 fifty · 3 filled · 4 dead
    int    tier        = 3
    int    bornBar     = na
    int    touchBar    = -1
    int    tap50Bar    = -1
    bool   signaled    = false
    bool   flipped     = false
    bool   isFvg       = true
    float  deepest     = na    // deepest penetration reached (fill tracking)
    bool   liqBeforeFail = false
    int    id          = 0     // V5: stable identity, so a POI can be deduped
    int    tier0       = 3     // tier awarded at CREATION — the re-grade starts here
    string kindTxt     = ""
    // ── V7.0 · §19 · PROVENANCE. A zone must know which physical events made it.
    //    v6.4 graded a zone T1 from GLOBAL flags — "some raid is in play on this
    //    side" and "some MSS happened in the last ten bars" — which are exactly
    //    the unrelated-event confluences §2 forbids. These four fields record the
    //    events that were actually AT this zone, and f_gradeZone now checks them.
    int    pa          = 0     // PD-array class (PA_FVG / PA_OB / PA_BRK / …)
    int    srcPoolId   = 0     // the liquidity pool whose raid produced it
    int    srcRaidBar  = na
    int    srcMssBar   = na
    int    srcDispBar  = na

var zones = array.new<Zone>()
var zoneSeq = array.new<int>(1, 0)

f_tierTxt(int t) => t == 1 ? "T1" : t == 2 ? "T2" : "T3"

// na-safe zone accessors, same reason as the pool ones in MODULE 7
f_zoneId(Zone z) =>
    int zid = 0
    if not na(z)
        zid := z.id
    zid

f_zoneDead(Zone z) =>
    bool dead = false
    if not na(z)
        dead := z.signaled or z.tier > minTier
    dead

// V5.3-C1: na-safe read of a zone's LIVE (re-graded) tier. The machine
// refreshes its setup's poiTier from this every confirmed bar, so the grade,
// the hTier gate and the debug panel judge the tier the POI HAS, not the tier
// it had when it was tapped. na → 3 (worst), never a promotion.
f_zoneTier(Zone z) =>
    int zt = 3
    if not na(z)
        zt := z.tier
    zt

// V5.5-E2 · na-safe LIVE freshness of a zone. v5.4's S/D producer scored
// freshness from nbFresh / nsFresh — the NEXT buy / sell POI from MODULE 9's
// scan, which is not necessarily the zone being traded. Surviving V4-BUG-5 leak.
f_zoneFresh(Zone z) =>
    bool fr = false
    if not na(z)
        fr := z.state <= 1
    fr


// ═══ V7.0 · §19 · TIER GRADING IS CAUSAL NOW ═════════════════════════
// WHAT WAS WRONG. v6.4 read `bslInPlay` ("a buy-side raid exists somewhere on
// the chart") and `recentMssDn` ("a bearish shift happened within ten bars").
// Neither had to be anywhere near the zone being graded, and neither had to be
// in the right ORDER, so a supply zone printed T1 off a raid four hundred
// points away and a shift that pre-dated it. That is the exact failure §2
// names: confluence standing in for causality. T1 is the tier the whole grade
// ladder and the minTier gate are built on, so this one substitution was
// mis-pricing every downstream decision.
//
// WHAT IT DOES NOW. The raid has to sit AT the zone (inside poiBindAtr, the
// same binding tolerance the setup machine uses) and still be live, and the
// shift has to come AFTER that raid. The zone records both, plus the
// displacement bar, so the provenance can be audited afterwards in the debug
// panel rather than asserted here.
f_gradeZone(bool isSupply, float zTop, float zBot) =>
    Pool  rp   = isSupply ? anyHiPool : anyLoPool
    float rpx  = isSupply ? anyHiExt  : anyLoExt
    int   rbar = isSupply ? anyHiBar  : anyLoBar
    int   mbar = isSupply ? math.max(nz(iChDnBar, -1), nz(cisdDnBar, -1))
         : math.max(nz(iChUpBar, -1), nz(cisdUpBar, -1))
    bool  liq  = not na(rbar) and not na(rpx) and f_recent(rbar, sweepLook) and
         rpx <= zTop + poiBindAtr * atr and rpx >= zBot - poiBindAtr * atr
    bool  mss  = liq and mbar > nz(rbar, 99999999) and f_recent(mbar, TRIG_LOOK)
    bool  htfA = isSupply ? (htfDir <= 0) : (htfDir >= 0)
    bool  strc = isSupply ? structDir <= 0 : structDir >= 0
    bool  disp = isSupply ? dispDnBar[1] or dispDnBar[2] : dispUpBar[1] or dispUpBar[2]
    int t = 3
    // V7.2 BUG-03 · the global chart-range OTE is gone from this rung. It was a
    //   dead disjunct (the OTE band is a subset of the half premOK/discOK already
    //   demands) and it imported the chart's dealing range into a zone's grade.
    if liq and disp and mss and htfA and (isSupply ? premOK : discOK)
        t := 1
    else if disp and strc
        t := 2
    [t, liq, na(rp) ? 0 : rp.id, nz(rbar, -1), mss ? mbar : -1]

// V4-BUG-11 / V5-6 · POI QUALITY IS DYNAMIC.
// v4 graded a zone once, inside f_newZone, and that tier was then trusted
// forever — a T1 demand zone stayed T1 after the HTF flipped bearish, after
// external structure broke down and after 90 % of it had been eaten. The live
// tier is now recomputed from the CREATION tier every confirmed bar:
//   · 50 % mitigated  → never better than T2   (the discount is half gone)
//   · fully filled    → T3, visual only        (the imbalance no longer exists)
//   · HTF now opposes → one tier worse
//   · structure now opposes → one tier worse
// The tier can only ever get WORSE than the one the zone was born with, which is
// what stops a stale POI from being re-promoted by a transient alignment.
f_regrade(Zone z) =>
    int t = z.tier0
    if z.state >= 2
        t := t < 2 ? 2 : t
    if z.state >= 3
        t := 3
    if not (z.isSupply ? htfDir <= 0 : htfDir >= 0)
        t := t >= 3 ? 3 : t + 1
    if not (z.isSupply ? structDir <= 0 : structDir >= 0)
        t := t >= 3 ? 3 : t + 1
    if t != z.tier
        z.tier := t
        if showZones and showTier
            box.set_text(z.bx, (z.kindTxt != "" ? z.kindTxt : z.isSupply ? "SUPPLY" : "DEMAND") + " " + f_tierTxt(t))
    t

// The box IS the zone's data container, so a zone is ALWAYS created and
// `showZones` only controls whether it is visible (BUG-6 / Phase 28).
f_newZone(bool isSupply, float top, float bot, int tier, string kind, int lft, bool isFvg) =>
    c   = isSupply ? COL_BEAR : COL_BULL
    txt = showZones ? (kind != "" ? kind : (isSupply ? "SUPPLY" : "DEMAND")) + (showTier ? " " + f_tierTxt(tier) : "") : ""
    x1  = lft != 0 ? lft : bar_index - 2
    bx  = box.new(x1, top, bar_index + 1, bot,
         border_color = showZones ? color.new(c, tier == 1 ? 35 : 55) : color.new(c, 100),
         bgcolor = showZones ? color.new(c, tier == 1 ? 90 : 93) : color.new(c, 100),
         text = txt, text_color = color.new(c, showZones ? 0 : 100), text_size = size.small,
         text_halign = text.align_right,
         text_valign = isSupply ? text.align_top : text.align_bottom)
    md  = line.new(x1, (top + bot) / 2, bar_index + 1, (top + bot) / 2,
         color = color.new(c, showZones ? 72 : 100), style = line.style_dotted)
    array.set(zoneSeq, 0, array.get(zoneSeq, 0) + 1)
    Zone.new(bx = bx, mid = md, isSupply = isSupply, tier = tier, tier0 = tier,
         id = array.get(zoneSeq, 0), bornBar = bar_index, isFvg = isFvg, kindTxt = kind,
         top = top, bot = bot)

// V6.5-O6 · THE FLIP, WRITTEN ONCE. The supply→demand and demand→supply
// violation blocks were mirror images: same fourteen field writes, same six
// drawing calls, differing only in the target side, the colour, the ▲/▼ arrow
// and the caption alignment. `toSup` carries all four. Identical output.
f_zoneFlip(Zone z, bool toSup, bool isBrk) =>
    color fc = toSup ? COL_BEAR : COL_BULL
    z.isSupply := toSup
    z.flipped  := true
    z.state    := 0
    z.touchBar := -1
    z.tap50Bar := -1
    z.deepest  := na
    z.signaled := false
    z.liqBeforeFail := false
    z.tier     := isBrk ? 2 : 3
    z.tier0    := isBrk ? 2 : 3
    // §13 / §15 / §16 · v6.4 called every violated zone a BREAKER or a
    // MITIGATION block. An FVG that is closed through and then holds from the
    // other side is neither: it is an INVERSION of that gap, and ICT treats an
    // IFVG as an execution array in its own right. The three are separated by
    // WHAT FAILED, not by how the failure looked.
    z.pa       := z.isFvg ? PA_IFVG : isBrk ? PA_BRK : PA_MIT
    z.kindTxt  := (z.isFvg ? "IFVG " : isBrk ? "BREAKER " : "MITIGATION ") + (toSup ? "▼" : "▲")
    box.set_border_color(z.bx, color.new(fc, 55))
    box.set_bgcolor(z.bx, color.new(fc, 93))
    box.set_text(z.bx, z.kindTxt + (showTier ? " " + f_tierTxt(z.tier) : ""))
    box.set_text_color(z.bx, color.new(fc, 0))
    box.set_text_valign(z.bx, toSup ? text.align_top : text.align_bottom)
    line.set_color(z.mid, color.new(fc, 72))
    true

// ---- cap zones per side: prune the OLDEST, fully (BUG-22) ------------------
// Runs FIRST, on the set the previous bar left behind. Pruning after the update
// loop could delete a box that the loop had just handed to the trade engine as
// a candidate, and the engine would then be styling a deleted drawing.
if confirmed
    for side = 0 to 1
        bool sup = side == 1
        int  cnt = 0
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                Zone z = array.get(zones, i)
                if z.isSupply == sup
                    cnt += 1
        while cnt > maxZones
            int oldIx  = -1
            int oldBar = na
            for i = 0 to array.size(zones) - 1
                Zone z = array.get(zones, i)
                if z.isSupply == sup and (oldIx == -1 or nz(z.bornBar, 0) < oldBar)
                    oldIx  := i
                    oldBar := nz(z.bornBar, 0)
            if oldIx == -1
                break
            Zone o = array.get(zones, oldIx)
            box.delete(o.bx)
            line.delete(o.mid)
            array.remove(zones, oldIx)
            cnt -= 1

// ---- POI candidates produced by the 50 % engine (NOT signals) ---------------
sdCandLong  = false
sdCandShort = false
// zone REFERENCES, not indices: the loop below and the age-prune both remove
// zones, which would re-point a stored index at a different zone
Zone  sdZoneL   = na
Zone  sdZoneS   = na
float sdTopLong = na
float sdBotLong = na
int   sdTierL   = 3
float sdTopShort = na
float sdBotShort = na
int   sdTierS    = 3
// a raid level sitting AT a zone this bar (used for the breaker causal chain)
raidNearBar = confirmed and ((sslInPlay and anyLoBar == bar_index) or (bslInPlay and anyHiBar == bar_index))
raidNearPx  = sslInPlay and anyLoBar == bar_index ? anyLoPx : anyHiPx

if confirmed and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        float top  = z.top          // V5.4-D1: cached geometry, not a box API read
        float bot  = z.bot
        float midP = (top + bot) / 2
        float hgt  = math.max(top - bot, syminfo.mintick)
        // a liquidity event AT this zone, recorded on the zone itself — this
        // is what makes the BREAKER classification causal (Phase 12)
        if raidNearBar and not na(raidNearPx) and raidNearPx <= top + poiBindAtr * atr and raidNearPx >= bot - poiBindAtr * atr
            z.liqBeforeFail := true
        if z.isSupply
            if high >= bot
                if z.state == 0
                    z.touchBar := bar_index
                if z.state < 1
                    z.state := 1
                z.deepest := math.max(nz(z.deepest, bot), high)
            fillS = (nz(z.deepest, bot) - bot) / hgt
            if fillS >= 1 and z.state < 3
                z.state := 3
                if showFvgState
                    box.set_bgcolor(z.bx, color.new(COL_BEAR, 96))
            else if fillS >= 0.5 and z.state < 2
                z.state := 2
            // edge-triggered 50 % tap: re-arms only after price leaves the zone
            if high < bot
                z.tap50Bar := -1
            if high >= midP and z.tap50Bar == -1
                z.tap50Bar := bar_index
            // VIOLATION: confirmed close through the zone → breaker / mitigation
            if close > top
                if showFlip and not z.flipped
                    // Phase 12 causal chain, all recorded on THIS zone:
                    // it was created, price RETURNED into it, a liquidity event
                    // happened AT it, and the failure came with displacement +
                    // a structure shift. Anything less is a mitigation block.
                    f_zoneFlip(z, false, z.touchBar >= 0 and z.touchBar < bar_index and z.liqBeforeFail and dispUpBar and (recentIChUp or recentEChUp or recentEBosUp))
                else
                    box.delete(z.bx)
                    line.delete(z.mid)
                    array.remove(zones, i)
                continue
            // 50 % engine → CANDIDATE only. Freshest / best tier wins.
            f_regrade(z)
            bool eligS = not z.signaled and z.tier <= minTier and (not fvgFillDead or z.state < 3)
            if eligS and z.tap50Bar >= 0 and bar_index - z.tap50Bar <= confirmWin and zoneBearConf and high >= bot
                if not needSweep or bslInPlay
                    if not sdCandShort or z.tier < sdTierS
                        sdCandShort := true
                        sdZoneS     := z
                        sdTopShort  := top
                        sdBotShort  := bot
                        sdTierS     := z.tier
        else
            if low <= top
                if z.state == 0
                    z.touchBar := bar_index
                if z.state < 1
                    z.state := 1
                z.deepest := math.min(nz(z.deepest, top), low)
            fillD = (top - nz(z.deepest, top)) / hgt
            if fillD >= 1 and z.state < 3
                z.state := 3
                if showFvgState
                    box.set_bgcolor(z.bx, color.new(COL_BULL, 96))
            else if fillD >= 0.5 and z.state < 2
                z.state := 2
            if low > top
                z.tap50Bar := -1
            if low <= midP and z.tap50Bar == -1
                z.tap50Bar := bar_index
            if close < bot
                if showFlip and not z.flipped
                    f_zoneFlip(z, true, z.touchBar >= 0 and z.touchBar < bar_index and z.liqBeforeFail and dispDnBar and (recentIChDn or recentEChDn or recentEBosDn))
                else
                    box.delete(z.bx)
                    line.delete(z.mid)
                    array.remove(zones, i)
                continue
            f_regrade(z)
            bool eligD = not z.signaled and z.tier <= minTier and (not fvgFillDead or z.state < 3)
            if eligD and z.tap50Bar >= 0 and bar_index - z.tap50Bar <= confirmWin and zoneBullConf and low <= top
                if not needSweep or sslInPlay
                    if not sdCandLong or z.tier < sdTierL
                        sdCandLong  := true
                        sdZoneL     := z
                        sdTopLong   := top
                        sdBotLong   := bot
                        sdTierL     := z.tier

// ---- create new zones (displacement + FVG) ----------------------------------
bullFVG = low > high[2]
bearFVG = high < low[2]
zDispUp = bullBar[1] and body[1] >= dispFactor * atr
zDispDn = bearBar[1] and body[1] >= dispFactor * atr
newDemand = bullFVG and zDispUp
newSupply = bearFVG and zDispDn

if newDemand and confirmed
    float zTop = low
    float zBot = math.max(high[2], low - maxZoneAtr * atr)
    [tD, liqDz, spD, srD, smD] = f_gradeZone(false, zTop, zBot)
    bool dupD = false
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            bool ovD = not (zBot > z.top or zTop < z.bot)
            // §17 · BPR: this bullish gap opened inside a LIVE bearish gap. The
            // overlap is a balanced price range — both sides delivered there and
            // neither held. It is a PD array, so the surviving zone is re-tagged
            // and promoted; it is never a signal by itself.
            if ovD and showBPR and z.isSupply and z.isFvg and z.state < 3 and not z.flipped
                z.pa      := PA_BPR
                z.kindTxt := "BPR"
                z.tier    := math.min(z.tier, 2)
                z.tier0   := math.min(z.tier0, 2)
                box.set_text(z.bx, "BPR " + f_tierTxt(z.tier))
            if not z.isSupply and ovD
                // BUG-21: a SPENT zone is never replaced by a fresh overlapping
                // one — that re-armed the same price for a second entry.
                if z.signaled or z.tier <= tD
                    dupD := true
                else
                    box.delete(z.bx)
                    line.delete(z.mid)
                    array.remove(zones, i)
    if not dupD
        Zone zn = f_newZone(false, zTop, zBot, tD, "", 0, true)
        zn.srcPoolId  := spD
        zn.srcRaidBar := srD
        zn.srcMssBar  := smD
        zn.srcDispBar := bar_index - 1
        array.push(zones, zn)
        // §14 · THE ORDER BLOCK OF THIS LEG, and only of this leg. The OB is the
        // last opposing candle before the displacement that just left an FVG —
        // so it exists only where structure and imbalance already agree, which
        // is what stops "every opposite-coloured candle is an OB".
        if showOB and tD <= 2
            int   obI = bearBar[2] ? 2 : bearBar[3] ? 3 : bearBar[4] ? 4 : -1
            float obT = bearBar[2] ? high[2] : bearBar[3] ? high[3] : bearBar[4] ? high[4] : na
            float obB = bearBar[2] ? low[2]  : bearBar[3] ? low[3]  : bearBar[4] ? low[4]  : na
            if obI > 0 and obT - obB <= maxZoneAtr * atr
                Zone ob = f_newZone(false, obT, obB, tD, "OB ▲", bar_index - obI, false)
                ob.pa         := PA_OB
                ob.srcPoolId  := spD
                ob.srcRaidBar := srD
                ob.srcMssBar  := smD
                ob.srcDispBar := bar_index - 1
                array.push(zones, ob)

if newSupply and confirmed
    float zBot2 = high
    float zTop2 = math.min(low[2], high + maxZoneAtr * atr)
    [tS, liqSz, spS, srS, smS] = f_gradeZone(true, zTop2, zBot2)
    bool dupS = false
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            bool ovS = not (zBot2 > z.top or zTop2 < z.bot)
            if ovS and showBPR and not z.isSupply and z.isFvg and z.state < 3 and not z.flipped
                z.pa      := PA_BPR
                z.kindTxt := "BPR"
                z.tier    := math.min(z.tier, 2)
                z.tier0   := math.min(z.tier0, 2)
                box.set_text(z.bx, "BPR " + f_tierTxt(z.tier))
            if z.isSupply and ovS
                if z.signaled or z.tier <= tS
                    dupS := true
                else
                    box.delete(z.bx)
                    line.delete(z.mid)
                    array.remove(zones, i)
    if not dupS
        Zone zn2 = f_newZone(true, zTop2, zBot2, tS, "", 0, true)
        zn2.srcPoolId  := spS
        zn2.srcRaidBar := srS
        zn2.srcMssBar  := smS
        zn2.srcDispBar := bar_index - 1
        array.push(zones, zn2)
        if showOB and tS <= 2
            int   obJ = bullBar[2] ? 2 : bullBar[3] ? 3 : bullBar[4] ? 4 : -1
            float obT2 = bullBar[2] ? high[2] : bullBar[3] ? high[3] : bullBar[4] ? high[4] : na
            float obB2 = bullBar[2] ? low[2]  : bullBar[3] ? low[3]  : bullBar[4] ? low[4]  : na
            if obJ > 0 and obT2 - obB2 <= maxZoneAtr * atr
                Zone ob2 = f_newZone(true, obT2, obB2, tS, "OB ▼", bar_index - obJ, false)
                ob2.pa         := PA_OB
                ob2.srcPoolId  := spS
                ob2.srcRaidBar := srS
                ob2.srcMssBar  := smS
                ob2.srcDispBar := bar_index - 1
                array.push(zones, ob2)

// ---- rejection blocks: swing-point wick POIs --------------------------------
// The pivot must have SWEPT liquidity and price must have DISPLACED away.
rbSwpH = high[pivLen] > ta.highest(high, pivLen * 2)[pivLen + 1]
rbDspH = ta.lowest(low, pivLen) <= high[pivLen] - dispFactor * atr
rbSwpL = low[pivLen] < ta.lowest(low, pivLen * 2)[pivLen + 1]
rbDspL = ta.highest(high, pivLen) >= low[pivLen] + dispFactor * atr
rbNew = false
if showRB and confirmed
    if not na(ph)
        float rbTop = high[pivLen]
        float rbBot = math.max(open[pivLen], close[pivLen])
        if rbTop - rbBot >= minWickAtr * atr and rbSwpH and rbDspH
            bool rbDup = false
            if array.size(zones) > 0
                for i = array.size(zones) - 1 to 0
                    Zone z = array.get(zones, i)
                    if z.isSupply and not (rbBot > z.top or rbTop < z.bot)
                        rbDup := true
                        break
            if not rbDup
                Zone rz = f_newZone(true, rbTop, rbBot, structDir <= 0 ? 2 : 3, "REJECTION ▼", bar_index - pivLen, false)
                rz.pa := PA_REJ
                array.push(zones, rz)
                rbNew := true
    if not na(pl)
        float rbBot2 = low[pivLen]
        float rbTop2 = math.min(open[pivLen], close[pivLen])
        if rbTop2 - rbBot2 >= minWickAtr * atr and rbSwpL and rbDspL
            bool rbDup2 = false
            if array.size(zones) > 0
                for i = array.size(zones) - 1 to 0
                    Zone z = array.get(zones, i)
                    if not z.isSupply and not (rbBot2 > z.top or rbTop2 < z.bot)
                        rbDup2 := true
                        break
            if not rbDup2
                Zone rz2 = f_newZone(false, rbTop2, rbBot2, structDir >= 0 ? 2 : 3, "REJECTION ▲", bar_index - pivLen, false)
                rz2.pa := PA_REJ
                array.push(zones, rz2)
                rbNew := true

// ---- NEXT eligible buy / sell POI -------------------------------------------
float nbTop = na
float nbBot = na
float nsTop = na
float nsBot = na
int   nbTier  = 3
int   nsTier  = 3
if array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        float t = z.top             // V5.4-D1
        float b = z.bot
        bool  ok = not z.signaled and (not fvgFillDead or z.state < 3)
        if ok and not z.isSupply and b <= close and (na(nbTop) or t > nbTop)
            nbTop   := t
            nbBot   := b
            nbTier  := z.tier
        if ok and z.isSupply and t >= close and (na(nsBot) or b < nsBot)
            nsTop   := t
            nsBot   := b
            nsTier  := z.tier

touchNextBuy  = confirmed and not na(nbTop) and not na(nbTop[1]) and low <= nbTop and low[1] > nbTop[1]
touchNextSell = confirmed and not na(nsBot) and not na(nsBot[1]) and high >= nsBot and high[1] < nsBot[1]

// ═══════════════════════════ MODULE 11 · PATTERN PRODUCERS (candidates only)
// Everything in this module produces a CANDIDATE. None of it can print an
// entry and none of it writes a final stop. V5.3-C3, stated honestly: the
// trap watch DOES latch wFired on its own candidate — one candidate per
// armed watch, the anti-duplicate choice, even if the TRADE ENGINE then
// blocks that candidate. Everything else (cooldowns, zone.signaled,
// pool.spent) is consumed by the TRADE ENGINE, and only if it emits (BUG-5).
// ═════════════════════════════════════════════════════════════════════════════

// ═══════════ V5.5-E6 · TRAP ENGINE — FAILED BREAKOUT → RECLAIM (§15 / §16)
// This is v5.4's ① / ② breakout watch, promoted from "a price-action pattern"
// to the file's TRAP engine, because that is what it already was: a structural
// break, then late entrants, then failure, then a reclaim through the level.
// Three things are new.
//
//   1 · THE BROKEN LEVEL MUST BE CROWDED LIQUIDITY. §16 separates a trap from a
//       plain failed breakout by exactly this: the liquidity taken has to be
//       obvious. `trapNeedPool` requires a POOL IN THE REGISTRY to have been
//       BROKEN on the arming bar, not merely a pivot violated.
//   2 · THE TRAP IS GRADED. §15 lists the evidence; five of those items are
//       measurable here and f_trapQual scores them A / B / C. v5.4 graded every
//       failed breakout identically, which is precisely what §15 forbids.
//   3 · IT IS A DESCRIPTOR FIRST. A confirmed trap is written onto the liquidity
//       event (f_evTag) and sets the producer's POI tier. It pays NO liquidity
//       points — the raid it describes already paid them once (§8).
//
// ② (shrinking wicks) is NOT a trap: after an up-break, shrinking upper wicks
// are absorption and it fires LONG. It is kept for backward compatibility (§40),
// it is the weakest producer in the file, and it now additionally requires the
// close to be on the correct side of the broken level.
f_trapQual(bool pooled, float pen, int bars, bool decisive, bool disp) =>
    int pts = (pooled ? 1 : 0) + (pen <= 1.0 ? 1 : 0) + (bars <= trapReclMax ? 1 : 0) +
         (decisive ? 1 : 0) + (disp ? 1 : 0)
    pts >= 4 ? RQ_A : pts >= 3 ? RQ_B : RQ_C

// V7.1 · §15 / §16 · AN ELITE TRAP. v7.0 capped every trap at tier 2 and gated
// the producer behind "All engines", so the one pattern ICT treats as a primary
// entry model could never clear minTier = 2 into the A rung and never existed at
// all in the two stricter modes. An ELITE trap is ALL FIVE ingredients at once:
// tracked liquidity was broken, the overshoot stayed shallow, the reclaim came
// inside trapReclMax bars, the reclaim close was decisive, and it displaced.
// That is a complete causal chain — raid, failure, reclaim, delivery — so it
// earns a tier-1 POI and, with a grade-A raid behind it, the A+ rung.
f_trapElite(bool pooled, float pen, int bars, bool decisive, bool disp) =>
    trapElite and pooled and pen <= 1.0 and bars <= trapReclMax and decisive and disp

var int   wState   = 0
var float wLevel   = na
var int   wStart   = na
var float wExtreme = na
var bool  wFired   = false
var bool  wPool    = false      // V5.5-E6 · a tracked pool broke on the arming bar
var wicks = array.new<float>()

pa1Long  = false
pa1Short = false
pa2Long  = false
pa2Short = false
int   trapQ     = RQ_NONE
bool  trapEl    = false     // V7.1 · this trap is the complete five-ingredient story
float paSlLong  = na
float paSlShort = na

// arm only when idle, and only off a STRUCTURAL break (a weak run no longer
// arms a trap watch — BUG-2 made every weak close-through arm one). V5.5-E6
// adds the crowded-liquidity requirement.
if wState == 0 and brokeUp and body >= BRK_BODY_ATR * atr and confirmed and not na(brkUpLvl) and (not trapNeedPool or tPoolU)
    wState   := 1
    wLevel   := brkUpLvl
    wStart   := bar_index
    wExtreme := high
    wFired   := false
    wPool    := tPoolU
    array.clear(wicks)
else if wState == 0 and brokeDn and body >= BRK_BODY_ATR * atr and confirmed and not na(brkDnLvl) and (not trapNeedPool or tPoolD)
    wState   := -1
    wLevel   := brkDnLvl
    wStart   := bar_index
    wExtreme := low
    wFired   := false
    wPool    := tPoolD
    array.clear(wicks)

if wState == 1 and confirmed
    array.push(wicks, upWick)
    wExtreme := math.max(wExtreme, high)
else if wState == -1 and confirmed
    array.push(wicks, dnWick)
    wExtreme := math.min(wExtreme, low)

growing    = false
shrinking  = false
grewPrev   = false
shrankPrev = false
if array.size(wicks) >= 3
    wA = array.get(wicks, array.size(wicks) - 3)
    wB = array.get(wicks, array.size(wicks) - 2)
    wC = array.get(wicks, array.size(wicks) - 1)
    growing   := wC > wB and wB > wA and wB >= minWickAtr * atr
    shrinking := wA > wB and wB > wC and wA >= minWickAtr * atr
if array.size(wicks) >= 4
    pA = array.get(wicks, array.size(wicks) - 4)
    pB = array.get(wicks, array.size(wicks) - 3)
    pC = array.get(wicks, array.size(wicks) - 2)
    grewPrev   := pC > pB and pB > pA and pB >= minWickAtr * atr
    shrankPrev := pA > pB and pB > pC and pA >= minWickAtr * atr

if wState == 1 and confirmed and not wFired
    float penU  = math.max(wExtreme - wLevel, 0) / atr
    int   barsU = bar_index - wStart
    if showS1 and (growing or grewPrev) and bearBar and close < wLevel and body >= BRK_BODY_ATR * atr
        pa1Short  := true
        paSlShort := wExtreme
        trapQ     := f_trapQual(wPool, penU, barsU, close < wLevel - NEAR_LVL_ATR * atr, dispDnBar or strongDn)
        trapEl    := f_trapElite(wPool, penU, barsU, close < wLevel - NEAR_LVL_ATR * atr, dispDnBar or strongDn)   // V7.1
        wFired    := true
    else if showS2 and (shrinking or shrankPrev) and bullConfirm and close > wLevel
        pa2Long := true
        wFired  := true
if wState == -1 and confirmed and not wFired
    float penD  = math.max(wLevel - wExtreme, 0) / atr
    int   barsD = bar_index - wStart
    if showS1 and (growing or grewPrev) and bullBar and close > wLevel and body >= BRK_BODY_ATR * atr
        pa1Long  := true
        paSlLong := wExtreme
        trapQ    := f_trapQual(wPool, penD, barsD, close > wLevel + NEAR_LVL_ATR * atr, dispUpBar or strongUp)
        trapEl   := f_trapElite(wPool, penD, barsD, close > wLevel + NEAR_LVL_ATR * atr, dispUpBar or strongUp)    // V7.1
        wFired   := true
    else if showS2 and (shrinking or shrankPrev) and bearConfirm and close < wLevel
        pa2Short := true
        wFired   := true
// expiry / runaway — the watch dies on its own schedule, not on a signal
if wState != 0 and confirmed
    if bar_index - wStart > maxAfterBrk
        wState := 0
    else if wState == 1 and close > wLevel + RUNAWAY_ATR * atr
        wState := 0
    else if wState == -1 and close < wLevel - RUNAWAY_ATR * atr
        wState := 0
if showS1 and (pa1Long or pa1Short)
    f_chip(pa1Long, (pa1Long ? "BEAR TRAP " : "BULL TRAP ") + f_rqTxt(trapQ),
         color.new(pa1Long ? COL_BULL : COL_BEAR, 45), color.white, mkSize)


// ---- ⑫⑬ LOCATION FILTER (Phase 14 / BUG-20) --------------------------------
// "At a location" = at an HTF FVG POI, at an engineered / external pool that
// was just raided, in OTE, or at a premium / discount extreme. A mid-range
// pattern is drawn but is not tradable while crtNeedLoc is on.
f_atHtfPoi() =>
    bool aL = not na(hPoiBTop) and low  <= hPoiBTop + poiBindAtr * atr and high >= hPoiBBot - poiBindAtr * atr
    bool aS = not na(hPoiSTop) and high >= hPoiSBot - poiBindAtr * atr and low  <= hPoiSTop + poiBindAtr * atr
    [aL, aS]
[atHtfPoiL, atHtfPoiS] = f_atHtfPoi()


// ═══════════ V7.0 · CRT AND TURTLE SOUP: REMOVED IN FULL (§0)
// What stood here in v6.4: the `Crt` UDT + f_crtAdvance (a five-stage lifecycle,
// instantiated twice), the `Tbs` UDT + f_tbsAdvance (likewise), their four
// tbsLen rolling-extreme series, the two cooldown pairs, f_ctt_crtCand,
// f_ctt_tbsCand, f_ctt_htfCand, the `Ctt` marking UDT, f_cttTxt, f_cttMark
// (inlined four times), f_cttLvl, f_ctt_chart and f_ctt_htfMark.
//
// All of it is gone, and nothing replaced it in kind. The brief is explicit
// that no entry, score, gate, state transition or confirmation may depend on
// CRT or turtle soup, and the two producers they fed (PR_CRT / PR_TBS) were
// the file's only path from "a three-candle pattern" to an order. The evidence
// they were standing in for — a range extreme taken and reclaimed with
// displacement — is exactly what the liquidity registry's RAID grading plus the
// setup machine's MSS + displacement stages already measure, causally and with
// ownership, which is what §2 asks for and what a pattern match cannot give.
//
// Freed budget paid for: the HTF structure feed above, the order-block and BPR
// PD arrays, the leg-based OTE engine, the inducement test, the trendline
// liquidity engine and the AMD / Judas session layer.


// ══════════════════════ MODULE 11B · TWS · LIQUIDITY RUN · CONGESTION (V5.5-E)
// Three engines that did not exist in v5.4 in any form. None of them is a
// producer: TWS is a descriptor, the run engine is a GATE on fading, and the
// congestion filter is a grade modifier. Nothing here can print a signal.
// ═════════════════════════════════════════════════════════════════════════════

// ═══════════ V5.5-E3 · THREE-WAVE SEQUENCE — TWS (§14)
// §14 is explicit that TWS is "primarily a context / descriptor engine, not a
// standalone signal generator", so this engine cannot emit, cannot write a stop
// and cannot rank. It attaches a descriptor to the liquidity event and is worth
// a capped context bonus.
//
//   WAVE 1  first interaction — a new extreme against the rolling window.
//   WAVE 2  the manipulation — a DEEPER extreme, by at least twsDeepen·ATR, that
//           closes back BEYOND wave 1: it was rejected, not accepted.
//   WAVE 3  the resolution — wave 1 reclaimed, plus displacement or an MSS.
//   A wave that does not arrive inside twsWaveWin bars invalidates the sequence,
//   and ACCEPTANCE beyond wave 2 (a close through it) invalidates it outright —
//   that is a trend, not a three-wave manipulation.
type Tws
    int   st     = 0
    float w1Ext  = na
    int   w1Bar  = na
    float w2Ext  = na
    int   w2Bar  = na
    int   endBar = na

f_twsAdvance(Tws t, int dir, float ref) =>
    bool conf = false
    bool isL  = dir == 1
    if confirmed and useTws
        if (t.st == LC_CONF or t.st == LC_INVAL) and bar_index > nz(t.endBar, bar_index)
            t.st := LC_IDLE
        if t.st == LC_W1 and bar_index - nz(t.w1Bar, bar_index) > twsWaveWin
            t.st     := LC_INVAL
            t.endBar := bar_index
        else if t.st == LC_W2 and bar_index - nz(t.w2Bar, bar_index) > twsWaveWin
            t.st     := LC_INVAL
            t.endBar := bar_index
        else if t.st == LC_W2 and (isL ? close < t.w2Ext : close > t.w2Ext)
            t.st     := LC_INVAL          // acceptance beyond wave 2 = a trend
            t.endBar := bar_index
        if t.st == LC_IDLE
            if not na(ref) and (isL ? low <= ref : high >= ref)
                t.st    := LC_W1
                t.w1Ext := isL ? low : high
                t.w1Bar := bar_index
                t.w2Ext := na
                t.w2Bar := na
                t.endBar := na
        else if t.st == LC_W1 and bar_index > t.w1Bar
            bool deeper = isL ? low <= t.w1Ext - twsDeepen * atr : high >= t.w1Ext + twsDeepen * atr
            bool reject = isL ? close > t.w1Ext : close < t.w1Ext
            if deeper and reject
                t.st    := LC_W2
                t.w2Ext := isL ? low : high
                t.w2Bar := bar_index
        else if t.st == LC_W2 and bar_index > t.w2Bar
            bool res = isL ? close > t.w1Ext and (dispUpBar or mssBull) : close < t.w1Ext and (dispDnBar or mssBear)
            if res
                t.st     := LC_CONF
                t.endBar := bar_index
                conf     := true
    conf

// the wave-1 reference is computed ONCE, at top level, and handed in — a ta.*
// call inside a conditional branch of a function is exactly the pattern that
// produces silently wrong built-in state
var Tws twsUp = Tws.new()
var Tws twsDn = Tws.new()
// V6.2-SC-4 · folded. The wave-1 references are still computed ONCE per bar and
// handed in — this function is called unconditionally at global scope, so the
// ta.* built-ins advance on every bar exactly as before.
f_twsRun() =>
    float rL = ta.lowest(low, twsWaveWin)[1]
    float rS = ta.highest(high, twsWaveWin)[1]
    [f_twsAdvance(twsUp, 1, rL), f_twsAdvance(twsDn, -1, rS)]
[twsConfL, twsConfS] = f_twsRun()

// ═══════════ V7.0 · TWS MARK (the CTT layer's one surviving engine)
// v6.4's CTT layer marked CRT, turtle soup and TWS through a shared confluence
// label. CRT and turtle soup are gone, so what is left is one chip for the
// three-wave sequence — which is a CONTEXT descriptor, never a producer, and is
// drawn only where the wave-2 manipulation was deep enough to mean something.
if useTws and confirmed and twsConfL
    f_chip(true, "TWS ↑", color.new(COL_BULL, 45), color.white, mkSize)
if useTws and confirmed and twsConfS
    f_chip(false, "TWS ↓", color.new(COL_BEAR, 45), color.white, mkSize)


// ═══════════ MODULE 11C · MTF CRT / TBS / TWS — REMOVED IN v6.3 (TOKEN CAP)
// It was built, it worked as designed, and it measured 8 890 compiled tokens
// against the 516 this file has left (CE10117: 108 630 / 100 256). Four
// request.security calls publishing fourteen values each is 56 HTF series,
// and the feed function is inlined per call site — that is where the cost
// is, not in the state machines. The identical layer, unchanged in every
// rule, runs as 15.crt-tbs-tws-mtf-layer-v1.pine: add it to this chart and
// you have the trade engine here and the 15M / 30M / 1H / 4H structure
// marks there. If you would rather have it inline, the only currency the
// file has left is other systems — the dashboard (≈ 6 090 compiled), the
// debug panel (≈ 3 680) or MODULE 8B's liquidity marking (≈ 3 960).

// ═══════════ V5.5-E4 · LIQUIDITY RUN ENGINE (§11)
// v5.4 had `runUp` / `runDn`: a weak, non-displacement close through ONE level.
// §11 asks for something else entirely — pool A broken, then pool B, then
// expansion, an internal → external progression, and a classification. It also
// states the rule this engine exists to enforce: NEVER fade a liquidity run
// merely because liquidity was taken. A reversal needs exhaustion AND rejection
// AND reclaim AND a structural shift AND displacement.
//
//   RN_UNCONF  one pool broken this direction — nothing established yet.
//   RN_CONT    a second or later pool broken the same way inside runLife bars.
//              This is a RUN, and fading it is what runGate acts on.
//   RN_EXH     the run reached the next pool and RAIDED it instead of breaking
//              it — the first honest sign it is out of fuel.
//   RN_REV     exhaustion, and THEN an opposing shift with displacement. Only
//              here is a fade a trade rather than a hope.
type Run
    int   dir      = 0
    int   cls      = 0
    int   legs     = 0
    int   lastBar  = na
    bool  intToExt = false
    int   exhBar   = na

var Run run = Run.new()
runFresh = false
if confirmed
    if run.dir != 0 and not na(run.lastBar) and bar_index - run.lastBar > runLife
        run.dir      := 0
        run.cls      := RN_NONE
        run.legs     := 0
        run.intToExt := false
        run.exhBar   := na
    // exactly ONE side broke. Both breaking on one candle is not a directional
    // run, it is churn, and the congestion filter is the right reader of that.
    if poolBrkUp != poolBrkDn
        int   nd  = poolBrkUp ? 1 : -1
        int   nk  = poolBrkUp ? brkUpKind : brkDnKind
        bool  ext = nk == PK_EXT or nk == PK_PD or nk == PK_SES or nk == PK_EQ or nk == PK_HTF or nk == PK_PW
        if run.dir == nd and run.legs > 0
            run.legs     += 1
            run.cls      := RN_CONT
            run.intToExt := run.intToExt or ext
        else
            run.dir      := nd
            run.legs     := 1
            run.cls      := RN_UNCONF
            run.intToExt := ext
            run.exhBar   := na
        run.lastBar := bar_index
        runFresh    := true
    else if run.dir != 0 and run.legs > 0 and run.cls != RN_REV
        // EXHAUSTION: the run reached the next pool on its own side and could
        // not break it — it was raided and rejected instead
        bool raidedSame = run.dir == 1 ? (bslInPlay and anyHiBar == bar_index) : (sslInPlay and anyLoBar == bar_index)
        if raidedSame
            run.cls    := RN_EXH
            run.exhBar := bar_index
    // REVERSAL: exhaustion, then an OPPOSING structural shift WITH displacement,
    // on a later bar. Everything short of that stays a continuation (§11).
    if run.cls == RN_EXH and not na(run.exhBar) and bar_index > run.exhBar
        bool shift = run.dir == 1 ? mssBear and (dispDnBar or recentDispDn) : mssBull and (dispUpBar or recentDispUp)
        if shift
            run.cls := RN_REV

// §11 made operational: a LONG taken while sell-side liquidity is still being
// RUN downward is a fade. It is permitted once the run has EXHAUSTED or actually
// REVERSED — never while it is still classified RN_CONT.
runFadeLong  = runGate != "Off" and run.dir == -1 and run.cls == RN_CONT
runFadeShort = runGate != "Off" and run.dir ==  1 and run.cls == RN_CONT

// ═══════════ V5.5-E5 · CONGESTION / COMPRESSION FILTER (§29)
// Price action only — §29 and §39 both rule out bolting an oscillator on for
// this. Four independent readings of "there is no narrative here":
//   TIGHT    the whole window fits inside a fraction of what its own ATR says it
//            should have covered — compression.
//   CHURN    most bars sit inside the previous bar's range.
//   NO NET   the window travelled almost nowhere relative to the distance its
//            candles actually covered — chop.
//   FLIP     structure broke in BOTH directions inside the window: no side is in
//            control, and every break was noise.
// Two of four = congested. congGate then downgrades one grade, or blocks.
congOvl   = math.min(high, nz(high[1], high)) - math.max(low, nz(low[1], low))
congOvlOk = rng > 0 and nz(rng[1], 0) > 0 and nz(congOvl, 0) >= 0.6 * math.max(rng, nz(rng[1], 0)) ? 1.0 : 0.0
congTight = ta.highest(high, congLen) - ta.lowest(low, congLen) <= 0.45 * congLen * atr
congChurn = ta.sma(congOvlOk, congLen) >= 0.6
congTrav  = ta.sma(rng, congLen) * congLen
congNoNet = congTrav > 0 and not na(close[congLen]) and math.abs(close - close[congLen]) / congTrav <= 0.15
congFlip  = math.sum((bosUp or chochUp) ? 1.0 : 0.0, congLen) >= 1 and math.sum((bosDn or chochDn) ? 1.0 : 0.0, congLen) >= 1
congN     = (congTight ? 1 : 0) + (congChurn ? 1 : 0) + (congNoNet ? 1 : 0) + (congFlip ? 1 : 0)
congested = congGate != "Off" and congN >= 2
congHard  = congGate == "Block"

// ═══ V7.0 · §36 · MARKET REGIME ══════════════════════════════════
// Four readings, all from price action, all from series this file already
// computes: the congestion engine above, volatility against its own 50-bar
// mean, and where price sits in its own dealing range relative to the external
// structural direction. This is a CLASSIFICATION for the operator and for the
// score — it adds no new gate, because the gate that matters (congestion) is
// already wired and adding a second one on the same evidence would be exactly
// the over-filtering §46 warns against.
atrRel = atr / math.max(ta.sma(atr, 50), syminfo.mintick)
regime = congested ? RG_CHOP : atrRel >= 1.4 ? RG_EXP :
     extDir != 0 and rangeOK and (extDir > 0 ? pdPos >= 0.5 : pdPos <= 0.5) ? RG_TREND : RG_RANGE

// ═══ V7.0 · §39 · AMD / POWER OF THREE / JUDAS ═══════════════════════
// ACCUMULATION is the Asian range building. MANIPULATION is a killzone opening
// by taking the liquidity that range (or the previous session, or the previous
// day) left behind — the Judas leg. DISTRIBUTION is what follows once structure
// has shifted and price is expanding away.
// These are CONTEXT. They never trigger anything: judasL / judasS only attach a
// descriptor to the liquidity event and feed the capped context bonus, exactly
// as §39 requires.
amdKz    = timeframe.isintraday and (inLon or inNY or inSB)
amdSes   = anyLoKind == PK_SES or anyHiKind == PK_SES or anyLoKind == PK_PD or anyHiKind == PK_PD
amdManip = amdKz and amdSes and ((sslInPlay and f_recent(anyLoBar, 8)) or (bslInPlay and f_recent(anyHiBar, 8)))
amdDist  = amdKz and not amdManip and (recentDispUp or recentDispDn) and (recentMssUp or recentMssDn)
amdTxt   = not timeframe.isintraday ? "—" : amdManip ? "MANIP" : amdDist ? "DISTRIB" : inAsia ? "ACCUM" : "—"
judasL   = amdManip and sslInPlay and f_recent(anyLoBar, 8)
judasS   = amdManip and bslInPlay and f_recent(anyHiBar, 8)

// ═══════════ V5.5-E · ATTACH THE DESCRIPTORS TO THE EVENT (§7 / §8)
// Every engine above, plus the trap engine and the session story, describes the
// SAME physical liquidity event whenever it fires on a side that has a live
// raid. They are written onto that ONE pool, so the dashboard, the debug panel
// and the entry reason can print "one event, four descriptors" — and so that
// f_score can pay for them ONCE, out of a capped allowance that is structurally
// unable to touch the liquidity block.
if confirmed
    if twsConfL
        f_evTag(anyLoPool, "TWS")
    if twsConfS
        f_evTag(anyHiPool, "TWS")
    if pa1Long
        f_evTag(anyLoPool, "BEAR TRAP")
    if pa1Short
        f_evTag(anyHiPool, "BULL TRAP")
    if judasL
        f_evTag(anyLoPool, "JUDAS")
    if judasS
        f_evTag(anyHiPool, "JUDAS")
    if run.cls == RN_EXH and run.dir == -1
        f_evTag(anyLoPool, "RUN EXH")
    if run.cls == RN_EXH and run.dir == 1
        f_evTag(anyHiPool, "RUN EXH")


// ══════════════════════════════════ MODULE 12 · SETUP STATE MACHINE (V5-1/2/3/4)
// The ONLY path to a narrative entry. One live setup per direction.
//
//   0 NO SETUP → 1 HTF CONTEXT → 2 LIQUIDITY TARGET LOCKED → 3 THAT TARGET
//   RAIDED → 4 VALID POI AT THE RAID → 5 POST-RAID MSS → 6 DISPLACEMENT
//   → 7 FVG CREATED BY THAT DISPLACEMENT → 8 FVG RETEST = ENTRY → 9 SPENT
//
// Three things changed from v4 and they are the reason this module exists:
//
// 1 · CHRONOLOGY IS ENFORCED, NOT ASSUMED (V4-BUG-1). v4 ran these stages as a
//     straight run of independent `if s.st == ST_x` tests inside one call, and
//     every trigger could be true on one candle, so a single bar could walk
//     0 → 7. Here every stage stamps its bar and the next stage compares:
//
//        ctxBar < tgtBar < raidBar ≤ poiBar < mssBar < dispBar ≤ fvgBar < retestBar
//
//     The two ≤ pairs are the only physically simultaneous ones — the candle
//     that raids the pool can be the candle that taps the POI, and the
//     displacement candle IS the third candle of the gap it leaves. Everything
//     else needs a later bar, and a `moved` latch makes that structural rather
//     than incidental.
//
// 2 · EVERY EVENT IS OWNED (V4-BUG-3 / V4-BUG-2). The setup locks a target POOL
//     OBJECT at state 2 and state 3 fires only when THAT pool is raided, after
//     the lock. v4 asked f_findRaid for "the freshest raid on this side", so a
//     setup born at bar 103 could claim a raid from bar 100 on a pool it had
//     never been hunting.
//
// 3 · A DEAD SETUP CANNOT BE REBORN ON ITS OWN GRAVE (V4-BUG-4). Every
//     invalidation stamps resetBar, and state 0 → 1 refuses to arm on a bar
//     that already killed a setup.
//
// Nothing here emits. It reports [entry, blockReason] and MODULE 15 decides.
// ═════════════════════════════════════════════════════════════════════════════
// dedupe memories — read by the machine, written by the TRADE ENGINE (V5-11)
var int lastPoolIdL = 0
var int lastPoolIdS = 0
var int lastPoiIdL  = 0
var int lastPoiIdS  = 0
var int lastMssBarL = na
var int lastMssBarS = na
// V5.5-E7 · the PRICE and bar of the last executed liquidity event, per side
var float lastPoolPxL  = na
var float lastPoolPxS  = na
var int   lastPoolBarL = na
var int   lastPoolBarS = na

type Setup
    int    st        = 0
    int    id        = 0
    int    bornBar   = na
    int    ctxBar    = na
    bool   reversal  = false
    int    tgtId     = 0     // stage 2 · the liquidity being hunted, by IDENTITY
    string tgtTag    = ""
    int    tgtBar    = na
    Pool   tgtPool   = na
    int    liqId     = 0     // stage 3 · the raid of THAT pool, never another
    int    liqBar    = na
    float  liqExt    = na
    bool   liqStrong = false
    int    liqKind   = 0
    string liqTag    = ""
    int    liqQual   = 0
    Pool   pool      = na
    int    poiId     = 0     // stage 4 · the POI that sits AT that raid
    float  poiTop    = na
    float  poiBot    = na
    int    poiTier   = 3
    bool   poiFresh  = false
    bool   poiIsHtf  = false
    int    poiBar    = na
    Zone   poiZone   = na
    int    mssBar    = na    // stages 5 / 6 · the shift and its expansion
    bool   mssChoch  = false
    float  mssLvl    = na
    int    dispBar   = na
    float  dispBody  = na
    int    fvgBar    = na    // stage 7 · the gap that displacement left behind
    float  fvgTop    = na
    float  fvgBot    = na
    float  fvgH      = na
    int    retestBar = na    // stage 8 · execution
    int    retestQ   = 0
    // ── V7.0 · the impulse leg this setup created (§11), the inducement that
    //    paid for its raid (§38), when price FIRST entered the execution gap
    //    (§48 timing) and which PD-array class its POI is (§40).
    float  legLo     = na
    float  legHi     = na
    bool   induced   = false
    int    fvgTouch  = -1
    int    poiPa     = 0
    // ── V7.1 · the OTE BAND CLASS rather than a yes/no (§10), the number of
    //    DISCRETE touches of the execution gap (§48) and whether the setup's own
    //    displacement also left the dealing range (§2).
    int    oteQ      = 0
    int    fvgTouches = 0
    bool   inGap     = false
    bool   dispOutRng = false
    bool   sbWindow  = false
    int    resetBar  = na

// Releases the pool binding, clears every owned field and stamps the bar, so
// the arming stage can refuse to re-arm on this candle (V4-BUG-4).
f_setupReset(Setup s) =>
    if not na(s.pool)
        if s.pool.bound == s.id
            s.pool.bound := 0
    s.st        := ST_NONE
    s.ctxBar    := na
    s.reversal  := false
    s.tgtId     := 0
    s.tgtTag    := ""
    s.tgtBar    := na
    s.tgtPool   := na
    s.liqId     := 0
    s.liqBar    := na
    s.liqExt    := na
    s.liqStrong := false
    s.liqKind   := 0
    s.liqTag    := ""
    s.liqQual   := 0
    s.pool      := na
    s.poiId     := 0
    s.poiTop    := na
    s.poiBot    := na
    s.poiTier   := 3
    s.poiFresh  := false
    s.poiIsHtf  := false
    s.poiBar    := na
    s.poiZone   := na
    s.mssBar    := na
    s.mssChoch  := false
    s.mssLvl    := na
    s.dispBar   := na
    s.dispBody  := na
    s.fvgBar    := na
    s.fvgTop    := na
    s.fvgBot    := na
    s.fvgH      := na
    s.retestBar := na
    s.retestQ   := 0
    s.legLo     := na
    s.legHi     := na
    s.induced   := false
    s.fvgTouch  := -1
    s.poiPa     := 0
    s.oteQ       := 0        // V7.1
    s.fvgTouches := 0        // V7.1
    s.inGap      := false    // V7.1
    s.dispOutRng := false    // V7.1
    s.sbWindow  := false
    s.resetBar  := bar_index
    true

// NARRATIVE INTEGRITY (§23). Re-derives the whole causal chain from the stored
// bars and ids at the moment of the entry, independently of the transitions
// that produced it. If this returns false the TRADE ENGINE emits nothing, no
// matter how high the soft score is.
f_narrOk(Setup s) =>
    bool ok = s.st == ST_ENTRY
    ok := ok and s.tgtId != 0 and s.liqId == s.tgtId          // raid hit the locked target
    ok := ok and nz(s.liqBar, -1) > nz(s.bornBar, 99999999)   // no retroactive raid
    ok := ok and nz(s.tgtBar, -1) >= nz(s.ctxBar, 99999999)
    ok := ok and nz(s.liqBar, -1) >  nz(s.tgtBar, 99999999)
    ok := ok and nz(s.poiBar, -1) >= nz(s.liqBar, 99999999)
    ok := ok and nz(s.mssBar, -1) >  nz(s.liqBar, 99999999)
    ok := ok and nz(s.mssBar, -1) >  nz(s.poiBar, 99999999)  // V5.2-B5: the machine can never make these equal
    ok := ok and nz(s.dispBar, -1) > nz(s.mssBar, 99999999)
    ok := ok and nz(s.fvgBar, -1) >= nz(s.dispBar, 99999999)
    ok := ok and nz(s.fvgBar, -1) - nz(s.dispBar, -99999999) <= FVG_OWN_MAX
    ok := ok and nz(s.retestBar, -1) > nz(s.fvgBar, 99999999)
    ok

// ═══ V7.0 · §10 / §11 · TRUE OTE ══════════════════════════════════
// v6.4 asked one global question — "is close inside the 62-79 % band of the
// CHART'S dealing range?" — and handed the same answer to every setup on the
// bar. A retracement is a property of ONE impulse leg, and the leg that
// matters is the one this setup created: its own raid extreme (where the move
// originated) to the extreme its own displacement reached.
//   `deep` is the retest candle's extreme — how far price actually pulled back.
//   `px`   is the entry price — used only to prove the leg origin still holds.
// Reaching 62 % is the requirement; running past 79 % is not a disqualifier by
// itself (it is a deeper discount), but breaking the leg origin is, because at
// that point there is no leg left to retrace into.
// V7.1 · GRADED, NOT BOOLEAN. A 63 % retracement and a 92 % one paid the same
// four points and were equally A+ eligible, which is exactly backwards: the
// deeper the pullback runs past 79 %, the less leg is left to trade. The band is
// returned as a CLASS — 1 = 62-70 % (prime, full points, A+ eligible) · 2 =
// 70-79 % (deep; still tradable and still scored, but capped at grade A) · 3 =
// beyond 79 % (one token point, never A+) · 0 = never reached 62 %, or the leg
// origin has been broken and there is no leg left to retrace into.
f_inOte(bool isL, float lo, float hi, float deep, float px) =>
    float w = nz(hi - lo, 0)
    int   q = 0
    if w > 0 and not na(deep) and not na(px) and (isL ? px > lo : px < hi)
        float r = isL ? (hi - deep) / w : (deep - lo) / w
        q := r > OTE_2 ? 3 : r > OTE_M ? 2 : r >= OTE_1 ? 1 : 0
    q

f_setupAdvance(Setup s, int dir) =>
    bool   entry = false
    string blk   = ""
    bool   isL   = dir == 1
    // at most ONE transition per bar. The two exceptions below are the pairs
    // that are simultaneous by construction, and they are named explicitly so
    // no future edit can widen them by accident.
    bool   moved = false
    // V5.6-L12 · TOKEN BUDGET. f_setupReset is a ~37-write body and v5.6 called
    // it at NINETEEN sites inside this function, which is itself instantiated
    // twice — Pine inlines every call, so that was ~7 000 compiled tokens of one
    // reset. Every invalidation now raises `kill`; the reset runs ONCE, at the
    // end of the bar. Behaviour is identical: each stage guard carries
    // `not kill`, so nothing can advance after a kill on the same bar, exactly
    // as nothing could advance from ST_NONE before. The terminal-state clear
    // below stays a direct reset because the 0 → 1 block must see it this bar.
    bool   kill  = false
    if confirmed
        // ── 9 · terminal states clear on a LATER bar, so the engine always had
        //      one full bar in which to consume an ENTRY
        if s.st == ST_ENTRY or s.st == ST_DEAD
            if s.retestBar != bar_index
                f_setupReset(s)
        // ── invalidation, checked before any advance
        if s.st > ST_NONE and s.st < ST_ENTRY
            // V5.3-C1: refresh the owned POI tier from the LIVE zone before
            // judging anything. f_regrade decays tiers every bar; a grade or a
            // gate reading the stage-4 snapshot would trade the tier the zone
            // HAD, not the tier it HAS. HTF POIs have no re-grade → untouched.
            if s.st >= ST_POI and not s.poiIsHtf and not na(s.poiZone)
                s.poiTier := f_zoneTier(s.poiZone)
            // §11 · the leg extends while the move is still being made, and is
            //       frozen the moment displacement completes it. Extending it
            //       through the retracement would move the OTE band under the
            //       entry it is supposed to be judging.
            if s.st >= ST_RAID and s.st <= ST_DISP
                if isL
                    s.legHi := math.max(nz(s.legHi, high), high)
                else
                    s.legLo := math.min(nz(s.legLo, low), low)
            if bar_index - s.bornBar > setupLife
                blk := "setup expired"
                kill := true
            else if isL ? eChochDn : eChochUp
                blk := "opposite external CHoCH"
                kill := true
            else if s.st >= ST_RAID and f_poolSpent(s.pool)
                blk := "target pool already produced an entry"
                kill := true
            else if s.st >= ST_RAID and not na(s.liqExt) and (isL ? close < s.liqExt : close > s.liqExt)
                blk := "raid failed (closed beyond the wick)"
                kill := true
            else if s.st >= ST_RAID and nz(f_poolBrkBar(s.pool), -1) > nz(s.liqBar, -1)
                // V5.2-B4: a close back THROUGH the swept level is a failed
                // sweep even while it has not yet crossed the raid wick.
                blk := "raid level reclaimed (close back through the pool)"
                kill := true
            else if s.st >= ST_POI and s.poiIsHtf and bar_index - s.poiBar > femWait
                blk := "FEM window expired"
                kill := true
            else if s.st >= ST_POI and not na(s.poiBot) and (isL ? close < s.poiBot - NEAR_LVL_ATR * atr : close > s.poiTop + NEAR_LVL_ATR * atr)
                blk := "POI invalidated"
                kill := true
            else if s.st >= ST_POI and not s.poiIsHtf and f_zoneDead(s.poiZone)
                blk := "POI spent or re-graded below the minimum tier"
                kill := true
            // V7.1 · §2 · AN EXPANSION THAT IS GIVEN BACK WAS NOT A DISPLACEMENT.
            //   While the setup is still waiting for its gap, a close back through
            //   the level the MSS broke says the delivery failed. v7.0 let that
            //   setup carry on and hand its FVG to the entry stage anyway.
            else if s.st == ST_DISP and not na(s.mssLvl) and (isL ? close < s.mssLvl : close > s.mssLvl)
                blk := "displacement reversed back through the MSS level"
                kill := true
        // ── 0 → 1 · HTF CONTEXT (and the CONTINUATION / REVERSAL verdict)
        if s.st == ST_NONE and not moved and not kill
            if s.resetBar == bar_index
                blk := blk == "" ? "setup invalidated this bar — no same-bar re-arm" : blk
            else if (isL ? htfIsRevLong : htfIsRevShort) and not allowRev
                // V5.1-A3c: allowRev = OFF now means what it says. v5 only wired
                // allowRev into htfRevLong, which needHtfAlign = false bypassed.
                blk := "counter-HTF setup and REVERSAL setups are disabled"
            else if isL ? htfCtxLong : htfCtxShort
                s.st       := ST_CTX
                s.id       := bar_index * 2 + (isL ? 1 : 2)
                s.bornBar  := bar_index
                s.ctxBar   := bar_index
                s.reversal := isL ? htfIsRevLong : htfIsRevShort
                moved      := true
            else
                blk := "HTF context not aligned"
        // ── 1 → 2 · LOCK THE LIQUIDITY TARGET (identity, not just a price)
        if s.st == ST_CTX and not moved and not kill
            Pool tp = isL ? tgtSellPool : tgtBuyPool
            if na(tp)
                blk := "no liquidity target"
            else if strictSeq and bar_index <= s.ctxBar
                blk := "context armed this bar — target locks next bar"
            else
                s.st      := ST_TGT
                s.tgtId   := tp.id
                s.tgtTag  := tp.tag
                s.tgtPool := tp
                s.tgtBar  := bar_index
                moved     := true
        // ── 2 → 3 · THAT POOL IS RAIDED, after the lock (V4-BUG-2 / V4-BUG-3)
        if s.st == ST_TGT and not moved and not kill
            Pool tp2 = s.tgtPool
            if na(tp2)
                blk := "target lost"
                kill := true
            else if tp2.state == PS_DONE
                blk := "target pool broken or expired"
                kill := true
            else if tp2.state == PS_RAID or tp2.state == PS_REACT
                bool chrono = nz(tp2.raidBar, -1) > nz(s.tgtBar, 99999999) or (not strictSeq and nz(tp2.raidBar, -1) >= nz(s.tgtBar, 99999999))
                if not chrono
                    blk := "raid pre-dates the target lock — retroactive claim refused"
                    kill := true
                else if tp2.bound != 0 and tp2.bound != s.id
                    blk := "raid already bound to another setup"
                    kill := true
                else if tp2.spent
                    blk := "pool already produced an entry"
                    kill := true
                else if not f_recent(tp2.raidBar, sweepLook)
                    blk := "raid is stale"
                    kill := true
                else
                    s.st        := ST_RAID
                    s.liqId     := tp2.id
                    s.liqBar    := tp2.raidBar
                    s.liqExt    := tp2.raidExt
                    s.liqStrong := tp2.raidStrong
                    s.liqKind   := tp2.kind
                    s.liqTag    := tp2.tag
                    s.liqQual   := tp2.rq
                    s.pool      := tp2
                    tp2.bound   := s.id
                    // §11 · the impulse leg opens AT the raid extreme — that is
                    //       where the move this setup is trading began.
                    s.legLo     := isL ? tp2.raidExt : low
                    s.legHi     := isL ? high : tp2.raidExt
                    // §38 · was a minor pool taken first, to pay for this raid?
                    int indB = isL ? indLoBar : indHiBar
                    int indI = isL ? indLoId  : indHiId
                    s.induced   := useInduce and indB >= 0 and indI != tp2.id and
                         indB < nz(tp2.raidBar, 0) and nz(tp2.raidBar, 0) - indB <= induceLook
                    moved       := true
            else
                // still hunting. The nearest live pool is what price is actually
                // working toward, so the target may be RE-SELECTED — but the
                // clock restarts with it, so the raid can never pre-date it.
                Pool tp3 = isL ? tgtSellPool : tgtBuyPool
                if not na(tp3)
                    if tp3.id != s.tgtId
                        s.tgtId   := tp3.id
                        s.tgtTag  := tp3.tag
                        s.tgtPool := tp3
                        s.tgtBar  := bar_index
                blk := "target not yet raided"
        // ── 3 → 4 · A VALID POI AT THE RAID.  raid candle = POI candle is legal
        if s.st == ST_RAID and not kill and (not moved or s.liqBar == bar_index)
            if bar_index - s.liqBar > mssWin
                blk := "raid went stale before a POI"
                kill := true
            else
                // V7.1 · §7 · BINDING IS CONTAINMENT NOW. v7.0 accepted any array whose
                //   NEAREST EDGE fell within poiBindAtr (default 2.0) ATR of the raid
                //   extreme. Two ATR from the wick is not "the POI at the liquidity",
                //   it is a different trade with a borrowed reason. With poiStrictBind
                //   on, the array has to hold the wick that took the pool.
                float pTol = poiBindAtr * atr
                float hTop = isL ? hPoiBTop : hPoiSTop
                float hBot = isL ? hPoiBBot : hPoiSBot
                bool  hTap = useFEM and not na(hTop) and (isL ? low <= hTop and close > hBot : high >= hBot and close < hTop) and s.liqExt <= hTop + pTol and s.liqExt >= hBot - pTol
                if hTap
                    s.st       := ST_POI
                    s.poiTop   := hTop
                    s.poiBot   := hBot
                    s.poiTier  := 1
                    s.poiFresh := (isL ? nz(hPoiBIn, 0) : nz(hPoiSIn, 0)) == 0
                    s.poiIsHtf := true
                    s.poiId    := 0
                    s.poiZone  := na
                    s.poiBar   := bar_index
                    moved      := true
                else
                    // chart-TF POI: the best eligible zone that CONTAINS the raid
                    float zTopB  = na
                    float zBotB  = na
                    int   zTierB = 9
                    int   zwB    = 999
                    int   zPaB   = 0
                    int   zIdB   = 0
                    bool  zFrB   = false
                    Zone  zRef   = na
                    if array.size(zones) > 0
                        for i = 0 to array.size(zones) - 1
                            Zone z = array.get(zones, i)
                            bool sideOk = isL ? not z.isSupply : z.isSupply
                            bool dedupe = dedupePoi and z.id == (isL ? lastPoiIdL : lastPoiIdS)
                            // V7.1 · §40 · AGE. A zone that has been on the chart for
                            //   hundreds of bars has been mitigated and re-priced many
                            //   times over, whatever its live tier still reads.
                            bool live   = not z.signaled and not dedupe and (not fvgFillDead or z.state < 3) and z.tier <= minTier and bar_index - z.bornBar <= poiMaxAge
                            // §40 · Two live arrays can both contain the raid; ICT ranks
                            //   an order block above a raw gap and a mitigation block
                            //   below both, so the tie is broken by what the array IS,
                            //   not by which was found first.
                            // V7.1 · tier first · then the PD-array ladder (order block >
                            //   breaker > IFVG > BPR > RAW FVG > mitigation) · then how
                            //   little of it has been eaten. v7.0 ranked the first two
                            //   and broke the remaining ties on array order.
                            int zw = z.tier * 100 + f_paRank(z.pa) * 10 + z.state
                            if sideOk and live and zw < zwB
                                float zt = z.top    // V5.4-D1
                                float zb = z.bot
                                if s.liqExt <= zt + pTol and s.liqExt >= zb - pTol
                                    zTopB  := zt
                                    zBotB  := zb
                                    zwB    := zw
                                    zTierB := z.tier
                                    zPaB   := z.pa
                                    zIdB   := z.id
                                    zFrB   := z.state <= 1
                                    zRef   := z
                    if not na(zTopB)
                        s.st       := ST_POI
                        s.poiTop   := zTopB
                        s.poiBot   := zBotB
                        s.poiTier  := zTierB
                        s.poiFresh := zFrB
                        s.poiIsHtf := false
                        s.poiId    := zIdB
                        s.poiPa    := zPaB
                        s.poiZone  := zRef
                        s.poiBar   := bar_index
                        moved      := true
                    else
                        blk := "no valid POI at the raid"
        // ── 4 → 5 · POST-RAID MSS (V4-BUG-6). Strictly after the raid, breaking
        //      a level that formed around it, and far enough from the raid
        //      extreme that it is a shift rather than the sweep candle again.
        if s.st == ST_POI and not moved and not kill
            if bar_index - s.poiBar > mssWin
                blk := "MSS window expired"
                kill := true
            else if bar_index <= s.liqBar
                blk := "awaiting a POST-RAID shift"
            else
                bool  ch   = isL ? chochUp : chochDn
                // §5 · cisdMssUp/Dn already carry the displacement requirement, so
                //      a bare change in the state of delivery can no longer be
                //      promoted to a market-structure shift.
                bool  ci   = isL ? cisdMssUp : cisdMssDn
                float lvl  = ch ? (isL ? sInt.evLvlUp : sInt.evLvlDn) : (isL ? bearRunOpen : bullRunOpen)
                int   lvlB = ch ? (isL ? sInt.evBarUp : sInt.evBarDn) : (isL ? bearRunBar : bullRunBar)
                bool  rel  = not na(lvl) and nz(lvlB, -99999999) >= s.liqBar - mssWin
                bool  sep  = not na(lvl) and math.abs(lvl - s.liqExt) >= MSS_MIN_SEP_ATR * atr
                if (ch or (ci and not mssNeedChoch)) and rel and sep
                    s.st       := ST_MSS
                    s.mssBar   := bar_index
                    s.mssChoch := ch
                    s.mssLvl   := lvl
                    moved      := true
                else if ch or ci
                    blk := not rel ? "MSS broke an unrelated (pre-raid) level" : "MSS level is the raid itself"
                else
                    blk := "MSS / CHoCH missing"
        // ── 5 → 6 · DISPLACEMENT (V4-BUG-7). Strictly after the MSS, closing
        //      beyond the level the MSS broke and out of the POI it came from.
        if s.st == ST_MSS and not moved and not kill
            if bar_index - s.mssBar > dispWin
                blk := "displacement window expired"
                kill := true
            else
                // V7.1 · §2 · FOUR REQUIREMENTS, NOT TWO. A displacement has to be a
                //   BODY (dispBodyAtr, its own input on top of the chart-wide marker),
                //   it has to close BEYOND the level the MSS broke, it has to close
                //   OUTSIDE the POI it came from, and it has to HOLD what it took into
                //   the close. A candle that expands and then hands most of it back
                //   inside the same bar is a liquidity grab, not delivery, and v7.0
                //   accepted it as stage 6 on the strength of its body alone.
                float dRng = math.max(high - low, syminfo.mintick)
                bool  dsp  = (isL ? dispUpBar : dispDnBar) and body >= dispBodyAtr * atr
                bool  past = not na(s.mssLvl) and (isL ? close > s.mssLvl : close < s.mssLvl)
                bool  away = isL ? close > s.poiTop + POI_LEAVE_ATR * atr : close < s.poiBot - POI_LEAVE_ATR * atr
                bool  hold = (isL ? close - low : high - close) / dRng >= DISP_HOLD_FRAC
                if dsp and past and away and hold
                    s.st         := ST_DISP
                    s.dispBar    := bar_index
                    s.dispBody   := body / atr
                    // §10 · expansion that ALSO leaves the dealing range is the
                    //   strongest reading of the same candle: the move is no longer a
                    //   retracement inside a range, it is a new leg. Preferred in the
                    //   score, never required — causality first, confluence after.
                    s.dispOutRng := rangeOK and (isL ? close > rngHi : close < rngLo)
                    moved        := true
                else if dsp and past and away
                    blk := "weak displacement — closed back inside its own range"
                else if dsp
                    blk := not past ? "expansion did not clear the MSS level" : "expansion did not leave the POI"
                else
                    blk := "displacement missing"
        // ── 6 → 7 · THE FVG THAT DISPLACEMENT ITSELF CREATED (V4-BUG-8).
        //      The displacement candle must be one of the three candles that
        //      form the gap, which is what "the displacement's FVG" means.
        if s.st == ST_DISP and not kill and (not moved or s.dispBar == bar_index)
            if bar_index - s.dispBar > FVG_OWN_MAX
                // Plenty of real expansion candles leave no gap. That does not
                // invalidate the shift that produced them, so the setup falls
                // back to state 5 and waits for the next expansion — still
                // strictly after the same MSS — instead of being destroyed.
                if bar_index - s.mssBar <= dispWin
                    s.st         := ST_MSS
                    s.dispBar    := na
                    s.dispBody   := na
                    s.dispOutRng := false   // V7.1 · clears with the displacement it described
                    blk := "that expansion left no FVG — awaiting another"
                else
                    blk := "no FVG created by the displacement leg"
                    kill := true
            else if isL ? bullFVG : bearFVG
                float ft = isL ? low : low[2]
                float fb = isL ? high[2] : high
                if ft - fb >= fvgMinAtr * atr
                    s.st     := ST_FVG
                    s.fvgTop := ft
                    s.fvgBot := fb
                    s.fvgH   := ft - fb
                    s.fvgBar := bar_index
                    moved    := true
                else
                    blk := "FVG below the minimum height"
            else
                blk := "awaiting the FVG"
        // ── 7 → 8 · FVG RETEST = ENTRY (§10). A touch is not an entry: the gap
        //      must be penetrated to retestDepth AND the candle must close back
        //      through its 50 % with a rejection.
        if s.st == ST_FVG and not moved and not kill
            float h   = math.max(nz(s.fvgH, syminfo.mintick), syminfo.mintick)
            float mid = isL ? s.fvgTop - 0.5 * h : s.fvgBot + 0.5 * h
            float nd  = isL ? s.fvgTop - retestDepth * h : s.fvgBot + retestDepth * h
            float pen = isL ? (s.fvgTop - low) / h : (high - s.fvgBot) / h
            if isL ? close < s.fvgBot : close > s.fvgTop
                blk := "FVG invalidated (traded fully through)"
                kill := true
            else if bar_index - s.fvgBar > retestWin
                blk := "retest window expired"
                kill := true
            else if bar_index <= s.fvgBar
                blk := "awaiting the FVG retest"
            else
                // §48 · the clock starts when price FIRST enters the gap, not when
                //       the gap was made. Everything after that is the market
                //       deciding, and a rejection that takes many candles to
                //       arrive is a LATE entry into a mitigated array.
                // V7.1 · §48 · DISCRETE TOUCHES, not just the first one. Every fresh
                //   entry into the gap after having been fully outside it is one more
                //   mitigation of that array. lateBars still runs off the FIRST touch;
                //   the COUNT is what the A+ rung reads (apMaxTouch).
                bool inG = isL ? low <= s.fvgTop : high >= s.fvgBot
                if inG and not s.inGap
                    s.fvgTouches := s.fvgTouches + 1
                    if s.fvgTouch == -1
                        s.fvgTouch := bar_index
                s.inGap := inG
                bool deep = isL ? low <= nd : high >= nd
                bool back = isL ? close >= mid and close > s.fvgBot : close <= mid and close < s.fvgTop
                bool rej  = isL ? zoneBullConf or strongUp : zoneBearConf or strongDn
                bool late = s.fvgTouch >= 0 and bar_index - s.fvgTouch > lateBars
                // §11 · the OTE verdict is recorded on the setup at the moment of
                //       execution, from ITS leg, and is read by the score and by
                //       the A+ precondition. oteLegMode OFF falls back to the
                //       chart dealing range, which is what v6.4 always used.
                // V7.1 · it is a BAND CLASS, not a flag — 0 none · 1 prime 62-70 % ·
                //   2 deep 70-79 % (grade A max) · 3 beyond 79 % (never A+).
                s.oteQ := oteLegMode ? f_inOte(isL, s.legLo, s.legHi, isL ? low : high, close)
                     : ((isL ? inOTEbuy : inOTEsell) ? 1 : 0)
                if late
                    blk := "LATE — " + str.tostring(bar_index - s.fvgTouch) + " bars since the first FVG touch"
                    kill := true
                else if deep and back and rej
                    s.st        := ST_ENTRY
                    s.retestBar := bar_index
                    s.retestQ   := pen >= 0.8 ? 3 : pen >= 0.5 ? 2 : 1
                    s.sbWindow  := sbActive
                    entry       := true
                    moved       := true
                else if not deep
                    blk := "awaiting the FVG retest"
                else if not back
                    blk := "no close back through the FVG 50 %"
                else
                    blk := "retest without a rejection candle"
        // ── the ONE reset site (V5.6-L12). Same bar, same fields, same
        //      resetBar stamp — only the number of inlined copies changed.
        if kill
            f_setupReset(s)
    [entry, blk]

var Setup upS = Setup.new()
var Setup dnS = Setup.new()
[machLong,  blkLong]  = f_setupAdvance(upS, 1)
[machShort, blkShort] = f_setupAdvance(dnS, -1)
narrLong  = f_narrOk(upS)
narrShort = f_narrOk(dnS)

// ═══════════════════════════════════ MODULE 13 · ALIGNMENT SCORE (SOFT ONLY)
// V4-BUG-5 — v4's f_score read GLOBAL "did this happen in the last N bars"
// flags: recentMssUp, recentDispUp, cisdUpBar, raidExtLo, raidEqLo, sslStrong.
// None of them belonged to the setup being scored, so a dead setup's CHoCH, a
// sweep on an unrelated pool and a displacement from the other side of the
// chart all paid into one number. In v5 every ingredient is passed in BY the
// caller from the fields of the setup (or of the specific producer) being
// scored, and nothing is read from a global event memory.
//
//   CONTEXT   25 = HTF agreement 10 · external structure 6 · premium/discount 5
//                  · session narrative 4
//   LIQUIDITY 25 = raid grade 12 · pool class 8 · pool quality 5
//   POI       20 = HTF POI 6 · freshness 5 · live tier 5 · OTE 4
//   TRIGGER   20 = MSS grade 8 · displacement strength 6 · MSS ≠ displacement
//                  bar 3 · CISD independent of the MSS 3
//   EXECUTION 10 = retest quality 6 · rejection candle 4
//
// The score RANKS things that have already passed every hard gate. It is not a
// win probability and it can never create a grade on its own (V5-7).
// ═════════════════════════════════════════════════════════════════════════════
sesPts = not timeframe.isintraday ? 4 : inSB or inNY or inLon ? 4 : inAsia ? 2 : 0

// V5-12 · SESSION NARRATIVE. A session is not just a permitted clock window —
// London taking Asia's low and New York taking London's low are the two most
// common liquidity stories on an intraday chart, and they are recognised here
// as CONTEXT, not as a filter.
sesStoryL = timeframe.isintraday and sslInPlay and ((inLon and str.contains(anyLoTag, "Asia")) or ((inNY or inSbAM or inSbPM) and str.contains(anyLoTag, "Lon")) or (inSB and anyLoKind == PK_SES) or ((inLon or inNY) and anyLoKind == PK_PD))
sesStoryS = timeframe.isintraday and bslInPlay and ((inLon and str.contains(anyHiTag, "Asia")) or ((inNY or inSbAM or inSbPM) and str.contains(anyHiTag, "Lon")) or (inSB and anyHiKind == PK_SES) or ((inLon or inNY) and anyHiKind == PK_PD))

f_score(int dir, int tier, bool isHtfPoi, bool fresh, int retQ, bool rejOk, int rq, int rkind, int touches, bool rev, bool mssCh, bool mssOk, float dispBody, int mssB, int dispB, int cisdB, bool story, int descN, bool cong, bool induced, int oteQ, bool atHtfArr, bool dispOut) =>
    bool isL = dir == 1
    // ── CONTEXT 25
    int ctx = (isL ? htfDir > 0 : htfDir < 0) ? 10 : rev ? 4 : 0
    ctx += (isL ? extDir > 0 : extDir < 0) ? 6 : 0
    ctx += rangeOK and (isL ? pdPos < 0.5 : pdPos >= 0.5) ? 5 : 0
    ctx += story ? 4 : sesPts >= 4 ? 3 : sesPts
    // ── LIQUIDITY 25 — the grade of THIS setup's raid on THIS setup's pool
    int liq = rq == RQ_A ? 12 : rq == RQ_B ? 8 : rq == RQ_C ? 4 : 0
    liq += rkind == PK_HTF or rkind == PK_PW ? 8 : rkind == PK_EXT or rkind == PK_PD or rkind == PK_SES ? 8 : rkind == PK_EQ ? 6 : rkind == PK_TL ? 5 : rkind == PK_SWING ? 3 : 0
    // §29 · NO DOUBLE COUNTING. Inducement is a statement about the QUALITY of
    //     this raid, so it is paid out of the same five points prior respect
    //     was paid from — the LIQUIDITY block stays capped at 25 and a setup
    //     cannot be paid twice for one liquidity event.
    liq += (touches >= 2 ? 3 : touches == 1 ? 2 : 0) + (induced ? 2 : 0)
    // ── POI 20
    // §26 · an LTF entry sitting at an HTF PD array is worth something even when
    //     the HTF array is not itself the POI — but not as much, and out of the
    //     same six points, never in addition to them.
    int poi = isHtfPoi ? 6 : atHtfArr ? 3 : 0
    poi += fresh ? 5 : 0
    poi += tier == 1 ? 5 : tier == 2 ? 3 : 0
    // §11 · the setup's OWN OTE, not the chart's
    // V7.1 · the prime 62-70 % band is worth the full four; a 70-79 % deep entry
    //   is worth two; beyond 79 % is a token one. Same four-point allowance.
    poi += oteQ == 1 ? 4 : oteQ == 2 ? 2 : oteQ == 3 ? 1 : 0
    // ── TRIGGER 20 — independent evidence only
    int trg = mssOk ? (mssCh ? 8 : 5) : 0
    // V7.1 · measured against the SETUP's displacement floor, and a displacement
    //   that also left the dealing range reads as strongly as a double-size body
    //   — out of the SAME six points, so the TRIGGER block stays capped at 20.
    trg += dispBody >= 2 * dispBodyAtr or (dispOut and dispBody >= dispBodyAtr) ? 6 : dispBody >= dispBodyAtr ? 4 : 0
    trg += mssOk and nz(dispB, -1) != nz(mssB, -2) ? 3 : 0
    trg += f_recent(cisdB, TRIG_LOOK) and nz(cisdB, -1) != nz(mssB, -2) ? 3 : 0
    // ── EXECUTION 10
    int exe = retQ >= 3 ? 6 : retQ == 2 ? 4 : retQ == 1 ? 2 : 0
    exe += rejOk ? 4 : 0
    // ── EVENT DESCRIPTORS ≤ 6 (V5.5-E · §8). This is the ONLY place CRT, turtle
    //    soup, TWS, the trap engine and run exhaustion are worth anything in the
    //    score, they are worth it ONCE no matter how many of them fired, and the
    //    allowance is structurally unable to reach the LIQUIDITY block — which is
    //    still paid exactly once, from this event's own raid grade, pool class and
    //    touch history. Congestion is a debit against the same allowance, so a
    //    descriptor pile-up inside chop nets to nothing. The total is clamped at
    //    100 so the score stays a normalised 0-100 reading (§27).
    int ev = descN >= 3 ? 6 : descN == 2 ? 4 : descN == 1 ? 2 : 0
    ev := math.max(cong ? ev - 4 : ev, 0)
    [ctx, liq, poi, trg, exe, ev, math.min(ctx + liq + poi + trg + exe + ev, 100)]

// ═══════════════════════════════ MODULE 14 · BASE GATES + DEDUPE
// These filters SILENCE a signal. They never advance or consume state.
// ═════════════════════════════════════════════════════════════════════════════
var int lastLongSigBar  = na
var int lastShortSigBar = na
longCdOK  = masterCd == 0 or na(lastLongSigBar)  or bar_index - lastLongSigBar  > masterCd
shortCdOK = masterCd == 0 or na(lastShortSigBar) or bar_index - lastShortSigBar > masterCd

baseLongOK  = filtBias >= 0 and kzOK and volOK and sbGate and longCdOK  and (not structFilt or structDir >= 0)
baseShortOK = filtBias <= 0 and kzOK and volOK and sbGate and shortCdOK and (not structFilt or structDir <= 0)

// ---- CONFLUENCE CHRONOLOGY (V4-BUG-15) --------------------------------------
// v4's gate was `sslInPlay and (recentMssUp or mssUp) and recentDispUp` — three
// independent global flags in ANY order, so "displacement, then a shift, then an
// old sweep that is still in play" passed as a liquidity reversal. The producers
// outside the state machine now have to show the same ORDER the machine does:
//        raid  <  MSS  ≤  displacement,  all of them still live.
cMssBarL  = nz(iChUpBar, -1) > nz(cisdUpBar, -1) ? nz(iChUpBar, -1) : nz(cisdUpBar, -1)
cMssBarS  = nz(iChDnBar, -1) > nz(cisdDnBar, -1) ? nz(iChDnBar, -1) : nz(cisdDnBar, -1)
cDispBdL  = ta.valuewhen(dispUpBar, body / atr, 0)
cDispBdS  = ta.valuewhen(dispDnBar, body / atr, 0)
confGateLong  = sslInPlay and not na(anyLoBar) and cMssBarL > anyLoBar and nz(dispUpBar2, -1) >= cMssBarL and f_recent(cMssBarL, TRIG_LOOK) and recentDispUp
confGateShort = bslInPlay and not na(anyHiBar) and cMssBarS > anyHiBar and nz(dispDnBar2, -1) >= cMssBarS and f_recent(cMssBarS, TRIG_LOOK) and recentDispDn

// ---- DEDUPE (V5-11 / V4-BUG-14) ---------------------------------------------
// One liquidity event → one POI → one execution. v4 had only a bar cooldown, so
// the same pool, the same zone and the same structure shift could each produce a
// second and a third entry once masterCd bars had passed.
f_dedupeOk(int dir, int poolId, int poiId, int mssB, float poolPx) =>
    bool ok = true
    if dedupePool and poolId != 0
        ok := ok and poolId != (dir == 1 ? lastPoolIdL : lastPoolIdS)
    // V5.5-E7 · ID EQUALITY ALONE WAS NOT ENOUGH. A pool retired by age, by
    // reaction staleness or by distance leaves the registry silently, and
    // f_poolPush then re-registers the SAME price as a NEW pool with a NEW id —
    // so "one liquidity pool → one execution" quietly stopped applying to the
    // same physical level. The level is now deduped on PRICE and recency too:
    // same side, within eqTol·ATR, inside setupLife bars.
    if dedupePool and not na(poolPx)
        float lpx = dir == 1 ? lastPoolPxL : lastPoolPxS
        int   lbr = dir == 1 ? lastPoolBarL : lastPoolBarS
        if not na(lpx) and not na(lbr) and bar_index - lbr <= setupLife
            ok := ok and math.abs(poolPx - lpx) > eqTol * atr
    if dedupePoi and poiId != 0
        ok := ok and poiId != (dir == 1 ? lastPoiIdL : lastPoiIdS)
    if dedupeMss and not na(mssB)
        ok := ok and mssB != nz(dir == 1 ? lastMssBarL : lastMssBarS, -1)
    ok

allowConf = entryMode != "Narrative only (A+)"
allowAll  = entryMode == "All engines (legacy)"

// ══════════════════════════════ MODULE 14B · RISK PRIMITIVES (ARCH-7)
// These lived in v4's MODULE 16, i.e. AFTER the signal had already been emitted,
// which is exactly why v4 could print a trade whose structural stop was 3·ATR
// wide with un-raided liquidity 0.4·ATR overhead (V4-BUG-12). They are function
// definitions, so moving them above the TRADE ENGINE changes nothing except
// that the engine can now ASK before it decides.
//
// SL HIERARCHY: 1 liquidity-raid wick · 2 protected structural swing · 3 FVG
// invalidation · 4 POI edge · 5 ATR fallback. First candidate on the correct
// side AND inside [minRiskAtr, maxRiskAtr] wins.
// TP LADDER: internal liquidity → opposing FVG/OB → external liquidity, each
// with an R floor, and no target parked behind an un-raided opposing POI.
// ═════════════════════════════════════════════════════════════════════════════
f_slOk(int dir, float entry, float lvl) =>
    not na(lvl) and (dir == 1 ? lvl < entry : lvl > entry) and math.abs(entry - lvl) >= minRiskN * atr and math.abs(entry - lvl) <= maxRiskN * atr

f_sl(int dir, float entry, float lvlRaid, float lvlProt, float lvlFvg, float lvlPoi) =>
    float pad = SL_PAD_ATR * atr
    float c1 = na(lvlRaid) ? na : dir == 1 ? lvlRaid - pad : lvlRaid + pad
    float c2 = na(lvlProt) ? na : dir == 1 ? lvlProt - pad : lvlProt + pad
    float c3 = na(lvlFvg)  ? na : dir == 1 ? lvlFvg  - pad : lvlFvg  + pad
    float c4 = na(lvlPoi)  ? na : dir == 1 ? lvlPoi  - pad : lvlPoi  + pad
    float sl = na
    int   src = 5
    if f_slOk(dir, entry, c1)
        sl  := c1
        src := 1
    else if f_slOk(dir, entry, c2)
        sl  := c2
        src := 2
    else if f_slOk(dir, entry, c3)
        sl  := c3
        src := 3
    else if f_slOk(dir, entry, c4)
        sl  := c4
        src := 4
    else
        sl  := dir == 1 ? entry - atrStopMult * atr : entry + atrStopMult * atr
        src := 5
    // V5.1-A4: the ATR fallback is NOT exempt from the risk clamp. v5 returned it
    // unchecked, so a candidate whose every structural level had been rejected FOR
    // BEING WIDER than maxRiskAtr still printed — with a 1·ATR stop sitting inside
    // the level that invalidates the thesis. That is a worse answer to V4-BUG-12
    // than the bug it replaced. `ok` is a HARD gate in MODULE 15 now.
    bool ok = src < 5 or f_slOk(dir, entry, sl)
    [sl, src, ok]

f_slTxt(int src) =>
    src == 1 ? "raid wick" : src == 2 ? "protected swing" : src == 3 ? "FVG invalidation" : src == 4 ? "POI edge" : "ATR fallback"

// nearest live pool beyond `from` in the trade direction.
// scope 0 = internal (minor swings) · 1 = external (EXT / PD / session / EQ)
// V5.4-D2: `go` gates the scan INSIDE the function (the lineage pattern —
// Pine evaluates both branches of a ternary, so gating the call would not
// skip the work). go = "a producer fired this bar, or this is the last bar".
f_nextPool(bool go, int dir, float from, int scope) =>
    float best = na
    if go and array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            bool kindOk = scope == 0 ? p.kind == PK_SWING : p.kind == PK_EXT or p.kind == PK_PD or p.kind == PK_SES or p.kind == PK_EQ or p.kind == PK_HTF or p.kind == PK_PW or p.kind == PK_TL
            bool sideOk = dir == 1 ? p.buySide and p.px > from : not p.buySide and p.px < from
            if p.state <= PS_VAL and kindOk and sideOk
                if na(best) or (dir == 1 ? p.px < best : p.px > best)
                    best := p.px
    best

// nearest OPPOSING zone edge beyond `from` — the wall a target must respect
f_nextZone(bool go, int dir, float from) =>
    float best = na
    if go and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if not z.signaled and z.state < 3
                if dir == 1 and z.isSupply
                    float b = z.bot             // V5.4-D1
                    if b > from and (na(best) or b < best)
                        best := b
                else if dir == -1 and not z.isSupply
                    float tp = z.top
                    if tp < from and (na(best) or tp > best)
                        best := tp
    best

// §17 · OPPOSING LIQUIDITY. The nearest MEANINGFUL thing standing between the
// entry and its target: a live pool on the opposite side that is either
// engineered / external / session / previous-day liquidity or a minor swing that
// price has already respected, or an opposing POI that is still fresh (less than
// half mitigated) and graded T1/T2. Un-validated minor pivots are deliberately
// excluded — they sit everywhere and would cap every trade at nothing.
// "Risk 10 with resistance 8 away" is not a 2R trade however the maths is drawn.
f_oppLiq(bool go, int dir, float from) =>
    float best = na
    if go and array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            bool meaty  = p.kind != PK_SWING or p.state == PS_VAL
            bool sideOk = dir == 1 ? p.buySide and p.px > from : not p.buySide and p.px < from
            if p.state <= PS_VAL and meaty and sideOk
                if na(best) or (dir == 1 ? p.px < best : p.px > best)
                    best := p.px
    if go and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if not z.signaled and z.state < 2 and z.tier <= 2
                if dir == 1 and z.isSupply
                    float zb = z.bot            // V5.4-D1
                    if zb > from and (na(best) or zb < best)
                        best := zb
                else if dir == -1 and not z.isSupply
                    float zt2 = z.top
                    if zt2 < from and (na(best) or zt2 > best)
                        best := zt2
    best

// V5.1-A1 · TP2 IS MEASURED, NEVER SYNTHESISED.
// v5 seeded `t2 = entry + rrMult*risk` and then computed RR as
// (t2 - entry)/risk — which is rrMult, exactly. With the defaults
// rrMult = 2.0 >= rrAplus = 2.0 every RR floor in the file passed
// unconditionally, on every bar, on every instrument. In "Next level" mode it
// was worse: f_tp never touched t2 at all, so RR was a literal constant.
// The 4th return value `s2` records WHERE TP2 came from:
//   0 = synthetic (no structural target found) → MODULE 15 blocks the trade
//   1 = opposing zone wall · 2 = external liquidity · 3 = internal liquidity
//   4 = "Next level" target · -1 = "R multiple" (the user opted out of
//       structural targeting, so the RR gate is inert BY REQUEST)
f_tp(bool go, int dir, float entry, float risk) =>
    float t1 = dir == 1 ? entry + risk : entry - risk
    float t2 = dir == 1 ? entry + rrMult * risk : entry - rrMult * risk
    float t3 = dir == 1 ? entry + 3 * risk : entry - 3 * risk
    int   s2 = 0
    if tpMode == "Liquidity ladder"
        float iL = f_nextPool(go, dir, entry, 0)
        float zW = f_nextZone(go, dir, entry)
        float eL = f_nextPool(go, dir, entry, 1)
        float minD = rrB * risk        // the loosest floor any grade can use
        if not na(iL) and (dir == 1 ? iL - entry >= risk : entry - iL >= risk)
            t1 := iL
        // nearest candidate that is at least the loosest RR floor away, by
        // preference: opposing wall → external liquidity → internal liquidity
        float c2 = na
        int   cs = 0
        if not na(zW) and (dir == 1 ? zW - entry >= minD : entry - zW >= minD)
            c2 := zW
            cs := 1
        if not na(eL) and (dir == 1 ? eL - entry >= minD : entry - eL >= minD)
            if na(c2) or (dir == 1 ? eL < c2 : eL > c2)
                c2 := eL
                cs := 2
        if na(c2) and not na(iL) and (dir == 1 ? iL - entry >= minD : entry - iL >= minD)
            c2 := iL
            cs := 3
        if not na(c2)
            t2 := c2
            s2 := cs
        // t3 is only ever promoted OUTWARD (v5 let a 2R external pool drag TP3
        // down from its 3R default)
        if not na(eL) and (dir == 1 ? eL - entry >= math.max(2 * risk, t3 - entry) : entry - eL >= math.max(2 * risk, entry - t3))
            t3 := eL
        // never park ANY rung behind an un-raided opposing POI. v5 clamped t3
        // only, so TP1 and TP2 could both sit beyond the wall, and when t2 had
        // been promoted TO the wall the clamp collapsed t3 onto t2. v5 also
        // clamped against ZONES only, while the input tooltip promised
        // "un-raided opposing pool" — the wall is the nearest of both now.
        float pW = f_oppLiq(go, dir, entry)
        float wRaw = na(zW) ? pW : na(pW) ? zW : dir == 1 ? math.min(zW, pW) : math.max(zW, pW)
        if tpClamp and not na(wRaw)
            float wall = dir == 1 ? wRaw - NEAR_LVL_ATR * atr : wRaw + NEAR_LVL_ATR * atr
            if dir == 1
                t1 := math.min(t1, wall)
                t2 := math.min(t2, wall)
                t3 := math.min(t3, wall)
            else
                t1 := math.max(t1, wall)
                t2 := math.max(t2, wall)
                t3 := math.max(t3, wall)
    else if tpMode == "Next level"
        float tgt = na
        if dir == 1
            tgt := not na(nsBot) and nsBot > entry ? nsBot : not na(lastRes) and lastRes > entry ? lastRes : na
            if not na(tgt) and tgt - entry >= rrB * risk
                t2 := tgt
                t3 := math.max(t3, tgt)
                s2 := 4
        else
            tgt := not na(nbTop) and nbTop < entry ? nbTop : not na(lastSup) and lastSup < entry ? lastSup : na
            if not na(tgt) and entry - tgt >= rrB * risk
                t2 := tgt
                t3 := math.min(t3, tgt)
                s2 := 4
    else
        s2 := -1                        // "R multiple" — synthetic by request
    // keep the ladder monotone by CAPPING t1, never by inflating t2. v5 did
    // `t2 := math.max(t2, t1)`, so an internal pool promoted to TP1 five R away
    // dragged TP2 to 5R and bought an A+ RR off a TP1 level.
    if dir == 1
        t1 := math.min(t1, t2)
        t3 := math.max(t3, t2)
    else
        t1 := math.max(t1, t2)
        t3 := math.min(t3, t2)
    [t1, t2, t3, s2]

// §15 / §16 · GRADE. HARD gates decide IF a trade exists; this decides WHAT it
// is. A+ demands the complete owned narrative, a grade-A raid, a live tier-1
// POI, a CHoCH-grade shift when it is fighting the HTF, and the A+ RR floor —
// none of which a high score can substitute for (V4-BUG-13).
f_grade(bool mach, bool narr, int tier, int rq, bool rev, bool mssCh, float rr, float room, bool cong, bool runFade, int oteQ, bool pdExt, bool apTouch, bool elite) =>
    // V5.1-A3 · REVERSAL IS A HARD BLOCK, NOT A DOWNGRADE.
    // The header and the allowRev tooltip both promise a counter-HTF setup needs
    // a grade-A raid, a tier-1 POI and a CHoCH-grade MSS. v5 coded
    // `revOk = not rev or mssCh` — one of the three — and a failure only pushed
    // the setup down to grade B, which trades at the default minGrade. So the
    // advertised reversal requirements never blocked anything.
    // V7.0 · §10 · a REVERSAL must also come from the right half of the range.
    // The HTF premium / discount extreme is already required at the context
    // stage; this adds the CHART dealing range, because a counter-trend entry
    // taken at equilibrium is the one trade premium / discount exists to refuse.
    bool revOk = not rev or (mssCh and tier == 1 and rq == RQ_A and pdExt)
    int  g     = GR_NONE
    if revOk
        // V5.1-A2 · GRADE B NOW HAS EVIDENCE REQUIREMENTS.
        // v5 opened with `int g = GR_B` unconditionally, so a candidate with a
        // tier-3 POI, no graded raid, no narrative and no structural target still
        // graded B and cleared the default minGrade — hGrade was a no-op and
        // "hard gates a high score can never buy past" was untrue by default.
        if rq >= RQ_C and f_geq(rr, rrB)
            g := GR_B
        if g == GR_B and (not mach or narr) and tier <= 2 and rq >= RQ_B and f_geq(rr, rrAn)
            g := GR_A
        // §11 / §16 · A+ is the complete narrative, and "price returned to a
        //     meaningful institutional level" is part of that narrative. With
        //     oteNeedAp on, an entry that never retraced into its own leg's
        //     62 % is an A, not an A+, however good everything else looks.
        // V7.1 · THREE CHANGES TO THE A+ RUNG, two of them restrictions.
        //   ① the OTE band must be the PRIME 62-70 %. A 70-79 % entry is a deep
        //     discount — tradable and scored, but capped at grade A, and past 79 %
        //     there is barely a leg left to retrace into. Both caps hold even with
        //     oteNeedAp OFF: that switch forgives NOT REACHING the OTE (oteQ 0), it
        //     does not promote a retracement that ran too deep.
        //   ② the execution array must still be UNMITIGATED: A+ only within
        //     apMaxTouch discrete touches of the gap (§48). Beyond that the entry
        //     still prints, at A.
        //   ③ an ELITE trap substitutes for the machine narrative, because it has
        //     a complete one of its own (f_trapElite).
        if g == GR_A and ((mach and narr) or elite) and tier == 1 and rq == RQ_A and f_geq(rr, rrAPn) and apTouch and (elite ? oteQ >= 1 : oteNeedAp ? oteQ == 1 : oteQ <= 1)
            g := GR_AP
        // Not enough room to the first opposing pool = ONE step down, and one
        // step below B is no trade. v5 made GR_B a terminal absorber, so a room
        // violation on a B candidate was forgiven entirely. RR is no longer
        // folded into this (see MODULE 15) — the two gates are independent now.
        if useOppLiq and not oppLiqHard and not na(room) and room < oppLiqMult
            g := g == GR_AP ? GR_A : g == GR_A ? GR_B : GR_NONE
        // V5.5-E5 · CONGESTION is a one-step downgrade in soft mode (§29); the
        // hard-block variant is a gate in MODULE 15, not a grade modifier.
        if cong and not congHard
            g := g == GR_AP ? GR_A : g == GR_A ? GR_B : GR_NONE
        // V5.5-E4 · FADING AN UNEXHAUSTED LIQUIDITY RUN, same treatment (§11).
        if runFade and runGate == "Downgrade"
            g := g == GR_AP ? GR_A : g == GR_A ? GR_B : GR_NONE
    g

// ═════════════════════════════════════ MODULE 15 · TRADE ENGINE (ARCH-6)
// The ONLY authority that may declare LONG / SHORT. The order of business is
// now the one §24 asks for:
//
//   producer selection → SL / TP / RR / opposing liquidity → HARD GATES →
//   soft score → grade → arbitration → consumption
//
// Exactly one producer per direction wins by RANK (FEM > machine > S/D retest >
// CRT > turtle soup > trendline sweep > price action). If both directions
// qualify on one bar the higher-ranked one wins and an exact tie mutes BOTH.
// ═════════════════════════════════════════════════════════════════════════════
// V6.5-O4 · ONE PRODUCER CHAIN, TWO CALLS.
// v6.4 spelled the identical five-producer if / else-if ladder out twice — once
// per direction — preceded by forty default declarations. Every branch, every
// rank, every tag and every field write below is byte-for-byte what the LONG and
// SHORT blocks did; only the direction-specific NAMES became parameters, and the
// two strings that genuinely differ ("Demand / Supply 50% retest" and
// "① BEAR / BULL TRAP") are chosen from `isL`. The defaults that used to be the
// forty declarations are now the function's own locals, and the destructures
// below declare the same forty globals with the same types.
f_prod(bool isL, bool mach, Setup s, bool sdC, bool cg, int sdT, Zone sdZ, float sdEdge, bool pa1, bool pa2, float paSl, float anyExt, int anyRq, int anyKind, Pool anyPool, int anyId, bool isRev, int iChBar, float cDispBd, int cMssBar, int dispBar2) =>
    int    pr   = 0
    string tg   = ""
    float  psl  = na
    int    ti   = 3
    bool   hp   = false
    bool   fr   = false
    int    rtq  = 0
    int    rqv  = 0
    int    rk   = 0
    int    tc   = 0
    bool   rv   = false
    bool   mc   = false
    bool   mo   = false
    float  db   = 0
    int    mb   = na
    int    dbr  = na
    int    pid  = 0
    int    zid  = 0
    float  fvgE = na
    float  poiE = na
    if mach
        pr   := s.poiIsHtf ? PR_FEM : PR_MACH
        tg   := s.poiIsHtf ? "◎ FEM " + htfTf + "→LTF" : "Sweep+POI+MSS"
        psl  := s.liqExt
        ti   := s.poiTier
        hp   := s.poiIsHtf
        fr   := s.poiFresh
        rtq  := s.retestQ
        rqv  := s.liqQual
        rk   := s.liqKind
        tc   := f_poolTouch(s.pool)
        rv   := s.reversal
        mc   := s.mssChoch
        mo   := true
        db   := nz(s.dispBody, 0)
        mb   := s.mssBar
        dbr  := s.dispBar
        pid  := s.liqId
        zid  := s.poiId
        fvgE := isL ? s.fvgBot : s.fvgTop
        poiE := isL ? s.poiBot : s.poiTop
    // V7.2 BUG-02 · CONTAINMENT, not coincidence. The raid this producer is about
    //   to inherit as its reason, its stop and its grade has to be the raid THIS
    //   zone holds — the same test the machine's stage 3->4 applies, at the one
    //   place both sides pass through.
    else if allowConf and sdC and cg and (not needSweep or (not na(sdZ) and anyExt <= sdZ.top + poiBindAtr * atr and anyExt >= sdZ.bot - poiBindAtr * atr))
        pr   := PR_SD
        tg   := isL ? "Demand 50% retest" : "Supply 50% retest"
        psl  := anyExt
        ti   := sdT
        fr   := f_zoneFresh(sdZ)          // V5.5-E2 · the zone being TRADED
        rtq  := 2
        zid  := f_zoneId(sdZ)
        poiE := sdEdge
    // V7.1 · an ELITE ① trap is admitted in EVERY entry mode, "Narrative only"
    //   included, because it brings its own complete causal chain rather than
    //   borrowing the machine's. Ordinary ① traps and ② still need "All engines",
    //   and the confluence chronology gate `cg` still applies to all of them.
    else if (allowAll or (trapEl and pa1)) and (pa1 or pa2) and cg
        pr  := PR_TRAP
        tg  := pa1 ? (isL ? "① BEAR TRAP " : "① BULL TRAP ") + f_rqTxt(trapQ) + (trapEl ? "+" : "") : "② PinTrap"
        psl := paSl
        // V5.5-E6 · a GRADED trap has a POI: the level it reclaimed. An ungraded
        // one (and ②, which is absorption rather than a trap) stays tier 3 and is
        // therefore display-only at the default minTier — V5.3-C2's honest default.
        ti  := pa1 and trapEl ? 1 : pa1 and trapQ >= RQ_B ? 2 : 3   // V7.1 · elite → tier 1
    // V5.6-L12 · every non-machine producer reads the SAME live raid on its side.
    if pr > PR_MACH
        rqv := anyRq
        rk  := anyKind
        tc  := f_poolTouch(anyPool)
        rv  := isRev
        mc  := f_recent(iChBar, TRIG_LOOK)
        mo  := true
        db  := cDispBd
        mb  := cMssBar
        dbr := dispBar2
        pid := anyId
    [pr, tg, psl, ti, hp, fr, rtq, rqv, rk, tc, rv, mc, mo, db, mb, dbr, pid, zid, fvgE, poiE]

// ---- LONG candidate selection, best rank first ------------------------------
[prodL, tagL, prodSlL, tierL, htfPoiL, freshL, retQL, rqL, rkindL, touchL, revL, mssChL, mssOkL, dispBdL, mssBL, dispBL, poolIdL, poiIdL, fvgBotL, poiBotL] = f_prod(true, machLong, upS, sdCandLong, confGateLong, sdTierL, sdZoneL, sdBotLong, pa1Long, pa2Long, paSlLong, anyLoExt, anyLoRq, anyLoKind, anyLoPool, anyLoId, htfIsRevLong, iChUpBar, cDispBdL, cMssBarL, dispUpBar2)

// ---- SHORT candidate selection ----------------------------------------------
[prodS, tagS, prodSlS, tierS, htfPoiS, freshS, retQS, rqS, rkindS, touchS, revS, mssChS, mssOkS, dispBdS, mssBS, dispBS, poolIdS, poiIdS, fvgTopS, poiTopS] = f_prod(false, machShort, dnS, sdCandShort, confGateShort, sdTierS, sdZoneS, sdTopShort, pa1Short, pa2Short, paSlShort, anyHiExt, anyHiRq, anyHiKind, anyHiPool, anyHiId, htfIsRevShort, iChDnBar, cDispBdS, cMssBarS, dispDnBar2)

// ---- V5.5-E · WHOSE EVENT IS THIS? (§7 / §8 / E4) --------------------------
// v5.4 read upS.liqTag / upS.sbWindow for EVERY producer, so the operator-facing
// reason line named the machine setup's raid — usually blank or stale — on all
// five non-machine entries. Everything the reason, the label, the dashboard and
// the descriptor bonus need is resolved here, from the object that actually
// produced the candidate: the pool the MACHINE bound, or the live raid on that
// side for every other producer.
descNL = prodL <= PR_MACH ? f_poolDescN(upS.pool) : f_poolDescN(anyLoPool)
descNS = prodS <= PR_MACH ? f_poolDescN(dnS.pool) : f_poolDescN(anyHiPool)
descTL = prodL <= PR_MACH ? f_poolDesc(upS.pool)  : f_poolDesc(anyLoPool)
descTS = prodS <= PR_MACH ? f_poolDesc(dnS.pool)  : f_poolDesc(anyHiPool)
evTagL = prodL <= PR_MACH ? upS.liqTag : anyLoTag
evTagS = prodS <= PR_MACH ? dnS.liqTag : anyHiTag
evIdL  = prodL <= PR_MACH ? upS.liqId : anyLoId
evIdS  = prodS <= PR_MACH ? dnS.liqId : anyHiId
evPxL  = prodL <= PR_MACH ? f_poolPx(upS.pool) : anyLoPx
evPxS  = prodS <= PR_MACH ? f_poolPx(dnS.pool) : anyHiPx
sbWinL = prodL <= PR_MACH ? upS.sbWindow : sbActive
sbWinS = prodS <= PR_MACH ? dnS.sbWindow : sbActive

// ---- RISK FIRST (V4-BUG-12). Both sides are resolved unconditionally at top
//      level because Pine keeps tuple destructuring out of conditional scopes.
//      V5.4-D2: the ladder / room SCANS inside them only run when a producer
//      fired or on the last bar (dashboard / debug). okLong / okShort already
//      require prodX > 0, so a skipped bar's na values can gate nothing.
needRiskL = prodL > 0 or barstate.islast
needRiskS = prodS > 0 or barstate.islast
lvlProtL = nz(protLowI, protLowE)
// V5.5-E3 · NO CROSS-PRODUCER POI STOP. PR_SD already writes poiBotL from
// sdBotLong, so v5.4's `: sdBotLong` fallback could ONLY ever fire for a
// producer that has no POI at all (CRT / turtle soup / trap) — and it then handed
// f_sl an unrelated demand zone's edge as stop candidate 4, i.e. a stop sitting
// inside the level that invalidates a different thesis. A producer with no POI
// now simply has no POI candidate.
[slL, slSrcL, slOkL] = f_sl(1, close, prodL > 0 ? prodSlL : na, lvlProtL, fvgBotL, poiBotL)
riskL = math.max(math.abs(close - slL), syminfo.mintick)
[tp1L, tp2L, tp3L, tgtSrcL] = f_tp(needRiskL, 1, close, riskL)
oppL   = f_oppLiq(needRiskL, 1, close)
// na room = "nothing standing in the way", NOT 99.0 (v5's sentinel leaked into
// the debug panel as "opposing liquidity only 99.00R away").
roomL  = na(oppL) ? na : (oppL - close) / riskL
// V5.1-A5: RR is the PURE measured reward-to-risk to TP2. v5 folded the room
// check into it with math.min(rrRaw, room), which meant the documented soft mode
// (oppLiqHard = OFF) hard-blocked anyway whenever oppLiqMult <= rrB — and did it
// through the RR gate, so the debug panel reported the wrong reason. Room is a
// gate and a grade modifier now; it is not arithmetic on RR.
rrL    = (tp2L - close) / riskL

lvlProtS = nz(protHighI, protHighE)
[slS, slSrcS, slOkS] = f_sl(-1, close, prodS > 0 ? prodSlS : na, lvlProtS, fvgTopS, poiTopS)
riskS = math.max(math.abs(close - slS), syminfo.mintick)
[tp1S, tp2S, tp3S, tgtSrcS] = f_tp(needRiskS, -1, close, riskS)
oppS   = f_oppLiq(needRiskS, -1, close)
roomS  = na(oppS) ? na : (close - oppS) / riskS
rrS    = (close - tp2S) / riskS

// ---- V7.0 · the ingredients the machine OWNS, resolved per side -------------
// A non-machine producer has no impulse leg and no bound inducement, so it
// falls back to the chart-level readings — which is exactly what it is: a
// weaker statement, and it scores like one.
indHitL = prodL <= PR_MACH ? upS.induced : useInduce and indLoBar >= 0 and f_recent(indLoBar, induceLook)
indHitS = prodS <= PR_MACH ? dnS.induced : useInduce and indHiBar >= 0 and f_recent(indHiBar, induceLook)
// V7.1 · the OTE reading is a BAND CLASS now. A non-machine producer has no
// impulse leg of its own, so the chart reading enters at class 2 — fully
// tradable and fully scored, but never on its own the basis of an A+.
oteQL   = prodL <= PR_MACH ? upS.oteQ : inOTEbuy  ? 2 : 0
oteQS   = prodS <= PR_MACH ? dnS.oteQ : inOTEsell ? 2 : 0
// V7.1 · the remaining three ingredients are read exactly once each, so they are
// spelled at their call sites rather than named here:
//   §48 A+ needs an UNMITIGATED array — `prodX > PR_MACH or Xs.fvgTouches <= apMaxTouch`
//   §2  did this setup's own displacement leave the dealing range — `Xs.dispOutRng`
//   §15 an ELITE trap carries the machine's A+ privilege — `prodX == PR_TRAP and trapEl`

// ---- SOFT SCORE of the winning candidate of each side -----------------------
[ctxL, liqL, poiL, trgL, exeL, evL, scoreLong]  = f_score(1,  tierL, htfPoiL, freshL, retQL, zoneBullConf or bullPin, rqL, rkindL, touchL, revL, mssChL, mssOkL, dispBdL, mssBL, dispBL, cisdUpBar, sesStoryL, descNL, congested, indHitL, oteQL, atHtfPoiL, prodL <= PR_MACH and upS.dispOutRng)
[ctxS, liqS, poiS, trgS, exeS, evS, scoreShort] = f_score(-1, tierS, htfPoiS, freshS, retQS, zoneBearConf or bearPin, rqS, rkindS, touchS, revS, mssChS, mssOkS, dispBdS, mssBS, dispBS, cisdDnBar, sesStoryS, descNS, congested, indHitS, oteQS, atHtfPoiS, prodS <= PR_MACH and dnS.dispOutRng)

// ---- GRADE -------------------------------------------------------------------
gradeL = prodL == 0 ? GR_NONE : f_grade(prodL <= PR_MACH, narrLong,  tierL, rqL, revL, mssChL, rrL, roomL, congested, runFadeLong, oteQL, inDiscExt, prodL > PR_MACH or upS.fvgTouches <= apMaxTouch, prodL == PR_TRAP and trapEl)
gradeS = prodS == 0 ? GR_NONE : f_grade(prodS <= PR_MACH, narrShort, tierS, rqS, revS, mssChS, rrS, roomS, congested, runFadeShort, oteQS, inPremExt, prodS > PR_MACH or dnS.fvgTouches <= apMaxTouch, prodS == PR_TRAP and trapEl)
aPlusLong  = gradeL == GR_AP
aPlusShort = gradeS == GR_AP

// ---- HARD GATES (§16). A high score can never buy past any of these ---------
// hSl  — a stop exists INSIDE the risk clamp (V5.1-A4). v5 had no such gate.
// hTgt — TP2 came from a real level, not from rrMult (V5.1-A1).
// hRr  — the loosest floor only; the PER-GRADE floors are preconditions inside
//        f_grade, so testing them again here (against the already-downgraded
//        grade, as v5 did) could only ever loosen them.
hNarrL  = prodL > PR_MACH or narrLong
hTgtL   = tgtSrcL != 0
hRrL    = f_geq(rrL, rrB)
hRoomL  = not useOppLiq or not oppLiqHard or na(roomL) or roomL >= oppLiqMult
hDedupL = f_dedupeOk(1, poolIdL, poiIdL, mssBL, evPxL)
hTierL  = tierL <= minTier
hGradeL = gradeL >= f_grMin(minGrade)
hScoreL = minScore == 0 or scoreLong >= minScore
// V5.5-E4 / E5 · the two new hard gates. In "Downgrade" mode both are grade
// modifiers inside f_grade and these evaluate true; only "Block" makes them hard.
hCongL  = not congested or not congHard
hRunL   = not runFadeLong or runGate != "Block"
okLong  = prodL > 0 and baseLongOK and hNarrL and slOkL and hTgtL and hRrL and hRoomL and hDedupL and hTierL and hCongL and hRunL and hGradeL and hScoreL

hNarrS  = prodS > PR_MACH or narrShort
hTgtS   = tgtSrcS != 0
hRrS    = f_geq(rrS, rrB)
hRoomS  = not useOppLiq or not oppLiqHard or na(roomS) or roomS >= oppLiqMult
hDedupS = f_dedupeOk(-1, poolIdS, poiIdS, mssBS, evPxS)
hTierS  = tierS <= minTier
hGradeS = gradeS >= f_grMin(minGrade)
hScoreS = minScore == 0 or scoreShort >= minScore
hCongS  = not congested or not congHard
hRunS   = not runFadeShort or runGate != "Block"
okShort = prodS > 0 and baseShortOK and hNarrS and slOkS and hTgtS and hRrS and hRoomS and hDedupS and hTierS and hCongS and hRunS and hGradeS and hScoreS

// ---- direction arbitration: never both, never twice -------------------------
bool bothTie = okLong and okShort and prodL == prodS
finalLong  = okLong  and not bothTie and (not okShort or prodL < prodS)
finalShort = okShort and not bothTie and (not okLong  or prodS < prodL)

// ---- the exact reason an entry did NOT print, for the debug panel -----------
// V5.5-E8 · `go` short-circuits the whole chain. v5.4 rebuilt both of these
// strings — about twenty str.tostring calls and their concatenations — on EVERY
// historical bar, while the only consumer is the debug table on the last bar.
// Pine evaluates both branches of a ternary, so wrapping the CALL would not have
// skipped the work; the gate has to be inside, which is the same pattern Phase D
// used for the risk scanners.
f_blockReason(bool go, bool prodOk, string machBlk, bool narr, bool cdOk, bool baseOk, bool tier, int tierV, bool slOk, bool tgt, bool rr, float rrV, bool room, float roomV, bool dedup, bool grade, int g, bool rev, bool score, int scoreV, bool tie, bool cong, bool runF) =>
    not go      ? "" :
         not prodOk  ? (machBlk == "" ? "no producer" : machBlk) :
         not narr   ? "narrative integrity failed (causal order / ownership)" :
         not cdOk   ? "cooldown" :
         not dedup  ? "duplicate — this pool / POI / MSS already traded" :
         not baseOk ? "context filter (bias / KZ / volatility / SB / structure)" :
         not tier   ? "POI tier " + f_tierTxt(tierV) + " below the minimum" :
         not slOk   ? "no stop inside the risk clamp (" + str.tostring(minRiskN, "#.##") + "–" + str.tostring(maxRiskN, "#.##") + " ATR)" :
         not tgt    ? "no structural target ≥ " + str.tostring(rrB, "#.##") + "R away — TP2 would be synthetic" :
         not rr     ? "RR " + str.tostring(rrV, "#.##") + " below the absolute floor " + str.tostring(rrB, "#.##") :
         not room   ? "opposing liquidity only " + f_roomTxt(roomV) + " away" :
         not cong   ? "congestion — " + str.tostring(congN) + "/4 chop readings in the last " + str.tostring(congLen) + " bars" :
         not runF   ? "would fade an unexhausted liquidity run (" + str.tostring(run.legs) + " legs, " + f_rnTxt(run.cls) + ")" :
         not grade  ? (g == GR_NONE and rev ? "REVERSAL setup without a grade-A raid + tier-1 POI + CHoCH + a premium/discount extreme" :
              g == GR_NONE ? "no grade — insufficient evidence (raid quality / RR)" :
              "grade " + f_grTxt(g) + " below the minimum") :
         not score  ? "score " + str.tostring(scoreV) + " < " + str.tostring(minScore) :
         tie        ? "equal-rank conflict — both sides muted" : ""

dbgOn = showDebug and barstate.islast
blockLong  = finalLong  ? "" : f_blockReason(dbgOn, prodL > 0, blkLong,  hNarrL, longCdOK,  baseLongOK,  hTierL, tierL, slOkL, hTgtL, hRrL, rrL, hRoomL, roomL, hDedupL, hGradeL, gradeL, revL, hScoreL, scoreLong,  bothTie, hCongL, hRunL)
blockShort = finalShort ? "" : f_blockReason(dbgOn, prodS > 0, blkShort, hNarrS, shortCdOK, baseShortOK, hTierS, tierS, slOkS, hTgtS, hRrS, rrS, hRoomS, roomS, hDedupS, hGradeS, gradeS, revS, hScoreS, scoreShort, bothTie, hCongS, hRunS)

// ---- CONSUMPTION: state is spent only now, and only by the winner ----------
if finalLong
    lastLongSigBar := bar_index
    lastPoolIdL    := poolIdL
    lastPoiIdL     := poiIdL
    lastMssBarL    := mssBL
    lastPoolPxL    := evPxL      // V5.5-E7
    lastPoolBarL   := bar_index
    if prodL <= PR_MACH
        upS.st := ST_DEAD
        if not na(upS.pool)
            upS.pool.state := PS_DONE
            upS.pool.spent := true
        if not na(upS.poiZone)
            upS.poiZone.signaled := true
    else if prodL == PR_SD and not na(sdZoneL)
        sdZoneL.signaled := true
        box.set_bgcolor(sdZoneL.bx, color.new(COL_BULL, 95))
    else if prodL == PR_TRAP
        wState := 0
    if not na(anyLoPool) and prodL > PR_MACH and dedupePool
        anyLoPool.spent := true
if finalShort
    lastShortSigBar := bar_index
    lastPoolIdS     := poolIdS
    lastPoiIdS      := poiIdS
    lastMssBarS     := mssBS
    lastPoolPxS     := evPxS     // V5.5-E7
    lastPoolBarS    := bar_index
    if prodS <= PR_MACH
        dnS.st := ST_DEAD
        if not na(dnS.pool)
            dnS.pool.state := PS_DONE
            dnS.pool.spent := true
        if not na(dnS.poiZone)
            dnS.poiZone.signaled := true
    else if prodS == PR_SD and not na(sdZoneS)
        sdZoneS.signaled := true
        box.set_bgcolor(sdZoneS.bx, color.new(COL_BEAR, 95))
    else if prodS == PR_TRAP
        wState := 0
    if not na(anyHiPool) and prodS > PR_MACH and dedupePool
        anyHiPool.spent := true

// V5.2-B3 · A TRANSIENT block does not destroy the narrative. A machine setup
// that reached state 8 but was refused by cooldown / session / volatility /
// RR / room / target / grade / score / arbitration returns to state 7 and may
// retest again inside retestWin. PERMANENT verdicts stay terminal — failed
// narrative integrity and dedupe (this pool / POI / MSS already traded) leave
// the setup in state 8 for the state-9 cleanup to reset on the next bar, as
// before. The FVG lifecycle checks (traded-through, window) re-apply next bar.
if machLong and not finalLong and upS.st == ST_ENTRY and hNarrL and hDedupL
    upS.st        := ST_FVG
    upS.retestBar := na
    upS.retestQ   := 0
if machShort and not finalShort and dnS.st == ST_ENTRY and hNarrS and hDedupS
    dnS.st        := ST_FVG
    dnS.retestBar := na
    dnS.retestQ   := 0

// ---- §28 · ENTRY REASON CODE ------------------------------------------------
// One line an operator can read back: grade | what was raided and how well →
// what it reacted from → how it shifted → what it re-entered on → the RR.
f_reason(bool go, int dir, int prod, string tag, int g, int tier, bool htfPoi, string liqTag, int rq, float rr, int retQ, bool rev, bool sb, bool story, bool mssCh, int evId, string desc, bool cong, bool runF, bool idm, bool ote, int pa) =>
    bool isL = dir == 1
    string r = ""
    if go
        r := f_grTxt(g) + " | EVENT #" + str.tostring(evId) + " " + (isL ? "SSL" : "BSL") + " RAID " + f_rqTxt(rq) + (liqTag != "" ? " (" + liqTag + ")" : "")
        r += desc != "" ? " [" + desc + "]" : ""
        r += idm ? " · IDM taken" : ""
        r += " → " + (htfPoi ? "HTF " + htfTf + " POI" : prod <= PR_MACH ? f_paTxt(pa) : isL ? "DEMAND" : "SUPPLY") + " " + f_tierTxt(tier)
        r += " → " + (prod <= PR_MACH ? (mssCh ? "CHoCH" : "CISD") + " → DISP → FVG " + (retQ >= 3 ? "deep" : retQ == 2 ? "50%" : "touch") : tag)
        r += ote ? " → OTE" : ""
        r += " → " + str.tostring(rr, "#.##") + "R"
        r += rev ? " · REVERSAL" : ""
        r += story ? " · session story" : ""
        r += sb ? " · SB" : ""
        r += cong ? " · CONGESTED" : ""
        r += runF ? " · fading a run" : ""
    r

reasonLong  = f_reason(finalLong  and showReason, 1,  prodL, tagL, gradeL, tierL, htfPoiL, evTagL, rqL, rrL, retQL, revL, sbWinL, sesStoryL, mssChL, evIdL, descTL, congested, runFadeLong, indHitL, oteQL > 0, upS.poiPa)
reasonShort = f_reason(finalShort and showReason, -1, prodS, tagS, gradeS, tierS, htfPoiS, evTagS, rqS, rrS, retQS, revS, sbWinS, sesStoryS, mssChS, evIdS, descTS, congested, runFadeShort, indHitS, oteQS > 0, dnS.poiPa)

// ═══════════════════════════════════════ MODULE 16 · EMITTED RISK (ARCH-7)
// Every level was already resolved in MODULE 15, because the RR and the
// opposing-liquidity room are HARD GATES there. This module only selects the
// winning side's numbers for the drawing layer.
// ═════════════════════════════════════════════════════════════════════════════
sigDir   = finalLong ? 1 : finalShort ? -1 : 0
sigEntry = sigDir != 0 ? close : na
sigSL    = finalLong ? slL : finalShort ? slS : na
sigSlSrc = finalLong ? slSrcL : finalShort ? slSrcS : 0
sigTP1   = finalLong ? tp1L : finalShort ? tp1S : na
sigTP2   = finalLong ? tp2L : finalShort ? tp2S : na
sigTP3   = finalLong ? tp3L : finalShort ? tp3S : na

// ═══════════ MODULE 16B · ICT DETECTION + MARKING — REMOVED IN v5.8 ═══════════
// v5.8 compiled to 101 135 / 100 256 tokens (CE10117). Per the header's cut
// order, ICT-CUT-1/2/3 (the whole inline ICT module: inputs, IctM, f_ict) were
// deleted. The FULL ICT layer runs standalone as 10.ict-forensic-layer-v1.pine
// alongside this script — nothing is lost, and v5.7's inline module was the
// budget subset of that file anyway.
// ═════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════ MODULE 17 · VISUAL ENGINE
// Everything v2 drew is still drawn here. The one thing that changed is
// authority: no drawing in this module decides anything, and the only entry
// mark on the chart is the one the TRADE ENGINE emitted (Phase 28).
// ═════════════════════════════════════════════════════════════════════════════
// ---- key level plots ---------------------------------------------------------
plot(showLevels ? lastRes : na, "Resistance (last swing high)",
     color = color.new(COL_BEAR, 50), style = plot.style_linebr)
plot(showLevels ? lastSup : na, "Support (last swing low)",
     color = color.new(COL_BULL, 50), style = plot.style_linebr)
plot(showStruct and showProt ? protLowE : na, "Protected low (external)",
     color = color.new(COL_BULL, 15), style = plot.style_linebr, linewidth = 2)
plot(showStruct and showProt ? protHighE : na, "Protected high (external)",
     color = color.new(COL_BEAR, 15), style = plot.style_linebr, linewidth = 2)

// ---- liquidity / structure marks (confirmed bars only — no intrabar flicker)
plotchar(showSweeps and sslSweep, "Sell-side sweep", "◆", location.belowbar,
     color.new(COL_BULL, 0), size = size.tiny)
plotchar(showSweeps and bslSweep, "Buy-side sweep", "◆", location.abovebar,
     color.new(COL_BEAR, 0), size = size.tiny)
plotchar(showSweeps and eqlSwept, "EQL pool raided", "◈", location.belowbar,
     color.new(COL_BULL, 0), size = size.tiny)
plotchar(showSweeps and eqhSwept, "EQH pool raided", "◈", location.abovebar,
     color.new(COL_BEAR, 0), size = size.tiny)
plotchar(showSesHL and sesHiRaid, "Session high raided", "▿", location.abovebar,
     color.new(COL_BEAR, 15), size = size.tiny)
plotchar(showSesHL and sesLoRaid, "Session low raided", "▵", location.belowbar,
     color.new(COL_BULL, 15), size = size.tiny)
plotchar(showSesHL and sesHiBroke, "Session high broken", "⇡", location.abovebar,
     color.new(COL_BULL, 15), size = size.tiny)
plotchar(showSesHL and sesLoBroke, "Session low broken", "⇣", location.belowbar,
     color.new(COL_BEAR, 15), size = size.tiny)
// V5.6 · EXTERNAL liquidity raided (PDH / PDL / PWH / PWL / external swing).
// v5.5 marked swing sweeps, EQ pool raids and session raids but had no mark at
// all for the highest-priority liquidity on the chart.
plotchar(lqExtHiMark, "External BSL raided", "◇", location.abovebar,
     color.new(COL_BEAR, 0), size = size.tiny)
plotchar(lqExtLoMark, "External SSL raided", "◇", location.belowbar,
     color.new(COL_BULL, 0), size = size.tiny)
// the ONLY entry marks on the chart
plotchar(finalLong,  "TRADE ENGINE · LONG",  "▲", location.belowbar, COL_BULL, size = size.small)
plotchar(finalShort, "TRADE ENGINE · SHORT", "▼", location.abovebar, COL_BEAR, size = size.small)

// ---- session / volatility shading -------------------------------------------
bgcolor(paintKZ and timeframe.isintraday and inAsia ? color.new(color.purple, 95) : na, title = "Asia KZ")
bgcolor(paintKZ and timeframe.isintraday and inLon  ? color.new(color.blue,   94) : na, title = "London KZ")
bgcolor(paintKZ and timeframe.isintraday and inNY   ? color.new(color.orange, 94) : na, title = "NY AM KZ")
bgcolor(paintKZ and timeframe.isintraday and inSB   ? color.new(color.teal,   92) : na, title = "Silver Bullet KZ")
bgcolor(paintNews and timeframe.isintraday and inVol ? color.new(color.red,   90) : na, title = "Scheduled volatility window")

// ---- the single entry label --------------------------------------------------
// §42 · the label answers WHY: grade, engine, POI tier, raid grade, the session
// the trade belongs to, and then the full causal line from f_reason.
sesTag = not timeframe.isintraday ? "" : inSB ? " · SB" : inNY ? " · NY" : inLon ? " · LONDON" : inAsia ? " · ASIA" : ""
if finalLong
    string t = f_grTxt(gradeL) + " LONG " + str.tostring(scoreLong) + " · " + str.tostring(rrL, "#.#") + "R\n" + tagL + " · " +
         f_tierTxt(tierL) + " · raid " + f_rqTxt(rqL) + (revL ? " · REV" : "") + sesTag
    if showReason
        t := t + "\n" + reasonLong
    f_chip(true, t, color.new(COL_BULL, uiTrans), color.white, sigSize)
if finalShort
    string t2 = f_grTxt(gradeS) + " SHORT " + str.tostring(scoreShort) + " · " + str.tostring(rrS, "#.#") + "R\n" + tagS + " · " +
         f_tierTxt(tierS) + " · raid " + f_rqTxt(rqS) + (revS ? " · REV" : "") + sesTag
    if showReason
        t2 := t2 + "\n" + reasonShort
    f_chip(false, t2, color.new(COL_BEAR, uiTrans), color.white, sigSize)

// ---- developing-setup preview (ARCH-9): dim, no state, no alert -------------
var label devLb = na
if showDev
    label.delete(devLb)
    bool devL = devBar and upS.st == ST_FVG and low  <= upS.fvgTop
    bool devS = devBar and dnS.st == ST_FVG and high >= dnS.fvgBot
    if devL or devS
        devLb := f_chip(devL, "⋯", color.new(devL ? COL_BULL : COL_BEAR, 75), color.new(color.white, 25), size.tiny)

// ---- entry / SL / TP of the last emitted signal ------------------------------
// V5.6-L12 · five identical line + label pairs, held in two arrays and drawn by
// one helper. Same colours, same styles, same text as the ten named objects.
var tradeLns = array.new<line>()
var tradeLbs = array.new<label>()
f_tradeLvl(int x2, float y, color lc, string txt, color bg) =>
    array.push(tradeLns, line.new(bar_index, y, x2, y, color = lc, style = line.style_dashed))
    array.push(tradeLbs, label.new(x2, y, txt, style = label.style_label_left, color = bg, textcolor = color.white, size = infoSize))
    true

if showTrade and sigDir != 0
    while array.size(tradeLns) > 0
        line.delete(array.pop(tradeLns))
    while array.size(tradeLbs) > 0
        label.delete(array.pop(tradeLbs))
    int x2 = bar_index + TRADE_BARS
    color tpc = sigDir == 1 ? COL_BULL : COL_BEAR
    f_tradeLvl(x2, sigEntry, color.gray,          "E " + str.tostring(sigEntry, format.mintick), color.new(color.gray, 20))
    f_tradeLvl(x2, sigSL,    COL_BEAR,            "SL " + str.tostring(sigSL, format.mintick) + " · " + f_slTxt(sigSlSrc), color.new(COL_BEAR, 20))
    f_tradeLvl(x2, sigTP1,   color.new(tpc, 45),  "TP1 " + str.tostring(sigTP1, format.mintick), color.new(tpc, 45))
    f_tradeLvl(x2, sigTP2,   color.new(tpc, 20),  "TP2 " + str.tostring(sigTP2, format.mintick), color.new(tpc, 30))
    f_tradeLvl(x2, sigTP3,   tpc,                 "TP3 " + str.tostring(sigTP3, format.mintick), color.new(tpc, 15))

// ---- live HTF FVG POI boxes ---------------------------------------------------
var box hPoiBuyBx  = na
var box hPoiSellBx = na
if barstate.islast
    box.delete(hPoiBuyBx)
    box.delete(hPoiSellBx)
    if showPoi and not na(hPoiBTop)
        hPoiBuyBx := box.new(bar_index - 10, hPoiBTop, bar_index + TRADE_BARS, hPoiBBot,
             border_color = color.new(COL_BULL, 50), bgcolor = color.new(COL_BULL, 95),
             border_style = line.style_dashed,
             text = "HTF " + htfTf + " demand POI" + (nz(hPoiBIn) == 0 ? " · fresh" : " · tested ×" + str.tostring(nz(hPoiBIn))),
             text_size = size.small, text_color = color.new(COL_BULL, 0), text_halign = text.align_right)
    if showPoi and not na(hPoiSTop)
        hPoiSellBx := box.new(bar_index - 10, hPoiSTop, bar_index + TRADE_BARS, hPoiSBot,
             border_color = color.new(COL_BEAR, 50), bgcolor = color.new(COL_BEAR, 95),
             border_style = line.style_dashed,
             text = "HTF " + htfTf + " supply POI" + (nz(hPoiSIn) == 0 ? " · fresh" : " · tested ×" + str.tostring(nz(hPoiSIn))),
             text_size = size.small, text_color = color.new(COL_BEAR, 0), text_halign = text.align_right)

// ---- the machine's LOCKED execution FVG (state 7) ----------------------------
var box machFvgBxL = na
var box machFvgBxS = na
if barstate.islast
    box.delete(machFvgBxL)
    box.delete(machFvgBxS)
    if upS.st == ST_FVG and not na(upS.fvgTop)
        machFvgBxL := box.new(upS.fvgBar, upS.fvgTop, bar_index + TRADE_BARS, upS.fvgBot,
             border_color = color.new(COL_BULL, 35), bgcolor = color.new(COL_BULL, 92),
             text = "◎ FVG · retest", text_size = size.small,
             text_color = color.new(COL_BULL, 0), text_halign = text.align_right)
    if dnS.st == ST_FVG and not na(dnS.fvgTop)
        machFvgBxS := box.new(dnS.fvgBar, dnS.fvgTop, bar_index + TRADE_BARS, dnS.fvgBot,
             border_color = color.new(COL_BEAR, 35), bgcolor = color.new(COL_BEAR, 92),
             text = "◎ FVG · retest", text_size = size.small,
             text_color = color.new(COL_BEAR, 0), text_halign = text.align_right)

// ---- LIQUIDITY INTENT labels: what price is hunting next ---------------------
var label tgtBuyLb  = na
var label tgtSellLb = na
if barstate.islast
    label.delete(tgtBuyLb)
    label.delete(tgtSellLb)
    if showPools and not na(tgtBuy)
        tgtBuyLb := label.new(bar_index + 3 * TRADE_BARS, tgtBuy, "◂ target BSL " + tgtBuyTag,
             style = label.style_label_left, color = color.new(COL_BEAR, 55),
             textcolor = color.white, size = infoSize)
    if showPools and not na(tgtSell)
        tgtSellLb := label.new(bar_index + 3 * TRADE_BARS, tgtSell, "◂ target SSL " + tgtSellTag,
             style = label.style_label_left, color = color.new(COL_BULL, 55),
             textcolor = color.white, size = infoSize)

// ---- order-flow areas: premium / discount halves of the dealing range --------
var box flowDisc = na
var box flowPrem = na
if barstate.islast
    box.delete(flowDisc)
    box.delete(flowPrem)
    if showFlow and rangeOK
        int fx1 = math.min(nz(rngLoBar, bar_index - 20), nz(rngHiBar, bar_index - 20))
        int fx2 = bar_index + TRADE_BARS
        bool buySide  = structDir == 1
        bool sellSide = structDir == -1
        flowDisc := box.new(fx1, eqLvl, fx2, rngLo,
             border_color = color.new(COL_BULL, buySide ? 65 : 88),
             bgcolor      = color.new(COL_BULL, buySide ? 94 : 97),
             border_style = line.style_dotted,
             text = "DISCOUNT", text_size = size.small,
             text_color = color.new(COL_BULL, buySide ? 10 : 45),
             text_halign = text.align_right, text_valign = text.align_bottom)
        flowPrem := box.new(fx1, rngHi, fx2, eqLvl,
             border_color = color.new(COL_BEAR, sellSide ? 65 : 88),
             bgcolor      = color.new(COL_BEAR, sellSide ? 94 : 97),
             border_style = line.style_dotted,
             text = "PREMIUM", text_size = size.small,
             text_color = color.new(COL_BEAR, sellSide ? 10 : 45),
             text_halign = text.align_right, text_valign = text.align_top)

// ---- dealing range EQ + OTE box ----------------------------------------------
var box   oteBox = na
var line  eqLine = na
var label oteLb  = na
if barstate.islast
    box.delete(oteBox)
    line.delete(eqLine)
    label.delete(oteLb)
    bool drawBuyOte  = structDir == 1  and bullRange
    bool drawSellOte = structDir == -1 and bearRange
    if showRange and (drawBuyOte or drawSellOte)
        int rx1 = bar_index - 20
        int rx2 = bar_index + TRADE_BARS
        eqLine := line.new(rx1, eqLvl, rx2, eqLvl,
             color = color.new(color.gray, 40), style = line.style_dashed)
        float oTop = drawBuyOte ? oteBuyTop : oteSellTop
        float oBot = drawBuyOte ? oteBuyBot : oteSellBot
        color oc   = drawBuyOte ? COL_BULL : COL_BEAR
        oteBox := box.new(rx1, oTop, rx2, oBot,
             border_color = color.new(oc, 45), bgcolor = color.new(oc, 92),
             border_style = line.style_dotted)
        oteLb := label.new(rx2 + 2 * TRADE_BARS, (oTop + oBot) / 2,
             drawBuyOte ? "OTE buy" : "OTE sell",
             style = label.style_label_left, color = color.new(oc, 60),
             textcolor = color.white, size = infoSize)

// ---- extend live zone drawings ONCE, on the last bar -------------------------
if barstate.islast and array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        box.set_right(z.bx, bar_index + 1)
        line.set_x2(z.mid, bar_index + 1)

// ---- NEXT buy / sell POI labels + highlight ---------------------------------
var label nextBuyLb  = na
var label nextSellLb = na
if barstate.islast
    label.delete(nextBuyLb)
    label.delete(nextSellLb)
    if showNext and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            float t = box.get_top(z.bx)
            float b = box.get_bottom(z.bx)
            bool isNext = (not z.isSupply and t == nbTop and b == nbBot) or (z.isSupply and t == nsTop and b == nsBot)
            box.set_border_width(z.bx, isNext ? 2 : 1)
    if showNext and not na(nbTop)
        string nbDist = close <= nbTop ? "inside" : str.tostring((close - nbTop) / close * 100, "#.##") + "% below"
        nextBuyLb := label.new(bar_index + TRADE_BARS, (nbTop + nbBot) / 2,
             "NEXT BUY " + f_tierTxt(nbTier) + " ▸ " + str.tostring(nbBot, format.mintick) + "–" + str.tostring(nbTop, format.mintick) + " (" + nbDist + ")",
             style = label.style_label_left, color = color.new(COL_BULL, 40),
             textcolor = color.white, size = infoSize)
    if showNext and not na(nsBot)
        string nsDist = close >= nsBot ? "inside" : str.tostring((nsBot - close) / close * 100, "#.##") + "% above"
        nextSellLb := label.new(bar_index + TRADE_BARS, (nsTop + nsBot) / 2,
             "NEXT SELL " + f_tierTxt(nsTier) + " ▸ " + str.tostring(nsBot, format.mintick) + "–" + str.tostring(nsTop, format.mintick) + " (" + nsDist + ")",
             style = label.style_label_left, color = color.new(COL_BEAR, 40),
             textcolor = color.white, size = infoSize)

// ══════════════════════════════════════════════ MODULE 18 · DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
f_biasTxt(int b) => b > 0 ? "▲ Bull" : b < 0 ? "▼ Bear" : "—"
f_biasCol(int b) => b > 0 ? color.new(COL_BULL, 75) : b < 0 ? color.new(COL_BEAR, 75) : color.new(color.gray, 75)
f_layers(int c, int l, int p, int t, int e, int v) =>
    "C" + str.tostring(c) + " L" + str.tostring(l) + " P" + str.tostring(p) + " T" + str.tostring(t) +
         " E" + str.tostring(e) + " D" + str.tostring(v)
f_stTxt(int st) =>
    st == ST_NONE ? "0 idle" : st == ST_CTX ? "1 HTF ctx" : st == ST_TGT ? "2 target" :
         st == ST_RAID ? "3 raided" : st == ST_POI ? "4 POI" : st == ST_MSS ? "5 MSS" :
         st == ST_DISP ? "6 disp" : st == ST_FVG ? "7 FVG" : st == ST_ENTRY ? "8 ENTRY" : "9 spent"
f_prodTxt(int p) =>
    p == PR_FEM ? "FEM" : p == PR_MACH ? "Sweep+POI+MSS" : p == PR_SD ? "S/D retest" :
         p == PR_TRAP ? "Trap engine" : "—"

var table dash = table.new(position.top_right, 2, 26,
     border_color = color.new(color.gray, 70), border_width = 1)
hdrBg  = color.new(color.gray, 60)
rowBg  = color.new(color.gray, 85)

// V5.6-L12 · one dashboard row = label cell + value cell. Every row below used
// to spell both table.cell calls out in full; same cells, same arguments.
f_dRow(int r, string lbl, string val, color bg, string sz, string tip) =>
    table.cell(dash, 0, r, lbl, text_size = dashSize, bgcolor = rowBg, text_color = color.white, tooltip = tip)
    table.cell(dash, 1, r, val, bgcolor = bg, text_color = color.white, text_size = sz)
    true

if showDash and barstate.islast
    int freshDZ = 0
    int freshSZ = 0
    int t1Cnt  = 0
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.tier == 1
                t1Cnt += 1
            if z.state == 0
                if z.isSupply
                    freshSZ += 1
                else
                    freshDZ += 1
    int livePools = 0
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if p.state <= PS_VAL
                livePools += 1
    table.cell(dash, 0, 0, "TF",   bgcolor = hdrBg, text_color = color.white, text_size = dashSize)
    table.cell(dash, 1, 0, "Bias", bgcolor = hdrBg, text_color = color.white, text_size = dashSize)
    f_dRow(1, "5m",  f_biasTxt(b5),   f_biasCol(b5),   dashSize, "")
    f_dRow(2, "15m", f_biasTxt(b15),  f_biasCol(b15),  dashSize, "")
    f_dRow(3, "1H",  f_biasTxt(b60),  f_biasCol(b60),  dashSize, "")
    f_dRow(4, "4H",  f_biasTxt(b240), f_biasCol(b240), dashSize, "")
    f_dRow(5, "1D",  f_biasTxt(bD),   f_biasCol(bD),   dashSize, "")
    f_dRow(6, "HTF ctx " + htfCtxTf, f_biasTxt(htfDir) + (na(htfPd) ? "" : "  " + str.tostring(htfPd * 100, "#") + "%") + "  · " + htfTf + " struct " + f_biasTxt(hStrDir), f_biasCol(htfDir), dashSize,
         "§6 / §25 · the HTF hierarchy. LEFT: the context timeframe's closed EMA bias and where price sits in its HTF dealing range. RIGHT: the EXTERNAL structural direction of the marking HTF, taken from its own confirmed pivots. An LTF internal shift can never overturn either of these — it only decides execution timing.")
    f_dRow(7, "Zones", "fresh D:" + str.tostring(freshDZ) + " S:" + str.tostring(freshSZ) + " · T1:" + str.tostring(t1Cnt), rowBg, dashSize, "")
    string sweepTxt = (sslInPlay ? "SSL✓" + (sslStrong ? "★ " : " ") : "") + (bslInPlay ? "BSL✓" + (bslStrong ? "★" : "") : "")
    f_dRow(8, "Raid in play", sweepTxt == "" ? "none" : sweepTxt, rowBg, dashSize, "")
    f_dRow(9, "Liq targets", (na(tgtSell) ? "—" : str.tostring(tgtSell, format.mintick) + " " + tgtSellTag) + " / " +
         (na(tgtBuy) ? "—" : str.tostring(tgtBuy, format.mintick) + " " + tgtBuyTag) + "  (" + str.tostring(livePools) + ")", rowBg, dashSize2,
         "What price is hunting next: nearest un-raided pool on each side, plus the number of live pools tracked.")
    string nbTxt = na(nbTop) ? "none" : str.tostring(nbBot, format.mintick) + "–" + str.tostring(nbTop, format.mintick) + " " + f_tierTxt(nbTier)
    string nsTxt = na(nsBot) ? "none" : str.tostring(nsBot, format.mintick) + "–" + str.tostring(nsTop, format.mintick) + " " + f_tierTxt(nsTier)
    f_dRow(10, "Next buy",  nbTxt, color.new(COL_BULL, 80), dashSize, "")
    f_dRow(11, "Next sell", nsTxt, color.new(COL_BEAR, 80), dashSize, "")
    string structTxt = "int " + (msDir > 0 ? "▲" : msDir < 0 ? "▼" : "—") + " · ext " + (extDir > 0 ? "▲" : extDir < 0 ? "▼" : "—")
    f_dRow(12, "Structure", structTxt, f_biasCol(extDir), dashSize, "")
    string pdTxt = na(pdPos) ? "—" : (pdPos >= 0.5 ? "Premium " : "Discount ") + str.tostring(pdPos * 100, "#") + "%"
    f_dRow(13, "Range pos", pdTxt, rowBg, dashSize, "")
    string kzTxt = not timeframe.isintraday ? "—" : inSB ? "Silver Bullet" : inNY ? "NY AM" : inLon ? "London" : inAsia ? "Asia" : "off-hours"
    f_dRow(14, "Killzone", kzTxt, inSB ? color.new(color.teal, 60) : rowBg, dashSize, "")
    // V5.5-E · the three lifecycles, per side, in the slot the trendline row used
    string lcTxt = "TWS " + f_lcTxt(twsUp.st) + "/" + f_lcTxt(twsDn.st) + " · AMD " + amdTxt + " · " + f_rgTxt(regime)
    f_dRow(15, "TWS · AMD · regime", lcTxt, twsUp.st == LC_CONF ? color.new(COL_BULL, 70) :
         twsDn.st == LC_CONF ? color.new(COL_BEAR, 70) : rowBg, dashSize2,
         "LEFT: the three-wave sequence per side (idle / wave1 / wave2 / CONF). TWS is CONTEXT — it can never emit.\nMIDDLE: the session's accumulation / manipulation / distribution phase (§39). MANIP means this killzone has taken the previous session's liquidity and is the Judas leg.\nRIGHT: the market regime read from price action alone (§36) — TREND / RANGE / EXPANSION / CHOP. CHOP costs a grade, or blocks, per the congestion setting.")

    string volTxt = not timeframe.isintraday ? "—" : inVol ? "⚠ WINDOW" : "clear"
    f_dRow(16, "Volatility win", volTxt, inVol and timeframe.isintraday ? color.new(color.red, 60) : rowBg, dashSize,
         "SCHEDULED volatility window (fixed clock slots) — this is not a live economic calendar.")
    f_dRow(17, "◎ Machine", "L " + f_stTxt(upS.st) + " · S " + f_stTxt(dnS.st),
         upS.st >= ST_MSS ? color.new(COL_BULL, 60) : dnS.st >= ST_MSS ? color.new(COL_BEAR, 60) : rowBg, dashSize,
         "State machine per direction: 0 idle → 1 HTF context → 2 liquidity target → 3 raided → 4 POI → 5 MSS → 6 displacement → 7 FVG locked → 8 ENTRY.")
    string doTxt = not timeframe.isintraday or na(midOpen) ? "—" : close >= midOpen ? "above 00:00 ▲" : "below 00:00 ▼"
    color  doBg  = not timeframe.isintraday or na(midOpen) ? rowBg : close >= midOpen ? color.new(COL_BULL, 75) : color.new(COL_BEAR, 75)
    f_dRow(18, "Day open", doTxt, doBg, dashSize, "")
    color scBg = aPlusLong ? color.new(COL_BULL, 45) : aPlusShort ? color.new(COL_BEAR, 45) : rowBg
    f_dRow(19, "Alignment", "L:" + str.tostring(scoreLong) + "  S:" + str.tostring(scoreShort) + (aPlusLong ? "  A+▲" : aPlusShort ? "  A+▼" : ""), scBg, dashSize,
         "Narrative alignment 0–100 — NOT a win probability, and it is SOFT: it ranks candidates that have already passed every hard gate. Context 25 · Liquidity 25 · POI 20 · Trigger 20 · Execution 10, every ingredient taken from the setup's own owned events. A+ needs the complete owned narrative in chronological order, a grade-A raid, a LIVE tier-1 POI, a CHoCH-grade shift if it is fighting the HTF, and the A+ RR floor — a high score alone never qualifies.")
    f_dRow(20, "Layers", "L " + f_layers(ctxL, liqL, poiL, trgL, exeL, evL) + "\nS " + f_layers(ctxS, liqS, poiS, trgS, exeS, evS), rowBg, dashSize2, "")
    f_dRow(21, "Grade · RR", "L " + f_grTxt(gradeL) + " " + str.tostring(rrL, "#.#") + "R  ·  S " + f_grTxt(gradeS) + " " + str.tostring(rrS, "#.#") + "R",
         gradeL == GR_AP ? color.new(COL_BULL, 45) : gradeS == GR_AP ? color.new(COL_BEAR, 45) : rowBg, dashSize,
         "Grade of the CURRENT candidate on each side and its REALISTIC reward-to-risk: the TP2 of the liquidity ladder, clamped by the distance to the nearest meaningful opposing liquidity, because a target behind an un-raided pool is not a target. RR is a HARD gate — A+ needs the A+ floor, A the A floor, everything else the B floor.")
    f_dRow(22, "Opposing liq", "L " + (na(roomL) ? "clear" : str.tostring(roomL, "#.#") + "R") + "  ·  S " + (na(roomS) ? "clear" : str.tostring(roomS, "#.#") + "R"),
         (roomL < oppLiqMult or roomS < oppLiqMult) and useOppLiq ? color.new(color.orange, 65) : rowBg, dashSize,
         "Distance to the nearest opposing pool or opposing POI, measured in units of the trade's own risk. Under the configured multiple the setup is downgraded, or blocked if the hard-block option is on.")
    // ── V5.5-E · §34 · THE EVENT, AND WHY THE TRADE EXISTS ───────────────────
    f_dRow(23, "Event", "L " + (evIdL == 0 ? "—" : "#" + str.tostring(evIdL) + " " + evTagL + " " + f_rqTxt(rqL)) +
         "  ·  S " + (evIdS == 0 ? "—" : "#" + str.tostring(evIdS) + " " + evTagS + " " + f_rqTxt(rqS)), rowBg, dashSize2,
         "V5.5-E §7 · the identity of the physical liquidity event each side is built on: its pool id, what the level was, and the graded raid. ONE event, one id — every engine that recognises it is a DESCRIPTOR of it, never an extra confirmation.")
    f_dRow(24, "Descriptors", "L " + (descTL == "" ? "—" : descTL) + "  ·  S " + (descTS == "" ? "—" : descTS), rowBg, dashSize2,
         "V5.5-E §8 · every engine that describes the SAME event. They are worth ONE capped bonus of at most 6 points between them and they can never pay a liquidity point, however many of them fire.")
    f_dRow(25, "Run · congestion", (run.dir == 0 ? "no run" : (run.dir == 1 ? "▲ " : "▼ ") + f_rnTxt(run.cls) + " " + str.tostring(run.legs) + " leg" + (run.intToExt ? " int→ext" : "")) +
         "  ·  chop " + str.tostring(congN) + "/4" + (congested ? " ⚠" : ""),
         congested ? color.new(color.orange, 65) : run.cls == RN_CONT ? color.new(color.yellow, 75) : rowBg, dashSize2,
         "V5.5-E4 / E5 · the liquidity-run classification (none / 1 leg / RUN / exhausted / REVERSED) with its direction and leg count, and the congestion reading out of four. Fading a RUN, and trading inside congestion, each cost one grade — or are blocked outright, depending on the two gate settings.")

// ═══════════════════════════════════════ MODULE 19 · DEBUG PANEL (§27)
// Rows 1–9 are the state machine per direction. With verbose debug on, rows
// 10–19 print the OWNERSHIP trace — setup id, which pool was locked as the
// target, which pool was actually raided and how well, which POI, which shift,
// which expansion, which gap, and every one of their bars — followed by the
// narrative verdict, the grade and the risk numbers. The last row is the exact
// gate that stopped the trade. Between them they answer "why did nothing
// print?" and "why did THAT print?" without guesswork.
// ═════════════════════════════════════════════════════════════════════════════
dbgPosition = dbgPos == "Bottom right" ? position.bottom_right : dbgPos == "Bottom left" ? position.bottom_left :
     dbgPos == "Middle right" ? position.middle_right : position.top_left
var table dbg = table.new(dbgPosition, 3, 23, border_color = color.new(color.gray, 70), border_width = 1)

f_dbgTxt(int r, string lbl, string lTxt, string sTxt) =>
    table.cell(dbg, 0, r, lbl, text_size = dbgSize, bgcolor = rowBg, text_color = color.white, text_halign = text.align_left)
    table.cell(dbg, 1, r, lTxt, text_size = dbgSize, bgcolor = rowBg, text_color = color.new(color.white, 10), text_halign = text.align_left)
    table.cell(dbg, 2, r, sTxt, text_size = dbgSize, bgcolor = rowBg, text_color = color.new(color.white, 10), text_halign = text.align_left)
    true

f_barTxt(int b) => na(b) ? "—" : str.tostring(bar_index - b) + " ago"

f_dbgRow(int r, string lbl, bool okL, bool okS) =>
    table.cell(dbg, 0, r, lbl, text_size = dbgSize, bgcolor = rowBg, text_color = color.white, text_halign = text.align_left)
    table.cell(dbg, 1, r, f_tick(okL), text_size = dbgSize, text_color = okL ? COL_BULL : color.new(color.white, 40),
         bgcolor = okL ? color.new(COL_BULL, 82) : rowBg)
    table.cell(dbg, 2, r, f_tick(okS), text_size = dbgSize, text_color = okS ? COL_BEAR : color.new(color.white, 40),
         bgcolor = okS ? color.new(COL_BEAR, 82) : rowBg)
    true

if showDebug and barstate.islast
    table.cell(dbg, 0, 0, "SETUP STATE", bgcolor = hdrBg, text_color = color.white, text_size = dbgSize)
    table.cell(dbg, 1, 0, "LONG",  bgcolor = color.new(COL_BULL, 55), text_color = color.white, text_size = dbgSize)
    table.cell(dbg, 2, 0, "SHORT", bgcolor = color.new(COL_BEAR, 55), text_color = color.white, text_size = dbgSize)
    f_dbgRow(1, "1 HTF CONTEXT",  upS.st >= ST_CTX,   dnS.st >= ST_CTX)
    f_dbgRow(2, "2 LIQ TARGET",   upS.st >= ST_TGT,   dnS.st >= ST_TGT)
    f_dbgRow(3, "3 SWEEP/RAID",   upS.st >= ST_RAID,  dnS.st >= ST_RAID)
    f_dbgRow(4, "4 POI",          upS.st >= ST_POI,   dnS.st >= ST_POI)
    f_dbgRow(5, "5 MSS/CHoCH",    upS.st >= ST_MSS,   dnS.st >= ST_MSS)
    f_dbgRow(6, "6 DISPLACEMENT", upS.st >= ST_DISP,  dnS.st >= ST_DISP)
    f_dbgRow(7, "7 FVG LOCKED",   upS.st >= ST_FVG,   dnS.st >= ST_FVG)
    f_dbgRow(8, "8 RETEST/ENTRY", upS.st >= ST_ENTRY, dnS.st >= ST_ENTRY)
    f_dbgRow(9, "9 EMITTED",      finalLong,          finalShort)
    if dbgVerbose
        f_dbgTxt(10, "setup id",  str.tostring(upS.id), str.tostring(dnS.id))
        f_dbgTxt(11, "target",    (upS.tgtId == 0 ? "—" : "#" + str.tostring(upS.tgtId) + " " + upS.tgtTag + " " + f_barTxt(upS.tgtBar)),
             (dnS.tgtId == 0 ? "—" : "#" + str.tostring(dnS.tgtId) + " " + dnS.tgtTag + " " + f_barTxt(dnS.tgtBar)))
        f_dbgTxt(12, "raid",      (upS.liqId == 0 ? "—" : "#" + str.tostring(upS.liqId) + " " + upS.liqTag + " " + f_rqTxt(upS.liqQual) + " " + f_barTxt(upS.liqBar)),
             (dnS.liqId == 0 ? "—" : "#" + str.tostring(dnS.liqId) + " " + dnS.liqTag + " " + f_rqTxt(dnS.liqQual) + " " + f_barTxt(dnS.liqBar)))
        f_dbgTxt(13, "POI · array", (na(upS.poiBar) ? "—" : (upS.poiIsHtf ? "HTF" : "#" + str.tostring(upS.poiId) + " " + f_paTxt(upS.poiPa)) + " " + f_tierTxt(upS.poiTier) + " " + f_barTxt(upS.poiBar)),
             (na(dnS.poiBar) ? "—" : (dnS.poiIsHtf ? "HTF" : "#" + str.tostring(dnS.poiId) + " " + f_paTxt(dnS.poiPa)) + " " + f_tierTxt(dnS.poiTier) + " " + f_barTxt(dnS.poiBar)))
        f_dbgTxt(14, "MSS",       (na(upS.mssBar) ? "—" : (upS.mssChoch ? "CHoCH " : "CISD ") + f_barTxt(upS.mssBar)),
             (na(dnS.mssBar) ? "—" : (dnS.mssChoch ? "CHoCH " : "CISD ") + f_barTxt(dnS.mssBar)))
        f_dbgTxt(15, "disp",      (na(upS.dispBar) ? "—" : str.tostring(nz(upS.dispBody), "#.##") + "×ATR " + f_barTxt(upS.dispBar)),
             (na(dnS.dispBar) ? "—" : str.tostring(nz(dnS.dispBody), "#.##") + "×ATR " + f_barTxt(dnS.dispBar)))
        // §44 / §48 · the gap, its OTE verdict, the inducement and the timing
        f_dbgTxt(16, "FVG · OTE · IDM", (na(upS.fvgBar) ? "—" : str.tostring(nz(upS.fvgH) / atr, "#.##") + "×ATR " + f_barTxt(upS.fvgBar) + " · " + str.tostring(upS.oteQ) + "/" + str.tostring(upS.fvgTouches) + " · " + f_tick(upS.induced) + " · " + f_tmTxt(upS.st < ST_FVG ? TM_PREM : upS.fvgTouch >= 0 and bar_index - upS.fvgTouch > lateBars ? TM_LATE : TM_VALID)),
             (na(dnS.fvgBar) ? "—" : str.tostring(nz(dnS.fvgH) / atr, "#.##") + "×ATR " + f_barTxt(dnS.fvgBar) + " · " + str.tostring(dnS.oteQ) + "/" + str.tostring(dnS.fvgTouches) + " · " + f_tick(dnS.induced) + " · " + f_tmTxt(dnS.st < ST_FVG ? TM_PREM : dnS.fvgTouch >= 0 and bar_index - dnS.fvgTouch > lateBars ? TM_LATE : TM_VALID)))
        f_dbgTxt(17, "narrative", (narrLong ? "✓ owned + in order" : "✗") + (upS.reversal ? " · REVERSAL" : ""),
             (narrShort ? "✓ owned + in order" : "✗") + (dnS.reversal ? " · REVERSAL" : ""))
        f_dbgTxt(18, "producer",  (prodL == 0 ? "—" : f_prodTxt(prodL) + " " + f_grTxt(gradeL) + " " + f_tierTxt(tierL) + " raid " + f_rqTxt(rqL)),
             (prodS == 0 ? "—" : f_prodTxt(prodS) + " " + f_grTxt(gradeS) + " " + f_tierTxt(tierS) + " raid " + f_rqTxt(rqS)))
        f_dbgTxt(19, "RR · room · score", str.tostring(rrL, "#.##") + "R · " + f_roomTxt(roomL) + " · " + str.tostring(scoreLong),
             str.tostring(rrS, "#.##") + "R · " + f_roomTxt(roomS) + " · " + str.tostring(scoreShort))
        // V5.5-E · the descriptor trace: which engines called this ONE event, and
        // what the capped allowance paid for all of them together
        f_dbgTxt(20, "event · desc",
             (evIdL == 0 ? "—" : "#" + str.tostring(evIdL) + " " + (descTL == "" ? "—" : descTL) + " D" + str.tostring(evL)),
             (evIdS == 0 ? "—" : "#" + str.tostring(evIdS) + " " + (descTS == "" ? "—" : descTS) + " D" + str.tostring(evS)))
        f_dbgTxt(21, "run · chop",
             (runFadeLong  ? "✗ fades " : "") + f_rnTxt(run.cls) + " " + str.tostring(run.legs) + "L · " + str.tostring(congN) + "/4",
             (runFadeShort ? "✗ fades " : "") + f_rnTxt(run.cls) + " " + str.tostring(run.legs) + "L · " + str.tostring(congN) + "/4")
    table.cell(dbg, 0, 22, "BLOCKED", text_size = dbgSize, bgcolor = hdrBg, text_color = color.white, text_halign = text.align_left)
    table.cell(dbg, 1, 22, blockLong  == "" ? "—" : blockLong,  text_size = dbgSize, bgcolor = rowBg,
         text_color = color.new(color.white, 10), text_halign = text.align_left)
    table.cell(dbg, 2, 22, blockShort == "" ? "—" : blockShort, text_size = dbgSize, bgcolor = rowBg,
         text_color = color.new(color.white, 10), text_halign = text.align_left)

// ══════════════════════════════════════════════════ MODULE 20 · ALERTS
// Every v2 alert NAME is preserved so existing alerts keep working, but the
// [SIGNAL] conditions now come from the TRADE ENGINE, so one bar can no longer
// fire eleven of them at once (BUG-14). Names carry the decision layer:
//   [SIGNAL] an entry was emitted · [TRIG] structure / delivery event
//   [LIQ] liquidity taken · [POI] a POI / machine state changed
//   [CTX] context window. Use "Once per bar close".
// ═════════════════════════════════════════════════════════════════════════════
// machine-state edges need a shadow of last bar's state (a UDT field has no
// history operator), updated at the very end of the script
var int upStPrev = 0
var int dnStPrev = 0
machPoiNew = (upS.st == ST_POI  and upStPrev != ST_POI)  or (dnS.st == ST_POI  and dnStPrev != ST_POI)
machMssNew = (upS.st == ST_MSS  and upStPrev != ST_MSS)  or (dnS.st == ST_MSS  and dnStPrev != ST_MSS)
machFvgNew = (upS.st == ST_FVG  and upStPrev != ST_FVG)  or (dnS.st == ST_FVG  and dnStPrev != ST_FVG)

emitFem  = (finalLong and prodL == PR_FEM)  or (finalShort and prodS == PR_FEM)
emitMach = (finalLong and prodL == PR_MACH) or (finalShort and prodS == PR_MACH)
emitSD   = (finalLong and prodL == PR_SD)   or (finalShort and prodS == PR_SD)
emitPA1  = (finalLong and prodL == PR_TRAP and pa1Long) or (finalShort and prodS == PR_TRAP and pa1Short)
emitPA2  = (finalLong and prodL == PR_TRAP and pa2Long) or (finalShort and prodS == PR_TRAP and pa2Short)
trapConf = pa1Long or pa1Short

// -- [SIGNAL] entries (the TRADE ENGINE is the only source)
alertcondition(finalLong and aPlusLong,        "[SIGNAL] A+ LONG (all 5 layers)",  "A+ LONG — HTF context → liquidity target → raid → POI → MSS → displacement → FVG → retest on {{ticker}} {{interval}}")
alertcondition(finalShort and aPlusShort,      "[SIGNAL] A+ SHORT (all 5 layers)", "A+ SHORT — HTF context → liquidity target → raid → POI → MSS → displacement → FVG → retest on {{ticker}} {{interval}}")
alertcondition(finalLong and gradeL == GR_A,    "[SIGNAL] A LONG",                  "A LONG — owned narrative, graded raid, PD array, MSS, displacement, FVG retest on {{ticker}} {{interval}}")
alertcondition(finalShort and gradeS == GR_A,  "[SIGNAL] A SHORT",                 "A SHORT — owned narrative, graded raid, PD array, MSS, displacement, FVG retest on {{ticker}} {{interval}}")
alertcondition(finalLong and scoreLong >= 80,  "[SIGNAL] ★ 80+ alignment LONG",    "High-alignment (80+) LONG on {{ticker}} {{interval}} — alignment, NOT win probability")
alertcondition(finalShort and scoreShort >= 80, "[SIGNAL] ★ 80+ alignment SHORT",  "High-alignment (80+) SHORT on {{ticker}} {{interval}} — alignment, NOT win probability")
alertcondition(finalLong,                      "[SIGNAL] Any LONG",                "LONG signal on {{ticker}} {{interval}}")
alertcondition(finalShort,                     "[SIGNAL] Any SHORT",               "SHORT signal on {{ticker}} {{interval}}")
alertcondition(emitFem,                        "[SIGNAL] ◎ Fractal entry model",   "FEM executed (HTF POI → raid → LTF MSS → displacement → LTF FVG retest) on {{ticker}} {{interval}}")
alertcondition(emitMach,                       "[SIGNAL] ★ Sweep + Zone entry",    "Sweep + POI + MSS narrative entry on {{ticker}} {{interval}}")
alertcondition(emitSD,                         "[SIGNAL] S/D zone 50% entry",      "Supply/Demand 50% retest entry on {{ticker}} {{interval}}")
alertcondition(emitPA1,                        "[SIGNAL] ① Breakout Rejection Trap", "① Breakout Rejection Trap entry on {{ticker}} {{interval}}")
alertcondition(emitPA2,                        "[SIGNAL] ② Pin Bar Liquidity Trap", "② Pin Bar Liquidity Trap entry on {{ticker}} {{interval}}")
// -- [TRIG] structure / delivery events (information, not entries)
alertcondition(eChochUp or eChochDn,           "[TRIG] External CHoCH",            "EXTERNAL CHoCH — protected swing broken with displacement on {{ticker}} {{interval}}")
alertcondition(eBosUp or eBosDn,               "[TRIG] External BOS",              "EXTERNAL BOS on {{ticker}} {{interval}}")
alertcondition(chochUp or chochDn,               "[TRIG] Internal CHoCH",            "Internal CHoCH — the protected swing broke with displacement on {{ticker}} {{interval}}")
alertcondition(bosUp or bosDn,                 "[TRIG] Internal BOS",              "Internal BOS — trend continuation break on {{ticker}} {{interval}}")
alertcondition(cisdUp or cisdDn,                "[TRIG] CISD",                      "Change in state of delivery — order-flow flip, NOT a structure shift on {{ticker}} {{interval}}")
alertcondition(mssBull or mssBear,             "[TRIG] MSS",                       "MSS — a CHoCH, or a CISD carrying displacement on {{ticker}} {{interval}}")
alertcondition((ifcBull or ifcBear) and confirmed, "[TRIG] IFC candle",            "IFC candle (pool taken + displacement close) on {{ticker}} {{interval}}")
// -- V5.5-E · the new lifecycle engines. STATE TRANSITIONS, one per event (§35)
alertcondition(twsConfL or twsConfS,           "[TRIG] TWS three-wave confirmed",  "TWS three-wave sequence CONFIRMED (interaction, deeper manipulation, reclaim + displacement) on {{ticker}} {{interval}} — context only, not an entry")
alertcondition(trapConf,                       "[TRIG] Trap confirmed",            "TRAP CONFIRMED — obvious liquidity broken, breakout failed, level reclaimed on {{ticker}} {{interval}}")
alertcondition(runFresh and run.cls == RN_CONT, "[LIQ] Liquidity run",             "LIQUIDITY RUN — a second liquidity pool broken in the same direction on {{ticker}} {{interval}}; fading it is gated until it exhausts")
// -- [LIQ] liquidity events
alertcondition(eqhSwept or eqlSwept,           "[LIQ] EQH/EQL pool swept",         "Equal highs/lows pool RAIDED on {{ticker}} {{interval}}")
alertcondition(sesHiRaid or sesLoRaid,         "[LIQ] Session high/low raided",    "Session level RAIDED (taken, closed back inside) on {{ticker}} {{interval}}")
alertcondition(sesHiBroke or sesLoBroke,       "[LIQ] Session high/low broken",    "Session level BROKEN (close beyond — expansion) on {{ticker}} {{interval}}")
alertcondition(poolRaids > 0,                  "[LIQ] Liquidity pool raided",      "A tracked liquidity pool was RAIDED on {{ticker}} {{interval}}")
// -- [POI] POI / machine state
alertcondition(touchNextBuy,                   "[POI] Price entered next BUY zone",  "Price entered the next BUY (demand) POI on {{ticker}} {{interval}}")
alertcondition(touchNextSell,                  "[POI] Price entered next SELL zone", "Price entered the next SELL (supply) POI on {{ticker}} {{interval}}")
alertcondition(machPoiNew,                     "[POI] FEM: HTF POI tapped",        "Setup reached state 4 — POI confirmed at the raid, awaiting the LTF MSS on {{ticker}} {{interval}}")
alertcondition(machMssNew,                     "[POI] FEM: LTF shift confirmed",   "Setup reached state 5 — LTF MSS / CHoCH confirmed, awaiting displacement on {{ticker}} {{interval}}")
alertcondition(machFvgNew,                     "[POI] FEM: LTF FVG locked",        "Setup reached state 7 — execution FVG locked, awaiting its retest on {{ticker}} {{interval}}")
// -- [CTX] context windows
alertcondition(inVol and not inVol[1],         "[CTX] Volatility window started",  "Scheduled volatility window started on {{ticker}} — entries suppressed")
alertcondition(not inVol and inVol[1],         "[CTX] Volatility window ended",    "Scheduled volatility window ended on {{ticker}} — entries re-enabled")

// shadow update: LAST statement in the script, after every consumer above
if confirmed
    upStPrev := upS.st
    dnStPrev := dnS.st
