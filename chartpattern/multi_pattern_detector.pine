// =====================================================================================================================
//  INSTITUTIONAL-GRADE MULTI-PATTERN CHART DETECTOR  —  Pine Script v6
// =====================================================================================================================
//  Author : Quant Pattern Engine
//  Purpose: Non-repainting, multi-timeframe geometric + candlestick chart-pattern detection with validation,
//           0–100 confidence scoring, automatic trade-setup generation (entry/SL/TP1-3, R:R), visualization and alerts.
//
//  DESIGN NOTES (read before editing):
//  --------------------------------------------------------------------------------------------------------------------
//  * NON-REPAINTING: All structure is built from CONFIRMED pivots only. ta.pivothigh/low return a value `legR` bars
//    after the pivot bar, so a detected pivot is already historically fixed and cannot repaint. Breakout confirmation
//    additionally requires `barstate.isconfirmed` (candle close). No `request.security(... lookahead_on)` is used.
//  * ENGINE: pivots -> ZigZag pivot sequence (alternating H/L) -> pattern detectors run over the last K pivots.
//    Detecting on a compact pivot array (not raw bars) keeps loops tiny and respects TradingView runtime limits.
//  * SCOPE: The source prompt lists 80+ named patterns. Many are aliases or sub-variants of the same geometry
//    (e.g. "Bullish Rectangle" == Rectangle resolved up). This engine implements the high-reliability, geometrically
//    distinct families and maps the named variants onto them. See KNOWN LIMITATIONS at end of file.
//  * PERFORMANCE: Object pools are capped (max_lines_count / max_labels_count / max_boxes_count) and old drawings are
//    deleted on each new detection to stay within limits.
// =====================================================================================================================

//@version=6
indicator("Multi-Pattern Detector [Institutional]", shorttitle="MPD", overlay=true, max_lines_count=300, max_labels_count=300, max_boxes_count=100)

// =====================================================================================================================
//  MODULE 1 — SETTINGS / INPUTS
// =====================================================================================================================
var string GRP_ENGINE  = "1 · Detection Engine"
var string GRP_VALID   = "2 · Validation"
var string GRP_SCORE   = "3 · Scoring & Filter"
var string GRP_TRADE   = "4 · Trade Setup"
var string GRP_VIS     = "5 · Visualization"
var string GRP_PATT    = "6 · Pattern Toggles"
var string GRP_SMC     = "7 · SMC / ICT Confluence"
var string GRP_ALERT   = "8 · Alerts"

// --- Engine ---------------------------------------------------------------------------------------------------------
pivotLeft     = input.int(5,  "Pivot left legs",   minval=1, maxval=50, group=GRP_ENGINE, tooltip="Bars to the LEFT used to confirm a swing pivot. Larger = fewer, more significant pivots.")
pivotRight    = input.int(5,  "Pivot right legs",  minval=1, maxval=50, group=GRP_ENGINE, tooltip="Bars to the RIGHT. A pivot confirms only after this many bars close -> non-repainting lag.")
maxPivots     = input.int(12, "Pivots tracked",    minval=6, maxval=30, group=GRP_ENGINE, tooltip="Length of the ZigZag pivot buffer the detectors scan.")
useHTF        = input.bool(false, "Use higher-timeframe pivots", group=GRP_ENGINE)
htfTF         = input.timeframe("60", "Higher timeframe", group=GRP_ENGINE)

// --- Validation -----------------------------------------------------------------------------------------------------
tolPct        = input.float(3.0, "Level tolerance %",        minval=0.1, maxval=15.0, step=0.1, group=GRP_VALID, tooltip="Max % difference for two swing levels to be treated as 'equal' (double/triple tops, rectangles).")
minBars       = input.int(10,  "Min bars per pattern",      minval=3,  maxval=200, group=GRP_VALID)
maxBars       = input.int(250, "Max bars per pattern",      minval=20, maxval=1000, group=GRP_VALID)
volMult       = input.float(1.3, "Breakout volume multiple", minval=1.0, maxval=5.0, step=0.1, group=GRP_VALID, tooltip="Breakout volume must exceed this multiple of average volume to count as confirmed.")
atrFilter     = input.float(1.0, "ATR noise filter (x)",    minval=0.0, maxval=5.0, step=0.1, group=GRP_VALID, tooltip="Minimum pattern height in ATR multiples. Filters tiny noise patterns.")
confirmBars   = input.int(1,   "Breakout confirm candles",  minval=1,  maxval=5, group=GRP_VALID)

// --- Scoring --------------------------------------------------------------------------------------------------------
minScore      = input.int(60, "Minimum confidence score", minval=0, maxval=100, group=GRP_SCORE, tooltip="Patterns scoring below this are not drawn/alerted.")
useTrendCtx   = input.bool(true, "Reward trend-aligned continuation", group=GRP_SCORE)

// --- Trade Setup ----------------------------------------------------------------------------------------------------
atrLen        = input.int(14, "ATR length", minval=1, group=GRP_TRADE)
slAtrMult     = input.float(1.0, "ATR stop multiple", minval=0.1, step=0.1, group=GRP_TRADE)
useMeasured   = input.bool(true, "Measured-move targets", group=GRP_TRADE, tooltip="TP from pattern height projection. If off, uses R-multiples.")
tp1R          = input.float(1.0, "TP1 (R)", minval=0.1, step=0.1, group=GRP_TRADE)
tp2R          = input.float(2.0, "TP2 (R)", minval=0.1, step=0.1, group=GRP_TRADE)
tp3R          = input.float(3.0, "TP3 (R)", minval=0.1, step=0.1, group=GRP_TRADE)

// --- Visualization --------------------------------------------------------------------------------------------------
showPattern   = input.bool(true, "Pattern boundaries/lines", group=GRP_VIS)
showLabels    = input.bool(true, "Pattern labels",            group=GRP_VIS)
showTrade     = input.bool(true, "Entry / SL / TP lines",     group=GRP_VIS)
showDash      = input.bool(true, "Dashboard table",           group=GRP_VIS)
labelSize     = input.string("Normal", "Label size", options=["Small","Normal","Large"], group=GRP_VIS)
colBull       = input.color(color.new(#26a69a, 0), "Bullish", group=GRP_VIS)
colBear       = input.color(color.new(#ef5350, 0), "Bearish", group=GRP_VIS)
colNeutral    = input.color(color.new(#ffb300, 0), "Neutral", group=GRP_VIS)

// --- Pattern Toggles ------------------------------------------------------------------------------------------------
pDoubleTB     = input.bool(true, "Double Top / Bottom",        group=GRP_PATT)
pTripleTB     = input.bool(true, "Triple Top / Bottom",        group=GRP_PATT)
pHnS          = input.bool(true, "Head & Shoulders (+ Inv.)",  group=GRP_PATT)
pTriangle     = input.bool(true, "Triangles (Asc/Desc/Sym)",   group=GRP_PATT)
pWedge        = input.bool(true, "Wedges (Rising/Falling)",     group=GRP_PATT)
pChannel      = input.bool(true, "Channels",                    group=GRP_PATT)
pRect         = input.bool(true, "Rectangle / Range",           group=GRP_PATT)
pFlag         = input.bool(true, "Flags / Pennants",            group=GRP_PATT)
pCandle       = input.bool(true, "Candle triads (3 soldiers/crows)", group=GRP_PATT)
pRound        = input.bool(true, "Rounding Top / Bottom",       group=GRP_PATT)
pCup          = input.bool(true, "Cup & Handle (+ Inverse)",    group=GRP_PATT)
pDiamond      = input.bool(true, "Diamond Top / Bottom",        group=GRP_PATT)
roundBars     = input.int(40, "Rounding/Cup window (bars)", minval=12, maxval=200, group=GRP_PATT, tooltip="Lookback used by curvature-based detectors (Rounding, Cup & Handle).")

// --- SMC / ICT ------------------------------------------------------------------------------------------------------
useSMC        = input.bool(true,  "Enable SMC/ICT confluence", group=GRP_SMC, tooltip="Score and entry refinement using FVG, order blocks, liquidity sweeps, market structure (BOS), premium/discount and OTE.")
smcLen        = input.int(20, "Structure lookback (bars)", minval=5, maxval=200, group=GRP_SMC, tooltip="Window for swing high/low used by BOS, sweeps, premium/discount and OTE.")
minConfl      = input.int(0,  "Min confluences to allow", minval=0, maxval=5, group=GRP_SMC, tooltip="Reject a detected pattern unless it has at least this many SMC confluences. 0 = no gate (score boost only).")
conflBoost    = input.int(4,  "Score boost per confluence", minval=0, maxval=10, group=GRP_SMC)
useRetest     = input.bool(true,  "Conservative entry at SMC retest level", group=GRP_SMC, tooltip="Sets a second entry at the nearest FVG/OTE level instead of the breakout candle.")
showSMC       = input.bool(false, "Draw SMC zones (FVG + equilibrium)", group=GRP_SMC)

// --- Alerts ---------------------------------------------------------------------------------------------------------
alertOnDetect = input.bool(true, "Alert on detection", group=GRP_ALERT)

// =====================================================================================================================
//  MODULE 2 — UTILITY FUNCTIONS
// =====================================================================================================================
// Direction constants for readability.
var int DIR_BULL =  1
var int DIR_BEAR = -1
var int DIR_NEUT =  0

atr      = ta.atr(atrLen)
volAvg   = ta.sma(volume, 20)

labelSizeConst() =>
    switch labelSize
        "Small"  => size.small
        "Large"  => size.large
        => size.normal

// Percentage distance between two prices, relative to the larger magnitude. Used for "level equality" tests.
f_pctDiff(float a, float b) =>
    m = math.max(math.abs(a), math.abs(b))
    m == 0.0 ? 0.0 : math.abs(a - b) / m * 100.0

// True when two levels are within the user tolerance band.
f_near(float a, float b) =>
    f_pctDiff(a, b) <= tolPct

// Map a 0–100 score to a quality bucket string.
f_grade(float s) =>
    s >= 85 ? "Institutional" : s >= 70 ? "Strong" : s >= 50 ? "Moderate" : "Weak"

// Color for a direction.
f_dirColor(int dir) =>
    dir == DIR_BULL ? colBull : dir == DIR_BEAR ? colBear : colNeutral

// =====================================================================================================================
//  MODULE 3 — PIVOT ENGINE  (non-repainting source of structure)
// =====================================================================================================================
// We optionally pull pivots from a higher timeframe. request.security WITHOUT lookahead is non-repainting because the
// HTF value only updates on the HTF close.
phSrc = high
plSrc = low
if useHTF
    phSrc := request.security(syminfo.tickerid, htfTF, high, lookahead=barmerge.lookahead_off)
    plSrc := request.security(syminfo.tickerid, htfTF, low,  lookahead=barmerge.lookahead_off)

pivotHigh = ta.pivothigh(phSrc, pivotLeft, pivotRight)
pivotLow  = ta.pivotlow(plSrc,  pivotLeft, pivotRight)

// =====================================================================================================================
//  MODULE 4 — ZIGZAG ENGINE  (alternating pivot sequence)
// =====================================================================================================================
// We maintain three parallel arrays describing the confirmed pivot sequence:
//   zPrice : pivot price
//   zBar   : bar_index of the pivot
//   zType  : +1 for swing-high, -1 for swing-low
// Newest pivot is appended at the END. We enforce alternation: if the new pivot has the same type as the last stored
// one, we keep whichever is more extreme (merge) instead of storing two same-type pivots in a row.
var array<float> zPrice = array.new<float>()
var array<int>   zBar   = array.new<int>()
var array<int>   zType  = array.new<int>()

f_pushPivot(float price, int bar, int ptype) =>
    n = array.size(zType)
    if n > 0 and array.get(zType, n - 1) == ptype
        // Same type as previous -> merge, keeping the more extreme swing.
        prev = array.get(zPrice, n - 1)
        replace = ptype == DIR_BULL ? price > prev : price < prev
        if replace
            array.set(zPrice, n - 1, price)
            array.set(zBar,   n - 1, bar)
    else
        array.push(zPrice, price)
        array.push(zBar,   bar)
        array.push(zType,  ptype)
    // Trim buffer to maxPivots (drop oldest from the front).
    while array.size(zType) > maxPivots
        array.shift(zPrice)
        array.shift(zBar)
        array.shift(zType)

// The pivot, when confirmed, occurred `pivotRight` bars ago.
if not na(pivotHigh)
    f_pushPivot(pivotHigh, bar_index - pivotRight, DIR_BULL)
if not na(pivotLow)
    f_pushPivot(pivotLow, bar_index - pivotRight, DIR_BEAR)

// Convenience getters indexing from the END (0 = most recent pivot).
f_pP(int i) => // price
    n = array.size(zPrice)
    (i < n and i >= 0) ? array.get(zPrice, n - 1 - i) : na
f_pB(int i) => // bar
    n = array.size(zBar)
    (i < n and i >= 0) ? array.get(zBar, n - 1 - i) : na
f_pT(int i) => // type
    n = array.size(zType)
    (i < n and i >= 0) ? array.get(zType, n - 1 - i) : na

// =====================================================================================================================
//  MODULE 5 — PATTERN RESULT TYPE
// =====================================================================================================================
// A detected pattern is described by this record. Detectors return one (or na) per bar.
type Pattern
    string name
    int    dir          // DIR_BULL / DIR_BEAR / DIR_NEUT
    float  score        // 0..100
    float  neckline     // breakout / confirmation level
    float  height       // measured pattern height (for measured-move targets)
    int    startBar
    int    endBar
    float  hiBound      // upper boundary level (for boxes)
    float  loBound      // lower boundary level

// =====================================================================================================================
//  MODULE 6 — SCORING ENGINE
// =====================================================================================================================
// Composite 0–100 score. Each component is bounded then weighted. Components:
//   symmetry  : geometric symmetry quality (0..1)
//   volConf   : breakout volume confirmation (0..1)
//   breakout  : breakout candle strength vs ATR (0..1)
//   trendCtx  : alignment with prevailing trend (0..1)
//   sizeQual  : pattern size vs ATR noise floor (0..1)
f_score(float symmetry, float volConf, float breakout, float trendCtx, float sizeQual) =>
    s =  symmetry * 28.0
    s += volConf  * 22.0
    s += breakout * 20.0
    s += (useTrendCtx ? trendCtx : 0.5) * 15.0
    s += sizeQual * 15.0
    math.round(math.min(100.0, math.max(0.0, s)))

// Breakout volume confirmation factor (0..1).
f_volFactor() =>
    na(volume) or na(volAvg) or volAvg == 0 ? 0.5 : math.min(1.0, volume / (volAvg * volMult))

// Breakout candle body strength relative to ATR (0..1).
f_breakFactor() =>
    atr == 0 ? 0.5 : math.min(1.0, math.abs(close - open) / atr)

// Prevailing trend via EMA slope, returns DIR_*.
emaTrend = ta.ema(close, 50)
trendDir = emaTrend > emaTrend[5] ? DIR_BULL : emaTrend < emaTrend[5] ? DIR_BEAR : DIR_NEUT

f_trendFactor(int dir, bool continuation) =>
    // Continuation patterns reward trend alignment; reversal patterns reward counter-trend setup.
    aligned = continuation ? (dir == trendDir) : (dir != trendDir and trendDir != DIR_NEUT)
    aligned ? 1.0 : 0.4

f_sizeFactor(float height) =>
    atr == 0 ? 0.5 : math.min(1.0, height / (atr * math.max(atrFilter, 0.5)) / 3.0)

// =====================================================================================================================
//  MODULE 6.5 — SMC / ICT CONFLUENCE ENGINE
// =====================================================================================================================
// Smart Money Concepts / Inner Circle Trader confluences used to (a) confirm pattern direction, (b) boost the score,
// and (c) generate a conservative "retest" entry at an institutional level instead of the raw breakout candle.
//
//   * Premium / Discount : equilibrium = midpoint of the last `smcLen` range. Longs favored in discount (below eq),
//                          shorts in premium (above eq).
//   * Fair Value Gap     : 3-candle imbalance. Bullish FVG = low > high[2]; bearish FVG = high < low[2]. The gap zone
//                          is a magnet/retest level.
//   * Liquidity Sweep    : price runs the prior swing (stop hunt) then closes back inside -> displacement intent.
//   * Market Structure   : Break Of Structure. Close beyond the prior swing high/low sets the structural bias (BOS).
//   * Order Block (proxy): last opposing candle before the displacement that caused the BOS (its body is the OB zone).
//   * OTE (Optimal Trade Entry) : 0.62–0.79 retracement of the last swing — the ICT sniper entry band.
// All series below are computed every bar from confirmed data (no lookahead) so confluence is non-repainting.

smcSwH   = ta.highest(high, smcLen)
smcSwL   = ta.lowest(low,  smcLen)
smcEq    = (smcSwH + smcSwL) / 2.0
inDisc   = close < smcEq
inPrem   = close > smcEq

// Fair Value Gaps (most recent kept).
bullFVG  = low > high[2]
bearFVG  = high < low[2]
var float fvgTop = na
var float fvgBot = na
var int   fvgDir = 0
if bullFVG
    fvgTop := low
    fvgBot := high[2]
    fvgDir := DIR_BULL
if bearFVG
    fvgTop := low[2]
    fvgBot := high
    fvgDir := DIR_BEAR

// Liquidity sweeps of the prior swing.
prevSwH  = ta.highest(high, smcLen)[1]
prevSwL  = ta.lowest(low,  smcLen)[1]
sweepBull = low  < prevSwL and close > prevSwL
sweepBear = high > prevSwH and close < prevSwH

// Market structure (BOS) -> persistent structural bias.
var int structDir = 0
if close > prevSwH
    structDir := DIR_BULL
if close < prevSwL
    structDir := DIR_BEAR

// Order block proxy: body of the last opposing candle before a bullish/bearish close-through.
var float obBullHi = na
var float obBullLo = na
var float obBearHi = na
var float obBearLo = na
if close > prevSwH and close[1] < open[1]            // up-break preceded by a down candle
    obBullHi := high[1]
    obBullLo := low[1]
if close < prevSwL and close[1] > open[1]            // down-break preceded by an up candle
    obBearHi := high[1]
    obBearLo := low[1]

// OTE retracement bands (0.62–0.79 of the active swing).
smcRange   = smcSwH - smcSwL
oteBullHi  = smcSwH - smcRange * 0.62
oteBullLo  = smcSwH - smcRange * 0.79
oteBearLo  = smcSwL + smcRange * 0.62
oteBearHi  = smcSwL + smcRange * 0.79
inOteBull  = close <= oteBullHi and close >= oteBullLo
inOteBear  = close >= oteBearLo and close <= oteBearHi

// Confluence tally for a candidate direction. Returns [count, retestLevel, text].
f_smc(int dir) =>
    int    cnt = 0
    float  retest = na
    string txt = ""
    if dir == DIR_BULL
        if inDisc
            cnt += 1
            txt += "DISC "
        if fvgDir == DIR_BULL and not na(fvgTop)
            cnt += 1
            retest := fvgTop
            txt += "FVG "
        if not na(obBullHi)
            cnt += 1
            retest := na(retest) ? obBullHi : retest
            txt += "OB "
        if sweepBull
            cnt += 1
            txt += "SWEEP "
        if structDir == DIR_BULL
            cnt += 1
            txt += "BOS "
        if inOteBull
            cnt += 1
            retest := na(retest) ? oteBullHi : retest
            txt += "OTE "
    else if dir == DIR_BEAR
        if inPrem
            cnt += 1
            txt += "PREM "
        if fvgDir == DIR_BEAR and not na(fvgBot)
            cnt += 1
            retest := fvgBot
            txt += "FVG "
        if not na(obBearLo)
            cnt += 1
            retest := na(retest) ? obBearLo : retest
            txt += "OB "
        if sweepBear
            cnt += 1
            txt += "SWEEP "
        if structDir == DIR_BEAR
            cnt += 1
            txt += "BOS "
        if inOteBear
            cnt += 1
            retest := na(retest) ? oteBearLo : retest
            txt += "OTE "
    [cnt, retest, txt]

// =====================================================================================================================
//  MODULE 7 — PATTERN DETECTORS
//  Each detector inspects the most recent pivots (0 = newest) and returns a Pattern or na.
//  Detectors only fire on the bar a NEW pivot was confirmed (newPivot), preventing duplicate signals every bar.
// =====================================================================================================================
newPivot = not na(pivotHigh) or not na(pivotLow)

// Span validity: pattern bar-length within [minBars, maxBars] and height above ATR noise floor.
f_validSpan(int b0, int b1, float height) =>
    span = math.abs(b0 - b1)
    span >= minBars and span <= maxBars and (atrFilter == 0.0 or height >= atr * atrFilter)

// ---- 7.1 DOUBLE TOP / BOTTOM ---------------------------------------------------------------------------------------
// Geometry: two roughly-equal extremes (P2,P0) separated by a counter pivot (P1). Confirms on neckline break.
f_doubleTopBottom() =>
    Pattern p = na
    if pDoubleTB and array.size(zType) >= 3
        t0 = f_pT(0)
        t1 = f_pT(1)
        t2 = f_pT(2)
        p0 = f_pP(0)
        p1 = f_pP(1)
        p2 = f_pP(2)
        b0 = f_pB(0)
        b2 = f_pB(2)
        // Double TOP: high, low, high with the two highs ~equal.
        if t0 == DIR_BULL and t1 == DIR_BEAR and t2 == DIR_BULL and f_near(p0, p2)
            height = math.max(p0, p2) - p1
            if f_validSpan(b0, b2, height)
                symmetry = 1.0 - f_pctDiff(p0, p2) / tolPct
                sc = f_score(symmetry, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BEAR, false), f_sizeFactor(height))
                p := Pattern.new("Double Top", DIR_BEAR, sc, p1, height, b2, b0, math.max(p0,p2), p1)
        // Double BOTTOM: low, high, low with the two lows ~equal.
        if t0 == DIR_BEAR and t1 == DIR_BULL and t2 == DIR_BEAR and f_near(p0, p2)
            height = p1 - math.min(p0, p2)
            if f_validSpan(b0, b2, height)
                symmetry = 1.0 - f_pctDiff(p0, p2) / tolPct
                sc = f_score(symmetry, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BULL, false), f_sizeFactor(height))
                p := Pattern.new("Double Bottom", DIR_BULL, sc, p1, height, b2, b0, p1, math.min(p0,p2))
    p

// ---- 7.2 TRIPLE TOP / BOTTOM ---------------------------------------------------------------------------------------
f_tripleTopBottom() =>
    Pattern p = na
    if pTripleTB and array.size(zType) >= 5
        t0=f_pT(0)
        t2=f_pT(2)
        t4=f_pT(4)
        p0=f_pP(0)
        p1=f_pP(1)
        p2=f_pP(2)
        p3=f_pP(3)
        p4=f_pP(4)
        b0=f_pB(0)
        b4=f_pB(4)
        // Triple TOP: three ~equal highs (P0,P2,P4) with two troughs between.
        if t0==DIR_BULL and t2==DIR_BULL and t4==DIR_BULL and f_near(p0,p2) and f_near(p2,p4)
            neck = math.min(p1, p3)
            height = math.max(math.max(p0,p2),p4) - neck
            if f_validSpan(b0, b4, height)
                symmetry = 1.0 - (f_pctDiff(p0,p2)+f_pctDiff(p2,p4))/(2*tolPct)
                sc = f_score(symmetry, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BEAR,false), f_sizeFactor(height))
                p := Pattern.new("Triple Top", DIR_BEAR, sc, neck, height, b4, b0, math.max(math.max(p0,p2),p4), neck)
        if t0==DIR_BEAR and t2==DIR_BEAR and t4==DIR_BEAR and f_near(p0,p2) and f_near(p2,p4)
            neck = math.max(p1, p3)
            height = neck - math.min(math.min(p0,p2),p4)
            if f_validSpan(b0, b4, height)
                symmetry = 1.0 - (f_pctDiff(p0,p2)+f_pctDiff(p2,p4))/(2*tolPct)
                sc = f_score(symmetry, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BULL,false), f_sizeFactor(height))
                p := Pattern.new("Triple Bottom", DIR_BULL, sc, neck, height, b4, b0, neck, math.min(math.min(p0,p2),p4))
    p

// ---- 7.3 HEAD & SHOULDERS (+ INVERSE) ------------------------------------------------------------------------------
// Geometry over 5 pivots: shoulder, head (more extreme), shoulder, with neckline through the two intervening counters.
f_headShoulders() =>
    Pattern p = na
    if pHnS and array.size(zType) >= 5
        t0=f_pT(0)
        t2=f_pT(2)
        t4=f_pT(4)
        ls=f_pP(4)
        n1=f_pP(3)
        hd=f_pP(2)
        n2=f_pP(1)
        rs=f_pP(0)
        b0=f_pB(0)
        b4=f_pB(4)
        // Bearish H&S: highs at 0,2,4; head (P2) is the highest; shoulders ~equal.
        if t0==DIR_BULL and t2==DIR_BULL and t4==DIR_BULL and hd > ls and hd > rs and f_near(ls, rs)
            neck = (n1 + n2) / 2.0
            height = hd - neck
            if f_validSpan(b0, b4, height)
                symmetry = 1.0 - f_pctDiff(ls, rs)/tolPct
                sc = f_score(symmetry, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BEAR,false), f_sizeFactor(height))
                p := Pattern.new("Head & Shoulders", DIR_BEAR, sc, neck, height, b4, b0, hd, neck)
        // Bullish Inverse H&S: lows at 0,2,4; head (P2) is the lowest.
        if t0==DIR_BEAR and t2==DIR_BEAR and t4==DIR_BEAR and hd < ls and hd < rs and f_near(ls, rs)
            neck = (n1 + n2) / 2.0
            height = neck - hd
            if f_validSpan(b0, b4, height)
                symmetry = 1.0 - f_pctDiff(ls, rs)/tolPct
                sc = f_score(symmetry, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BULL,false), f_sizeFactor(height))
                p := Pattern.new("Inverse Head & Shoulders", DIR_BULL, sc, neck, height, b4, b0, neck, hd)
    p

// ---- 7.4 TRIANGLES / WEDGES / CHANNELS / RECTANGLES ----------------------------------------------------------------
// These share converging/diverging trendline geometry. We fit a line through the recent highs and one through the
// recent lows using the last few same-type pivots, then classify by slope signs and convergence.
// Highs: pivots of type +1 ; Lows: type -1. We grab the two most recent of each.
f_recentSameType(int ptype, int which) => // which: 0=most recent, 1=second most recent
    found = 0
    int   bb = na
    float pp = na
    n = array.size(zType)
    i = 0
    while i < n
        idx = n - 1 - i
        if array.get(zType, idx) == ptype
            if found == which
                bb := array.get(zBar, idx)
                pp := array.get(zPrice, idx)
                break
            found += 1
        i += 1
    [pp, bb]

f_slope(float p0, int b0, float p1, int b1) =>
    (b0 == b1) ? 0.0 : (p0 - p1) / (b0 - b1)

f_trianglesEtc() =>
    Pattern p = na
    [h0, hb0] = f_recentSameType(DIR_BULL, 0)
    [h1, hb1] = f_recentSameType(DIR_BULL, 1)
    [l0, lb0] = f_recentSameType(DIR_BEAR, 0)
    [l1, lb1] = f_recentSameType(DIR_BEAR, 1)
    if not na(h0) and not na(h1) and not na(l0) and not na(l1)
        upSlope = f_slope(h0, hb0, h1, hb1)   // slope of resistance line (highs)
        dnSlope = f_slope(l0, lb0, l1, lb1)   // slope of support line (lows)
        startB  = math.min(math.min(hb0,hb1), math.min(lb0,lb1))
        endB    = math.max(math.max(hb0,hb1), math.max(lb0,lb1))
        height  = math.max(h0,h1) - math.min(l0,l1)
        // Normalize slopes by ATR/bar to make sign tests robust.
        flatHi = math.abs(upSlope) < atr * 0.02
        flatLo = math.abs(dnSlope) < atr * 0.02
        converging = (upSlope < 0 and dnSlope > 0)
        diverging  = (upSlope > 0 and dnSlope < 0)
        if f_validSpan(startB, endB, height)
            symmetry = 0.7
            base = f_score(symmetry, f_volFactor(), f_breakFactor(), 0.6, f_sizeFactor(height))
            // Ascending triangle: flat highs + rising lows -> bullish continuation.
            if pTriangle and flatHi and dnSlope > 0 and not flatLo
                p := Pattern.new("Ascending Triangle", DIR_BULL, base, math.max(h0,h1), height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Descending triangle: falling highs + flat lows -> bearish continuation.
            else if pTriangle and flatLo and upSlope < 0 and not flatHi
                p := Pattern.new("Descending Triangle", DIR_BEAR, base, math.min(l0,l1), height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Symmetrical triangle: converging both -> bilateral.
            else if pTriangle and converging
                p := Pattern.new("Symmetrical Triangle", DIR_NEUT, base, close, height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Rising wedge: both lines rising, converging -> bearish reversal.
            else if pWedge and upSlope > 0 and dnSlope > 0 and dnSlope > upSlope
                p := Pattern.new("Rising Wedge", DIR_BEAR, base, math.min(l0,l1), height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Falling wedge: both lines falling, converging -> bullish reversal.
            else if pWedge and upSlope < 0 and dnSlope < 0 and upSlope < dnSlope
                p := Pattern.new("Falling Wedge", DIR_BULL, base, math.max(h0,h1), height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Channels: parallel slopes (same sign, similar magnitude).
            else if pChannel and math.sign(upSlope) == math.sign(dnSlope) and math.abs(upSlope - dnSlope) < atr * 0.02 and not flatHi
                dir = upSlope > 0 ? DIR_BULL : DIR_BEAR
                nm  = upSlope > 0 ? "Ascending Channel" : "Descending Channel"
                p := Pattern.new(nm, dir, base, close, height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Rectangle / range: both flat, roughly equal highs and lows.
            else if pRect and flatHi and flatLo and f_near(h0,h1) and f_near(l0,l1)
                p := Pattern.new("Rectangle / Range", DIR_NEUT, base, close, height, startB, endB, math.max(h0,h1), math.min(l0,l1))
            // Broadening / megaphone: diverging.
            else if pChannel and diverging
                p := Pattern.new("Broadening Formation", DIR_NEUT, base, close, height, startB, endB, math.max(h0,h1), math.min(l0,l1))
    p

// ---- 7.5 FLAGS / PENNANTS ------------------------------------------------------------------------------------------
// Flag = sharp impulse (pole) followed by a small counter-trend consolidation. We approximate: a large prior swing
// then a tight 3-pivot consolidation whose range is a fraction of the pole.
f_flags() =>
    Pattern p = na
    if pFlag and array.size(zType) >= 4
        p0=f_pP(0)
        p1=f_pP(1)
        p2=f_pP(2)
        p3=f_pP(3)
        b0=f_pB(0)
        b3=f_pB(3)
        pole   = math.abs(p3 - p2)
        consol = math.abs(p0 - p1)
        if pole > 0 and consol < pole * 0.5 and pole >= atr * atrFilter * 2.0
            // Direction = pole direction.
            dir = p2 < p3 ? DIR_BULL : DIR_BEAR
            nm  = dir == DIR_BULL ? "Bull Flag" : "Bear Flag"
            sc  = f_score(0.7, f_volFactor(), f_breakFactor(), f_trendFactor(dir, true), f_sizeFactor(pole))
            neck = dir == DIR_BULL ? math.max(p0,p1) : math.min(p0,p1)
            if f_validSpan(b0, b3, pole)
                p := Pattern.new(nm, dir, sc, neck, pole, b3, b0, math.max(p0,p1,p2,p3), math.min(p0,p1,p2,p3))
    p

// ---- 7.6 CANDLE TRIADS (Three White Soldiers / Three Black Crows) --------------------------------------------------
f_candleTriads() =>
    Pattern p = na
    if pCandle and barstate.isconfirmed
        bull3 = close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2] and (close-open) > atr*0.3
        bear3 = close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2] and (open-close) > atr*0.3
        if bull3
            h = high - low[2]
            sc = f_score(0.6, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BULL,true), f_sizeFactor(h))
            p := Pattern.new("Three White Soldiers", DIR_BULL, sc, low[2], h, bar_index-2, bar_index, high, low[2])
        else if bear3
            h = high[2] - low
            sc = f_score(0.6, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BEAR,true), f_sizeFactor(h))
            p := Pattern.new("Three Black Crows", DIR_BEAR, sc, high[2], h, bar_index-2, bar_index, high[2], low)
    p

// ---- 7.7 ROUNDING TOP / BOTTOM (curvature, window-based) -----------------------------------------------------------
// Rounding patterns are smooth arcs, not sharp pivots, so we read the raw price window instead of the zigzag buffer.
// Bottom: rims (window edges) ~equal and high, trough centered, sides descend-then-ascend gradually (quarter points
// sit between rim and trough). Top is the mirror image.
f_rounding() =>
    Pattern p = na
    N = roundBars
    if pRound and bar_index > N + 2
        q  = math.floor(N / 4)
        // --- Rounding BOTTOM ---
        rimL_b = (high[N-1] + high[N-2]) / 2.0
        rimR_b = (high[0]   + high[1])   / 2.0
        trough = ta.lowest(low, N)
        tBars  = -ta.lowestbars(low, N)            // 0 = current bar .. N-1 = oldest
        qL_b   = low[N - q]                         // near left rim
        qR_b   = low[q]                             // near right rim
        centeredB = tBars > N * 0.25 and tBars < N * 0.75
        heightB   = math.max(rimL_b, rimR_b) - trough
        gradualB  = qL_b > trough and qR_b > trough and qL_b < rimL_b and qR_b < rimR_b
        if pRound and centeredB and f_near(rimL_b, rimR_b) and heightB >= atr * atrFilter and gradualB
            sc = f_score(0.75, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BULL, false), f_sizeFactor(heightB))
            p := Pattern.new("Rounding Bottom", DIR_BULL, sc, math.max(rimL_b, rimR_b), heightB, bar_index - N, bar_index, math.max(rimL_b, rimR_b), trough)
        // --- Rounding TOP ---
        rimL_t = (low[N-1] + low[N-2]) / 2.0
        rimR_t = (low[0]   + low[1])   / 2.0
        peak   = ta.highest(high, N)
        pBars  = -ta.highestbars(high, N)
        qL_t   = high[N - q]
        qR_t   = high[q]
        centeredT = pBars > N * 0.25 and pBars < N * 0.75
        heightT   = peak - math.min(rimL_t, rimR_t)
        gradualT  = qL_t < peak and qR_t < peak and qL_t > rimL_t and qR_t > rimR_t
        if na(p) and centeredT and f_near(rimL_t, rimR_t) and heightT >= atr * atrFilter and gradualT
            sc = f_score(0.75, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BEAR, false), f_sizeFactor(heightT))
            p := Pattern.new("Rounding Top", DIR_BEAR, sc, math.min(rimL_t, rimR_t), heightT, bar_index - N, bar_index, peak, math.min(rimL_t, rimR_t))
    p

// ---- 7.8 CUP & HANDLE (+ INVERSE) ----------------------------------------------------------------------------------
// Cup = rounding bottom over [N..H] bars; Handle = small recent pullback in the last H bars that holds above the cup
// midpoint and stays below the right rim. Inverse mirrors for tops.
f_cupHandle() =>
    Pattern p = na
    H = math.max(3, math.floor(roundBars / 5))     // handle length
    N = roundBars
    if pCup and bar_index > N + H + 2
        // Cup portion shifted back by H bars (handle occupies the most recent H bars).
        rimL = (high[N+H-1] + high[N+H-2]) / 2.0
        rimR = (high[H]      + high[H+1])   / 2.0
        cupLow  = ta.lowest(low, N)[H]              // trough of the cup region
        cupH    = math.max(rimL, rimR) - cupLow
        // Handle: recent pullback contained in upper portion of the cup.
        hHigh = ta.highest(high, H)
        hLow  = ta.lowest(low, H)
        mid   = cupLow + cupH * 0.5
        cupOK = f_near(rimL, rimR) and cupH >= atr * atrFilter and cupLow < rimL and cupLow < rimR
        handleOK = hLow > mid and hHigh <= rimR * 1.01 and (hHigh - hLow) < cupH * 0.5
        if cupOK and handleOK
            sc = f_score(0.8, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BULL, true), f_sizeFactor(cupH))
            p := Pattern.new("Cup & Handle", DIR_BULL, sc, math.max(rimL, rimR), cupH, bar_index - N - H, bar_index, math.max(rimL, rimR), cupLow)
        // --- Inverse Cup & Handle (mirror) ---
        if na(p)
            irimL = (low[N+H-1] + low[N+H-2]) / 2.0
            irimR = (low[H]      + low[H+1])   / 2.0
            cupHi = ta.highest(high, N)[H]
            icupH = cupHi - math.min(irimL, irimR)
            ihHigh = ta.highest(high, H)
            ihLow  = ta.lowest(low, H)
            imid   = cupHi - icupH * 0.5
            icupOK = f_near(irimL, irimR) and icupH >= atr * atrFilter and cupHi > irimL and cupHi > irimR
            ihandleOK = ihHigh < imid and ihLow >= irimR * 0.99 and (ihHigh - ihLow) < icupH * 0.5
            if icupOK and ihandleOK
                sc = f_score(0.8, f_volFactor(), f_breakFactor(), f_trendFactor(DIR_BEAR, true), f_sizeFactor(icupH))
                p := Pattern.new("Inverse Cup & Handle", DIR_BEAR, sc, math.min(irimL, irimR), icupH, bar_index - N - H, bar_index, cupHi, math.min(irimL, irimR))
    p

// ---- 7.9 DIAMOND TOP / BOTTOM --------------------------------------------------------------------------------------
// Diamond = broadening phase (swing amplitude expanding) followed by a contracting phase (amplitude shrinking) -> the
// middle swing is the widest. Direction is taken from the prevailing trend (top after up-move, bottom after down).
f_diamond() =>
    Pattern p = na
    if pDiamond and array.size(zType) >= 6
        a0 = math.abs(f_pP(0) - f_pP(1))
        a1 = math.abs(f_pP(1) - f_pP(2))
        a2 = math.abs(f_pP(2) - f_pP(3))
        a3 = math.abs(f_pP(3) - f_pP(4))
        a4 = math.abs(f_pP(4) - f_pP(5))
        b0 = f_pB(0)
        b5 = f_pB(5)
        // Amplitude (oldest->newest): a4,a3,a2,a1,a0 — expand to a peak then contract. Peak at the middle (a2).
        expand   = a4 < a3 and a3 < a2
        contract = a2 > a1 and a1 > a0
        hi = math.max(math.max(f_pP(0), f_pP(1)), math.max(math.max(f_pP(2), f_pP(3)), math.max(f_pP(4), f_pP(5))))
        lo = math.min(math.min(f_pP(0), f_pP(1)), math.min(math.min(f_pP(2), f_pP(3)), math.min(f_pP(4), f_pP(5))))
        height = hi - lo
        if expand and contract and f_validSpan(b0, b5, height)
            dir = trendDir == DIR_BEAR ? DIR_BULL : DIR_BEAR     // diamond is a reversal of the prevailing move
            nm  = dir == DIR_BEAR ? "Diamond Top" : "Diamond Bottom"
            neck = dir == DIR_BEAR ? lo : hi
            sc  = f_score(0.7, f_volFactor(), f_breakFactor(), f_trendFactor(dir, false), f_sizeFactor(height))
            p := Pattern.new(nm, dir, sc, neck, height, b5, b0, hi, lo)
    p

// =====================================================================================================================
//  MODULE 8 — DETECTION DISPATCH
//  Run detectors; pick the highest-scoring valid pattern this bar that clears minScore.
// =====================================================================================================================
f_pick(Pattern best, Pattern cand) =>
    Pattern r = best
    if not na(cand) and cand.score >= minScore
        if na(best) or cand.score > best.score
            r := cand
    r

Pattern detected = na
if newPivot or barstate.isconfirmed
    detected := f_pick(detected, f_doubleTopBottom())
    detected := f_pick(detected, f_tripleTopBottom())
    detected := f_pick(detected, f_headShoulders())
    detected := f_pick(detected, f_trianglesEtc())
    detected := f_pick(detected, f_flags())
    detected := f_pick(detected, f_diamond())
    detected := f_pick(detected, f_candleTriads())
    detected := f_pick(detected, f_rounding())
    detected := f_pick(detected, f_cupHandle())

// --- SMC / ICT confluence gate + score boost ---
int    smcCnt    = 0
float  smcRetest = na
string smcTxt    = ""
if useSMC and not na(detected) and detected.dir != DIR_NEUT
    [c, r, t] = f_smc(detected.dir)
    smcCnt    := c
    smcRetest := r
    smcTxt    := t
    // Reject if it fails the confluence gate; otherwise boost the score by the confluence count.
    if smcCnt < minConfl
        detected := na
    else
        detected.score := math.min(100.0, detected.score + smcCnt * conflBoost)

hasPattern = not na(detected)

// =====================================================================================================================
//  MODULE 9 — TRADE SETUP GENERATION
// =====================================================================================================================
type Trade
    float entry        // aggressive (breakout) entry
    float retest       // conservative SMC/ICT retest entry (na if none)
    float sl
    float tp1
    float tp2
    float tp3
    float rr           // R:R to TP2
    int   confl        // SMC confluence count
    string conflTxt    // confluence tags (DISC/FVG/OB/SWEEP/BOS/OTE)

f_buildTrade(Pattern p, float smcRetest, int smcCnt, string smcTags) =>
    Trade t = na
    if not na(p) and p.dir != DIR_NEUT
        bull = p.dir == DIR_BULL
        entry = close
        // Conservative entry = SMC retest level if available and on the correct side of price.
        retest = float(na)
        if useRetest and not na(smcRetest)
            valid = bull ? smcRetest <= entry : smcRetest >= entry
            retest := valid ? smcRetest : na
        // Structure stop = pattern boundary; ATR stop = entry +/- ATR*mult; take the wider (safer).
        structSL = bull ? p.loBound : p.hiBound
        atrSL    = bull ? entry - atr*slAtrMult : entry + atr*slAtrMult
        sl = bull ? math.min(structSL, atrSL) : math.max(structSL, atrSL)
        risk = math.abs(entry - sl)
        // Measured-move primary target = breakout level +/- pattern height.
        mm = bull ? p.neckline + p.height : p.neckline - p.height
        tp1 = bull ? entry + risk*tp1R : entry - risk*tp1R
        tp2 = useMeasured ? mm : (bull ? entry + risk*tp2R : entry - risk*tp2R)
        tp3 = bull ? entry + risk*tp3R : entry - risk*tp3R
        rr  = risk == 0 ? 0.0 : math.abs(tp2 - entry) / risk
        t := Trade.new(entry, retest, sl, tp1, tp2, tp3, rr, smcCnt, smcTags)
    t

Trade trade = f_buildTrade(detected, smcRetest, smcCnt, smcTxt)

// =====================================================================================================================
//  MODULE 10 — VISUALIZATION ENGINE
// =====================================================================================================================
// We keep a rolling set of drawing objects and delete the previous detection's drawings before drawing the new one,
// so object counts stay bounded regardless of history length.
var box    pBox  = na
var line   neckLn = na
var label  pLab  = na
var line   slLn  = na
var line   e_Ln  = na
var line   t1Ln  = na
var line   t2Ln  = na
var line   rtLn  = na

f_clearDrawings() =>
    if not na(pBox)
        box.delete(pBox)
    if not na(neckLn)
        line.delete(neckLn)
    if not na(pLab)
        label.delete(pLab)
    if not na(slLn)
        line.delete(slLn)
    if not na(e_Ln)
        line.delete(e_Ln)
    if not na(t1Ln)
        line.delete(t1Ln)
    if not na(t2Ln)
        line.delete(t2Ln)
    if not na(rtLn)
        line.delete(rtLn)

if hasPattern and barstate.isconfirmed
    f_clearDrawings()
    col = f_dirColor(detected.dir)
    // --- Pattern boundary box ---
    if showPattern
        pBox := box.new(detected.startBar, detected.hiBound, detected.endBar, detected.loBound, border_color=col, bgcolor=color.new(col, 90), border_width=1)
        neckLn := line.new(detected.startBar, detected.neckline, bar_index + 5, detected.neckline, color=col, style=line.style_dashed, width=1)
    // --- Label ---
    if showLabels
        txt = detected.name + "  (" + str.tostring(detected.score, "#") + " · " + f_grade(detected.score) + ")"
        if not na(trade)
            txt += "\nE " + str.tostring(trade.entry, format.mintick) + "  SL " + str.tostring(trade.sl, format.mintick) + "  R:R " + str.tostring(trade.rr, "#.0#")
            if not na(trade.retest)
                txt += "\nRetest " + str.tostring(trade.retest, format.mintick)
            if useSMC and trade.confl > 0
                txt += "\nSMC " + str.tostring(trade.confl) + "x  " + trade.conflTxt
        labStyle = detected.dir == DIR_BEAR ? label.style_label_down : label.style_label_up
        labY     = detected.dir == DIR_BEAR ? detected.hiBound : detected.loBound
        pLab := label.new(detected.endBar, labY, txt, style=labStyle, color=col, textcolor=color.white, size=labelSizeConst())
    // --- Trade lines ---
    if showTrade and not na(trade)
        e_Ln := line.new(bar_index, trade.entry, bar_index + 8, trade.entry, color=color.new(color.blue, 0), width=1)
        slLn := line.new(bar_index, trade.sl,    bar_index + 8, trade.sl,    color=color.new(colBear, 0), style=line.style_dotted, width=1)
        t1Ln := line.new(bar_index, trade.tp1,   bar_index + 8, trade.tp1,   color=color.new(colBull, 30), style=line.style_dotted, width=1)
        t2Ln := line.new(bar_index, trade.tp2,   bar_index + 8, trade.tp2,   color=color.new(colBull, 0),  style=line.style_dotted, width=1)
        // Conservative SMC retest entry (institutional level).
        if not na(trade.retest)
            rtLn := line.new(bar_index, trade.retest, bar_index + 8, trade.retest, color=color.new(color.purple, 0), style=line.style_dashed, width=1)

// --- Optional SMC zone overlay (equilibrium + most recent FVG) ---
var line eqLn  = na
var box  fvgBx = na
if showSMC and barstate.isconfirmed
    if not na(eqLn)
        line.delete(eqLn)
    eqLn := line.new(bar_index - smcLen, smcEq, bar_index + 3, smcEq, color=color.new(color.gray, 30), style=line.style_dotted, width=1)
    if not na(fvgTop) and not na(fvgBot)
        if not na(fvgBx)
            box.delete(fvgBx)
        fvgCol = fvgDir == DIR_BULL ? colBull : colBear
        fvgBx := box.new(bar_index - 2, fvgTop, bar_index + 3, fvgBot, border_color=color.new(fvgCol, 40), bgcolor=color.new(fvgCol, 85), border_width=1)

// =====================================================================================================================
//  MODULE 11 — DASHBOARD
// =====================================================================================================================
// Helper declared at GLOBAL scope (Pine v6 forbids function defs inside local blocks).
f_row(table tbl, int r, string k, string v, color vc) =>
    table.cell(tbl, 0, r, k, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 20))
    table.cell(tbl, 1, r, v, text_color=vc, text_size=size.small, bgcolor=color.new(color.black, 40))

var table dash = na
if showDash and barstate.islast
    if na(dash)
        dash := table.new(position.top_right, 2, 9, border_width=1, frame_color=color.gray, frame_width=1)
    table.cell(dash, 0, 0, "MULTI-PATTERN", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.teal, 0))
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=color.white, text_size=size.small, bgcolor=color.new(color.teal, 0))
    if hasPattern
        f_row(dash, 1, "Pattern", detected.name, f_dirColor(detected.dir))
        f_row(dash, 2, "Direction", detected.dir==DIR_BULL?"Bullish":detected.dir==DIR_BEAR?"Bearish":"Neutral", f_dirColor(detected.dir))
        f_row(dash, 3, "Score", str.tostring(detected.score,"#") + " · " + f_grade(detected.score), f_dirColor(detected.dir))
        f_row(dash, 4, "Entry", na(trade)?"—":str.tostring(trade.entry, format.mintick), color.white)
        f_row(dash, 5, "Retest", (na(trade) or na(trade.retest))?"—":str.tostring(trade.retest, format.mintick), color.new(color.purple, 0))
        f_row(dash, 6, "Stop", na(trade)?"—":str.tostring(trade.sl, format.mintick), colBear)
        f_row(dash, 7, "R:R (TP2)", na(trade)?"—":str.tostring(trade.rr,"#.0#"), colBull)
        f_row(dash, 8, "SMC confl", (na(trade) or trade.confl==0)?"—":(str.tostring(trade.confl)+"x "+trade.conflTxt), f_dirColor(detected.dir))
    else
        f_row(dash, 1, "Pattern", "scanning…", color.gray)
        f_row(dash, 2, "Trend", trendDir==DIR_BULL?"Up":trendDir==DIR_BEAR?"Down":"Flat", f_dirColor(trendDir))
        f_row(dash, 3, "Structure", structDir==DIR_BULL?"Bullish BOS":structDir==DIR_BEAR?"Bearish BOS":"—", f_dirColor(structDir))
        f_row(dash, 4, "Prem/Disc", inDisc?"Discount":inPrem?"Premium":"Equilibrium", inDisc?colBull:colBear)
        f_row(dash, 5, "Pivots", str.tostring(array.size(zType)), color.white)
        f_row(dash, 6, "ATR", str.tostring(atr, format.mintick), color.white)
        f_row(dash, 7, "Min score", str.tostring(minScore), color.white)
        f_row(dash, 8, "Min confl", str.tostring(minConfl), color.white)

// =====================================================================================================================
//  MODULE 12 — ALERTS
// =====================================================================================================================
// Single dynamic alert. Message is JSON-ish so it is webhook-friendly.
alertMsg = hasPattern ? ("{\"symbol\":\"" + syminfo.ticker + "\",\"tf\":\"" + timeframe.period + "\",\"pattern\":\"" + detected.name + "\",\"dir\":\"" + (detected.dir==DIR_BULL?"bull":detected.dir==DIR_BEAR?"bear":"neutral") + "\",\"score\":" + str.tostring(detected.score,"#") + ",\"smc\":" + str.tostring(na(trade)?0:trade.confl) + ",\"smcTags\":\"" + (na(trade)?"":str.tostring(trade.conflTxt)) + "\",\"entry\":" + (na(trade)?"null":str.tostring(trade.entry, format.mintick)) + ",\"retest\":" + ((na(trade) or na(trade.retest))?"null":str.tostring(trade.retest, format.mintick)) + ",\"sl\":" + (na(trade)?"null":str.tostring(trade.sl, format.mintick)) + ",\"tp1\":" + (na(trade)?"null":str.tostring(trade.tp1, format.mintick)) + "}") : ""

if alertOnDetect and hasPattern and barstate.isconfirmed
    alert(alertMsg, alert.freq_once_per_bar_close)

// Static alertcondition for users who prefer the classic alert dialog (fires on any qualifying detection).
alertcondition(hasPattern, title="Pattern detected", message="Multi-Pattern: new pattern detected. See chart label.")

// =====================================================================================================================
//  KNOWN LIMITATIONS  (read me)
//  --------------------------------------------------------------------------------------------------------------------
//  * Pivot-based detection lags by `pivotRight` bars by design (this is the cost of non-repainting). Lower the value
//    for faster signals at the cost of more noise.
//  * Curved patterns now implemented via window-based curvature (Rounding Top/Bottom, Cup & Handle + Inverse) and
//    pivot-amplitude analysis (Diamond Top/Bottom). These read the raw price window (roundBars) rather than the zigzag
//    buffer. Tune `roundBars` per timeframe. Saucer Bottom maps onto "Rounding Bottom" (just a shallower arc).
//  * Named prompt variants map onto implemented geometry:
//      Bullish/Bearish Rectangle      -> "Rectangle / Range" + resolution direction
//      Megaphone / Broadening Wedge   -> "Broadening Formation"
//      Bull/Bear Pennant              -> approximated by "Symmetrical Triangle" after an impulse, or by "Bull/Bear Flag"
//      Channels (Rising/Falling/Horiz)-> "Ascending/Descending Channel" + "Rectangle / Range"
//      Complex / Adam-Eve variants    -> base reversal family (H&S, Double/Triple)
//  * One pattern is surfaced per bar (highest score). For multi-pattern stacking, raise minScore and review history.
//  * Volume factor degrades gracefully to 0.5 on volumeless instruments (some FX/CFD feeds).
//  * SMC/ICT layer: confluences (Discount/Premium, FVG, Order Block proxy, Liquidity Sweep, BOS, OTE) boost the score
//    (+conflBoost each) and produce a conservative retest entry (purple line) at the nearest FVG/OB/OTE level. Set
//    `minConfl` > 0 to REQUIRE institutional confluence before a pattern is accepted. Neutral/bilateral patterns are
//    not SMC-gated (no directional bias). Order-block proxy is the last opposing candle before a BOS, not a full
//    mitigation-block model.
//
//  RECOMMENDED SETTINGS BY MARKET
//  --------------------------------------------------------------------------------------------------------------------
//  Forex (1H/4H) : pivotL/R 5/5, tol 2.5%, volMult 1.2, atrFilter 1.0, minScore 60
//  Gold XAUUSD   : pivotL/R 6/6, tol 3.5%, volMult 1.3, atrFilter 1.2, minScore 62
//  Crypto        : pivotL/R 4/4, tol 4.0%, volMult 1.5, atrFilter 1.5, minScore 65   (high volatility)
//  Stocks (D)    : pivotL/R 5/5, tol 3.0%, volMult 1.4, atrFilter 1.0, minScore 60   (volume reliable)
// =====================================================================================================================
